{
  "version": 2,
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/run-scheduled",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cleanup-media",
      "schedule": "0 20 * * *"
    }
  ],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/css/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/js/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/downloads/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(css|js|downloads)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
