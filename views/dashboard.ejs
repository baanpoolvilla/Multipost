<script>
  (async function checkExpiredJobs() {
    try {
      const [postsRes, jobsRes] = await Promise.all([
        fetch('/api/posts/expired'),
        fetch('/api/agent/jobs/expired'),
      ]);
      const expiredPosts = postsRes.ok ? await postsRes.json() : [];
      const expiredJobs  = jobsRes.ok  ? await jobsRes.json()  : [];
      const total = expiredPosts.length + expiredJobs.length;
      if (!total) return;
      const { isConfirmed, isDenied } = await Swal.fire({
        icon: 'warning',
        title: `มีงานหมดเวลา ${total} รายการ`,
        html: `ระบบไม่โพสงานที่หมดเวลาให้อัตโนมัติ เพื่อป้องกันการโพสย้อนหลัง<br>กรุณาเลื่อนเวลาใหม่ หรือลบรายการที่ไม่ต้องการแล้ว`,
        showCancelButton: true, showDenyButton: true,
        confirmButtonText: '<i class="fa-solid fa-eye"></i> ดูรายการ',
        denyButtonText: '<i class="fa-solid fa-trash"></i> ลบทั้งหมด',
        cancelButtonText: 'ปิด', confirmButtonColor: '#F97316', denyButtonColor: '#c62828',
      });
      if (isConfirmed) {
        const hasPosts = expiredPosts.length > 0, hasJobs = expiredJobs.length > 0;
        if (hasPosts && hasJobs) {
          const pick = await Swal.fire({
            icon: 'question', title: 'ดูรายการไหน?',
            html: `มีทั้งโพสต์เพจที่หมดเวลา (${expiredPosts.length}) และแชร์กลุ่มที่หมดเวลา (${expiredJobs.length})`,
            showDenyButton: true, showCancelButton: true,
            confirmButtonText: `<i class="fa-brands fa-facebook"></i> โพสต์เพจ (${expiredPosts.length})`,
            denyButtonText: `<i class="fa-solid fa-users"></i> แชร์กลุ่ม (${expiredJobs.length})`,
            cancelButtonText: 'ปิด', confirmButtonColor: '#F97316', denyButtonColor: '#0D9488',
          });
          if (pick.isConfirmed) location.href = '/post-queue?status=expired';
          else if (pick.isDenied) location.href = '/job-queue?status=expired';
        } else {
          location.href = hasPosts ? '/post-queue?status=expired' : '/job-queue?status=expired';
        }
      } else if (isDenied) {
        await Promise.all([
          ...expiredPosts.map(p => fetch(`/history/${p.id}`, { method: 'DELETE' }).catch(() => {})),
          ...expiredJobs.map(j  => fetch(`/api/agent/jobs/${j._id}`, { method: 'DELETE' }).catch(() => {})),
        ]);
        Swal.fire({ icon: 'success', title: 'ลบแล้ว', timer: 1500, showConfirmButton: false });
      }
    } catch {}
  })();
</script>
