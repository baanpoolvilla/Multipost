<script>
  function toggleDelayTipWeb() {
    const p = document.getElementById('delayTipWebPanel');
    p.style.display = p.style.display === 'none' ? '' : 'none';
  }
  function toggleWebTips(e) {
    e?.stopPropagation();
    const el  = document.getElementById('webTipsPanel');
    const btn = document.getElementById('btnWebTips');
    if (el.style.display !== 'none') {
      el.style.display = 'none'; btn?.classList.remove('active'); return;
    }
    el.style.display = '';
    btn?.classList.add('active');
    const bRect = btn.getBoundingClientRect();
    const eW = el.offsetWidth, eH = el.offsetHeight;
    const vW = window.innerWidth, vH = window.innerHeight;
    let top = bRect.top - eH - 6;
    if (top < 8) top = bRect.bottom + 6;
    let left = bRect.left;
    if (left + eW > vW - 8) left = vW - eW - 8;
    if (left < 8) left = 8;
    el.style.top = top + 'px'; el.style.left = left + 'px';
  }
  document.addEventListener('click', (e) => {
    const wrap = document.getElementById('webTipsWrap');
    if (wrap && !wrap.contains(e.target)) {
      const el = document.getElementById('webTipsPanel');
      const btn = document.getElementById('btnWebTips');
      if (el) el.style.display = 'none';
      if (btn) btn.classList.remove('active');
    }
  });
  function toggleVideoInfo() {
    const p = document.getElementById('videoInfoPanel');
    p.style.display = p.style.display === 'none' ? 'flex' : 'none';
  }
</script>
