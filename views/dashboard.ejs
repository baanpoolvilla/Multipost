<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>โพสใหม่ · EasyBoss Multi-Post</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.11.0/dist/tabler-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/auth-guard.js"></script>
</head>
<body class="eb">

<div class="app">
  <%- include('partials/sidebar', { active: 'compose' }) %>

  <div class="main">
    <div class="topbar">
      <div>
        <h1>โพสใหม่ <span class="tag pg">เพจ</span></h1>
        <div class="sub">โพสต์เดียว ส่งได้หลายเพจพร้อมกัน</div>
      </div>
      <div class="tb-actions">
        <button type="button" class="btn" onclick="saveCurrentAsTemplate()"><i class="ti ti-device-floppy"></i> บันทึกเทมเพลต</button>
        <button type="button" id="submitBtn" class="btn primary" onclick="submitPost()"><i class="ti ti-send"></i> โพส</button>
      </div>
    </div>

    <div class="grid two">
      <!-- ── Composer ── -->
      <div class="card">
        <!-- Tags bar -->
        <div id="tagsBar" class="tags-bar" style="display:none"></div>

        <!-- Hidden inputs (functional — do not remove) -->
        <input type="hidden" id="feelingEmoji">
        <input type="hidden" id="feelingLabel">
        <input type="file" id="fileInput" multiple accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/quicktime,video/x-msvideo,video/webm" style="display:none">

        <!-- Page selector -->
        <div class="mini" style="margin-bottom:8px">โพสต์ไปยัง <b style="color:var(--module-color-dk)" id="pageCountLabel">โพสไปยัง <%= pages.length %> เพจ</b></div>
        <div class="page-selector pill-row" style="margin-bottom:14px">
          <button class="page-sel-chip all-chip active" onclick="toggleAllPages(this)">
            <i class="fa-solid fa-check"></i> ทั้งหมด
          </button>
          <% const colors = ['blue','green','orange','purple','red']; %>
          <% pages.slice(0, 8).forEach((p, i) => { %>
          <button class="page-sel-chip active" data-page-id="<%= p.pageId %>" onclick="togglePage(this)">
            <div class="avatar avatar-<%= colors[i%5] %>" style="width:16px;height:16px;font-size:.55rem;flex-shrink:0"><%= p.pageName.slice(-1) %></div>
            <%= p.pageName %>
            <span class="chip-remove" onclick="event.stopPropagation();removePage('<%= p.pageId %>',this.closest('.page-sel-chip'))" title="ปิดใช้งานเพจนี้">×</span>
          </button>
          <% }); %>
          <% if (pages.length > 8) { %>
          <button class="page-sel-chip more-pages-chip" id="morePageChip" onclick="openPagePopup()">
            <i class="fa-solid fa-ellipsis"></i>
            <span id="morePageChipLabel">+ <%= pages.length - 8 %> เพจ</span>
          </button>
          <% } %>
          <button type="button" class="page-sel-chip add-page-chip" onclick="openAddPagePopup()" title="เพิ่มเพจ">
            <i class="fa-solid fa-plus"></i>
          </button>
        </div>

        <!-- Textarea -->
        <textarea id="message" placeholder="พิมพ์ข้อความที่ต้องการโพส..." rows="6"></textarea>
        <div class="emoji-strip" style="margin-top:8px">
          <% ['😊','🔥','❤️','👍','🎉','✨','📣','💎','🏖️','🌟'].forEach(e => { %>
          <button type="button" class="emoji-btn" onclick="insertEmoji('<%= e %>')"><%= e %></button>
          <% }); %>
        </div>

        <!-- Image previews (functional) -->
        <div id="tplImagePreview" class="image-preview-grid" style="display:none"></div>
        <div id="imagePreview" class="image-preview-grid" style="display:none"></div>

        <!-- Action row -->
        <div style="display:flex;align-items:center;gap:7px;margin-top:12px;flex-wrap:wrap">
          <button type="button" class="ico-btn" onclick="triggerImage()" title="รูปภาพ/วิดีโอ"><i class="ti ti-photo"></i></button>
          <button type="button" class="ico-btn" onclick="openTemplateModal()" title="เทมเพลต"><i class="ti ti-template"></i></button>
          <button type="button" class="ico-btn" style="border-color:var(--module-color);color:var(--module-color)" onclick="aiAssist()" title="AI ช่วยเขียนแคปชัน"><i class="ti ti-sparkles"></i></button>
          <span onclick="toggleVideoInfo()" class="mini" style="cursor:pointer;display:inline-flex;align-items:center;gap:.25rem"><i class="ti ti-info-circle"></i> ข้อจำกัดวิดีโอ</span>
          <span style="margin-left:auto" class="mini"><span id="charCount">0</span> ตัวอักษร</span>
        </div>

        <hr class="sep">

        <!-- Delay + schedule -->
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
          <div style="display:flex;align-items:center;gap:.4rem">
            <i class="ti ti-stopwatch" style="color:var(--ink-soft)"></i>
            <span class="mini" style="white-space:nowrap">หน่วงเวลา/เพจ</span>
            <input type="number" id="postDelay" value="30" min="0" max="120" style="width:64px;text-align:center;padding:6px 8px">
            <span class="mini">วิ</span>
            <button type="button" onclick="toggleDelayTipWeb()" class="ico-btn" style="width:24px;height:24px;font-size:12px" title="คำแนะนำหน่วงเวลา"><i class="ti ti-help"></i></button>
          </div>
          <div style="display:flex;align-items:center;gap:.4rem;margin-left:auto">
            <a href="/schedule-post" class="chip out" style="text-decoration:none"><i class="ti ti-clock"></i> ตั้งเวลา</a>
            <div style="position:relative" id="webTipsWrap">
              <button type="button" id="btnWebTips" onclick="toggleWebTips(event)" class="chip" style="background:var(--warning-bg);color:var(--warning)">💡 เคล็ดลับ</button>
              <div id="webTipsPanel" style="display:none;position:fixed;z-index:9999;width:480px;filter:drop-shadow(0 6px 20px rgba(0,0,0,.18))">
                <div style="background:#fff;border:1px solid var(--line);border-radius:12px;padding:.9rem 1.05rem;font-size:.8rem;line-height:1.7">
                  <div style="font-weight:700;margin-bottom:.65rem;font-size:.85rem">💡 คำแนะนำการโพสให้ปลอดภัย</div>
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:.6rem">
                    <div style="background:var(--module-color-bg);border:1px solid #f5c37d;border-radius:9px;padding:.65rem .8rem">
                      <div style="font-weight:700;color:var(--module-color-dk);margin-bottom:.5rem;font-size:.78rem">📄 โพสลงเพจ</div>
                      <div style="display:flex;flex-direction:column;gap:.3rem;color:#374151">
                        <div>✅ ความถี่ ทุก 3–4 ชม. | 4–6 โพส/วัน</div>
                        <div>🕐 เวลาดี 9 · 12 · 15 · 18 · 20 น.</div>
                        <div>📸 สลับ รูป / คลิป / ข้อความ</div>
                        <div>❌ ห้าม เกิน 10 โพส/วัน</div>
                      </div>
                    </div>
                    <div style="background:var(--group-bg);border:1px solid #86c7bf;border-radius:9px;padding:.65rem .8rem">
                      <div style="font-weight:700;color:var(--group-dk);margin-bottom:.5rem;font-size:.78rem">👥 โพส&amp;แชร์กลุ่ม</div>
                      <div style="display:flex;flex-direction:column;gap:.3rem;color:#374151">
                        <div>⏱ Delay 30–60 วิ · ใหม่: 60–90 วิ</div>
                        <div>📊 ต่อรอบ ไม่เกิน 30–50 กลุ่ม</div>
                        <div>📅 ต่อวัน ไม่เกิน 60 กลุ่ม</div>
                        <div>🔄 แบ่งรอบ เช้า + บ่าย + เย็น</div>
                        <div>❌ ห้าม โพสทุกกลุ่มทีเดียว</div>
                      </div>
                    </div>
                  </div>
                  <div style="background:var(--warning-bg);border:1px solid #f0d59a;border-radius:7px;padding:.45rem .75rem;margin-top:.6rem;font-size:.76rem;color:#78350f">
                    ⚠️ โพสเร็ว/เยอะเกิน → FB อาจจำกัดการโพสหรือแบนบัญชีชั่วคราว
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Delay tip panel -->
        <div id="delayTipWebPanel" style="display:none;margin-top:.6rem">
          <div style="background:var(--info-bg);border:1px solid #b3d4f9;border-radius:8px;padding:.6rem .85rem;font-size:.8rem;line-height:1.8">
            <div style="font-weight:700;color:var(--info);margin-bottom:.3rem">⏱ คำแนะนำ: หน่วงเวลาต่อเพจ</div>
            <div style="display:grid;grid-template-columns:auto 1fr;gap:.05rem .55rem;color:#444">
              <span style="color:var(--danger);font-weight:600">0 วิ</span><span>⚠️ ไม่หน่วง — เสี่ยงโดนจำกัดจาก Facebook</span>
              <span style="color:var(--warning);font-weight:600">1-15 วิ</span><span>⚠️ เสี่ยงปานกลาง</span>
              <span style="color:var(--success);font-weight:700">30-60 วิ</span><span style="color:var(--success)">✅ แนะนำ — สมดุลความเร็วกับความปลอดภัย</span>
              <span style="color:var(--success);font-weight:600">&gt; 60 วิ</span><span>✅ ปลอดภัยสูง — แต่ใช้เวลานาน</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Right column: preview + recent + help ── -->
      <div class="grid" style="gap:16px;align-content:start">
        <div class="preview">
          <div class="ph"><i class="ti ti-eye"></i> พรีวิว</div>
          <div class="pv-card">
            <div class="pv-head">
              <div class="ava-sm" style="background:var(--brand-navy)"><%= pages.length ? pages[0].pageName.slice(-1) : 'BP' %></div>
              <div id="pvPage" style="font-size:12.5px;font-weight:600"><%= pages.length ? pages[0].pageName : 'เพจของคุณ' %></div>
            </div>
            <div class="pv-img"><i class="ti ti-photo"></i></div>
            <div class="pv-body" id="pvBody" style="color:var(--ink-soft)">พิมพ์ข้อความเพื่อดูตัวอย่าง…</div>
          </div>
        </div>

        <div class="card" style="padding:16px">
          <div style="font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:6px"><i class="ti ti-clock-hour-4" style="color:var(--module-color)"></i> โพสล่าสุด</div>
          <% if (recentPosts.length === 0) { %>
          <div class="mini" style="text-align:center;padding:1rem 0">ยังไม่มีโพสต์</div>
          <% } else { %>
          <% recentPosts.forEach(post => {
               const isSchd = post.status === 'pending';
               const refDt  = new Date(isSchd ? post.scheduledAt : (post.lastAttemptAt || post.createdAt));
               const hm     = refDt.toLocaleTimeString('th-TH', {hour:'2-digit', minute:'2-digit', hour12:false, timeZone:'Asia/Bangkok'});
               const allOk  = post.failCount === 0;
               const total  = post.results.length;
          %>
          <a href="<%= isSchd ? '#' : '/result/'+post.id %>" style="display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--line);font-size:12.5px">
            <span class="mini" style="min-width:38px"><%= hm %></span>
            <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%= post.message %>"><%= post.message.length > 24 ? post.message.slice(0,24)+'…' : post.message %></span>
            <span class="badge <%= isSchd ? 'b-wait' : (allOk ? 'b-ok' : 'b-fail') %>"><% if (isSchd) { %>รอโพส<% } else { %><%= post.successCount %>/<%= total %><% } %></span>
          </a>
          <% }); %>
          <% } %>
          <a href="/history" class="mini" style="display:inline-flex;align-items:center;gap:4px;margin-top:10px;color:var(--module-color-dk);font-weight:600">ดูทั้งหมด <i class="ti ti-arrow-right"></i></a>
        </div>

        <div class="card" style="padding:16px">
          <div style="font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:6px"><i class="ti ti-help-circle" style="color:var(--ink-soft)"></i> วิธีใช้งาน</div>
          <div class="mini" style="line-height:1.7">
            <div style="padding-bottom:.55rem;margin-bottom:.55rem;border-bottom:1px solid var(--line)"><i class="ti ti-circle-check" style="color:var(--success)"></i> <b style="color:var(--ink)">โพสลงเพจ</b> — พิมพ์ข้อความ เลือกเพจ กด "โพส" ได้เลย</div>
            <div><i class="ti ti-arrow-down-circle" style="color:var(--warning)"></i> <b style="color:var(--ink)">โพส&amp;แชร์ลงกลุ่ม</b> — ต้องติดตั้ง <a href="/agent" style="color:var(--group-dk);font-weight:600">Desktop Agent</a> ก่อน</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ── Template Modal (unchanged — functional) ── -->
<div id="templateModal" class="map-modal-overlay" style="display:none" onclick="closeTplOnBg(event)">
  <div class="map-modal-box" style="width:820px;max-width:96vw;max-height:92vh;display:flex;flex-direction:column;padding:0;border-radius:12px;overflow:hidden">
    <div style="background:#1a1a1a;padding:.75rem 1rem;display:flex;align-items:center;flex-wrap:wrap;gap:.5rem">
      <i class="fa-solid fa-layer-group" style="color:#fff;font-size:.95rem"></i>
      <span style="color:#fff;font-weight:700;font-size:.95rem">ระบบโพสต์</span>
      <span id="tplCountBadge" style="background:#444;color:#aaa;border-radius:999px;font-size:.7rem;padding:.1rem .45rem;min-width:18px;text-align:center">0</span>
      <div style="margin-left:auto;display:flex;align-items:center;gap:.4rem;flex-wrap:wrap">
        <div style="display:flex;background:#333;border-radius:7px;overflow:hidden">
          <button id="tplViewCardBtn" onclick="setTplView('card')" style="background:#1877f2;color:#fff;border:none;padding:.3rem .6rem;cursor:pointer;font-size:.78rem"><i class="fa-solid fa-grip"></i></button>
          <button id="tplViewListBtn" onclick="setTplView('list')" style="background:transparent;color:#aaa;border:none;padding:.3rem .6rem;cursor:pointer;font-size:.78rem"><i class="fa-solid fa-list"></i></button>
        </div>
        <div style="position:relative">
          <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:.5rem;top:50%;transform:translateY(-50%);color:#aaa;font-size:.7rem;pointer-events:none"></i>
          <input id="tplSearchInput" type="text" placeholder="ค้นหา..." oninput="renderTemplates()"
            style="background:#333;color:#fff;border:none;border-radius:7px;padding:.32rem .6rem .32rem 1.6rem;font-size:.78rem;font-family:inherit;outline:none;width:130px">
        </div>
        <button id="tplMultiBtn" onclick="toggleTplMultiSelect()"
          style="background:#333;color:#aaa;border:none;border-radius:7px;padding:.35rem .7rem;font-size:.78rem;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:.3rem" title="เลือกหลายรายการเพื่อย้ายเข้าโฟลเดอร์">
          <i class="fa-solid fa-folder-plus"></i><span>จัดโฟลเดอร์</span>
        </button>
        <button onclick="openCreateTemplate()"
          style="background:#1877f2;color:#fff;border:none;border-radius:7px;padding:.35rem .85rem;font-size:.8rem;cursor:pointer;font-family:inherit;font-weight:700;display:flex;align-items:center;gap:.35rem">
          <i class="fa-solid fa-plus"></i> สร้างโพสต์
        </button>
        <button onclick="closeTemplateModal()" style="background:none;border:none;color:#aaa;cursor:pointer;font-size:1.1rem;padding:.15rem .4rem;line-height:1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>
    <div id="tplFolderTabs" style="display:flex;gap:.35rem;flex-wrap:wrap;padding:.4rem .85rem;background:#222;border-bottom:1px solid #333;overflow-x:auto"></div>
    <div id="tplBulkBar" style="display:none;align-items:center;gap:.5rem;flex-wrap:wrap;padding:.5rem .85rem;background:#fff3cd;border-bottom:1px solid #ffe08a">
      <span style="font-size:.8rem;color:#856404;font-weight:600"><strong id="tplSelCount">0</strong> รายการที่เลือก</span>
      <button onclick="tplBulkMove()" style="background:#1877f2;color:#fff;border:none;border-radius:7px;padding:.3rem .65rem;font-size:.78rem;font-weight:600;cursor:pointer;font-family:inherit"><i class="fa-solid fa-folder-plus"></i> เพิ่มเข้าโฟลเดอร์</button>
      <button onclick="tplBulkRemoveFromFolder()" style="background:#fff;border:1px solid #856404;color:#856404;border-radius:7px;padding:.3rem .65rem;font-size:.78rem;cursor:pointer;font-family:inherit">เอาออกจากโฟลเดอร์</button>
      <button onclick="tplBulkDelete()" style="background:#fff;border:1px solid #c62828;color:#c62828;border-radius:7px;padding:.3rem .65rem;font-size:.78rem;cursor:pointer;font-family:inherit"><i class="fa-solid fa-trash"></i> ลบ</button>
      <button onclick="tplSelectAll()" style="background:none;border:none;color:#856404;font-size:.78rem;cursor:pointer;font-family:inherit;margin-left:auto">เลือกทั้งหมด</button>
      <button onclick="toggleTplMultiSelect()" style="background:none;border:none;color:#856404;font-size:.78rem;cursor:pointer;font-family:inherit">ปิด</button>
    </div>
    <div id="tplBody" style="flex:1;overflow-y:auto;padding:1rem;background:#f0f2f5;min-height:180px"></div>
    <div id="tplFooter" style="display:none;padding:.65rem 1rem;background:#fff;border-top:1px solid #e4e6eb">
      <button onclick="useTpl()" style="width:100%;background:#1877f2;color:#fff;border:none;border-radius:10px;padding:.6rem;font-size:.9rem;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:.5rem">
        <i class="fa-solid fa-paper-plane"></i> ใช้โพสต์นี้
      </button>
    </div>
  </div>
</div>

<!-- Video info popup (unchanged — functional) -->
<div id="videoInfoPanel" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:9999;align-items:center;justify-content:center" onclick="if(event.target===this)toggleVideoInfo()">
  <div style="background:#fff;border-radius:14px;padding:1.25rem 1.5rem;max-width:420px;width:90%;box-shadow:0 8px 32px rgba(0,0,0,.18)">
    <div style="font-weight:700;font-size:1rem;margin-bottom:.75rem;display:flex;align-items:center;gap:.5rem">
      <i class="ti ti-video" style="color:var(--module-color)"></i> ข้อจำกัดการโพสวิดีโอ
    </div>
    <div style="font-size:.84rem;color:#444;line-height:1.8">
      <div style="display:grid;grid-template-columns:auto 1fr;gap:.2rem .75rem;margin-bottom:.6rem">
        <span style="font-weight:700;color:#1c1e21">ขนาดไฟล์สูงสุด</span><span>1 GB ต่อไฟล์</span>
        <span style="font-weight:700;color:#1c1e21">ความยาวสูงสุด</span><span>240 นาที</span>
        <span style="font-weight:700;color:#1c1e21">ฟอร์แมตรองรับ</span><span>MP4, MOV, AVI, WMV, WebM</span>
        <span style="font-weight:700;color:#1c1e21">ความละเอียดแนะนำ</span><span>720p ขึ้นไป (1280×720)</span>
      </div>
      <div style="background:var(--warning-bg);border:1px solid #f9a825;border-radius:8px;padding:.5rem .75rem;font-size:.78rem;color:#78350f">
        ⚠️ วิดีโอขนาดใหญ่อาจใช้เวลาอัพโหลดนาน แนะนำ <strong>MP4 H.264</strong> เพื่อผลดีที่สุด
      </div>
    </div>
    <button onclick="toggleVideoInfo()" class="btn primary" style="margin-top:.85rem;width:100%;justify-content:center">รับทราบ</button>
  </div>
</div>

<script>
  function toggleDelayTipWeb() {
    const p = document.getElementById('delayTipWebPanel');
    p.style.display = p.style.display === 'none' ? '' : 'none';
  }
  function toggleWebTips(e) {
    e?.stopPropagation();
    const el  = document.getElementById('webTipsPanel');
    const btn = document.getElementById('btnWebTips');
    if (el.style.display !== 'none') { el.style.display = 'none'; return; }
    el.style.display = '';
    const bRect = btn.getBoundingClientRect();
    const eW = el.offsetWidth, eH = el.offsetHeight, vW = window.innerWidth;
    let top = bRect.top - eH - 6; if (top < 8) top = bRect.bottom + 6;
    let left = bRect.left; if (left + eW > vW - 8) left = vW - eW - 8; if (left < 8) left = 8;
    el.style.top = top + 'px'; el.style.left = left + 'px';
  }
  document.addEventListener('click', (e) => {
    const wrap = document.getElementById('webTipsWrap');
    if (wrap && !wrap.contains(e.target)) {
      const el = document.getElementById('webTipsPanel');
      if (el) el.style.display = 'none';
    }
  });
  function toggleVideoInfo() {
    const p = document.getElementById('videoInfoPanel');
    p.style.display = p.style.display === 'none' ? 'flex' : 'none';
  }
  // AI caption assist — placeholder until backend is wired (brief §3.2)
  function aiAssist() {
    Swal.fire({ icon: 'info', title: 'AI ช่วยเขียนแคปชัน', text: 'ฟีเจอร์นี้กำลังพัฒนา จะเปิดใช้เร็ว ๆ นี้', confirmButtonColor: '#F97316' });
  }
  // Live preview mirror
  (function () {
    const msg = document.getElementById('message');
    const pvBody = document.getElementById('pvBody');
    if (msg && pvBody) {
      const sync = () => {
        const v = msg.value.trim();
        pvBody.textContent = v || 'พิมพ์ข้อความเพื่อดูตัวอย่าง…';
        pvBody.style.color = v ? 'var(--ink)' : 'var(--ink-soft)';
      };
      msg.addEventListener('input', sync);
    }
  })();
</script>
