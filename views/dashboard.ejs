<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <div class="nav-avatar"><i class="fa-solid fa-user"></i></div>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <!-- Sidebar -->
  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item active"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <!-- Feed -->
  <main class="feed">

    <!-- Composer card -->
    <div class="card post-composer">
      <div class="composer-header">
        <div class="avatar avatar-blue"><i class="fa-solid fa-building"></i></div>
        <div class="composer-meta">
          <span class="composer-name">Admin</span>
          <div class="audience-badge">
            <i class="fa-solid fa-earth-asia"></i>
            <span>สาธารณะ</span>
            <i class="fa-solid fa-caret-down"></i>
          </div>
        </div>
      </div>

      <!-- Tags bar -->
      <div id="tagsBar" class="tags-bar" style="display:none"></div>

      <!-- Hidden inputs -->
      <input type="hidden" id="feelingEmoji">
      <input type="hidden" id="feelingLabel">
      <input type="file" id="fileInput" multiple accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/quicktime,video/x-msvideo,video/webm" style="display:none">

      <!-- Textarea area -->
      <div class="composer-textarea-wrap">
        <textarea id="message" placeholder="พิมพ์ข้อความที่ต้องการโพส..." rows="4"></textarea>
        <div class="emoji-strip">
          <% ['😊','🔥','❤️','👍','🎉','✨','📣','💎','🏖️','🌟'].forEach(e => { %>
          <button type="button" class="emoji-btn" onclick="insertEmoji('<%= e %>')"><%= e %></button>
          <% }); %>
        </div>
      </div>

      <!-- Template image previews (loaded from template) -->
      <div id="tplImagePreview" class="image-preview-grid" style="display:none"></div>

      <!-- Image preview (newly selected files) -->
      <div id="imagePreview" class="image-preview-grid" style="display:none"></div>
      <div class="char-bar"><span id="charCount">0</span> ตัวอักษร</div>

      <!-- Page selector -->
      <div class="page-selector">
        <span class="page-selector-label"><i class="fa-solid fa-layer-group" style="color:#1877f2"></i> เพจ:</span>
        <button class="page-sel-chip all-chip active" onclick="toggleAllPages(this)">
          <i class="fa-solid fa-check"></i> ทั้งหมด
        </button>
        <% const colors = ['blue','green','orange','purple','red']; %>
        <% pages.slice(0, 8).forEach((p, i) => { %>
        <button class="page-sel-chip active" data-page-id="<%= p.pageId %>" onclick="togglePage(this)">
          <div class="avatar avatar-<%= colors[i%5] %>" style="width:16px;height:16px;font-size:.55rem;flex-shrink:0"><%= p.pageName.slice(-1) %></div>
          <%= p.pageName %>
          <span class="chip-remove" onclick="event.stopPropagation();removePage('<%= p.pageId %>',this.closest('.page-sel-chip'))" title="ปิดใช้งานเพจนี้">×</span>
        </button>
        <% }); %>
        <% if (pages.length > 8) { %>
        <button class="page-sel-chip more-pages-chip" id="morePageChip" onclick="openPagePopup()">
          <i class="fa-solid fa-ellipsis"></i>
          <span id="morePageChipLabel">+ <%= pages.length - 8 %> เพจ</span>
        </button>
        <% } %>
        <button type="button" class="page-sel-chip add-page-chip" onclick="openAddPagePopup()" title="เพิ่มเพจ">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>

      <!-- Action buttons -->
      <div class="composer-actions-row">
        <button type="button" class="action-chip" onclick="triggerImage()">
          <i class="fa-solid fa-image" style="color:#45bd62"></i><span>รูปภาพ/วิดีโอ</span>
        </button>
        <span onclick="toggleVideoInfo()" style="font-size:.7rem;color:#8a8d91;cursor:pointer;display:inline-flex;align-items:center;gap:.2rem;padding:.2rem .4rem;border-radius:5px;transition:background .12s" onmouseover="this.style.background='#f0f2f5'" onmouseout="this.style.background='transparent'">
          <i class="fa-solid fa-circle-info" style="font-size:.72rem"></i> ข้อจำกัดวิดีโอ
        </span>
<button type="button" class="action-chip" onclick="openTemplateModal()">
          <i class="fa-solid fa-layer-group" style="color:#1877f2"></i><span>เทมเพลต</span>
        </button>
      </div>

      <!-- Delay + Schedule row -->
      <div style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;padding:.55rem 0;border-top:1px solid var(--border-color);margin-top:.1rem">
        <div style="display:flex;align-items:center;gap:.35rem">
          <i class="fa-solid fa-stopwatch" style="color:#8a8d91;font-size:.8rem"></i>
          <span style="font-size:.78rem;color:#65676b;white-space:nowrap">หน่วงเวลา/เพจ</span>
          <input type="number" id="postDelay" value="30" min="0" max="120"
            style="width:54px;padding:.28rem .4rem;border:1.5px solid #e4e6eb;border-radius:7px;font-size:.82rem;font-family:inherit;outline:none;text-align:center">
          <span style="font-size:.78rem;color:#8a8d91">วิ</span>
          <span style="font-size:.73rem;color:#42b72a;font-weight:600;white-space:nowrap">(แนะนำ 30-60)</span>
          <button type="button" onclick="toggleDelayTipWeb()"
            style="background:none;border:1px solid #dbe0e6;border-radius:50%;width:18px;height:18px;font-size:10px;cursor:pointer;color:#8a8d91;display:inline-flex;align-items:center;justify-content:center;padding:0;flex-shrink:0"
            title="คำแนะนำหน่วงเวลา">ⓘ</button>
        </div>
        <!-- Delay tip panel -->
        <div id="delayTipWebPanel" style="display:none;width:100%;margin-top:.35rem">
          <div style="background:#f0f7ff;border:1px solid #b3d4f9;border-radius:8px;padding:.6rem .85rem;font-size:.8rem;line-height:1.8">
            <div style="font-weight:700;color:#1877f2;margin-bottom:.3rem">⏱ คำแนะนำ: หน่วงเวลาต่อเพจ</div>
            <div style="display:grid;grid-template-columns:auto 1fr;gap:.05rem .55rem;color:#444">
              <span style="color:#f44336;font-weight:600">0 วิ</span><span>⚠️ ไม่หน่วง — เสี่ยงโดนจำกัดจาก Facebook</span>
              <span style="color:#ff9800;font-weight:600">1-15 วิ</span><span>⚠️ เสี่ยงปานกลาง</span>
              <span style="color:#42b72a;font-weight:700">30-60 วิ</span><span style="color:#42b72a">✅ แนะนำ — สมดุลระหว่างความเร็วกับความปลอดภัย</span>
              <span style="color:#42b72a;font-weight:600">&gt; 60 วิ</span><span>✅ ปลอดภัยสูง — แต่ใช้เวลานาน</span>
            </div>
            <div style="margin-top:.35rem;font-size:.74rem;color:#8a8d91">💡 ยิ่งโพสหลายเพจหรือบัญชีใหม่ ควรตั้งหน่วงเวลานานขึ้น</div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:.35rem;flex-wrap:wrap">
          <!-- Schedule link -->
          <a href="/schedule-post"
            style="display:inline-flex;align-items:center;gap:.3rem;background:#f0f7ff;border:1.5px solid #1877f2;border-radius:7px;padding:.26rem .65rem;font-size:.78rem;cursor:pointer;font-family:inherit;color:#1877f2;font-weight:600;text-decoration:none;transition:background .15s"
            onmouseover="this.style.background='#dbeafe'" onmouseout="this.style.background='#f0f7ff'">
            <i class="fa-solid fa-clock"></i> ตั้งเวลา
          </a>
          <!-- Tips popup button -->
          <div style="position:relative" id="webTipsWrap">
            <button type="button" id="btnWebTips" onclick="toggleWebTips(event)"
              style="display:inline-flex;align-items:center;gap:.3rem;background:#fff8e1;border:1.5px solid #f9a825;border-radius:7px;padding:.26rem .65rem;font-size:.78rem;cursor:pointer;font-family:inherit;color:#7b5800;font-weight:600;transition:background .15s">
              💡 เคล็ดลับ
            </button>
            <div id="webTipsPanel" style="display:none;position:fixed;z-index:9999;width:480px;filter:drop-shadow(0 6px 20px rgba(0,0,0,.18))">
              <div style="background:#fff;border:1.5px solid #e4e6eb;border-radius:12px;padding:.9rem 1.05rem;font-size:.8rem;line-height:1.7">
                <div style="font-weight:700;color:#1c1e21;margin-bottom:.65rem;font-size:.85rem">💡 คำแนะนำการโพสให้ปลอดภัย</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:.6rem">
                  <!-- เพจ -->
                  <div style="background:#f4f6ff;border:1.5px solid #b6c4f7;border-radius:9px;padding:.65rem .8rem">
                    <div style="font-weight:700;color:#1a3a8f;margin-bottom:.5rem;font-size:.78rem">📄 โพสลงเพจ</div>
                    <div style="display:flex;flex-direction:column;gap:.3rem;color:#374151">
                      <div><span style="background:#d1fae5;color:#065f46;border-radius:3px;padding:0 .35rem;font-size:.68rem;font-weight:700;margin-right:.3rem">✅ ความถี่</span>ทุก 3–4 ชม. | 4–6 โพส/วัน</div>
                      <div><span style="background:#dbeafe;color:#1e40af;border-radius:3px;padding:0 .35rem;font-size:.68rem;font-weight:700;margin-right:.3rem">🕐 เวลาดี</span>9 · 12 · 15 · 18 · 20 น.</div>
                      <div><span style="background:#fef3c7;color:#92400e;border-radius:3px;padding:0 .35rem;font-size:.68rem;font-weight:700;margin-right:.3rem">📸 สลับ</span>รูป / คลิป / ข้อความ</div>
                      <div><span style="background:#fee2e2;color:#991b1b;border-radius:3px;padding:0 .35rem;font-size:.68rem;font-weight:700;margin-right:.3rem">❌ ห้าม</span>เกิน 10 โพส/วัน</div>
                    </div>
                  </div>
                  <!-- กลุ่ม -->
                  <div style="background:#fffbf0;border:1.5px solid #f5c37d;border-radius:9px;padding:.65rem .8rem">
                    <div style="font-weight:700;color:#7b3b00;margin-bottom:.5rem;font-size:.78rem">👥 โพส&amp;แชร์กลุ่ม</div>
                    <div style="display:flex;flex-direction:column;gap:.3rem;color:#374151">
                      <div><span style="background:#d1fae5;color:#065f46;border-radius:3px;padding:0 .35rem;font-size:.68rem;font-weight:700;margin-right:.3rem">⏱ Delay</span>30–60 วิ · ใหม่: 60–90 วิ</div>
                      <div><span style="background:#dbeafe;color:#1e40af;border-radius:3px;padding:0 .35rem;font-size:.68rem;font-weight:700;margin-right:.3rem">📊 ต่อรอบ</span>ไม่เกิน 30–50 กลุ่ม</div>
                      <div><span style="background:#dbeafe;color:#1e40af;border-radius:3px;padding:0 .35rem;font-size:.68rem;font-weight:700;margin-right:.3rem">📅 ต่อวัน</span>ไม่เกิน 60 กลุ่ม</div>
                      <div><span style="background:#f3e8ff;color:#6b21a8;border-radius:3px;padding:0 .35rem;font-size:.68rem;font-weight:700;margin-right:.3rem">🔄 แบ่งรอบ</span>เช้า + บ่าย + เย็น</div>
                      <div><span style="background:#fef3c7;color:#92400e;border-radius:3px;padding:0 .35rem;font-size:.68rem;font-weight:700;margin-right:.3rem">🔁 ซ้ำ</span>กลุ่มเดิมห่างกัน 1–2 วัน</div>
                      <div><span style="background:#fee2e2;color:#991b1b;border-radius:3px;padding:0 .35rem;font-size:.68rem;font-weight:700;margin-right:.3rem">❌ ห้าม</span>โพสทุกกลุ่มทีเดียว</div>
                    </div>
                  </div>
                </div>
                <div style="background:#fff8e1;border:1px solid #f9a825;border-radius:7px;padding:.45rem .75rem;margin-top:.6rem;font-size:.76rem;color:#78350f;line-height:1.5">
                  ⚠️ โพสเร็ว/เยอะเกิน → FB อาจจำกัดการโพสหรือแบนบัญชีชั่วคราว
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="composer-submit-row">
        <div class="pages-badge">
          <i class="fa-solid fa-layer-group"></i>
          <span id="pageCountLabel">โพสไปยัง <%= pages.length %> เพจ</span>
        </div>
        <button type="button" class="action-chip" onclick="saveCurrentAsTemplate()"
          style="background:#f0f2f5;border:none;margin-right:.35rem;padding:.42rem .8rem;font-size:.78rem;color:#1c1e21">
          <i class="fa-solid fa-floppy-disk" style="color:#1877f2"></i> บันทึกเทมเพลต
        </button>
        <button type="button" id="submitBtn" class="btn-post" onclick="submitPost()">
          <i class="fa-solid fa-paper-plane"></i> โพสต์
        </button>
      </div>
    </div>

    <!-- Recent posts card -->
    <div class="card">
      <div class="card-title" style="margin-bottom:.65rem">
        <i class="fa-solid fa-clock-rotate-left"></i> โพสล่าสุด
      </div>

      <% if (recentPosts.length === 0) { %>
      <div style="text-align:center;padding:1.2rem 0;color:#8a8d91;font-size:.88rem">
        <i class="fa-regular fa-face-meh-blank" style="font-size:1.8rem;display:block;margin-bottom:.4rem"></i>
        ยังไม่มีโพสต์
      </div>
      <% } else { %>
      <% recentPosts.forEach(post => { %>
      <%
        const isSchd = post.status === 'pending';
        const refDt  = new Date(isSchd ? post.scheduledAt : post.createdAt);
        const hm     = refDt.toLocaleTimeString('th-TH', {hour:'2-digit', minute:'2-digit', hour12:false, timeZone:'Asia/Bangkok'});
        const allOk  = post.failCount === 0;
        const total  = post.results.length;
      %>
      <a href="<%= isSchd ? '#' : '/result/'+post.id %>" class="recent-post-row" <%= isSchd ? 'style="cursor:default"' : '' %>>
        <div class="recent-post-time">
          <i class="fa-regular fa-<%= isSchd ? 'calendar-clock' : 'clock' %>"></i> <%= hm %>
        </div>
        <div class="recent-post-msg" title="<%= post.message %>">
          <%= post.message.length > 28 ? post.message.slice(0,28)+'…' : post.message %>
        </div>
        <div class="recent-post-stat <%= isSchd ? 'pending' : (allOk ? 'ok' : 'partial') %>">
          <% if (isSchd) { %>⏳ รอโพส<% } else { %><%= allOk ? 'สำเร็จ' : 'บางส่วน' %> <%= post.successCount %>/<%= total %><% } %>
        </div>
      </a>
      <% }); %>
      <% } %>

      <a href="/history" class="recent-see-all">
        ดูทั้งหมด <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>

  </main>

  <!-- Right panel -->
  <aside class="right-panel">
    <div class="card stats-card">
      <div class="stats-title"><i class="fa-solid fa-chart-line"></i> ภาพรวม</div>
      <div class="stats-row"><span>เพจที่เชื่อมต่อ</span><span class="stats-val blue"><%= pages.length %></span></div>
      <div class="stats-row"><span>พร้อมโพสต์</span><span class="stats-val green"><%= pages.length %></span></div>
      <a href="/overview" class="overview-btn-link">
        <i class="fa-solid fa-chart-line"></i> ดูภาพรวมทั้งหมด
      </a>
    </div>

    <div class="card" style="margin-top:.75rem;padding:1rem 1.1rem">
      <div class="stats-title" style="margin-bottom:.65rem"><i class="fa-solid fa-circle-question"></i> วิธีใช้งาน</div>
      <div style="font-size:.83rem;color:var(--text-secondary);line-height:1.75">
        <div style="display:flex;gap:.5rem;align-items:flex-start;margin-bottom:.55rem;padding-bottom:.55rem;border-bottom:1px solid var(--border-color)">
          <i class="fa-solid fa-circle-check" style="color:#42b72a;margin-top:.15rem;flex-shrink:0"></i>
          <div>
            <strong style="color:var(--text-primary)">โพสลงเพจ</strong><br>
            พิมพ์ข้อความ เลือกเพจ แล้วกด "โพสต์" ได้เลย ไม่ต้องติดตั้งอะไรเพิ่ม
          </div>
        </div>
        <div style="display:flex;gap:.5rem;align-items:flex-start">
          <i class="fa-solid fa-circle-down" style="color:#f7b928;margin-top:.15rem;flex-shrink:0"></i>
          <div>
            <strong style="color:var(--text-primary)">โพส&amp;แชร์ลงกลุ่ม</strong><br>
            ต้องติดตั้ง <strong>Desktop Agent</strong> บนเครื่อง Windows ก่อน — ดาวน์โหลดได้ที่หน้า "<a href="/agent" style="color:#1877f2;text-decoration:none;font-weight:600">ติดตั้ง Desktop Agent</a>"
          </div>
        </div>
      </div>
    </div>
  </aside>

</div>

<!-- ── Template Modal ── -->
<div id="templateModal" class="map-modal-overlay" style="display:none" onclick="closeTplOnBg(event)">
  <div class="map-modal-box" style="width:820px;max-width:96vw;max-height:92vh;display:flex;flex-direction:column;padding:0;border-radius:12px;overflow:hidden">
    <!-- Header -->
    <div style="background:#1a1a1a;padding:.75rem 1rem;display:flex;align-items:center;flex-wrap:wrap;gap:.5rem">
      <i class="fa-solid fa-layer-group" style="color:#fff;font-size:.95rem"></i>
      <span style="color:#fff;font-weight:700;font-size:.95rem">ระบบโพสต์</span>
      <span id="tplCountBadge" style="background:#444;color:#aaa;border-radius:999px;font-size:.7rem;padding:.1rem .45rem;min-width:18px;text-align:center">0</span>
      <div style="margin-left:auto;display:flex;align-items:center;gap:.4rem;flex-wrap:wrap">
        <div style="display:flex;background:#333;border-radius:7px;overflow:hidden">
          <button id="tplViewCardBtn" onclick="setTplView('card')" style="background:#1877f2;color:#fff;border:none;padding:.3rem .6rem;cursor:pointer;font-size:.78rem"><i class="fa-solid fa-grip"></i></button>
          <button id="tplViewListBtn" onclick="setTplView('list')" style="background:transparent;color:#aaa;border:none;padding:.3rem .6rem;cursor:pointer;font-size:.78rem"><i class="fa-solid fa-list"></i></button>
        </div>
        <div style="position:relative">
          <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:.5rem;top:50%;transform:translateY(-50%);color:#aaa;font-size:.7rem;pointer-events:none"></i>
          <input id="tplSearchInput" type="text" placeholder="ค้นหา..." oninput="renderTemplates()"
            style="background:#333;color:#fff;border:none;border-radius:7px;padding:.32rem .6rem .32rem 1.6rem;font-size:.78rem;font-family:inherit;outline:none;width:130px">
        </div>
        <button id="tplMultiBtn" onclick="toggleTplMultiSelect()"
          style="background:#333;color:#aaa;border:none;border-radius:7px;padding:.35rem .7rem;font-size:.78rem;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:.3rem" title="เลือกหลายรายการเพื่อย้ายเข้าโฟลเดอร์">
          <i class="fa-solid fa-folder-plus"></i><span>จัดโฟลเดอร์</span>
        </button>
        <button onclick="openCreateTemplate()"
