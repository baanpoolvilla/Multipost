<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <div class="nav-avatar"><i class="fa-solid fa-user"></i></div>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <!-- Sidebar -->
  <aside class="sidebar">
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item active"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน โพส&แชร์</span></a>
    

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">เพจของคุณ</div>
    <div id="sidebarPagesList">
    <% const colors = ['purple','green','orange','blue','red']; %>
    <% pages.slice(0, 5).forEach((p, i) => { %>
    <div class="sidebar-item">
      <div class="avatar avatar-<%= colors[i%5] %> avatar-xs"><%= p.pageName.slice(-1) %></div>
      <span style="flex:1"><%= p.pageName %></span>
      <% if ((p.groups||[]).length > 0) { %>
      <span style="background:#e7f3ff;color:#1877f2;border-radius:999px;font-size:.65rem;padding:.05rem .38rem;font-weight:700;flex-shrink:0"><%= p.groups.length %>กลุ่ม</span>
      <% } %>
    </div>
    <% }); %>

    <% if (pages.length > 5) { %>
    <div class="sidebar-item" id="showMoreBtn" onclick="toggleMorePages()" style="color:#65676b">
      <i class="fa-solid fa-chevron-down" id="moreChevron"></i>
      <span>เพิ่มเติม <%= pages.length - 5 %> เพจ</span>
    </div>
    <div id="morePagesList" style="display:none">
      <% pages.slice(5).forEach((p, i) => { %>
      <div class="sidebar-item">
        <div class="avatar avatar-<%= colors[(i+5)%5] %> avatar-xs"><%= p.pageName.slice(-1) %></div>
        <span style="flex:1"><%= p.pageName %></span>
        <% if ((p.groups||[]).length > 0) { %>
        <span style="background:#e7f3ff;color:#1877f2;border-radius:999px;font-size:.65rem;padding:.05rem .38rem;font-weight:700;flex-shrink:0"><%= p.groups.length %>กลุ่ม</span>
        <% } %>
      </div>
      <% }); %>
    </div>
    <% } %>
    </div>
  </aside>

  <!-- Feed -->
  <main class="feed">

    <!-- Composer card -->
    <div class="card post-composer">
      <div class="composer-header">
        <div class="avatar avatar-blue"><i class="fa-solid fa-building"></i></div>
        <div class="composer-meta">
          <span class="composer-name">Admin</span>
          <div class="audience-badge">
            <i class="fa-solid fa-earth-asia"></i>
            <span>สาธารณะ</span>
            <i class="fa-solid fa-caret-down"></i>
          </div>
        </div>
      </div>

      <!-- Tags bar -->
      <div id="tagsBar" class="tags-bar" style="display:none"></div>

      <!-- Hidden inputs -->
      <input type="hidden" id="feelingEmoji">
      <input type="hidden" id="feelingLabel">
      <input type="file" id="fileInput" multiple accept="image/jpeg,image/png,image/gif,image/webp" style="display:none">

      <!-- Textarea area -->
      <div class="composer-textarea-wrap">
        <textarea id="message" placeholder="พิมพ์ข้อความที่ต้องการโพส..." rows="4"></textarea>
        <div class="emoji-strip">
          <% ['😊','🔥','❤️','👍','🎉','✨','📣','💎','🏖️','🌟'].forEach(e => { %>
          <button type="button" class="emoji-btn" onclick="insertEmoji('<%= e %>')"><%= e %></button>
          <% }); %>
        </div>
      </div>

      <!-- Template image previews (loaded from template) -->
      <div id="tplImagePreview" class="image-preview-grid" style="display:none"></div>

      <!-- Image preview (newly selected files) -->
      <div id="imagePreview" class="image-preview-grid" style="display:none"></div>
      <div class="char-bar"><span id="charCount">0</span> ตัวอักษร</div>

      <!-- Page selector -->
      <div class="page-selector">
        <span class="page-selector-label"><i class="fa-solid fa-layer-group" style="color:#1877f2"></i> เพจ:</span>
        <button class="page-sel-chip all-chip active" onclick="toggleAllPages(this)">
          <i class="fa-solid fa-check"></i> ทั้งหมด
        </button>
        <% pages.slice(0, 8).forEach((p, i) => { %>
        <button class="page-sel-chip active" data-page-id="<%= p.pageId %>" onclick="togglePage(this)">
          <div class="avatar avatar-<%= colors[i%5] %>" style="width:16px;height:16px;font-size:.55rem;flex-shrink:0"><%= p.pageName.slice(-1) %></div>
          <%= p.pageName %>
          <span class="chip-remove" onclick="event.stopPropagation();removePage('<%= p.pageId %>',this.closest('.page-sel-chip'))" title="ปิดใช้งานเพจนี้">×</span>
        </button>
        <% }); %>
        <% if (pages.length > 8) { %>
        <button class="page-sel-chip more-pages-chip" id="morePageChip" onclick="openPagePopup()">
          <i class="fa-solid fa-ellipsis"></i>
          <span id="morePageChipLabel">+ <%= pages.length - 8 %> เพจ</span>
        </button>
        <% } %>
        <button type="button" class="page-sel-chip add-page-chip" onclick="openAddPagePopup()" title="เพิ่มเพจ">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>

      <!-- Action buttons -->
      <div class="composer-actions-row">
        <button type="button" class="action-chip" onclick="triggerImage()">
          <i class="fa-solid fa-image" style="color:#45bd62"></i><span>รูปภาพ/วิดีโอ</span>
        </button>
<button type="button" class="action-chip" onclick="openTemplateModal()">
          <i class="fa-solid fa-layer-group" style="color:#1877f2"></i><span>เทมเพลต</span>
        </button>
      </div>

      <div class="composer-submit-row">
        <div class="pages-badge">
          <i class="fa-solid fa-layer-group"></i>
          <span id="pageCountLabel">โพสไปยัง <%= pages.length %> เพจ</span>
        </div>
        <button type="button" class="action-chip" onclick="saveCurrentAsTemplate()"
          style="background:#f0f2f5;border:none;margin-right:.35rem;padding:.42rem .8rem;font-size:.78rem;color:#1c1e21">
          <i class="fa-solid fa-floppy-disk" style="color:#1877f2"></i> บันทึกเทมเพลต
        </button>
        <button type="button" id="submitBtn" class="btn-post" onclick="submitPost()">
          <i class="fa-solid fa-paper-plane"></i> โพสต์
        </button>
      </div>
    </div>

    <!-- Recent posts card -->
    <div class="card">
      <div class="card-title" style="margin-bottom:.65rem">
        <i class="fa-solid fa-clock-rotate-left"></i> โพสล่าสุด
        <a href="/pages" class="manage-pages-link" style="margin-left:auto">
          <i class="fa-brands fa-facebook"></i> จัดการเพจ
        </a>
      </div>

      <% if (recentPosts.length === 0) { %>
      <div style="text-align:center;padding:1.2rem 0;color:#8a8d91;font-size:.88rem">
        <i class="fa-regular fa-face-meh-blank" style="font-size:1.8rem;display:block;margin-bottom:.4rem"></i>
        ยังไม่มีโพสต์
      </div>
      <% } else { %>
      <% recentPosts.forEach(post => { %>
      <%
        const dt  = new Date(post.createdAt);
        const hm  = dt.toLocaleTimeString('th-TH', {hour:'2-digit', minute:'2-digit', hour12:false, timeZone: 'Asia/Bangkok'});
        const allOk = post.failCount === 0;
        const total = post.results.length;
      %>
      <a href="/result/<%= post.id %>" class="recent-post-row">
        <div class="recent-post-time">
          <i class="fa-regular fa-clock"></i> <%= hm %>
        </div>
        <div class="recent-post-msg" title="<%= post.message %>">
          <%= post.message.length > 28 ? post.message.slice(0,28)+'…' : post.message %>
        </div>
        <div class="recent-post-stat <%= allOk ? 'ok' : 'partial' %>">
          <%= allOk ? 'สำเร็จ' : 'บางส่วน' %> <%= post.successCount %>/<%= total %>
        </div>
      </a>
      <% }); %>
      <% } %>

      <a href="/history" class="recent-see-all">
        ดูทั้งหมด <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>

  </main>

  <!-- Right panel -->
  <aside class="right-panel">
    <div class="card stats-card">
      <div class="stats-title"><i class="fa-solid fa-chart-line"></i> ภาพรวม</div>
      <div class="stats-row"><span>เพจที่เชื่อมต่อ</span><span class="stats-val blue"><%= pages.length %></span></div>
      <div class="stats-row"><span>พร้อมโพสต์</span><span class="stats-val green"><%= pages.length %></span></div>
      <a href="/overview" class="overview-btn-link">
        <i class="fa-solid fa-chart-line"></i> ดูภาพรวมทั้งหมด
      </a>
    </div>

    <div class="card" style="margin-top:.75rem;padding:1rem 1.1rem">
      <div class="stats-title" style="margin-bottom:.65rem"><i class="fa-solid fa-circle-question"></i> วิธีใช้งาน</div>
      <div style="font-size:.83rem;color:var(--text-secondary);line-height:1.75">
        <div style="display:flex;gap:.5rem;align-items:flex-start;margin-bottom:.55rem;padding-bottom:.55rem;border-bottom:1px solid var(--border-color)">
          <i class="fa-solid fa-circle-check" style="color:#42b72a;margin-top:.15rem;flex-shrink:0"></i>
          <div>
            <strong style="color:var(--text-primary)">โพสลงเพจ</strong><br>
            พิมพ์ข้อความ เลือกเพจ แล้วกด "โพสต์" ได้เลย ไม่ต้องติดตั้งอะไรเพิ่ม
          </div>
        </div>
        <div style="display:flex;gap:.5rem;align-items:flex-start">
          <i class="fa-solid fa-circle-down" style="color:#f7b928;margin-top:.15rem;flex-shrink:0"></i>
          <div>
            <strong style="color:var(--text-primary)">โพส&amp;แชร์ลงกลุ่ม</strong><br>
            ต้องติดตั้ง <strong>Desktop Agent</strong> บนเครื่อง Windows ก่อน — ดาวน์โหลดได้ที่หน้า "<a href="/agent" style="color:#1877f2;text-decoration:none;font-weight:600">ติดตั้ง Desktop Agent</a>"
          </div>
        </div>
      </div>
    </div>
  </aside>

</div>

<!-- ── Template Modal ── -->
<div id="templateModal" class="map-modal-overlay" style="display:none" onclick="closeTplOnBg(event)">
  <div class="map-modal-box" style="width:820px;max-width:96vw;max-height:92vh;display:flex;flex-direction:column;padding:0;border-radius:12px;overflow:hidden">
    <!-- Header -->
    <div style="background:#1a1a1a;padding:.75rem 1rem;display:flex;align-items:center;flex-wrap:wrap;gap:.5rem">
      <i class="fa-solid fa-layer-group" style="color:#fff;font-size:.95rem"></i>
      <span style="color:#fff;font-weight:700;font-size:.95rem">ระบบโพสต์</span>
      <span id="tplCountBadge" style="background:#444;color:#aaa;border-radius:999px;font-size:.7rem;padding:.1rem .45rem;min-width:18px;text-align:center">0</span>
      <div style="margin-left:auto;display:flex;align-items:center;gap:.4rem;flex-wrap:wrap">
        <div style="display:flex;background:#333;border-radius:7px;overflow:hidden">
          <button id="tplViewCardBtn" onclick="setTplView('card')" style="background:#1877f2;color:#fff;border:none;padding:.3rem .6rem;cursor:pointer;font-size:.78rem"><i class="fa-solid fa-grip"></i></button>
          <button id="tplViewListBtn" onclick="setTplView('list')" style="background:transparent;color:#aaa;border:none;padding:.3rem .6rem;cursor:pointer;font-size:.78rem"><i class="fa-solid fa-list"></i></button>
        </div>
        <div style="position:relative">
          <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:.5rem;top:50%;transform:translateY(-50%);color:#aaa;font-size:.7rem;pointer-events:none"></i>
          <input id="tplSearchInput" type="text" placeholder="ค้นหา..." oninput="renderTemplates()"
            style="background:#333;color:#fff;border:none;border-radius:7px;padding:.32rem .6rem .32rem 1.6rem;font-size:.78rem;font-family:inherit;outline:none;width:130px">
        </div>
        <button onclick="openCreateTemplate()"
          style="background:#1877f2;color:#fff;border:none;border-radius:7px;padding:.35rem .85rem;font-size:.8rem;cursor:pointer;font-family:inherit;font-weight:700;display:flex;align-items:center;gap:.35rem">
          <i class="fa-solid fa-plus"></i> สร้างโพสต์
        </button>
        <button onclick="closeTemplateModal()" style="background:none;border:none;color:#aaa;cursor:pointer;font-size:1.1rem;padding:.15rem .4rem;line-height:1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>
    <!-- Body -->
    <div id="tplBody" style="flex:1;overflow-y:auto;padding:1rem;background:#f0f2f5;min-height:180px"></div>
    <!-- Footer (use button) -->
    <div id="tplFooter" style="display:none;padding:.65rem 1rem;background:#fff;border-top:1px solid #e4e6eb">
      <button onclick="useTpl()" style="width:100%;background:#1877f2;color:#fff;border:none;border-radius:10px;padding:.6rem;font-size:.9rem;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:.5rem">
        <i class="fa-solid fa-paper-plane"></i> ใช้โพสต์นี้
      </button>
    </div>
  </div>
</div>

<script>
  const ALL_PAGES = <%- JSON.stringify(pages) %>;
  let DISABLED_PAGES = <%- JSON.stringify(disabledPages) %>;
</script>
<script src="/js/app.js"></script>
</body>
</html>
