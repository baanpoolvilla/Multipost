<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ประวัติโพสกลุ่ม - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-calendar-days"></i><span>Schedule Center</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/group-history" class="sidebar-item active"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <div class="sidebar-item" style="padding-left:2.5rem;font-size:.83rem;opacity:.45;cursor:default;pointer-events:none">
      <i class="fa-solid fa-chart-bar" style="font-size:.78rem"></i><span>รายงานโพสกลุ่ม</span>
    </div>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
  </aside>

  <main class="feed">

    <div class="card" style="padding:.85rem 1.25rem;display:flex;align-items:center;justify-content:space-between">
      <div class="card-title">
        <i class="fa-solid fa-clock-rotate-left"></i>
        ประวัติโพสลงกลุ่ม
        <span id="historyCount" style="background:#e4e6ea;padding:.15rem .55rem;border-radius:999px;font-size:.8rem;margin-left:.4rem"><%= jobs.length %></span>
      </div>
      <% if (jobs.length > 0) { %>
      <button class="btn-danger-sm" onclick="confirmClearAll()">
        <i class="fa-solid fa-trash"></i> ล้างทั้งหมด
      </button>
      <% } %>
    </div>

    <% if (jobs.length > 0) { %>
    <!-- Filter bar -->
    <div class="card" style="padding:.85rem 1.25rem">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem">
        <span style="font-weight:700;font-size:.88rem;color:#444">
          <i class="fa-solid fa-filter" style="color:#1877f2;font-size:.8rem;margin-right:.3rem"></i>ค้นหาและกรอง
        </span>
        <button onclick="clearFilters()" id="btnClearFilter"
          style="background:#fff0f0;border:1px solid #fcc;border-radius:7px;padding:.22rem .6rem;font-size:.77rem;font-family:inherit;color:#c62828;cursor:pointer;font-weight:600;transition:opacity .15s;opacity:.35;pointer-events:none">
          <i class="fa-solid fa-rotate-left"></i> ล้างตัวกรอง
        </button>
      </div>

      <!-- Row 1: search + status + group + category -->
      <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:.65rem;margin-bottom:.65rem">
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-magnifying-glass" style="width:12px"></i> ค้นหาข้อความ
          </div>
          <input id="hSearch" type="text" placeholder="พิมพ์คำค้น..." oninput="applyFilters()"
            style="width:100%;padding:.42rem .75rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;outline:none;box-sizing:border-box;transition:border-color .15s"
            onfocus="this.style.borderColor='#1877f2'" onblur="this.style.borderColor='#e4e6eb'">
        </div>
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-circle-dot" style="width:12px"></i> สถานะ
          </div>
          <select id="hStatus" onchange="applyFilters()"
            style="width:100%;padding:.42rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;color:#444;background:#fff;cursor:pointer;outline:none">
            <option value="">ทั้งหมด</option>
            <option value="success">สำเร็จทั้งหมด</option>
            <option value="partial">มีล้มเหลว</option>
          </select>
        </div>
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-users" style="width:12px"></i> กลุ่ม
          </div>
          <select id="hGroup" onchange="applyFilters()"
            style="width:100%;padding:.42rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;color:#444;background:#fff;cursor:pointer;outline:none">
            <option value="">ทุกกลุ่ม</option>
          </select>
        </div>
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-tag" style="width:12px"></i> หมวดหมู่
          </div>
          <select id="hCat" onchange="applyFilters()"
            style="width:100%;padding:.42rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;color:#444;background:#fff;cursor:pointer;outline:none">
            <option value="">ทุกหมวด</option>
            <% allCats.forEach(c => { %>
            <option value="<%= c %>"><%= c %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <!-- Row 2: date range -->
      <div style="display:flex;align-items:flex-end;gap:.5rem;flex-wrap:wrap">
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-calendar-days" style="width:12px"></i> ตั้งแต่วันที่
          </div>
          <input type="date" id="hDateFrom" onchange="applyFilters()"
            style="padding:.4rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#444;outline:none;cursor:pointer">
        </div>
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-clock" style="width:12px"></i> เวลา
          </div>
          <div class="dt24-wrap">
            <input type="number" id="hTimeFrom_h" min="0" max="23" placeholder="ชม." onchange="applyFilters()">
            <span>:</span>
            <input type="number" id="hTimeFrom_m" min="0" max="59" placeholder="นาที" onchange="applyFilters()">
          </div>
        </div>
        <div style="padding-bottom:.5rem;color:#bbb;font-size:.9rem">—</div>
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">ถึงวันที่</div>
          <input type="date" id="hDateTo" onchange="applyFilters()"
            style="padding:.4rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#444;outline:none;cursor:pointer">
        </div>
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-clock" style="width:12px"></i> เวลา
          </div>
          <div class="dt24-wrap">
            <input type="number" id="hTimeTo_h" min="0" max="23" placeholder="ชม." onchange="applyFilters()">
            <span>:</span>
            <input type="number" id="hTimeTo_m" min="0" max="59" placeholder="นาที" onchange="applyFilters()">
          </div>
        </div>
      </div>

      <div id="hFilterInfo" style="display:none;margin-top:.6rem;padding-top:.5rem;border-top:1px solid #f0f2f5;font-size:.79rem;color:#8a8d91">
        <i class="fa-solid fa-circle-info" style="color:#1877f2;margin-right:.3rem"></i>
        แสดง <strong id="hShown" style="color:#1877f2">0</strong> จาก <strong><%= jobs.length %></strong> รายการ
      </div>
    </div>
    <% } %>

    <% if (jobs.length === 0) { %>
    <div class="card empty-state">
      <i class="fa-regular fa-face-meh-blank"></i>
      <h3>ยังไม่มีประวัติการโพสกลุ่ม</h3>
      <p>เมื่อ Agent โพสสำเร็จแล้ว ประวัติจะแสดงที่นี่</p>
      <a href="/job-queue" class="btn-post" style="text-decoration:none;margin-top:1rem">
        <i class="fa-solid fa-list-check"></i> ไปที่คิวโพส
      </a>
    </div>
    <% } %>

    <% const colors = ['purple','green','orange','blue','red']; %>
    <% jobs.forEach(job => { %>
    <%
      const allOk   = job.successCount > 0 && job.failCount === 0;
      const allFail = job.successCount === 0 && job.failCount > 0;
    %>
    <div class="card history-card" id="card-<%= job._id %>">

      <!-- Card header -->
      <div class="fb-post-header">
        <div class="avatar avatar-<%= allOk ? 'green' : allFail ? 'red' : 'blue' %>">
          <i class="fa-solid fa-robot"></i>
        </div>
        <div style="flex:1">
          <div class="fb-post-author">
            Desktop Agent
            <span style="background:<%= allOk ? '#d1e7dd' : allFail ? '#f8d7da' : '#fff3cd' %>;color:<%= allOk ? '#0a3622' : allFail ? '#842029' : '#856404' %>;border-radius:999px;font-size:.7rem;padding:.1rem .5rem;font-weight:700;margin-left:.35rem">
              <i class="fa-solid fa-<%= allOk ? 'check' : allFail ? 'xmark' : 'triangle-exclamation' %>" style="font-size:.65rem"></i>
              <%= allOk ? 'สำเร็จทั้งหมด' : allFail ? 'ล้มเหลวทั้งหมด' : 'สำเร็จบางส่วน' %>
            </span>
          </div>
          <div class="fb-post-time">
            <i class="fa-solid fa-clock"></i>
            <%= new Date(job.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok', dateStyle:'short', timeStyle:'short', hour12:false }) %>
            &nbsp;·&nbsp;
            <i class="fa-solid fa-users" style="color:#1877f2"></i>
            <%= (job.groups || []).length %> กลุ่ม
          </div>
        </div>
        <div class="history-actions">
          <a href="/group-result/<%= job._id %>"
             style="display:inline-flex;align-items:center;gap:.28rem;background:#e7f0fd;color:#1877f2;border:none;border-radius:7px;padding:.28rem .65rem;font-size:.78rem;font-weight:700;text-decoration:none;transition:background .15s"
             onmouseover="this.style.background='#cfe2ff'" onmouseout="this.style.background='#e7f0fd'"
             title="ดูรายงาน">
            <i class="fa-solid fa-chart-bar"></i> รายงาน
          </a>
          <button class="icon-btn danger" title="ลบ" onclick="deleteJob('<%= job._id %>', this)">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>

      <!-- Message -->
      <div class="history-message">
        <% const msg = job.message || ''; %>
        <% if (msg.length > 200) { %>
          <span class="msg-short"><%= msg.slice(0, 200) %>...<button class="read-more-btn" onclick="toggleMsg(this)"> อ่านเพิ่มเติม</button></span>
          <span class="msg-full" style="display:none"><%= msg %><button class="read-more-btn" onclick="toggleMsg(this)"> ย่อ</button></span>
        <% } else { %>
          <%= msg %>
        <% } %>
      </div>

      <!-- Images (skip localpath:: entries — local files) -->
      <% const webImages = (job.images || []).filter(img => img && !img.startsWith('localpath::') && !img.startsWith('/') && !/^[A-Za-z]:[\\\/]/.test(img)); %>
      <% if (webImages.length > 0) { %>
      <div class="post-img-grid post-img-<%= Math.min(webImages.length, 4) %>">
        <% webImages.slice(0, 4).forEach((img, i) => { %>
        <% const imgSrc = img.startsWith('http') ? img : '/uploads/' + img; %>
        <% const isVid  = /\.(mp4|mov|avi|webm)$/i.test(img); %>
        <div class="post-img-item <%= (i === 3 && webImages.length > 4) ? 'has-more' : '' %>"
             onclick="<%= isVid ? `viewVideo('${imgSrc}')` : `viewImage('${imgSrc}')` %>">
          <% if (isVid) { %>
          <video src="<%= imgSrc %>" class="vid-thumb" style="width:100%;height:100%;object-fit:cover" muted playsinline preload="metadata"
                 onerror="this.closest('.post-img-item').style.display='none'"></video>
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none">
            <div style="width:36px;height:36px;background:rgba(0,0,0,.55);border-radius:50%;display:flex;align-items:center;justify-content:center">
              <svg width="14" height="16" viewBox="0 0 14 16" fill="white"><polygon points="2,1 13,8 2,15"/></svg>
            </div>
          </div>
          <% } else { %>
          <img src="<%= imgSrc %>" alt="รูปภาพ" loading="lazy"
               onerror="this.closest('.post-img-item').style.display='none'">
          <% } %>
          <% if (i === 3 && webImages.length > 4) { %>
          <div class="img-more-overlay">+<%= webImages.length - 4 %></div>
          <% } %>
        </div>
        <% }); %>
      </div>
      <% } %>
      <% const localFiles = (job.images || []).filter(img => img && img.startsWith('localpath::')); %>
      <% if (localFiles.length > 0) { %>
      <div style="font-size:.78rem;color:#8a8d91;margin:.4rem 0 .2rem;display:flex;align-items:center;gap:.35rem">
        <i class="fa-solid fa-folder" style="color:#bbb"></i>
        ไฟล์ในเครื่อง <%= localFiles.length %> ไฟล์ (แสดงได้เฉพาะบนเครื่อง Agent)
      </div>
      <% } %>

      <!-- Footer: group result badges -->
      <div class="history-footer">
        <div class="history-pages" style="flex:1">
          <% const MAX_B = 8; %>
          <% (job.results || []).slice(0, MAX_B).forEach((r, i) => { %>
          <span class="mini-page-badge <%= r.status === 'success' ? 'success' : 'fail' %>">
            <div class="avatar avatar-<%= colors[i%5] %>" style="width:18px;height:18px;font-size:.6rem">
              <%= (r.groupName||'?').slice(0,1) %>
            </div>
            <%= r.groupName %>
            <i class="fa-solid fa-<%= r.status === 'success' ? 'check' : 'xmark' %>"></i>
          </span>
          <% }); %>
          <% if ((job.results||[]).length > MAX_B) { %>
          <button class="mini-more-btn" onclick="toggleMoreBadges(this, '<%= job._id %>')">
            + <%= (job.results||[]).length - MAX_B %> กลุ่ม
          </button>
          <span class="mini-more-group" id="mb-<%= job._id %>" style="display:none;flex-wrap:wrap;gap:.25rem">
            <% (job.results||[]).slice(MAX_B).forEach((r, i) => { %>
            <span class="mini-page-badge <%= r.status === 'success' ? 'success' : 'fail' %>">
              <div class="avatar avatar-<%= colors[(i+MAX_B)%5] %>" style="width:18px;height:18px;font-size:.6rem">
                <%= (r.groupName||'?').slice(0,1) %>
              </div>
              <%= r.groupName %>
              <i class="fa-solid fa-<%= r.status === 'success' ? 'check' : 'xmark' %>"></i>
            </span>
            <% }); %>
          </span>
          <% } %>
        </div>
        <div class="history-summary">
          <span class="pill pill-success" style="font-size:.75rem;padding:.2rem .6rem">
            <i class="fa-solid fa-check"></i> <%= job.successCount %>
          </span>
          <% if (job.failCount > 0) { %>
          <span class="pill pill-fail" style="font-size:.75rem;padding:.2rem .6rem">
            <i class="fa-solid fa-xmark"></i> <%= job.failCount %>
          </span>
          <% } %>
        </div>
      </div>

    </div>
    <% }); %>

  </main>

  <aside class="right-panel">
    <div class="card stats-card" onclick="showGroupSummaryModal()" style="cursor:pointer;transition:box-shadow .15s" onmouseover="this.style.boxShadow='0 0 0 2px #2e7d32'" onmouseout="this.style.boxShadow=''">
      <div class="stats-title" style="display:flex;align-items:center;justify-content:space-between">
        <span><i class="fa-solid fa-chart-simple"></i> สถิติรวม</span>
        <span style="font-size:.72rem;color:#2e7d32;font-weight:600"><i class="fa-solid fa-arrow-up-right-from-square"></i> ดูสรุป</span>
      </div>
      <%
        const totalJobs    = jobs.length;
        const totalSuccess = jobs.reduce((s, j) => s + j.successCount, 0);
        const totalFail    = jobs.reduce((s, j) => s + j.failCount, 0);
        const totalGroups  = jobs.reduce((s, j) => s + (j.groups||[]).length, 0);
      %>
      <div class="stats-row"><span>จำนวน Job</span><span class="stats-val blue" id="statJobs"><%= totalJobs %></span></div>
      <div class="stats-row"><span>กลุ่มทั้งหมด</span><span class="stats-val blue" id="statGroups"><%= totalGroups %></span></div>
      <div class="stats-row"><span>โพสสำเร็จ</span><span class="stats-val green" id="statSuccess"><%= totalSuccess %></span></div>
      <div class="stats-row"><span>ล้มเหลว</span><span class="stats-val red" id="statFail"><%= totalFail %></span></div>
    </div>
  </aside>

</div>

<script>
  function t24Get(prefix) {
    const h = document.getElementById(prefix+'_h')?.value;
    if (h === '' || h == null) return '';
    const m = document.getElementById(prefix+'_m')?.value;
    return `${String(h).padStart(2,'0')}:${String(m||0).padStart(2,'0')}`;
  }
  function t24Set(prefix, hhmm) {
    const [h,m] = (hhmm||'').split(':');
    document.getElementById(prefix+'_h').value = h||'';
    document.getElementById(prefix+'_m').value = m||'';
  }

  const _groupCatMap = <%- JSON.stringify(groupCatMap) %>;

  const _hJobs = <%- JSON.stringify(jobs.map(j => ({
    id:      String(j._id),
    msg:     j.message || '',
    at:      j.createdAt,
    success: j.successCount || 0,
    fail:    j.failCount || 0,
    groups:  (j.groups || []).map(g => ({ id: g.groupId, name: g.groupName })),
  }))) %>;

  // Populate group select
  (function() {
    const sel = document.getElementById('hGroup');
    if (!sel) return;
    const names = new Set();
    _hJobs.forEach(j => j.groups.forEach(g => names.add(g.name)));
    [...names].sort().forEach(n => {
      const o = document.createElement('option');
      o.value = o.textContent = n;
      sel.appendChild(o);
    });
  })();

  function applyFilters() {
    const q        = (document.getElementById('hSearch')?.value || '').toLowerCase().trim();
    const st       = document.getElementById('hStatus')?.value   || '';
    const grp      = document.getElementById('hGroup')?.value    || '';
    const cat      = document.getElementById('hCat')?.value      || '';
    const fromVal  = document.getElementById('hDateFrom')?.value || '';
    const toVal    = document.getElementById('hDateTo')?.value   || '';
    const timeFrom = t24Get('hTimeFrom');
    const timeTo   = t24Get('hTimeTo');

    let fromTs = null, toTs = null;
    if (fromVal) {
      const [fh, fm] = timeFrom ? timeFrom.split(':').map(Number) : [0, 0];
      fromTs = new Date(fromVal).setHours(fh, fm, 0, 0);
    }
    if (toVal) {
      const [th, tm] = timeTo ? timeTo.split(':').map(Number) : [23, 59];
      toTs = new Date(toVal).setHours(th, tm, 59, 999);
    }
    const timeOnlyFrom = !fromVal && timeFrom ? timeFrom : null;
    const timeOnlyTo   = !toVal   && timeTo   ? timeTo   : null;

    let shown = 0, sumSuccess = 0, sumFail = 0, sumGroups = 0;
    _hJobs.forEach(j => {
      const card = document.getElementById('card-' + j.id);
      if (!card) return;
      let ok = true;

      if (q  && !j.msg.toLowerCase().includes(q))    ok = false;
      if (st === 'success' && j.fail > 0)             ok = false;
      if (st === 'partial' && j.fail === 0)           ok = false;

      // Group filter
      if (grp && !j.groups.some(g => g.name === grp)) ok = false;

      // Category filter — cross-reference groupCatMap
      if (cat) {
        const groupsInCat = j.groups.filter(g => {
          const cats = _groupCatMap[g.id] || ['ทั่วไป'];
          return cats.includes(cat);
        });
        if (groupsInCat.length === 0) ok = false;
      }

      const postDate = new Date(j.at);
      const postTs   = postDate.getTime();
      if (fromTs !== null && postTs < fromTs) ok = false;
      if (toTs   !== null && postTs > toTs)   ok = false;
      if (timeOnlyFrom) {
        const postTime = postDate.toTimeString().slice(0,5);
        if (postTime < timeOnlyFrom) ok = false;
      }
      if (timeOnlyTo) {
        const postTime = postDate.toTimeString().slice(0,5);
        if (postTime > timeOnlyTo) ok = false;
      }

      card.style.display = ok ? '' : 'none';
      if (ok) { shown++; sumSuccess += j.success; sumFail += j.fail; sumGroups += j.groups.length; }
    });

    const hasFilter = q || st || grp || cat || fromVal || toVal || timeFrom || timeTo;
    const info = document.getElementById('hFilterInfo');
    if (info) {
      info.style.display = hasFilter ? 'block' : 'none';
      const el = document.getElementById('hShown');
      if (el) el.textContent = shown;
    }
    const cnt = document.getElementById('historyCount');
    if (cnt) cnt.textContent = hasFilter ? shown : _hJobs.length;
    // Update right-panel stats dynamically
    const sJ = document.getElementById('statJobs');   if (sJ) sJ.textContent = shown;
    const sG = document.getElementById('statGroups'); if (sG) sG.textContent = hasFilter ? sumGroups : <%- jobs.reduce((s,j)=>s+(j.groups||[]).length,0) %>;
    const sS = document.getElementById('statSuccess');if (sS) sS.textContent = hasFilter ? sumSuccess : <%- jobs.reduce((s,j)=>s+j.successCount,0) %>;
    const sF = document.getElementById('statFail');   if (sF) sF.textContent = hasFilter ? sumFail : <%- jobs.reduce((s,j)=>s+j.failCount,0) %>;
    const btnClear = document.getElementById('btnClearFilter');
    if (btnClear) {
      btnClear.style.opacity      = hasFilter ? '1' : '.35';
      btnClear.style.pointerEvents = hasFilter ? '' : 'none';
    }
  }

  function clearFilters() {
    ['hSearch','hStatus','hGroup','hCat','hDateFrom','hDateTo'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    t24Set('hTimeFrom', ''); t24Set('hTimeTo', '');
    applyFilters();
  }

  function viewImage(src) {
    Swal.fire({ imageUrl: src, imageAlt: 'รูปภาพ', showConfirmButton: false, showCloseButton: true, width: 'auto' });
  }

  function viewVideo(src) {
    Swal.fire({
      html: `<video src="${src}" controls autoplay style="max-width:100%;max-height:70vh;border-radius:8px"></video>`,
      showConfirmButton: false, showCloseButton: true, width: 'auto', background: '#000', padding: '1rem',
    });
  }

  function toggleMoreBadges(btn, jobId) {
    const group = document.getElementById('mb-' + jobId);
    const open  = group.style.display !== 'none';
    group.style.display = open ? 'none' : 'inline-flex';
    btn.textContent = open
      ? '+ ' + group.querySelectorAll('.mini-page-badge').length + ' กลุ่ม'
      : 'ซ่อน';
  }

  function toggleMsg(btn) {
    const card = btn.closest('.history-message');
    const s = card.querySelector('.msg-short');
    const f = card.querySelector('.msg-full');
    s.style.display = s.style.display === 'none' ? '' : 'none';
    f.style.display = f.style.display === 'none' ? '' : 'none';
  }

  async function deleteJob(id, btn) {
    const result = await Swal.fire({
      title: 'ลบรายการนี้?',
      text: 'ประวัติโพสนี้จะถูกลบถาวร',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#c62828',
      cancelButtonColor: '#65676b',
      confirmButtonText: '<i class="fa-solid fa-trash"></i> ลบเลย',
      cancelButtonText: 'ยกเลิก',
    });
    if (!result.isConfirmed) return;

    try {
      const res  = await fetch(`/api/agent/history/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        const card = document.getElementById(`card-${id}`);
        card.style.transition = 'opacity .3s, transform .3s';
        card.style.opacity = '0';
        card.style.transform = 'translateX(30px)';
        setTimeout(() => { card.remove(); updateCount(); }, 320);
        Swal.fire({ icon: 'success', title: 'ลบแล้ว', timer: 1200, showConfirmButton: false });
      }
    } catch {
      Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', confirmButtonColor: '#1877f2' });
    }
  }

  function updateCount() {
    const cards = document.querySelectorAll('.history-card');
    const badge = document.getElementById('historyCount');
    if (badge) badge.textContent = cards.length;
    if (cards.length === 0) location.reload();
  }

  // Try canvas thumbnail capture for videos (falls back to play-icon overlay on CORS block)
  document.querySelectorAll('video.vid-thumb').forEach(v => {
    let done = false;
    v.onloadedmetadata = () => { v.currentTime = 0.5; };
    v.onseeked = () => {
      if (done) return;
      done = true;
      try {
        const c = document.createElement('canvas');
        c.width = v.videoWidth || 320; c.height = v.videoHeight || 240;
        c.getContext('2d').drawImage(v, 0, 0);
        const img = document.createElement('img');
        img.src = c.toDataURL('image/jpeg', 0.85);
        img.style.cssText = 'width:100%;height:100%;object-fit:cover';
        img.onerror = () => {};
        v.replaceWith(img);
      } catch { /* CORS blocked — play icon overlay still shows */ }
    };
    v.load();
  });

  async function confirmClearAll() {
    const result = await Swal.fire({
      title: 'ล้างประวัติทั้งหมด?',
      text: 'จะลบประวัติโพสกลุ่มทั้งหมดออกจากระบบ',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#c62828',
      cancelButtonColor: '#65676b',
      confirmButtonText: 'ล้างเลย',
      cancelButtonText: 'ยกเลิก',
    });
    if (!result.isConfirmed) return;

    const cards = [...document.querySelectorAll('.history-card')];
    for (const card of cards) {
      const id = card.id.replace('card-', '');
      await fetch(`/api/agent/history/${id}`, { method: 'DELETE' });
    }
    location.reload();
  }

async function showGroupSummaryModal() {
  const { value: dates } = await Swal.fire({
    title: '<i class="fa-solid fa-users" style="color:#2e7d32"></i> สรุปแชร์กลุ่มตามช่วงเวลา',
    html: `<div style="display:flex;flex-wrap:wrap;gap:.6rem;justify-content:center;align-items:flex-end;margin-top:.5rem">
      <div><label style="font-size:.78rem;font-weight:600;color:#555;display:block;margin-bottom:.2rem">วันที่เริ่ม</label>
        <input id="gh-from" type="date" style="padding:.38rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.85rem;font-family:inherit;color:#333;outline:none"></div>
      <div><label style="font-size:.78rem;font-weight:600;color:#555;display:block;margin-bottom:.2rem">วันที่สิ้นสุด</label>
        <input id="gh-to" type="date" style="padding:.38rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.85rem;font-family:inherit;color:#333;outline:none"></div>
    </div>`,
    confirmButtonText: 'ดูสรุป', confirmButtonColor: '#2e7d32',
    showCancelButton: true, cancelButtonText: 'ยกเลิก', focusConfirm: false,
    preConfirm: () => ({ from: document.getElementById('gh-from').value, to: document.getElementById('gh-to').value }),
  });
  if (!dates) return;
  Swal.fire({ title: 'กำลังโหลด...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
  try {
    const p = new URLSearchParams();
    if (dates.from) p.set('from', dates.from);
    if (dates.to)   p.set('to',   dates.to);
    const data = await (await fetch('/api/stats/combined?' + p)).json();
    if (!data.ok) throw new Error();
    const g = data.groupStats;
    const fmt = d => new Date(d + 'T00:00:00').toLocaleDateString('th-TH', { dateStyle:'short' });
    const label = dates.from||dates.to ? `ช่วง: ${dates.from?fmt(dates.from):'—'} ถึง ${dates.to?fmt(dates.to):'—'}` : 'ข้อมูลทั้งหมด';
    const medals = ['🥇','🥈','🥉','4️⃣','5️⃣'];
    const topHtml = (data.topGroups||[]).map((item,i)=>{
      const tot=(item.success||0)+(item.fail||0);
      const rt=tot>0?Math.round(item.success/tot*100):0;
      return `<div style="display:flex;align-items:center;justify-content:space-between;font-size:.82rem;padding:.2rem 0;border-bottom:1px solid #f0f2f5">
        <span>${medals[i]} ${item.name||'—'}</span>
        <span><b style="color:#2e7d32">${item.success}</b>/<span style="color:#555">${tot}</span> <span style="font-size:.7rem;background:#e8fde8;color:#2e7d32;border-radius:4px;padding:.05rem .3rem">${rt}%</span></span></div>`;
    }).join('') || '<div style="font-size:.8rem;color:#bbb;text-align:center;padding:.4rem">ไม่มีข้อมูล</div>';
    Swal.fire({
      title: `<i class="fa-solid fa-users" style="color:#2e7d32"></i> แชร์ลงกลุ่ม`,
      html: `<div style="text-align:left">
        <div style="font-size:.78rem;color:#8a8d91;margin-bottom:.6rem">${label}</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-bottom:.8rem">
          <div style="background:#f0fdf4;border-radius:8px;padding:.5rem;text-align:center"><div style="font-size:1.3rem;font-weight:700;color:#2e7d32">${g.total}</div><div style="font-size:.72rem;color:#555">งาน</div></div>
          <div style="background:#e8fde8;border-radius:8px;padding:.5rem;text-align:center"><div style="font-size:1.3rem;font-weight:700;color:#059669">${g.success}</div><div style="font-size:.72rem;color:#555">สำเร็จ</div></div>
          <div style="background:#fff5f5;border-radius:8px;padding:.5rem;text-align:center"><div style="font-size:1.3rem;font-weight:700;color:#c62828">${g.fail}</div><div style="font-size:.72rem;color:#555">ล้มเหลว</div></div>
        </div>
        <div style="font-size:.75rem;font-weight:700;color:#555;margin-bottom:.4rem"><i class="fa-solid fa-ranking-star" style="color:#f7b928"></i> 5 อันดับกลุ่ม</div>
        ${topHtml}</div>`,
      confirmButtonText: 'ปิด', confirmButtonColor: '#2e7d32', width: '440px',
    });
  } catch { Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:'ไม่สามารถโหลดข้อมูลได้' }); }
}
</script>
</body>
</html>
