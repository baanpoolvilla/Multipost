<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>คิวโพส - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>

  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item active"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <!-- Header -->
    <div class="card" style="padding:.85rem 1.25rem;display:flex;align-items:center;justify-content:space-between">
      <div class="card-title" style="font-size:1.05rem">
        <i class="fa-solid fa-list-check"></i> คิวโพสลงเพจ
        <span style="background:#e4e6ea;padding:.15rem .55rem;border-radius:999px;font-size:.8rem;margin-left:.4rem" id="postCount"><%= posts.length %></span>
      </div>
      <button onclick="openSchedModal()"
        style="display:inline-flex;align-items:center;gap:.38rem;background:#1877f2;color:#fff;border:none;border-radius:9px;padding:.45rem .95rem;font-size:.83rem;cursor:pointer;font-family:inherit;font-weight:700">
        <i class="fa-solid fa-calendar-plus"></i> โพสตั้งเวลา
      </button>
    </div>

    <%
    const pageNameMap = {};
    pages.forEach(p => { pageNameMap[p.pageId] = p.pageName; });
    %>

    <!-- Posts list -->
    <div class="card">
      <div class="card-title">
        <i class="fa-solid fa-clock-rotate-left"></i> รายการโพส
        <% const schedCount = posts.filter(p => p.status==='pending').length; %>
        <button id="btnSchedFilter" onclick="toggleSchedFilter()"
          style="margin-left:.6rem;background:#fff3cd;border:1px solid #ffe08a;border-radius:7px;padding:.18rem .55rem;font-size:.78rem;font-weight:600;color:#856404;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-clock"></i> ตั้งเวลาไว้ (<%= schedCount %>)
        </button>
        <button id="btnPqTimelineView" onclick="togglePqTimelineView()"
          style="margin-left:.4rem;background:#fff3cd;border:1px solid #ffe08a;border-radius:7px;padding:.18rem .55rem;font-size:.78rem;font-weight:600;color:#856404;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-calendar-days"></i> ปฏิทิน
        </button>
        <button class="btn-link-sm" style="margin-left:auto" onclick="location.reload()"><i class="fa-solid fa-rotate-right"></i> รีเฟรช</button>
      </div>

      <!-- Bulk reschedule bar — shown only while "ตั้งเวลาไว้" filter is active and rows selected -->
      <div id="pqBulkBar" style="display:none;align-items:center;gap:.5rem;flex-wrap:wrap;padding:.5rem .65rem;border-bottom:1px solid var(--border-color)">
        <span style="font-size:.8rem;color:#856404;font-weight:600">
          <i class="fa-solid fa-clock"></i> เลือกแล้ว <strong id="pqSelCount">0</strong> รายการ
        </span>
        <button onclick="bulkReschedulePosts()"
          style="background:#856404;color:#fff;border:none;border-radius:7px;padding:.32rem .7rem;font-size:.79rem;font-weight:600;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-clock-rotate-left"></i> เลื่อนเวลาทั้งหมด
        </button>
        <button onclick="clearPqSelection()"
          style="background:#f0f2f5;border:none;border-radius:7px;padding:.32rem .7rem;font-size:.79rem;cursor:pointer;color:#65676b;font-family:inherit">
          ล้างที่เลือก
        </button>
      </div>

      <div id="pqTimelineView" style="display:none;padding:1rem .85rem;overflow-x:auto"></div>

      <% if (posts.length === 0) { %>
      <div style="color:var(--text-secondary);text-align:center;padding:1.5rem;font-size:.9rem">ยังไม่มีโพส</div>
      <% } else { %>
      <% const icons = { pending:'⏳', running:'🔄', success:'✅', failed:'❌', expired:'⏰', cancelled:'🚫' }; %>
      <% const statusTH = { pending:'รอ', running:'กำลังโพส', success:'เสร็จ', failed:'ล้มเหลว', expired:'หมดเวลา', cancelled:'ยกเลิก' }; %>
      <% const statusCls = { pending:'badge-yellow', running:'badge-blue', success:'badge-green', failed:'badge-red', expired:'badge-red', cancelled:'badge-red' }; %>
      <% posts.forEach((p, idx) => {
           let dispMsg = p.message||'';
           if (dispMsg.length>70) dispMsg = dispMsg.slice(0,70)+'…';
           const pageNames = (p.selectedPageIds||[]).map(id => pageNameMap[id]||id).join(', ') || 'ทุกเพจ';
      %>
      <div style="display:flex;align-items:flex-start;gap:.7rem;padding:.65rem .5rem;border-bottom:1px solid var(--border-color)"
           id="post_<%= p.id %>" class="post-row" data-idx="<%= idx %>" data-scheduled="<%= p.status==='pending' ? '1' : '0' %>">
        <span style="font-size:1.2rem;flex-shrink:0;margin-top:.1rem"><%= icons[p.status]||'❓' %></span>
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= dispMsg %></div>
          <div style="font-size:.78rem;color:var(--text-secondary);margin-top:.2rem">
            <%= pageNames %> ·
            <%= new Date(p.createdAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',hour12:false,dateStyle:'short',timeStyle:'short'}) %>
            <% if (p.scheduledAt) { %>
            · <span style="color:#856404;font-weight:600"><i class="fa-solid fa-clock" style="font-size:.7rem"></i> โพส <%= new Date(p.scheduledAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',hour12:false,dateStyle:'short',timeStyle:'short'}) %></span>
            <% } %>
            <% if (p.status==='success'||p.status==='failed') { %>
            · <strong><%= p.successCount||0 %>/<%= (p.results||[]).length %></strong> สำเร็จ
            <% } %>
          </div>
        </div>
        <span class="badge <%= statusCls[p.status]||'' %>" style="flex-shrink:0"><%= statusTH[p.status]||p.status %></span>
        <% if (p.status === 'pending' || p.status === 'expired') { %>
        <input type="checkbox" class="pqSelCb" data-id="<%= p.id %>" onchange="updatePqSelection()"
          style="accent-color:#856404;cursor:pointer;width:16px;height:16px" title="เลือกเพื่อเลื่อนเวลาทั้งหมด">
        <button onclick="reschedulePostQ('<%= p.id %>', '<%= p.scheduledAt || '' %>')"
          style="background:none;border:none;cursor:pointer;color:#856404;font-size:.85rem;padding:.1rem .3rem;border-radius:4px" title="แก้ไขเวลาโพส">
          <i class="fa-solid fa-clock"></i>
        </button>
        <% } %>
        <button onclick="deletePostQ('<%= p.id %>')" style="background:none;border:none;cursor:pointer;color:#c5c8d0;font-size:1rem;padding:.1rem .3rem;border-radius:4px" title="ลบ">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
      <% }); %>
      <% if (posts.length > 20) { %>
      <div id="showMoreRow" style="padding:.65rem;text-align:center">
        <button onclick="showMorePosts()" style="background:#f0f2f5;border:none;border-radius:8px;padding:.45rem 1.1rem;font-size:.85rem;cursor:pointer;font-family:inherit;color:#1877f2;font-weight:600">
          เพิ่มเติม (<%= posts.length-20 %> รายการ)
        </button>
      </div>
      <% } %>
      <% } %>
    </div>

  </main>
</div>

<style>
.btn-link-sm { background:none; border:none; color:#1877f2; font-size:.8rem; cursor:pointer; font-family:inherit; padding:0 .3rem }
.btn-link-sm:hover { text-decoration:underline }
.badge-yellow { background:#fff3cd; color:#856404 }
.badge-blue   { background:#cfe2ff; color:#084298 }
.badge-green  { background:#d1e7dd; color:#0a3622 }
.badge-red    { background:#f8d7da; color:#842029 }
</style>

<script>
function dt24Get(prefix) {
  const d = document.getElementById(prefix+'_d')?.value;
  if (!d) return '';
  const h = String(document.getElementById(prefix+'_h').value||0).padStart(2,'0');
  const m = String(document.getElementById(prefix+'_m').value||0).padStart(2,'0');
  return `${d}T${h}:${m}`;
}
function _fpSetDate(el, dateStr) {
  if (!el) return;
  if (el._flatpickr) el._flatpickr.setDate(dateStr || null, false);
  else el.value = dateStr || '';
}
function dt24Set(prefix, localStr) {
  const [d,t] = (localStr||'').split('T');
  _fpSetDate(document.getElementById(prefix+'_d'), d);
  const [h,m] = (t||'').split(':');
  document.getElementById(prefix+'_h').value = h||'';
  document.getElementById(prefix+'_m').value = m||'';
}

const _pqScheduled = <%- JSON.stringify(posts.filter(p => p.status==='pending').map(p => ({ id: p.id, msg: p.message, at: p.scheduledAt }))) %>;
let _pqVisible = 20;

document.querySelectorAll('.post-row').forEach(r => {
  if (parseInt(r.dataset.idx) >= _pqVisible) r.style.display = 'none';
});

function showMorePosts() {
  _pqVisible += 20;
  document.querySelectorAll('.post-row').forEach(r => {
    if (parseInt(r.dataset.idx) < _pqVisible) r.style.display = 'flex';
  });
  const btn = document.getElementById('showMoreRow');
  const remaining = document.querySelectorAll('.post-row[style*="display: none"], .post-row[style*="display:none"]').length;
  if (remaining === 0 && btn) btn.style.display = 'none';
}

/* ── "ตั้งเวลาไว้" filter ── */
let _schedFilterActive = false;

function toggleSchedFilter() {
  _schedFilterActive = !_schedFilterActive;
  const btn = document.getElementById('btnSchedFilter');
  const moreRow = document.getElementById('showMoreRow');
  if (_schedFilterActive) {
    if (btn) { btn.style.background = '#856404'; btn.style.color = '#fff'; }
    if (moreRow) moreRow.style.display = 'none';
    document.querySelectorAll('.post-row').forEach(r => {
      r.style.display = r.dataset.scheduled === '1' ? 'flex' : 'none';
    });
  } else {
    if (btn) { btn.style.background = '#fff3cd'; btn.style.color = '#856404'; }
    document.querySelectorAll('.post-row').forEach(r => {
      r.style.display = parseInt(r.dataset.idx) < _pqVisible ? 'flex' : 'none';
    });
    if (moreRow) moreRow.style.display = '';
  }
  updatePqSelection();
}

let _pqTimelineOn = false;
function togglePqTimelineView() {
  _pqTimelineOn = !_pqTimelineOn;
  const view = document.getElementById('pqTimelineView');
  const btn  = document.getElementById('btnPqTimelineView');
  document.querySelectorAll('.post-row').forEach(r => { if (_pqTimelineOn) r.style.display = 'none'; });
  const moreRow = document.getElementById('showMoreRow');
  if (_pqTimelineOn) {
    renderPostQueueTimeline();
    view.style.display = '';
    btn.style.background = '#856404'; btn.style.color = '#fff';
    if (moreRow) moreRow.style.display = 'none';
  } else {
    view.style.display = 'none';
    btn.style.background = '#fff3cd'; btn.style.color = '#856404';
    if (_schedFilterActive) {
      document.querySelectorAll('.post-row').forEach(r => {
        r.style.display = r.dataset.scheduled === '1' ? 'flex' : 'none';
      });
    } else {
      document.querySelectorAll('.post-row').forEach(r => {
        r.style.display = parseInt(r.dataset.idx) < _pqVisible ? 'flex' : 'none';
      });
      if (moreRow) moreRow.style.display = '';
    }
  }
  updatePqSelection();
}

function renderPostQueueTimeline() {
  const view = document.getElementById('pqTimelineView');
  const items = _pqScheduled;
  if (!items.length) {
    view.innerHTML = '<div style="text-align:center;padding:2rem;color:#8a8d91">ไม่มีโพสที่ตั้งเวลาไว้</div>';
    return;
  }
  const byDate = {};
  items.forEach(p => {
    const d = new Date(p.at);
    const key = d.toLocaleDateString('en-CA');
    (byDate[key] = byDate[key] || []).push(p);
  });
  const now = new Date();
  const hourLines = [0, 4, 8, 12, 16, 20];
  const cols = Object.keys(byDate).sort().map(key => {
    const d = new Date(key + 'T00:00:00');
    const label = d.toLocaleDateString('th-TH', { weekday: 'short', day: 'numeric', month: 'short' });
    const chips = byDate[key].map(p => {
      const t = new Date(p.at);
      const top = ((t.getHours() + t.getMinutes() / 60) / 24 * 100).toFixed(2);
      const overdue = t < now;
      const time = t.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', hour12: false });
      const msg = (p.msg || '').slice(0, 30).replace(/'/g, '&#39;');
      return `<div onclick="reschedulePostQ('${p.id}','${p.at}')" title="${time} — ${msg}"
        style="position:absolute;left:4px;right:4px;top:${top}%;background:${overdue ? '#fde8e8' : '#fff3cd'};color:${overdue ? '#c62828' : '#856404'};border:1px solid ${overdue ? '#f5b5b5' : '#ffe08a'};border-radius:5px;padding:.15rem .35rem;font-size:.68rem;font-weight:600;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:140px;z-index:1">
        ${overdue ? '⚠️' : '⏰'} ${time} ${msg}</div>`;
    }).join('');
    const lines = hourLines.map(h => `<div style="position:absolute;left:0;right:0;top:${(h/24*100).toFixed(2)}%;border-top:1px dashed #eee;font-size:.62rem;color:#bbb;padding-left:2px">${String(h).padStart(2,'0')}:00</div>`).join('');
    return `<div style="flex:0 0 150px;min-width:150px">
      <div style="font-size:.78rem;font-weight:700;color:#444;text-align:center;margin-bottom:.4rem">${label}</div>
      <div style="position:relative;height:360px;background:#fafbfc;border:1px solid #eee;border-radius:8px">${lines}${chips}</div>
    </div>`;
  }).join('');
  view.innerHTML = `<div style="display:flex;gap:.6rem">${cols}</div>`;
}

function updatePqSelection() {
  const checked = [...document.querySelectorAll('.pqSelCb')].filter(cb => cb.checked && cb.closest('.post-row').style.display !== 'none');
  const bar = document.getElementById('pqBulkBar');
  if (bar) bar.style.display = checked.length ? 'flex' : 'none';
  const cnt = document.getElementById('pqSelCount');
  if (cnt) cnt.textContent = checked.length;
}

function clearPqSelection() {
  document.querySelectorAll('.pqSelCb').forEach(cb => cb.checked = false);
  updatePqSelection();
}

async function bulkReschedulePosts() {
  const ids = [...document.querySelectorAll('.pqSelCb')].filter(cb => cb.checked).map(cb => cb.dataset.id);
  if (!ids.length) return;
  const { value, isConfirmed } = await Swal.fire({
    title: `<i class="fa-solid fa-clock" style="color:#856404"></i> เลื่อนเวลาโพส ${ids.length} รายการ`,
    html: `<div style="text-align:left">
      <label style="font-size:.82rem;font-weight:600;color:#555;display:block;margin-bottom:.3rem">เวลาที่ต้องการโพส (ใช้กับทุกรายการที่เลือก)</label>
      <div class="dt24-wrap">
        <input type="date" lang="en-GB" id="swal-pqBulkAt_d">
        <input type="number" id="swal-pqBulkAt_h" min="0" max="23" placeholder="ชม.">
        <span>:</span>
        <input type="number" id="swal-pqBulkAt_m" min="0" max="59" placeholder="นาที">
      </div>
    </div>`,
    confirmButtonText: 'บันทึกทั้งหมด', confirmButtonColor: '#856404',
    showCancelButton: true, cancelButtonText: 'ยกเลิก', focusConfirm: false,
    preConfirm: () => {
      const v = dt24Get('swal-pqBulkAt');
      if (!v) { Swal.showValidationMessage('กรุณาเลือกวันที่และเวลา'); return false; }
      return v;
    },
  });
  if (!isConfirmed) return;
  const scheduledAt = new Date(value + ':00+07:00').toISOString();
  try {
    await Promise.all(ids.map(id => fetch(`/posts/${id}/reschedule`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ scheduledAt }),
    })));
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เลื่อนเวลาไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
  }
}

async function reschedulePostQ(id, currentScheduledAt) {
  const current = currentScheduledAt
    ? new Date(currentScheduledAt).toLocaleString('sv-SE', { timeZone: 'Asia/Bangkok' }).slice(0, 16)
    : '';
  const { value, isConfirmed } = await Swal.fire({
    title: '<i class="fa-solid fa-clock" style="color:#856404"></i> แก้ไขเวลาโพส',
    html: `<div style="text-align:left">
      <label style="font-size:.82rem;font-weight:600;color:#555;display:block;margin-bottom:.3rem">เวลาที่ต้องการโพส</label>
      <div class="dt24-wrap">
        <input type="date" lang="en-GB" id="swal-pqAt_d">
        <input type="number" id="swal-pqAt_h" min="0" max="23" placeholder="ชม.">
        <span>:</span>
        <input type="number" id="swal-pqAt_m" min="0" max="59" placeholder="นาที">
      </div>
      <div style="font-size:.75rem;color:#8a8d91;margin-top:.4rem">เว้นว่างไว้เพื่อล้างเวลาที่ตั้งไว้ (จะโพสทันที)</div>
    </div>`,
    confirmButtonText: 'บันทึก',
    confirmButtonColor: '#1877f2',
    showCancelButton: true,
    cancelButtonText: 'ยกเลิก',
    focusConfirm: false,
    didOpen: () => dt24Set('swal-pqAt', current),
    preConfirm: () => dt24Get('swal-pqAt'),
  });
  if (!isConfirmed) return;
  try {
    const scheduledAt = value ? new Date(value + ':00+07:00').toISOString() : null;
    const r = await fetch(`/posts/${id}/reschedule`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ scheduledAt }),
    });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'แก้ไขไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
  }
}

async function deletePostQ(id) {
  const res = await Swal.fire({ title:'ลบโพส?', icon:'warning', showCancelButton:true, confirmButtonColor:'#fa5252', confirmButtonText:'ลบ', cancelButtonText:'ยกเลิก' });
  if (!res.isConfirmed) return;
  try {
    const r = await fetch(`/history/${id}`, { method:'DELETE' });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    document.getElementById(`post_${id}`)?.remove();
    const cnt = document.querySelectorAll('[id^="post_"]').length;
    document.getElementById('postCount').textContent = cnt;
  } catch (e) {
    Swal.fire({ icon:'error', title:'ลบไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
  }
}
</script>
<!-- ── Scheduled Post Modal ── -->
<div id="schedModal"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.52);z-index:9999;align-items:center;justify-content:center;padding:1rem"
     onclick="if(event.target===this)closeSchedModal()">
  <div style="background:#fff;border-radius:16px;width:540px;max-width:96vw;max-height:92vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.22)">

    <!-- Header -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:.9rem 1.2rem;border-bottom:1px solid #e4e6eb;position:sticky;top:0;background:#fff;z-index:1">
      <div style="display:flex;align-items:center;gap:.5rem;font-weight:800;font-size:.97rem;color:#1c1e21">
        <i class="fa-solid fa-calendar-clock" style="color:#1877f2"></i> โพสตั้งเวลา
      </div>
      <button onclick="closeSchedModal()" style="background:none;border:none;cursor:pointer;color:#65676b;font-size:1.1rem;padding:.2rem .4rem;border-radius:6px;line-height:1" title="ปิด">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div style="padding:1rem 1.2rem">

      <!-- Author -->
      <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.8rem">
        <div class="avatar avatar-blue" style="flex-shrink:0"><i class="fa-solid fa-building"></i></div>
        <div>
          <div style="font-weight:700;font-size:.88rem;color:#1c1e21">Admin</div>
          <div style="display:inline-flex;align-items:center;gap:.3rem;background:#f0f2f5;border-radius:6px;padding:.14rem .42rem;font-size:.72rem;color:#65676b;margin-top:.1rem">
            <i class="fa-solid fa-earth-asia"></i> สาธารณะ
          </div>
        </div>
      </div>

      <!-- Textarea -->
      <div style="background:#f0f2f5;border-radius:12px;padding:.65rem .85rem">
        <textarea id="schedMsg" placeholder="พิมพ์ข้อความที่ต้องการโพส..." rows="4"
          style="width:100%;box-sizing:border-box;border:none;background:transparent;font-family:inherit;font-size:.9rem;resize:none;outline:none;color:#1c1e21;line-height:1.55"
          oninput="document.getElementById('schedCharCount').textContent=this.value.length"></textarea>
        <div style="display:flex;gap:.22rem;flex-wrap:wrap;padding-top:.3rem;border-top:1px solid #e4e6eb;margin-top:.25rem">
          <% ['😊','🔥','❤️','👍','🎉','✨','📣','💎','🏖️','🌟'].forEach(e => { %>
          <button type="button"
            onclick="(function(){var t=document.getElementById('schedMsg');t.value+='<%= e %>';t.dispatchEvent(new Event('input'));}).call(this)"
            style="background:none;border:none;cursor:pointer;font-size:1.1rem;padding:.1rem;border-radius:5px;line-height:1"
            onmouseover="this.style.background='#e4e6eb'" onmouseout="this.style.background='none'"><%= e %></button>
          <% }); %>
        </div>
      </div>
      <div style="text-align:right;font-size:.72rem;color:#8a8d91;margin-top:.25rem">
        <span id="schedCharCount">0</span> ตัวอักษร
      </div>

      <!-- Page selector -->
      <div class="page-selector" style="margin-top:.75rem">
        <span class="page-selector-label">
          <i class="fa-solid fa-layer-group" style="color:#1877f2"></i> เพจ:
        </span>
        <button class="page-sel-chip all-chip active" id="schedAllChip" onclick="schedToggleAll(this)">
          <i class="fa-solid fa-check"></i> ทั้งหมด
        </button>
        <% const _sc = ['blue','green','orange','purple','red']; %>
        <% pages.forEach((p, i) => { %>
        <button class="page-sel-chip active sched-pg" data-page-id="<%= p.pageId %>" onclick="schedTogglePage(this)">
          <div class="avatar avatar-<%= _sc[i%5] %>" style="width:16px;height:16px;font-size:.55rem;flex-shrink:0"><%= p.pageName.slice(-1) %></div>
          <%= p.pageName %>
        </button>
        <% }); %>
      </div>

      <!-- Schedule datetime (required) -->
      <div style="border:2px solid #e7f0fd;background:#f8fbff;border-radius:12px;padding:.85rem 1rem;margin-top:.85rem">
        <div style="font-size:.8rem;font-weight:700;color:#1877f2;margin-bottom:.55rem">
          <i class="fa-solid fa-calendar-clock"></i> วันที่และเวลาที่ต้องการโพส <span style="color:#c62828">*</span>
        </div>
        <div class="dt24-wrap" style="flex-wrap:wrap;gap:.35rem">
          <input type="date" lang="en-GB" id="schd_d" style="cursor:pointer;min-width:110px">
          <input type="number" id="schd_h" min="0" max="23" placeholder="ชม." style="width:50px;text-align:center">
          <span style="font-size:.9rem;font-weight:700;color:#555">:</span>
          <input type="number" id="schd_m" min="0" max="59" placeholder="น." style="width:50px;text-align:center">
        </div>
        <div style="display:flex;gap:.28rem;flex-wrap:wrap;margin-top:.45rem">
          <button type="button" onclick="schdToday()"
            style="background:#e7f0fd;border:none;border-radius:7px;padding:.26rem .65rem;font-size:.73rem;cursor:pointer;color:#1877f2;font-family:inherit;font-weight:600">วันนี้ตอนนี้</button>
          <button type="button" onclick="schdQuick(60)"
            style="background:#f0f2f5;border:none;border-radius:7px;padding:.26rem .6rem;font-size:.73rem;cursor:pointer;color:#444;font-family:inherit">+1 ชม.</button>
          <button type="button" onclick="schdQuick(180)"
            style="background:#f0f2f5;border:none;border-radius:7px;padding:.26rem .6rem;font-size:.73rem;cursor:pointer;color:#444;font-family:inherit">+3 ชม.</button>
          <button type="button" onclick="schdQuick(1440)"
            style="background:#f0f2f5;border:none;border-radius:7px;padding:.26rem .6rem;font-size:.73rem;cursor:pointer;color:#444;font-family:inherit">+1 วัน</button>
        </div>
      </div>

      <!-- Delay -->
      <div style="display:flex;align-items:center;gap:.4rem;margin-top:.75rem;padding:.5rem .65rem;background:#f8f9fa;border-radius:10px">
        <i class="fa-solid fa-stopwatch" style="color:#8a8d91;font-size:.8rem"></i>
        <span style="font-size:.78rem;color:#65676b;white-space:nowrap">หน่วงเวลา/เพจ</span>
        <input type="number" id="schedDelay" value="30" min="0" max="120"
          style="width:54px;padding:.28rem .4rem;border:1.5px solid #e4e6eb;border-radius:7px;font-size:.82rem;font-family:inherit;outline:none;text-align:center">
        <span style="font-size:.78rem;color:#8a8d91">วิ</span>
        <span style="font-size:.73rem;color:#42b72a;font-weight:600">(แนะนำ 30-60)</span>
      </div>

      <!-- Submit row -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-top:1rem;padding-top:.85rem;border-top:1px solid #e4e6eb">
        <div style="font-size:.78rem;color:#65676b;display:flex;align-items:center;gap:.3rem">
          <i class="fa-solid fa-layer-group" style="color:#1877f2;font-size:.73rem"></i>
          <span id="schedPageCount">โพสไปยัง <%= pages.length %> เพจ</span>
        </div>
        <button type="button" onclick="submitSchedPost()" id="schedSubmitBtn"
          style="display:inline-flex;align-items:center;gap:.4rem;background:#1877f2;color:#fff;border:none;border-radius:10px;padding:.55rem 1.1rem;font-size:.88rem;cursor:pointer;font-family:inherit;font-weight:700">
          <i class="fa-solid fa-calendar-check"></i> ตั้งเวลาโพส
        </button>
      </div>

    </div><!-- /padding -->
  </div><!-- /modal box -->
</div><!-- /modal overlay -->

<script>
// ── Scheduled Post Modal ──
const PQUEUE_PAGES = <%- JSON.stringify(pages) %>;
let schedPages = new Set(PQUEUE_PAGES.map(p => p.pageId));

function openSchedModal() {
  const m = document.getElementById('schedModal');
  m.style.display = 'flex';
  document.body.style.overflow = 'hidden';
  // Default to +1 hour
  schdQuick(60);
}
function closeSchedModal() {
  document.getElementById('schedModal').style.display = 'none';
  document.body.style.overflow = '';
}

// Page selection
function schedTogglePage(btn) {
  const id = btn.dataset.pageId;
  if (schedPages.has(id)) { schedPages.delete(id); btn.classList.remove('active'); }
  else                    { schedPages.add(id);    btn.classList.add('active'); }
  schedSyncAll(); updateSchedCount();
}
function schedToggleAll(btn) {
  if (btn.classList.contains('active')) {
    schedPages.clear();
    document.querySelectorAll('.sched-pg').forEach(c => c.classList.remove('active'));
    btn.classList.remove('active');
  } else {
    document.querySelectorAll('.sched-pg').forEach(c => { c.classList.add('active'); schedPages.add(c.dataset.pageId); });
    btn.classList.add('active');
  }
  updateSchedCount();
}
function schedSyncAll() {
  const a = document.getElementById('schedAllChip');
  if (a) a.classList.toggle('active', schedPages.size === PQUEUE_PAGES.length);
}
function updateSchedCount() {
  const el = document.getElementById('schedPageCount');
  if (el) el.textContent = `โพสไปยัง ${schedPages.size} เพจ`;
}

// Datetime helpers
const _schdPad = n => String(n).padStart(2, '0');
function _schdBkk(d) {
  return new Date(d.toLocaleString('en-US', { timeZone: 'Asia/Bangkok' }));
}
function schdToday() {
  const b = _schdBkk(new Date());
  _fpSetDate(document.getElementById('schd_d'), `${b.getFullYear()}-${_schdPad(b.getMonth()+1)}-${_schdPad(b.getDate())}`);
  document.getElementById('schd_h').value = b.getHours();
  document.getElementById('schd_m').value = b.getMinutes();
}
function schdQuick(minutes) {
  const b = _schdBkk(new Date(Date.now() + minutes * 60000));
  _fpSetDate(document.getElementById('schd_d'), `${b.getFullYear()}-${_schdPad(b.getMonth()+1)}-${_schdPad(b.getDate())}`);
  document.getElementById('schd_h').value = b.getHours();
  document.getElementById('schd_m').value = b.getMinutes();
}

// Submit
async function submitSchedPost() {
  const msg    = (document.getElementById('schedMsg').value || '').trim();
  const schedAt = dt24Get('schd');
  const delay  = parseInt(document.getElementById('schedDelay').value) || 0;

  if (!msg) {
    Swal.fire({ icon:'warning', title:'ยังไม่ได้กรอกข้อความ', confirmButtonColor:'#1877f2', confirmButtonText:'ตกลง' });
    return;
  }
  if (!schedAt) {
    Swal.fire({ icon:'warning', title:'กรุณาเลือกวันที่และเวลา', confirmButtonColor:'#1877f2', confirmButtonText:'ตกลง' });
    return;
  }
  if (schedPages.size === 0) {
    Swal.fire({ icon:'warning', title:'กรุณาเลือกเพจอย่างน้อย 1 เพจ', confirmButtonColor:'#1877f2', confirmButtonText:'ตกลง' });
    return;
  }

  const btn = document.getElementById('schedSubmitBtn');
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังบันทึก...'; }

  try {
    const fd = new FormData();
    fd.append('message', msg);
    schedPages.forEach(id => fd.append('selectedPages', id));
    fd.append('scheduledAt', new Date(schedAt.slice(0,16) + ':00+07:00').toISOString());
    if (delay > 0) fd.append('postDelay', delay);

    const r    = await fetch('/send', { method:'POST', body:fd });
    const data = await r.json();

    if (data.scheduled) {
      const dt = data.scheduledAt
        ? new Date(data.scheduledAt).toLocaleString('th-TH', { timeZone:'Asia/Bangkok', dateStyle:'short', timeStyle:'short' })
        : '';
      await Swal.fire({
        icon:'success', title:'ตั้งเวลาโพสแล้ว!',
        html: `<p style="color:#65676b">จะโพสต์อัตโนมัติ <strong>${dt}</strong></p>`,
        confirmButtonColor:'#1877f2', confirmButtonText:'ตกลง',
      });
      closeSchedModal();
      location.reload();
    } else {
      throw new Error(data.error || 'เกิดข้อผิดพลาด');
    }
  } catch(e) {
    Swal.fire({ icon:'error', title:'บันทึกไม่สำเร็จ', text:e.message, confirmButtonColor:'#1877f2' });
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-calendar-check"></i> ตั้งเวลาโพส'; }
  }
}
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>(function(){var O={dateFormat:'Y-m-d',altInput:true,altFormat:'d/m/Y',allowInput:true,disableMobile:true};function I(e){if(e._flatpickr)return;flatpickr(e,O);var ai=e._flatpickr&&e._flatpickr.altInput;if(ai){var s=e.getAttribute('style');if(s)ai.style.cssText=s;ai.style.cursor='pointer';ai.placeholder=e.getAttribute('title')||e.getAttribute('placeholder')||'วว/ดด/ปปปป';}}document.querySelectorAll('input[type="date"]').forEach(I);new MutationObserver(function(m){m.forEach(function(r){r.addedNodes.forEach(function(n){if(n.nodeType!==1)return;if(n.matches&&n.matches('input[type="date"]'))I(n);n.querySelectorAll&&n.querySelectorAll('input[type="date"]').forEach(I)})})}).observe(document.body,{childList:true,subtree:true});})()</script>
</body>
</html>
