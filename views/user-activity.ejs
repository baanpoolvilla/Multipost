<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ใครทำอะไร - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <% if (locals.currentStaff) { %>
      <span style="font-size:.82rem;color:#65676b;margin-right:.6rem"><i class="fa-solid fa-user-circle"></i> <%= currentStaff.name %></span>
      <form method="POST" action="/logout" style="display:inline">
        <button type="submit" class="btn-back" style="border:none;cursor:pointer"><i class="fa-solid fa-right-from-bracket"></i> ออกจากระบบ</button>
      </form>
      <% } %>
      <a href="/" class="btn-back"><i class="fa-solid fa-house"></i> หน้าหลัก</a>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">ระบบ</div>
    <a href="/user-activity" class="sidebar-item active"><i class="fa-solid fa-user-clock"></i><span>ใครทำอะไร</span></a>
    <a href="/manage-staff" class="sidebar-item"><i class="fa-solid fa-users-gear"></i><span>จัดการผู้ใช้งาน</span></a>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <div class="card" style="padding:.8rem 1.25rem">
      <div class="card-title" style="font-size:1.05rem">
        <i class="fa-solid fa-user-clock"></i> ใครทำอะไร
        <span style="background:#e4e6ea;padding:.12rem .5rem;border-radius:999px;font-size:.78rem;font-weight:400;margin-left:.35rem"><%= staffSummaries.length %> คน</span>
      </div>
    </div>

    <% if (staffSummaries.length === 0) { %>
    <div class="card"><div class="empty-state">ยังไม่มีข้อมูลกิจกรรม</div></div>
    <% } else { %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:.85rem">
      <% staffSummaries.forEach((s, i) => { %>
      <% const colors = ['blue','green','orange','purple','red']; const isUnassigned = s.id === 'unassigned'; %>
      <a href="/user-activity/<%= s.id %>" class="card" style="padding:1rem 1.1rem;text-decoration:none;color:inherit;display:block">
        <div style="display:flex;align-items:center;gap:.7rem;margin-bottom:.7rem">
          <div class="avatar avatar-<%= isUnassigned ? 'red' : colors[i%5] %>" style="width:40px;height:40px;font-size:1rem;flex-shrink:0">
            <% if (isUnassigned) { %><i class="fa-solid fa-question"></i><% } else { %><%= s.displayName.charAt(0).toUpperCase() %><% } %>
          </div>
          <div style="flex:1;min-width:0">
            <div style="font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= s.displayName %></div>
            <% if (s.lastActivityAt) { %>
            <div style="font-size:.74rem;color:var(--text3)">ล่าสุด <%= new Date(s.lastActivityAt).toLocaleString('th-TH', { timeZone:'Asia/Bangkok', dateStyle:'short', timeStyle:'short' }) %></div>
            <% } %>
          </div>
        </div>
        <div style="display:flex;gap:.6rem;font-size:.78rem;color:var(--text2);flex-wrap:wrap">
          <span><i class="fa-brands fa-facebook" style="color:#1877f2"></i> <%= s.pagePostCount %> โพสเพจ</span>
          <span><i class="fa-solid fa-users" style="color:#2e7d32"></i> <%= s.groupJobCount %> แชร์กลุ่ม</span>
        </div>
        <div style="display:flex;gap:.6rem;font-size:.78rem;margin-top:.35rem">
          <span style="color:#2e7d32">✓ <%= s.successCount %> สำเร็จ</span>
          <span style="color:#c62828">✕ <%= s.failCount %> ล้มเหลว</span>
        </div>
      </a>
      <% }); %>
    </div>
    <% } %>

  </main>

</div>
</body>
</html>
