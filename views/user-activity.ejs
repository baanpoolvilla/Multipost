<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>กิจกรรมพนักงาน - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.11.0/dist/tabler-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/auth-guard.js"></script>
  <script src="/js/navbar-user.js"></script>
</head>
<body class="eb">

<div class="app">

  <%- include('partials/sidebar', { active: 'team' }) %>

  <div class="main">

    <div class="card" style="padding:.8rem 1.25rem">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.6rem">
        <div class="card-title" style="margin-bottom:0;font-size:1.05rem">
          <i class="fa-solid fa-user-clock"></i> กิจกรรมพนักงาน
          <span style="background:#e4e6ea;padding:.12rem .5rem;border-radius:999px;font-size:.78rem;font-weight:400;margin-left:.35rem">ผู้ใช้งานทั้งหมด <%= staffSummaries.length %> คน</span>
        </div>
        <div style="display:flex;gap:.5rem;flex-wrap:wrap">
          <div style="position:relative">
            <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:.6rem;top:50%;transform:translateY(-50%);color:#8a8d91;font-size:.8rem;pointer-events:none"></i>
            <input id="uaNameSearch" type="text" placeholder="ค้นหาชื่อพนักงาน..." oninput="applyUaNameFilter()"
              style="padding:.35rem .7rem .35rem 1.9rem;border:1px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;width:180px;outline:none;color:#333">
          </div>
          <select id="uaSort" onchange="applyUaSort()"
            style="padding:.35rem .6rem;border:1px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#333;outline:none;cursor:pointer">
            <option value="recent">เรียงตาม: กิจกรรมล่าสุด</option>
            <option value="total">เรียงตาม: งานทั้งหมดมากสุด</option>
            <option value="name">เรียงตาม: ชื่อ (A-Z, ก-ฮ)</option>
          </select>
        </div>
      </div>
    </div>

    <% if (staffSummaries.length === 0) { %>
    <div class="card empty-state">
      <i class="fa-solid fa-user-clock"></i>
      <h3>ยังไม่มีข้อมูลกิจกรรม</h3>
      <p>เมื่อพนักงานเริ่มโพสต์หรือแชร์ ข้อมูลจะแสดงที่นี่</p>
    </div>
    <% } else { %>
    <div id="uaEmptyFiltered" class="card empty-state" style="display:none">
      <i class="fa-solid fa-magnifying-glass"></i>
      <h3>ไม่พบพนักงานที่ค้นหา</h3>
    </div>
    <div class="staff-grid" id="uaGrid">
      <% staffSummaries.forEach((s, i) => { %>
      <% const colors = ['blue','green','orange','purple','red']; const isUnassigned = s.id === 'unassigned'; %>
      <a href="/user-activity/<%= s.id %>" class="staff-card"
         data-name="<%= s.displayName.toLowerCase() %>"
         data-total="<%= s.pagePostCount + s.groupJobCount %>"
         data-last-at="<%= s.lastActivityAt ? new Date(s.lastActivityAt).getTime() : 0 %>">
        <div class="staff-card-head">
          <div class="avatar avatar-<%= isUnassigned ? 'red' : colors[i%5] %>">
            <% if (isUnassigned) { %><i class="fa-solid fa-question"></i><% } else { %><%= s.displayName.charAt(0).toUpperCase() %><% } %>
          </div>
          <div style="flex:1;min-width:0">
            <div class="staff-card-name"><%= s.displayName %></div>
            <% if (s.lastActivityAt) { %>
            <div class="staff-card-sub">ใช้งานล่าสุด <%= new Date(s.lastActivityAt).toLocaleString('th-TH', { timeZone:'Asia/Bangkok', dateStyle:'short', timeStyle:'short' }) %></div>
            <% } %>
          </div>
        </div>
        <div class="staff-card-divider"></div>
        <div class="staff-stat-row">
          <span class="staff-stat fb"><i class="fa-brands fa-facebook"></i> <%= s.pagePostCount %> โพสต์เพจ<% if (s.pageCount > 0) { %> (<%= s.pageCount %> เพจ)<% } %></span>
          <span class="staff-stat grp"><i class="fa-solid fa-users"></i> <%= s.groupJobCount %> แชร์กลุ่ม<% if (s.groupCount > 0) { %> (<%= s.groupCount %> กลุ่ม)<% } %></span>
        </div>
        <div class="staff-stat-row" style="margin-top:.5rem">
          <span class="staff-stat ok"><i class="fa-solid fa-circle-check"></i> <%= s.successCount %> สำเร็จ</span>
          <span class="staff-stat fail"><i class="fa-solid fa-circle-xmark"></i> <%= s.failCount %> ล้มเหลว</span>
          <% if (s.pendingCount > 0) { %>
          <span class="staff-stat" style="background:#fff3cd;color:#856404"><i class="fa-solid fa-clock"></i> <%= s.pendingCount %> รอ</span>
          <% } %>
        </div>
      </a>
      <% }); %>
    </div>
    <% } %>

    <script>
      function applyUaNameFilter() {
        const q = document.getElementById('uaNameSearch').value.toLowerCase().trim();
        const cards = [...document.querySelectorAll('#uaGrid .staff-card')];
        let visible = 0;
        cards.forEach(c => {
          const match = c.dataset.name.includes(q);
          c.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        const empty = document.getElementById('uaEmptyFiltered');
        if (empty) empty.style.display = visible === 0 ? '' : 'none';
      }

      function applyUaSort() {
        const grid = document.getElementById('uaGrid');
        if (!grid) return;
        const sortBy = document.getElementById('uaSort').value;
        const cards = [...grid.querySelectorAll('.staff-card')];
        cards.sort((a, b) => {
          if (sortBy === 'name') return a.dataset.name.localeCompare(b.dataset.name, 'th');
          if (sortBy === 'total') return parseInt(b.dataset.total) - parseInt(a.dataset.total);
          return parseInt(b.dataset.lastAt) - parseInt(a.dataset.lastAt);
        });
        cards.forEach(c => grid.appendChild(c));
      }
    </script>

  </div>

</div>
</body>
</html>
