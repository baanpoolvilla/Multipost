<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>แชร์โพสลงกลุ่ม - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .share-label {
      font-size: .8rem; font-weight: 600; color: #65676b;
      display: block; margin-bottom: .35rem;
    }
    .share-input {
      width: 100%; padding: .55rem .8rem;
      border: 1.5px solid #dbe0e6; border-radius: 8px;
      font-family: inherit; font-size: .9rem;
      outline: none; box-sizing: border-box; color: #1c1e21;
      transition: border-color .15s;
    }
    .share-input:focus { border-color: #1877f2; }
    .share-textarea {
      width: 100%; padding: .55rem .8rem;
      border: 1.5px solid #dbe0e6; border-radius: 8px;
      font-family: inherit; font-size: .9rem;
      outline: none; box-sizing: border-box; color: #1c1e21;
      resize: vertical; min-height: 80px;
      transition: border-color .15s;
    }
    .share-textarea:focus { border-color: #1877f2; }
    .form-section { margin-bottom: 1rem; }

    .group-section-header {
      display: flex; align-items: center; gap: .5rem;
      font-size: .82rem; font-weight: 700; color: #65676b;
      padding: .4rem 0 .3rem;
      border-bottom: 1px solid #f0f2f5;
      margin-bottom: .35rem;
    }
    .group-row {
      display: flex; align-items: center; gap: .55rem;
      padding: .35rem .5rem; border-radius: 7px;
      cursor: pointer; transition: background .12s;
    }
    .group-row:hover { background: #f0f2f5; }
    .group-row input[type=checkbox] {
      width: 16px; height: 16px; cursor: pointer; accent-color: #1877f2;
    }
    .group-row-name { font-size: .88rem; flex: 1; }
    .group-row-id { font-size: .72rem; color: #8a8d91; }

    .group-controls {
      display: flex; gap: .4rem; margin-bottom: .5rem;
    }
    .btn-sm-outline {
      font-size: .76rem; font-weight: 600; padding: .25rem .7rem;
      border: 1.5px solid #dbe0e6; border-radius: 6px;
      background: none; cursor: pointer; font-family: inherit;
      color: #65676b; transition: all .15s;
    }
    .btn-sm-outline:hover { border-color: #1877f2; color: #1877f2; background: #f0f6ff; }

    .interval-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: .6rem;
    }
    .interval-box { display: flex; flex-direction: column; gap: .25rem; }
    .interval-box label { font-size: .76rem; color: #65676b; font-weight: 600; }
    .interval-box input {
      padding: .45rem .7rem; border: 1.5px solid #dbe0e6;
      border-radius: 8px; font-family: inherit; font-size: .9rem;
      outline: none; text-align: center; transition: border-color .15s;
    }
    .interval-box input:focus { border-color: #1877f2; }
    .interval-unit { font-size: .75rem; color: #8a8d91; text-align: center; margin-top: .1rem; }

    .btn-start {
      width: 100%; padding: .7rem; border-radius: 10px;
      background: #1877f2; color: #fff; border: none;
      font-family: inherit; font-size: .95rem; font-weight: 700;
      cursor: pointer; display: flex; align-items: center;
      justify-content: center; gap: .5rem; transition: background .15s, opacity .15s;
    }
    .btn-start:hover { background: #1464cc; }
    .btn-start:disabled { opacity: .55; cursor: not-allowed; }

    .btn-stop {
      width: 100%; padding: .7rem; border-radius: 10px;
      background: #c62828; color: #fff; border: none;
      font-family: inherit; font-size: .95rem; font-weight: 700;
      cursor: pointer; display: flex; align-items: center;
      justify-content: center; gap: .5rem; transition: background .15s;
      display: none;
    }
    .btn-stop:hover { background: #a31515; }

    /* Status panel */
    .status-counts {
      display: grid; grid-template-columns: 1fr 1fr; gap: .6rem;
      margin-bottom: .75rem;
    }
    .status-count-box {
      border-radius: 10px; padding: .7rem .85rem;
      display: flex; flex-direction: column; gap: .2rem;
    }
    .status-count-box.green { background: #e8f5e9; border: 1.5px solid #a5d6a7; }
    .status-count-box.red   { background: #ffebee; border: 1.5px solid #ef9a9a; }
    .status-count-label { font-size: .75rem; font-weight: 600; }
    .status-count-box.green .status-count-label { color: #2e7d32; }
    .status-count-box.red   .status-count-label { color: #c62828; }
    .status-count-num { font-size: 1.6rem; font-weight: 700; line-height: 1; }
    .status-count-box.green .status-count-num { color: #2e7d32; }
    .status-count-box.red   .status-count-num { color: #c62828; }

    .share-log { display: flex; flex-direction: column; gap: .4rem; max-height: 420px; overflow-y: auto; }
    .log-row {
      display: flex; align-items: flex-start; gap: .5rem;
      padding: .45rem .6rem; border-radius: 8px;
      font-size: .82rem;
    }
    .log-row.ok   { background: #f1f8e9; }
    .log-row.fail { background: #fff3e0; }
    .log-row.wait { background: #f3f0ff; }
    .log-icon { flex-shrink: 0; margin-top: .1rem; font-size: .9rem; }
    .log-row.ok   .log-icon { color: #2e7d32; }
    .log-row.fail .log-icon { color: #c62828; }
    .log-row.wait .log-icon { color: #7b2ff7; }
    .log-meta { font-weight: 700; }
    .log-detail { color: #65676b; font-size: .78rem; }

    .progress-bar-wrap {
      background: #f0f2f5; border-radius: 999px;
      height: 6px; overflow: hidden; margin-bottom: .6rem;
    }
    .progress-bar-fill {
      height: 100%; background: #1877f2;
      border-radius: 999px; transition: width .4s;
      width: 0%;
    }

    .empty-groups {
      text-align: center; padding: 1.5rem 1rem;
      color: #8a8d91; font-size: .87rem;
    }
    .empty-groups i { font-size: 2rem; display: block; margin-bottom: .5rem; opacity: .4; }

    .page-count-badge {
      background: #e7f3ff; color: #1877f2;
      border-radius: 999px; font-size: .7rem;
      padding: .08rem .4rem; font-weight: 700;
    }
  </style>
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <a href="/" class="btn-back"><i class="fa-solid fa-house"></i> หน้าหลัก</a>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/" class="sidebar-item"><i class="fa-solid fa-house"></i><span>หน้าหลัก</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสต์</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/share-post" class="sidebar-item active"><i class="fa-solid fa-share-nodes"></i><span>แชร์โพสลงกลุ่ม</span></a>
  </aside>

  <main class="feed">

    <div class="card">
      <div class="card-title" style="margin-bottom:1.1rem">
        <i class="fa-solid fa-share-nodes"></i> แชร์โพสอัตโนมัติลงกลุ่ม
      </div>

      <!-- URL input -->
      <div class="form-section">
        <label class="share-label"><i class="fa-solid fa-link" style="color:#1877f2"></i> ลิ้งโพสที่ต้องการแชร์</label>
        <input type="text" id="postUrl" class="share-input"
          placeholder="https://www.facebook.com/permalink.php?story_fbid=..."
          value="<%= url %>">
      </div>

      <!-- Message -->
      <div class="form-section">
        <label class="share-label"><i class="fa-regular fa-comment" style="color:#1877f2"></i> ข้อความสำหรับแชร์ (ถ้ามี)</label>
        <textarea id="shareMessage" class="share-textarea"
          placeholder="ข้อความเพิ่มเติมประกอบการแชร์..."></textarea>
      </div>

      <!-- Groups selector -->
      <div class="form-section">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem">
          <label class="share-label" style="margin:0">
            <i class="fa-solid fa-users" style="color:#1877f2"></i> เลือกกลุ่มที่ต้องการแชร์
            <span id="selectedCount" style="font-weight:400;color:#8a8d91;margin-left:.25rem"></span>
          </label>
          <div class="group-controls" style="margin:0">
            <button class="btn-sm-outline" onclick="selectAllGroups()"><i class="fa-solid fa-check-double"></i> เลือกทั้งหมด</button>
            <button class="btn-sm-outline" onclick="deselectAllGroups()"><i class="fa-solid fa-xmark"></i> ยกเลิก</button>
          </div>
        </div>

        <div id="groupList">
          <%
            const allGroups = [];
            pages.forEach(p => { if ((p.groups||[]).length > 0) allGroups.push(p); });
          %>

          <% if (allGroups.length === 0) { %>
          <div class="empty-groups">
            <i class="fa-solid fa-users-slash"></i>
            ยังไม่มีกลุ่มในระบบ<br>
            <a href="/pages" style="color:#1877f2;font-weight:600">เพิ่มกลุ่มที่หน้าจัดการเพจ</a>
          </div>
          <% } else { %>
            <% const colors = ['purple','green','orange','blue','red']; %>
            <% allGroups.forEach((page, pi) => { %>
            <div class="group-section-header">
              <div class="avatar avatar-<%= colors[pi%5] %> avatar-xs"><%= page.pageName.slice(-1) %></div>
              <span><%= page.pageName %></span>
              <span class="page-count-badge"><%= page.groups.length %> กลุ่ม</span>
            </div>
            <% page.groups.forEach(g => { %>
            <label class="group-row" data-group-id="<%= g.groupId %>" data-page-id="<%= page.pageId %>">
              <input type="checkbox" class="group-cb"
                data-group-id="<%= g.groupId %>"
                data-page-id="<%= page.pageId %>"
                data-group-name="<%= g.groupName %>"
                data-page-name="<%= page.pageName %>"
                checked>
              <span class="group-row-name"><%= g.groupName %></span>
              <span class="group-row-id"><%= g.groupId %></span>
            </label>
            <% }); %>
            <% }); %>
          <% } %>
        </div>
      </div>

      <!-- Interval -->
      <div class="form-section">
        <label class="share-label"><i class="fa-regular fa-clock" style="color:#1877f2"></i> ตั้งค่าหน่วงเวลาระหว่างแชร์</label>
        <div class="interval-grid">
          <div class="interval-box">
            <label>น้อยที่สุด</label>
            <input type="number" id="minDelay" value="30" min="5" max="300">
            <div class="interval-unit">วินาที</div>
          </div>
          <div class="interval-box">
            <label>มากที่สุด</label>
            <input type="number" id="maxDelay" value="60" min="5" max="600">
            <div class="interval-unit">วินาที</div>
          </div>
        </div>
      </div>

      <!-- Buttons -->
      <button id="startBtn" class="btn-start" onclick="startSharing()">
        <i class="fa-solid fa-play"></i> เริ่มแชร์อัตโนมัติ
      </button>
      <button id="stopBtn" class="btn-stop" onclick="stopSharing()">
        <i class="fa-solid fa-stop"></i> หยุดแชร์
      </button>
    </div>

  </main>

  <aside class="right-panel">

    <!-- Status counts -->
    <div class="card">
      <div class="card-title" style="margin-bottom:.75rem">
        <i class="fa-solid fa-bolt"></i> สถานะการแชร์
      </div>
      <div class="status-counts">
        <div class="status-count-box green">
          <div class="status-count-label"><i class="fa-solid fa-circle-check"></i> แชร์สำเร็จ</div>
          <div class="status-count-num" id="successNum">0</div>
        </div>
        <div class="status-count-box red">
          <div class="status-count-label"><i class="fa-solid fa-circle-xmark"></i> แชร์ไม่สำเร็จ</div>
          <div class="status-count-num" id="failNum">0</div>
        </div>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar-fill" id="progressBar"></div>
      </div>
      <div id="progressText" style="font-size:.78rem;color:#65676b;text-align:center">รอเริ่มต้น</div>
    </div>

    <!-- Log -->
    <div class="card">
      <div class="card-title" style="margin-bottom:.75rem">
        <i class="fa-solid fa-list-check"></i> รายงานการแชร์โพส
      </div>
      <div class="share-log" id="shareLog">
        <div style="text-align:center;padding:1rem;color:#8a8d91;font-size:.83rem">
          <i class="fa-solid fa-share-nodes" style="font-size:1.4rem;opacity:.3;display:block;margin-bottom:.4rem"></i>
          กดเริ่มแชร์เพื่อเริ่มต้น
        </div>
      </div>
    </div>

  </aside>
</div>

<script>
  let isStopped = false;

  function getCheckedGroups() {
    return [...document.querySelectorAll('.group-cb:checked')].map(cb => ({
      groupId:   cb.dataset.groupId,
      pageId:    cb.dataset.pageId,
      groupName: cb.dataset.groupName,
      pageName:  cb.dataset.pageName,
    }));
  }

  function updateSelectedCount() {
    const n = document.querySelectorAll('.group-cb:checked').length;
    const total = document.querySelectorAll('.group-cb').length;
    document.getElementById('selectedCount').textContent = `(เลือก ${n}/${total} กลุ่ม)`;
  }

  function selectAllGroups() {
    document.querySelectorAll('.group-cb').forEach(cb => cb.checked = true);
    updateSelectedCount();
  }

  function deselectAllGroups() {
    document.querySelectorAll('.group-cb').forEach(cb => cb.checked = false);
    updateSelectedCount();
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateSelectedCount();
    document.querySelectorAll('.group-cb').forEach(cb => {
      cb.addEventListener('change', updateSelectedCount);
    });
  });

  function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

  function randBetween(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function addLog(type, groupName, pageName, detail) {
    const log  = document.getElementById('shareLog');
    const icons = { ok: 'fa-circle-check', fail: 'fa-circle-xmark', wait: 'fa-hourglass-half' };
    const row  = document.createElement('div');
    row.className = `log-row ${type}`;
    row.innerHTML = `
      <i class="fa-solid ${icons[type]} log-icon"></i>
      <div>
        <div class="log-meta">${groupName}</div>
        <div class="log-detail">${pageName} · ${detail}</div>
      </div>`;
    if (log.querySelector('div[style]')) log.innerHTML = '';
    log.prepend(row);
  }

  async function startSharing() {
    const postUrl = document.getElementById('postUrl').value.trim();
    if (!postUrl) {
      Swal.fire({ icon: 'warning', title: 'กรุณาใส่ลิ้งโพส', timer: 1800, showConfirmButton: false });
      return;
    }

    const groups = getCheckedGroups();
    if (groups.length === 0) {
      Swal.fire({ icon: 'warning', title: 'กรุณาเลือกอย่างน้อย 1 กลุ่ม', timer: 1800, showConfirmButton: false });
      return;
    }

    const message  = document.getElementById('shareMessage').value.trim();
    const minDelay = Math.max(5, parseInt(document.getElementById('minDelay').value) || 30) * 1000;
    const maxDelay = Math.max(minDelay / 1000, parseInt(document.getElementById('maxDelay').value) || 60) * 1000;

    isStopped = false;
    document.getElementById('startBtn').style.display = 'none';
    document.getElementById('stopBtn').style.display  = 'flex';
    document.getElementById('shareLog').innerHTML = '';

    let successNum = 0, failNum = 0;
    document.getElementById('successNum').textContent = '0';
    document.getElementById('failNum').textContent    = '0';
    document.getElementById('progressBar').style.width = '0%';

    for (let i = 0; i < groups.length; i++) {
      if (isStopped) {
        addLog('wait', 'หยุดโดยผู้ใช้', '', `แชร์สำเร็จ ${successNum} / ล้มเหลว ${failNum}`);
        break;
      }

      const g = groups[i];
      document.getElementById('progressText').textContent =
        `กำลังแชร์ ${i + 1}/${groups.length} · ${g.groupName}`;

      try {
        const res = await fetch('/api/share-to-group', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ postUrl, message, groupId: g.groupId, pageId: g.pageId }),
        });
        const data = await res.json();
        if (data.ok) {
          successNum++;
          addLog('ok', g.groupName, g.pageName, 'แชร์สำเร็จ');
        } else {
          failNum++;
          addLog('fail', g.groupName, g.pageName, data.error || 'ล้มเหลว');
        }
      } catch (e) {
        failNum++;
        addLog('fail', g.groupName, g.pageName, e.message);
      }

      document.getElementById('successNum').textContent = successNum;
      document.getElementById('failNum').textContent    = failNum;
      document.getElementById('progressBar').style.width =
        `${Math.round((i + 1) / groups.length * 100)}%`;

      if (i < groups.length - 1 && !isStopped) {
        const delay = randBetween(minDelay, maxDelay);
        const sec   = Math.round(delay / 1000);
        document.getElementById('progressText').textContent =
          `รอ ${sec} วินาที ก่อนกลุ่มถัดไป...`;
        await sleep(delay);
      }
    }

    if (!isStopped) {
      document.getElementById('progressText').textContent =
        `เสร็จแล้ว · สำเร็จ ${successNum} ล้มเหลว ${failNum}`;
      document.getElementById('progressBar').style.width = '100%';
    }

    document.getElementById('startBtn').style.display = 'flex';
    document.getElementById('stopBtn').style.display  = 'none';
  }

  function stopSharing() {
    isStopped = true;
    document.getElementById('stopBtn').style.display  = 'none';
    document.getElementById('startBtn').style.display = 'flex';
    document.getElementById('progressText').textContent = 'หยุดแล้ว';
  }
</script>
</body>
</html>
