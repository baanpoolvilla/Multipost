/* ── Chart ── */
const ctx = document.getElementById('postsChart');
if (ctx) {
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: <%- chartLabels %>,
      datasets: [{
        label: 'จำนวนโพสต์',
        data: <%- chartData %>,
        backgroundColor: 'rgba(24,119,242,.7)',
        borderColor: '#1877f2',
        borderWidth: 1,
        borderRadius: 6,
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f0f2f5' } },
        x: { grid: { display: false } }
      }
    }
  });
}
</script>
</body>
</html>
