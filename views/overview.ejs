<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ภาพรวม - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.11.0/dist/tabler-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/auth-guard.js"></script>
  <script src="/js/navbar-user.js"></script>
</head>
<body class="eb">

<div class="app">

  <%- include('partials/sidebar', { active: 'poverview' }) %>

  <div class="main">

    <!-- Page title -->
    <div class="card" style="padding:.8rem 1.25rem">
      <div class="card-title" style="font-size:1.05rem;display:flex;align-items:center;flex-wrap:wrap;gap:.5rem;justify-content:space-between">
        <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
          <i class="fa-solid fa-chart-line" style="color:#1877f2"></i>
          ภาพรวมทั้งหมด
          <span id="last-updated" style="font-size:.78rem;font-weight:400;color:#8a8d91;margin-left:.4rem">
            <i class="fa-solid fa-spinner fa-spin" style="font-size:.75rem"></i> กำลังอัปเดต...
          </span>
        </div>
        <div style="display:flex;gap:.4rem;flex-wrap:wrap">
          <a href="/page-summary" style="background:#1877f2;color:#fff;border:none;border-radius:8px;padding:.35rem .85rem;font-size:.82rem;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:.4rem;text-decoration:none">
            <i class="fa-solid fa-chart-bar"></i> สรุปช่วงเวลา
          </a>
        </div>
      </div>
    </div>

    <!-- Summary metric cards -->
    <div class="overview-grid">
      <div class="metric-card blue">
        <div class="metric-icon"><i class="fa-solid fa-paper-plane"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-posts"><%= totalPosts %></div>
          <div class="metric-label">โพสต์ทั้งหมด</div>
        </div>
      </div>
      <div class="metric-card green">
        <div class="metric-icon"><i class="fa-solid fa-circle-check"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-success"><%= totalSuccess %></div>
          <div class="metric-label">ส่งสำเร็จ</div>
        </div>
      </div>
      <div class="metric-card purple">
        <div class="metric-icon"><i class="fa-solid fa-thumbs-up"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-likes"><%= totalLikes.toLocaleString() %></div>
          <div class="metric-label">ไลค์ทั้งหมด</div>
        </div>
      </div>
      <div class="metric-card orange">
        <div class="metric-icon"><i class="fa-solid fa-comment"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-comments"><%= totalComments.toLocaleString() %></div>
          <div class="metric-label">ความคิดเห็น</div>
        </div>
      </div>
      <div class="metric-card teal">
        <div class="metric-icon"><i class="fa-solid fa-share-nodes"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-shares"><%= totalShares.toLocaleString() %></div>
          <div class="metric-label">แชร์</div>
        </div>
      </div>
      <div class="metric-card red">
        <div class="metric-icon"><i class="fa-solid fa-eye"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-reach"><%= totalReach.toLocaleString() %></div>
          <div class="metric-label">การเข้าถึง</div>
        </div>
      </div>
      <div class="metric-card green" style="border: 2px solid #2e7d32; background: #f0fff4;">
        <div class="metric-icon" style="background: #2e7d32;"><i class="fa-solid fa-chart-pie"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-rate" style="color: #2e7d32;"><%= successRate %>%</div>
          <div class="metric-label">อัตราสำเร็จ</div>
        </div>
      </div>
    </div>

    <!-- Chart -->
    <div class="card">
      <div class="card-title" style="margin-bottom:1rem">
        <i class="fa-solid fa-chart-bar"></i> โพสต์ 7 วันที่ผ่านมา
      </div>
      <canvas id="postsChart" height="90"></canvas>
    </div>

    <!-- Per-page breakdown -->
    <% if (pageStats.length > 0) { %>
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.6rem;margin-bottom:1rem">
        <div class="card-title" style="margin-bottom:0">
          <i class="fa-solid fa-layer-group"></i> สถิติแต่ละเพจ
        </div>
        <div style="position:relative">
          <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:.6rem;top:50%;transform:translateY(-50%);color:#8a8d91;font-size:.8rem;pointer-events:none"></i>
          <input id="page-search" type="text" placeholder="ค้นหาชื่อเพจ..." oninput="filterPages(this.value)"
            style="padding:.35rem .7rem .35rem 1.9rem;border:1px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;width:180px;outline:none;color:#333">
        </div>
      </div>
      <div class="overview-table-wrap">
        <table class="overview-table">
          <thead>
            <tr>
              <th>เพจ</th>
              <th><i class="fa-solid fa-paper-plane"></i> โพสต์</th>
              <th><i class="fa-solid fa-thumbs-up"></i> ไลค์</th>
              <th><i class="fa-solid fa-comment"></i> คอมเมนต์</th>
              <th><i class="fa-solid fa-share-nodes"></i> แชร์</th>
              <th><i class="fa-solid fa-eye"></i> Reach</th>
              <th>อัตราสำเร็จ</th>
            </tr>
          </thead>
          <tbody id="pages-tbody">
            <% pageStats.forEach((p, i) => { %>
            <% const rate = p.posts > 0 ? Math.round(p.success/p.posts*100) : 0; %>
            <% const colors = ['purple','green','orange','blue','red']; %>
            <tr class="page-row" data-name="<%= p.pageName.toLowerCase() %>" data-index="<%= i %>">
              <td>
                <div style="display:flex;align-items:center;gap:.5rem">
                  <div class="avatar avatar-<%= colors[i%5] %> avatar-sm"><%= p.pageName.slice(-1) %></div>
                  <span style="font-weight:600"><%= p.pageName %></span>
                </div>
              </td>
              <td class="num"><%= p.posts %></td>
              <td class="num blue-text"><%= p.likes.toLocaleString() %></td>
              <td class="num orange-text"><%= p.comments.toLocaleString() %></td>
              <td class="num teal-text"><%= p.shares.toLocaleString() %></td>
              <td class="num purple-text"><%= p.reach.toLocaleString() %></td>
              <td>
                <div class="rate-bar-wrap">
                  <div class="rate-bar" style="width:<%= rate %>%"></div>
                  <span class="rate-text"><%= rate %>%</span>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div id="show-more-wrap" style="text-align:center;margin-top:.75rem;display:none">
        <button onclick="showAllPages()" style="background:none;border:1px solid #1877f2;color:#1877f2;border-radius:8px;padding:.35rem 1.1rem;font-size:.82rem;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-chevron-down"></i> ดูเพิ่มเติม
        </button>
      </div>
    </div>
    <% } %>

    <!-- Recent posts with analytics -->
    <% if (recentPosts.length > 0) { %>
    <div class="card">
      <div class="card-title" style="margin-bottom:1rem">
        <i class="fa-solid fa-clock-rotate-left"></i> โพสต์ล่าสุด
      </div>
      <% recentPosts.forEach(post => { %>
      <div class="overview-post-row">
        <div class="overview-post-msg">
          <a href="/result/<%= post.id %>" style="color:#1877f2;text-decoration:none;font-weight:600;font-size:.88rem">
            <%= post.message.length > 80 ? post.message.slice(0,80)+'…' : post.message %>
          </a>
          <div style="font-size:.75rem;color:#8a8d91;margin-top:.2rem">
            <i class="fa-regular fa-clock"></i> <%= new Date(post.lastAttemptAt || post.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
            &nbsp;·&nbsp; <%= post.results.length %> เพจ
          </div>
        </div>
        <div class="overview-post-stats">
          <%
            const totLikes    = post.results.reduce((s,r) => s + (r.analytics?.likes    || 0), 0);
            const totComments = post.results.reduce((s,r) => s + (r.analytics?.comments || 0), 0);
            const totReach    = post.results.reduce((s,r) => s + (r.analytics?.reach    || 0), 0);
          %>
          <span><i class="fa-solid fa-thumbs-up" style="color:#f7b928"></i> <%= totLikes %></span>
          <span><i class="fa-solid fa-comment" style="color:#f5533d"></i> <%= totComments %></span>
          <span><i class="fa-solid fa-eye" style="color:#45bd62"></i> <%= totReach %></span>
          <span class="pill pill-<%= post.failCount===0?'success':'fail' %>" style="font-size:.72rem;padding:.15rem .5rem">
            <%= post.successCount %>/<%= post.results.length %>
          </span>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>

    <% if (totalPosts === 0) { %>
    <div class="card empty-state">
      <i class="fa-solid fa-chart-line"></i>
      <h3>ยังไม่มีข้อมูล</h3>
      <p>เริ่มโพสต์แล้วดูสถิติที่นี่ได้เลย</p>
      <a href="/" class="btn-post" style="text-decoration:none;margin-top:1rem">
        <i class="fa-solid fa-paper-plane"></i> เริ่มโพสต์
      </a>
    </div>
    <% } %>

  </div>

  <aside class="right-panel">
    <div class="card stats-card">
      <div class="stats-title" style="display:flex;align-items:center;justify-content:space-between">
        <span><i class="fa-solid fa-trophy" style="color:#f7b928"></i> Top เพจ</span>
        <button onclick="showPageEngInfo()" style="background:none;border:none;cursor:pointer;color:#1877f2;font-size:.82rem;padding:.1rem .25rem" title="วิธีคำนวณ"><i class="fa-solid fa-circle-info"></i></button>
      </div>
      <%
        const medals = ['🥇','🥈','🥉','4️⃣','5️⃣'];
        const pageEngScore = p => (p.likes||0)*1 + (p.comments||0)*2 + (p.shares||0)*3 + (p.reach||0)*0.01;
        const sorted = [...pageStats].sort((a,b) => pageEngScore(b) - pageEngScore(a)).slice(0,5);
      %>
      <% if (sorted.length === 0) { %>
        <p style="font-size:.82rem;color:#8a8d91;margin-top:.4rem">ยังไม่มีข้อมูล</p>
      <% } %>
      <% sorted.forEach((p, i) => { %>
      <% const rate = p.posts > 0 ? Math.round((p.success||0)/p.posts*100) : 0; %>
      <div style="padding:.5rem 0;border-bottom:1px solid var(--border)">
        <div style="display:flex;align-items:center;gap:.35rem;margin-bottom:.25rem">
          <span><%= medals[i] %></span>
          <span style="font-weight:600;font-size:.83rem;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= p.pageName %></span>
          <span style="font-size:.7rem;color:#888"><%= rate %>%</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:.12rem .35rem;font-size:.75rem;color:var(--text3)">
          <span>📝 <b style="color:var(--text)"><%= p.posts %></b> โพส</span>
          <span>👁️ <b style="color:#45bd62"><%= (p.reach||0).toLocaleString() %></b></span>
          <span>👍 <b style="color:#1877f2"><%= (p.likes||0).toLocaleString() %></b></span>
          <span>💬 <b style="color:#f5533d"><%= (p.comments||0).toLocaleString() %></b></span>
        </div>
      </div>
      <% }); %>
    </div>
  </aside>

</div>

<script>
/* ── Auto-refresh (no button needed) ── */
const POLL_MS = 60 * 1000; // poll ทุก 1 นาที

function setLastUpdated() {
  const now = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
  const el  = document.getElementById('last-updated');
  if (el) el.innerHTML = `· อัปเดต ${now}`;
}

async function updateNumbers() {
  const res  = await fetch('/api/stats');
  const data = await res.json();
  const set  = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
  set('m-posts',     data.totalPosts);
  set('m-success',   data.totalSuccess);
  set('m-likes',     data.totalLikes.toLocaleString());
  set('m-comments',  data.totalComments.toLocaleString());
  set('m-shares', data.totalShares.toLocaleString());
  set('m-reach',  data.totalReach.toLocaleString());
  set('m-rate',   data.successRate + '%');
}

// Auto-refresh จาก Facebook ทุกครั้งที่โหลดหน้า
(async function autoRefreshOnLoad() {
  try {
    await fetch('/api/refresh-analytics', { method: 'POST' });
    await updateNumbers();
    setLastUpdated();
  } catch {
    setLastUpdated();
  }
})();

// Poll ทุก 5 นาทีเพื่ออัปเดตตัวเลขล่าสุด
setInterval(async () => {
  try { await updateNumbers(); setLastUpdated(); } catch {}
}, POLL_MS);

/* ── Page table: search + show-more ── */
const PAGE_LIMIT = 8;
let showingAll = false;

function applyPageVisibility(query) {
  const rows = document.querySelectorAll('.page-row');
  let visible = 0;
  rows.forEach(row => {
    const match = !query || row.dataset.name.includes(query.toLowerCase());
    const withinLimit = showingAll || parseInt(row.dataset.index) < PAGE_LIMIT;
    row.style.display = match && withinLimit ? '' : 'none';
    if (match) visible++;
  });
  const wrap = document.getElementById('show-more-wrap');
  if (wrap) wrap.style.display = (!showingAll && !query && rows.length > PAGE_LIMIT) ? '' : 'none';
}

function filterPages(q) {
  showingAll = !!q; // เมื่อค้นหา ให้แสดงทุกแถว
  applyPageVisibility(q);
}

function showAllPages() {
  showingAll = true;
  const q = document.getElementById('page-search')?.value || '';
  applyPageVisibility(q);
}

applyPageVisibility('');

/* ── Engagement formula info ── */
function showPageEngInfo() {
  Swal.fire({
    title: '<i class="fa-solid fa-circle-info" style="color:#1877f2"></i> วิธีคำนวณ Top เพจ',
    html: `<div style="text-align:left;font-size:.88rem">
      <p style="color:#555;margin-bottom:.75rem">เรียงตาม <b>คะแนน Engagement</b> (การมีส่วนร่วม) ซึ่งชั่งน้ำหนักว่าผู้ชมมีปฏิกิริยาอย่างไรต่อโพสต์ ไม่ใช่แค่การมองเห็น</p>
      <div style="background:#f0f7ff;border-radius:10px;padding:.75rem 1rem;margin-bottom:.75rem">
        <div style="font-weight:700;color:#1877f2;margin-bottom:.5rem">สูตรคะแนน</div>
        <div style="display:grid;grid-template-columns:auto 1fr;gap:.3rem .75rem;font-size:.85rem">
          <span style="color:#f7b928;font-weight:700">👍 ไลค์</span><span>× 1 (Reaction พื้นฐาน)</span>
          <span style="color:#f5533d;font-weight:700">💬 คอมเมนต์</span><span>× 2 (มีส่วนร่วมสูง)</span>
          <span style="color:#09af74;font-weight:700">🔁 แชร์</span><span>× 3 (เผยแพร่ไปยังคนใหม่)</span>
          <span style="color:#45bd62;font-weight:700">👁️ Reach</span><span>× 0.01 (การเข้าถึง)</span>
        </div>
      </div>
      <p style="font-size:.78rem;color:#8a8d91">แชร์ได้รับน้ำหนักสูงสุดเพราะนำโพสต์ออกนอกเครือข่ายผู้ติดตาม คอมเมนต์รองลงมาเพราะแสดงถึงการมีส่วนร่วมเชิงลึก</p>
    </div>`,
    confirmButtonText: 'รับทราบ', confirmButtonColor: '#1877f2', width: '430px',
  });
}

/* ── สรุปช่วงเวลา โพสเพจ (moved to /page-summary page) ── */
async function showPageRangeModal() {
  const _prIs = 'width:100%;padding:.38rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.85rem;font-family:inherit;color:#333;outline:none;box-sizing:border-box';
  const _prLs = 'font-size:.8rem;font-weight:600;color:#555;display:block;margin-bottom:.2rem';
  const prToday = new Date().toISOString().slice(0, 10);
  const { value: dates } = await Swal.fire({
    title: '<i class="fa-brands fa-facebook" style="color:#1877f2"></i> สถิติโพสเพจตามช่วงเวลา',
    html: `<div style="text-align:left;display:flex;flex-direction:column;gap:.55rem">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
        <div><label style="${_prLs}">วันที่เริ่ม</label>
          <input id="pr-from" type="date" lang="en-GB" style="${_prIs}"></div>
        <div><label style="${_prLs}">วันที่สิ้นสุด</label>
          <input id="pr-to" type="date" lang="en-GB" style="${_prIs}"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
        <div><label style="${_prLs}">เวลาเริ่ม (ไม่บังคับ)</label>
          <div class="dt24-wrap"><input type="number" id="pr-tfrom_h" min="0" max="23" placeholder="ชม."><span>:</span><input type="number" id="pr-tfrom_m" min="0" max="59" placeholder="นาที"></div></div>
        <div><label style="${_prLs}">เวลาสิ้นสุด (ไม่บังคับ)</label>
          <div class="dt24-wrap"><input type="number" id="pr-tto_h" min="0" max="23" placeholder="ชม."><span>:</span><input type="number" id="pr-tto_m" min="0" max="59" placeholder="นาที"></div></div>
      </div>
    </div>`,
    confirmButtonText: 'ดูสถิติ', confirmButtonColor: '#1877f2',
    showCancelButton: true, cancelButtonText: 'ยกเลิก', focusConfirm: false,
    didOpen: () => {
      const _bkk = () => new Date(new Date().toLocaleString('en-US', { timeZone:'Asia/Bangkok' }));
      const _fillTime = (hId, mId) => { const n=_bkk(); document.getElementById(hId).value=n.getHours(); document.getElementById(mId).value=n.getMinutes(); };
      document.getElementById('pr-from').addEventListener('change', e => { if(e.target.value===prToday) _fillTime('pr-tfrom_h','pr-tfrom_m'); });
      document.getElementById('pr-to').addEventListener('change',   e => { if(e.target.value===prToday) _fillTime('pr-tto_h','pr-tto_m'); });
    },
    preConfirm: () => {
      const from  = document.getElementById('pr-from').value;
      const to    = document.getElementById('pr-to').value;
      const tfrom = t24Get('pr-tfrom');
      const tto   = t24Get('pr-tto');
      if (from && to && from > to) { Swal.showValidationMessage('⚠️ วันที่เริ่มต้องไม่เกินวันที่สิ้นสุด'); return false; }
      if (from && to && from === to && tfrom && tto && tfrom > tto) { Swal.showValidationMessage('⚠️ เวลาเริ่มต้องไม่เกินเวลาสิ้นสุด'); return false; }
      return { from, to, tfrom, tto };
    },
  });
  if (!dates) return;
  Swal.fire({ title: 'กำลังโหลด...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
  try {
    const _prParams = new URLSearchParams();
    if (dates.from)  _prParams.set('from', dates.from);
    if (dates.to)    _prParams.set('to',   dates.to);
    if (dates.tfrom) _prParams.set('timeFrom', dates.tfrom);
    if (dates.tto)   _prParams.set('timeTo',   dates.tto);
    const data = await (await fetch('/api/stats/combined?' + _prParams)).json();
    if (!data.ok) throw new Error('API error');
    const p = data.pageStats;
    const label = (dates.from || dates.to)
      ? `ช่วง: ${dates.from ? _fmtDateTH(dates.from) : '—'} ถึง ${dates.to ? _fmtDateTH(dates.to) : '—'}${dates.tfrom ? ` เวลา ${dates.tfrom}${dates.tto ? '–'+dates.tto : ''}` : ''}`
      : 'ข้อมูลทั้งหมด';
    Swal.fire({
      title: `<i class="fa-brands fa-facebook" style="color:#1877f2"></i> โพสเพจ`,
      html: `<div style="text-align:left">
        <div style="font-size:.78rem;color:#8a8d91;margin-bottom:.6rem">${label}</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-bottom:.8rem">
          <div style="background:#e8f4fd;border-radius:8px;padding:.5rem .6rem;text-align:center">
            <div style="font-size:1.3rem;font-weight:700;color:#1877f2">${p.total}</div>
            <div style="font-size:.72rem;color:#555">โพสต์</div>
          </div>
          <div style="background:#e8fde8;border-radius:8px;padding:.5rem .6rem;text-align:center">
            <div style="font-size:1.3rem;font-weight:700;color:#2e7d32">${p.success}</div>
            <div style="font-size:.72rem;color:#555">สำเร็จ</div>
          </div>
          <div style="background:#fff5f5;border-radius:8px;padding:.5rem .6rem;text-align:center">
            <div style="font-size:1.3rem;font-weight:700;color:#c62828">${p.fail}</div>
            <div style="font-size:.72rem;color:#555">ล้มเหลว</div>
          </div>
        </div>
        <div style="font-size:.75rem;font-weight:700;color:#555;margin-bottom:.4rem"><i class="fa-solid fa-trophy" style="color:#f7b928"></i> 5 อันดับเพจ</div>
        ${_rankRowsHtml(data.topPages)}
      </div>`,
      confirmButtonText: 'ปิด', confirmButtonColor: '#1877f2', width: '440px',
    });
  } catch { Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: 'ไม่สามารถโหลดข้อมูลได้' }); }
}

/* ── สรุปช่วงเวลา แชร์กลุ่ม ── */
async function showGroupRangeModal() {
  const _grIs  = 'width:100%;padding:.38rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.85rem;font-family:inherit;color:#333;outline:none;box-sizing:border-box';
  const _grLs  = 'font-size:.8rem;font-weight:600;color:#555;display:block;margin-bottom:.2rem';
  const grToday = new Date().toISOString().slice(0, 10);
  const { value: dates } = await Swal.fire({
    title: '<i class="fa-solid fa-users" style="color:#2e7d32"></i> สถิติแชร์กลุ่มตามช่วงเวลา',
    html: `<div style="text-align:left;display:flex;flex-direction:column;gap:.55rem">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
        <div><label style="${_grLs}">วันที่เริ่ม</label>
          <input id="gr-from" type="date" lang="en-GB" style="${_grIs}"></div>
        <div><label style="${_grLs}">วันที่สิ้นสุด</label>
          <input id="gr-to" type="date" lang="en-GB" style="${_grIs}"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
        <div><label style="${_grLs}">เวลาเริ่ม (ไม่บังคับ)</label>
          <div class="dt24-wrap"><input type="number" id="gr-tfrom_h" min="0" max="23" placeholder="ชม."><span>:</span><input type="number" id="gr-tfrom_m" min="0" max="59" placeholder="นาที"></div></div>
        <div><label style="${_grLs}">เวลาสิ้นสุด (ไม่บังคับ)</label>
          <div class="dt24-wrap"><input type="number" id="gr-tto_h" min="0" max="23" placeholder="ชม."><span>:</span><input type="number" id="gr-tto_m" min="0" max="59" placeholder="นาที"></div></div>
      </div>
    </div>`,
    confirmButtonText: 'ดูสถิติ', confirmButtonColor: '#2e7d32',
    showCancelButton: true, cancelButtonText: 'ยกเลิก', focusConfirm: false,
    didOpen: () => {
      const _bkk = () => new Date(new Date().toLocaleString('en-US', { timeZone:'Asia/Bangkok' }));
      const _fillTime = (hId, mId) => { const n=_bkk(); document.getElementById(hId).value=n.getHours(); document.getElementById(mId).value=n.getMinutes(); };
      document.getElementById('gr-from').addEventListener('change', e => { if(e.target.value===grToday) _fillTime('gr-tfrom_h','gr-tfrom_m'); });
      document.getElementById('gr-to').addEventListener('change',   e => { if(e.target.value===grToday) _fillTime('gr-tto_h','gr-tto_m'); });
    },
    preConfirm: () => {
      const from  = document.getElementById('gr-from').value;
      const to    = document.getElementById('gr-to').value;
      const tfrom = t24Get('gr-tfrom');
      const tto   = t24Get('gr-tto');
      if (from && to && from > to) { Swal.showValidationMessage('⚠️ วันที่เริ่มต้องไม่เกินวันที่สิ้นสุด'); return false; }
      if (from && to && from === to && tfrom && tto && tfrom > tto) { Swal.showValidationMessage('⚠️ เวลาเริ่มต้องไม่เกินเวลาสิ้นสุด'); return false; }
      return { from, to, tfrom, tto };
    },
  });
  if (!dates) return;
  Swal.fire({ title: 'กำลังโหลด...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
  try {
    const _grParams = new URLSearchParams();
    if (dates.from)  _grParams.set('from', dates.from);
    if (dates.to)    _grParams.set('to',   dates.to);
    if (dates.tfrom) _grParams.set('timeFrom', dates.tfrom);
    if (dates.tto)   _grParams.set('timeTo',   dates.tto);
    const data = await (await fetch('/api/stats/combined?' + _grParams)).json();
    if (!data.ok) throw new Error('API error');
    const g = data.groupStats;
    const label = (dates.from || dates.to)
      ? `ช่วง: ${dates.from ? _fmtDateTH(dates.from) : '—'} ถึง ${dates.to ? _fmtDateTH(dates.to) : '—'}${dates.tfrom ? ` เวลา ${dates.tfrom}${dates.tto ? '–'+dates.tto : ''}` : ''}`
      : 'ข้อมูลทั้งหมด';
    Swal.fire({
      title: `<i class="fa-solid fa-users" style="color:#2e7d32"></i> แชร์ลงกลุ่ม`,
      html: `<div style="text-align:left">
        <div style="font-size:.78rem;color:#8a8d91;margin-bottom:.6rem">${label}</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-bottom:.8rem">
          <div style="background:#f0fdf4;border-radius:8px;padding:.5rem .6rem;text-align:center">
            <div style="font-size:1.3rem;font-weight:700;color:#2e7d32">${g.total}</div>
            <div style="font-size:.72rem;color:#555">งาน (Job)</div>
          </div>
          <div style="background:#e8fde8;border-radius:8px;padding:.5rem .6rem;text-align:center">
            <div style="font-size:1.3rem;font-weight:700;color:#059669">${g.success}</div>
            <div style="font-size:.72rem;color:#555">สำเร็จ</div>
          </div>
          <div style="background:#fff5f5;border-radius:8px;padding:.5rem .6rem;text-align:center">
            <div style="font-size:1.3rem;font-weight:700;color:#c62828">${g.fail}</div>
            <div style="font-size:.72rem;color:#555">ล้มเหลว</div>
          </div>
        </div>
        <div style="font-size:.75rem;font-weight:700;color:#555;margin-bottom:.4rem"><i class="fa-solid fa-ranking-star" style="color:#1877f2"></i> 5 อันดับกลุ่ม</div>
        ${_rankRowsHtml(data.topGroups)}
      </div>`,
      confirmButtonText: 'ปิด', confirmButtonColor: '#2e7d32', width: '440px',
    });
  } catch { Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: 'ไม่สามารถโหลดข้อมูลได้' }); }
}

/* ── Chart ── */
const ctx = document.getElementById('postsChart');
if (ctx) {
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: <%- chartLabels %>,
      datasets: [{
        label: 'จำนวนโพสต์',
        data: <%- chartData %>,
        backgroundColor: 'rgba(24,119,242,.7)',
        borderColor: '#1877f2',
        borderWidth: 1,
        borderRadius: 6,
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f0f2f5' } },
        x: { grid: { display: false } }
      }
    }
  });
}
</script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>(function(){var O={dateFormat:'Y-m-d',altInput:true,altFormat:'d/m/Y',allowInput:true,disableMobile:true};function I(e){if(e._flatpickr)return;flatpickr(e,O);var ai=e._flatpickr&&e._flatpickr.altInput;if(ai){var s=e.getAttribute('style');if(s)ai.style.cssText=s;ai.style.cursor='pointer';ai.placeholder=e.getAttribute('title')||e.getAttribute('placeholder')||'วว/ดด/ปปปป';}}document.querySelectorAll('input[type="date"]').forEach(I);new MutationObserver(function(m){m.forEach(function(r){r.addedNodes.forEach(function(n){if(n.nodeType!==1)return;if(n.matches&&n.matches('input[type="date"]'))I(n);n.querySelectorAll&&n.querySelectorAll('input[type="date"]').forEach(I)})})}).observe(document.body,{childList:true,subtree:true});})()</script>
</body>
