<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ภาพรวม - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <a href="/" class="btn-back"><i class="fa-solid fa-plus"></i> โพสต์ใหม่</a>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/overview" class="sidebar-item active"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
  </aside>

  <main class="feed">

    <!-- Page title -->
    <div class="card" style="padding:.8rem 1.25rem">
      <div class="card-title" style="font-size:1.05rem;display:flex;align-items:center;flex-wrap:wrap;gap:.5rem;justify-content:space-between">
        <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
          <i class="fa-solid fa-chart-line" style="color:#1877f2"></i>
          ภาพรวมทั้งหมด
          <span id="last-updated" style="font-size:.78rem;font-weight:400;color:#8a8d91;margin-left:.4rem">
            <i class="fa-solid fa-spinner fa-spin" style="font-size:.75rem"></i> กำลังอัปเดต...
          </span>
        </div>
        <button onclick="showSummaryModal()" style="background:#1877f2;color:#fff;border:none;border-radius:8px;padding:.35rem .85rem;font-size:.82rem;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:.4rem">
          <i class="fa-solid fa-calendar-day"></i> สรุป
        </button>
      </div>
    </div>

    <!-- Summary metric cards -->
    <div class="overview-grid">
      <div class="metric-card blue">
        <div class="metric-icon"><i class="fa-solid fa-paper-plane"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-posts"><%= totalPosts %></div>
          <div class="metric-label">โพสต์ทั้งหมด</div>
        </div>
      </div>
      <div class="metric-card green">
        <div class="metric-icon"><i class="fa-solid fa-circle-check"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-success"><%= totalSuccess %></div>
          <div class="metric-label">ส่งสำเร็จ</div>
        </div>
      </div>
      <div class="metric-card purple">
        <div class="metric-icon"><i class="fa-solid fa-thumbs-up"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-likes"><%= totalLikes.toLocaleString() %></div>
          <div class="metric-label">ไลค์ทั้งหมด</div>
        </div>
      </div>
      <div class="metric-card orange">
        <div class="metric-icon"><i class="fa-solid fa-comment"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-comments"><%= totalComments.toLocaleString() %></div>
          <div class="metric-label">ความคิดเห็น</div>
        </div>
      </div>
      <div class="metric-card teal">
        <div class="metric-icon"><i class="fa-solid fa-share-nodes"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-shares"><%= totalShares.toLocaleString() %></div>
          <div class="metric-label">แชร์</div>
        </div>
      </div>
      <div class="metric-card red">
        <div class="metric-icon"><i class="fa-solid fa-eye"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-reach"><%= totalReach.toLocaleString() %></div>
          <div class="metric-label">การเข้าถึง</div>
        </div>
      </div>
      <div class="metric-card green" style="border: 2px solid #2e7d32; background: #f0fff4;">
        <div class="metric-icon" style="background: #2e7d32;"><i class="fa-solid fa-chart-pie"></i></div>
        <div class="metric-body">
          <div class="metric-val" id="m-rate" style="color: #2e7d32;"><%= successRate %>%</div>
          <div class="metric-label">อัตราสำเร็จ</div>
        </div>
      </div>
    </div>

    <!-- สรุป: date + time filter + stats + top 5 -->
    <div class="card">
      <div class="card-title" style="margin-bottom:.85rem">
        <i class="fa-solid fa-chart-pie" style="color:#1877f2"></i> สรุปตามช่วงเวลา
        <span style="font-size:.78rem;font-weight:400;color:#8a8d91;margin-left:.4rem">โพสเพจ + แชร์กลุ่ม + 5 อันดับ</span>
      </div>

      <!-- Filter row -->
      <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:.55rem;margin-bottom:.9rem">
        <div>
          <div style="font-size:.72rem;color:#8a8d91;font-weight:600;margin-bottom:.25rem">วันที่เริ่ม</div>
          <input id="csFrom" type="date" style="padding:.38rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;color:#333;outline:none;cursor:pointer">
        </div>
        <div>
          <div style="font-size:.72rem;color:#8a8d91;font-weight:600;margin-bottom:.25rem">วันที่สิ้นสุด</div>
          <input id="csTo" type="date" style="padding:.38rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;color:#333;outline:none;cursor:pointer">
        </div>
        <button onclick="loadCombinedStats()" style="padding:.4rem 1rem;background:#1877f2;color:#fff;border:none;border-radius:8px;font-size:.83rem;font-family:inherit;cursor:pointer;display:flex;align-items:center;gap:.4rem;height:34px">
          <i class="fa-solid fa-magnifying-glass"></i> ดูสถิติ
        </button>
        <button onclick="clearCombinedStats()" style="padding:.4rem .7rem;background:#f0f2f5;border:none;border-radius:8px;font-size:.83rem;font-family:inherit;cursor:pointer;color:#666;height:34px">
          ✕ ล้าง
        </button>
        <span id="csLoading" style="font-size:.82rem;color:#8a8d91;display:none"><i class="fa-solid fa-spinner fa-spin"></i></span>
      </div>

      <div id="csResults" style="display:none">
        <!-- Stats row -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:.9rem">
          <div style="background:#f0f7ff;border:1.5px solid #d0e6fb;border-radius:10px;padding:.75rem 1rem">
            <div style="font-size:.78rem;font-weight:700;color:#1877f2;margin-bottom:.55rem">
              <i class="fa-brands fa-facebook"></i> โพสลงเพจ
            </div>
            <div style="display:flex;flex-direction:column;gap:.3rem">
              <div style="display:flex;justify-content:space-between;font-size:.85rem">
                <span style="color:#555">โพสทั้งหมด</span><span id="cs-page-total" style="font-weight:700;color:#1877f2">—</span>
              </div>
              <div style="display:flex;justify-content:space-between;font-size:.85rem">
                <span style="color:#555">สำเร็จ</span><span id="cs-page-success" style="font-weight:700;color:#2e7d32">—</span>
              </div>
              <div style="display:flex;justify-content:space-between;font-size:.85rem">
                <span style="color:#555">ล้มเหลว</span><span id="cs-page-fail" style="font-weight:700;color:#c62828">—</span>
              </div>
            </div>
          </div>
          <div style="background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:10px;padding:.75rem 1rem">
            <div style="font-size:.78rem;font-weight:700;color:#2e7d32;margin-bottom:.55rem">
              <i class="fa-solid fa-users"></i> แชร์ลงกลุ่ม
            </div>
            <div style="display:flex;flex-direction:column;gap:.3rem">
              <div style="display:flex;justify-content:space-between;font-size:.85rem">
                <span style="color:#555">งาน (Job)</span><span id="cs-grp-total" style="font-weight:700;color:#2e7d32">—</span>
              </div>
              <div style="display:flex;justify-content:space-between;font-size:.85rem">
                <span style="color:#555">โพสกลุ่มสำเร็จ</span><span id="cs-grp-success" style="font-weight:700;color:#2e7d32">—</span>
              </div>
              <div style="display:flex;justify-content:space-between;font-size:.85rem">
                <span style="color:#555">ล้มเหลว</span><span id="cs-grp-fail" style="font-weight:700;color:#c62828">—</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Top 5 rankings -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
          <!-- Top 5 pages -->
          <div style="border:1.5px solid #e4e6eb;border-radius:10px;padding:.7rem .9rem">
            <div style="font-size:.78rem;font-weight:700;color:#555;margin-bottom:.5rem">
              <i class="fa-solid fa-trophy" style="color:#f7b928"></i> 5 อันดับเพจ (โพสมากสุด)
            </div>
            <div id="cs-top-pages" style="display:flex;flex-direction:column;gap:.3rem">
              <div style="font-size:.8rem;color:#bbb;text-align:center;padding:.5rem 0">ไม่มีข้อมูล</div>
            </div>
          </div>
          <!-- Top 5 groups -->
          <div style="border:1.5px solid #e4e6eb;border-radius:10px;padding:.7rem .9rem">
            <div style="font-size:.78rem;font-weight:700;color:#555;margin-bottom:.5rem">
              <i class="fa-solid fa-ranking-star" style="color:#1877f2"></i> 5 อันดับกลุ่ม (แชร์มากสุด)
            </div>
            <div id="cs-top-groups" style="display:flex;flex-direction:column;gap:.3rem">
              <div style="font-size:.8rem;color:#bbb;text-align:center;padding:.5rem 0">ไม่มีข้อมูล</div>
            </div>
          </div>
        </div>
        <div id="csDateLabel" style="font-size:.76rem;color:#8a8d91;margin-top:.5rem;text-align:right"></div>
      </div>
    </div>

    <!-- Chart -->
    <div class="card">
      <div class="card-title" style="margin-bottom:1rem">
        <i class="fa-solid fa-chart-bar"></i> โพสต์ 7 วันที่ผ่านมา
      </div>
      <canvas id="postsChart" height="90"></canvas>
    </div>

    <!-- Per-page breakdown -->
    <% if (pageStats.length > 0) { %>
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.6rem;margin-bottom:1rem">
        <div class="card-title" style="margin-bottom:0">
          <i class="fa-solid fa-layer-group"></i> สถิติแต่ละเพจ
        </div>
        <div style="position:relative">
          <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:.6rem;top:50%;transform:translateY(-50%);color:#8a8d91;font-size:.8rem;pointer-events:none"></i>
          <input id="page-search" type="text" placeholder="ค้นหาชื่อเพจ..." oninput="filterPages(this.value)"
            style="padding:.35rem .7rem .35rem 1.9rem;border:1px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;width:180px;outline:none;color:#333">
        </div>
      </div>
      <div class="overview-table-wrap">
        <table class="overview-table">
          <thead>
            <tr>
              <th>เพจ</th>
              <th><i class="fa-solid fa-paper-plane"></i> โพสต์</th>
              <th><i class="fa-solid fa-thumbs-up"></i> ไลค์</th>
              <th><i class="fa-solid fa-comment"></i> คอมเมนต์</th>
              <th><i class="fa-solid fa-share-nodes"></i> แชร์</th>
              <th><i class="fa-solid fa-eye"></i> Reach</th>
              <th>อัตราสำเร็จ</th>
            </tr>
          </thead>
          <tbody id="pages-tbody">
            <% pageStats.forEach((p, i) => { %>
            <% const rate = p.posts > 0 ? Math.round(p.success/p.posts*100) : 0; %>
            <% const colors = ['purple','green','orange','blue','red']; %>
            <tr class="page-row" data-name="<%= p.pageName.toLowerCase() %>" data-index="<%= i %>">
              <td>
                <div style="display:flex;align-items:center;gap:.5rem">
                  <div class="avatar avatar-<%= colors[i%5] %> avatar-sm"><%= p.pageName.slice(-1) %></div>
                  <span style="font-weight:600"><%= p.pageName %></span>
                </div>
              </td>
              <td class="num"><%= p.posts %></td>
              <td class="num blue-text"><%= p.likes.toLocaleString() %></td>
              <td class="num orange-text"><%= p.comments.toLocaleString() %></td>
              <td class="num teal-text"><%= p.shares.toLocaleString() %></td>
              <td class="num purple-text"><%= p.reach.toLocaleString() %></td>
              <td>
                <div class="rate-bar-wrap">
                  <div class="rate-bar" style="width:<%= rate %>%"></div>
                  <span class="rate-text"><%= rate %>%</span>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div id="show-more-wrap" style="text-align:center;margin-top:.75rem;display:none">
        <button onclick="showAllPages()" style="background:none;border:1px solid #1877f2;color:#1877f2;border-radius:8px;padding:.35rem 1.1rem;font-size:.82rem;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-chevron-down"></i> ดูเพิ่มเติม
        </button>
      </div>
    </div>
    <% } %>

    <!-- Group share overview (item 5) -->
    <div class="card" id="grpOverviewCard">
      <div class="card-title" style="margin-bottom:.85rem">
        <i class="fa-solid fa-users-rectangle" style="color:#2e7d32"></i> ภาพรวมแชร์กลุ่ม
        <span style="font-size:.78rem;font-weight:400;color:#8a8d91;margin-left:.4rem">ข้อมูลจาก Desktop Agent</span>
      </div>
      <div id="grpOverviewBody">
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem;margin-bottom:.85rem">
          <div style="background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:10px;padding:.7rem .9rem;text-align:center">
            <div id="go-jobs" style="font-size:1.5rem;font-weight:700;color:#2e7d32">—</div>
            <div style="font-size:.75rem;color:#555;margin-top:.15rem">งานทั้งหมด</div>
          </div>
          <div style="background:#e8fde8;border:1.5px solid #a7f3d0;border-radius:10px;padding:.7rem .9rem;text-align:center">
            <div id="go-success" style="font-size:1.5rem;font-weight:700;color:#059669">—</div>
            <div style="font-size:.75rem;color:#555;margin-top:.15rem">โพสกลุ่มสำเร็จ</div>
          </div>
          <div style="background:#fff5f5;border:1.5px solid #fecaca;border-radius:10px;padding:.7rem .9rem;text-align:center">
            <div id="go-fail" style="font-size:1.5rem;font-weight:700;color:#c62828">—</div>
            <div style="font-size:.75rem;color:#555;margin-top:.15rem">ล้มเหลว</div>
          </div>
        </div>
        <div id="go-top-groups" style="display:flex;flex-direction:column;gap:.3rem">
          <div style="font-size:.8rem;color:#bbb;text-align:center;padding:.5rem 0">
            <i class="fa-solid fa-spinner fa-spin"></i> กำลังโหลด...
          </div>
        </div>
      </div>
    </div>

    <!-- Recent posts with analytics -->
    <% if (recentPosts.length > 0) { %>
    <div class="card">
      <div class="card-title" style="margin-bottom:1rem">
        <i class="fa-solid fa-clock-rotate-left"></i> โพสต์ล่าสุด
      </div>
      <% recentPosts.forEach(post => { %>
      <div class="overview-post-row">
        <div class="overview-post-msg">
          <a href="/result/<%= post.id %>" style="color:#1877f2;text-decoration:none;font-weight:600;font-size:.88rem">
            <%= post.message.length > 80 ? post.message.slice(0,80)+'…' : post.message %>
          </a>
          <div style="font-size:.75rem;color:#8a8d91;margin-top:.2rem">
            <i class="fa-regular fa-clock"></i> <%= new Date(post.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
            &nbsp;·&nbsp; <%= post.results.length %> เพจ
          </div>
        </div>
        <div class="overview-post-stats">
          <%
            const totLikes    = post.results.reduce((s,r) => s + (r.analytics?.likes    || 0), 0);
            const totComments = post.results.reduce((s,r) => s + (r.analytics?.comments || 0), 0);
            const totReach    = post.results.reduce((s,r) => s + (r.analytics?.reach    || 0), 0);
          %>
          <span><i class="fa-solid fa-thumbs-up" style="color:#f7b928"></i> <%= totLikes %></span>
          <span><i class="fa-solid fa-comment" style="color:#f5533d"></i> <%= totComments %></span>
          <span><i class="fa-solid fa-eye" style="color:#45bd62"></i> <%= totReach %></span>
          <span class="pill pill-<%= post.failCount===0?'success':'fail' %>" style="font-size:.72rem;padding:.15rem .5rem">
            <%= post.successCount %>/<%= post.results.length %>
          </span>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>

    <% if (totalPosts === 0) { %>
    <div class="card empty-state">
      <i class="fa-solid fa-chart-line"></i>
      <h3>ยังไม่มีข้อมูล</h3>
      <p>เริ่มโพสต์แล้วดูสถิติที่นี่ได้เลย</p>
      <a href="/" class="btn-post" style="text-decoration:none;margin-top:1rem">
        <i class="fa-solid fa-paper-plane"></i> เริ่มโพสต์
      </a>
    </div>
    <% } %>

  </main>

  <aside class="right-panel">
    <div class="card stats-card">
      <div class="stats-title"><i class="fa-solid fa-trophy" style="color:#f7b928"></i> Top เพจ</div>
      <% const sorted = [...pageStats].sort((a,b) => b.reach - a.reach).slice(0,3); %>
      <% if (sorted.length === 0) { %>
        <p style="font-size:.82rem;color:#8a8d91;margin-top:.4rem">ยังไม่มีข้อมูล</p>
      <% } %>
      <% sorted.forEach((p, i) => { %>
      <div class="stats-row">
        <div style="display:flex;align-items:center;gap:.4rem">
          <span style="font-size:.85rem"><%= ['🥇','🥈','🥉'][i] %></span>
          <span style="font-size:.85rem"><%= p.pageName %></span>
        </div>
        <span class="stats-val purple-text" style="font-size:.82rem"><%= p.reach.toLocaleString() %></span>
      </div>
      <% }); %>
    </div>
  </aside>

</div>

<script>
/* ── Auto-refresh (no button needed) ── */
const POLL_MS = 60 * 1000; // poll ทุก 1 นาที

function setLastUpdated() {
  const now = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
  const el  = document.getElementById('last-updated');
  if (el) el.innerHTML = `· อัปเดต ${now}`;
}

async function updateNumbers() {
  const res  = await fetch('/api/stats');
  const data = await res.json();
  const set  = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
  set('m-posts',     data.totalPosts);
  set('m-success',   data.totalSuccess);
  set('m-likes',     data.totalLikes.toLocaleString());
  set('m-comments',  data.totalComments.toLocaleString());
  set('m-shares', data.totalShares.toLocaleString());
  set('m-reach',  data.totalReach.toLocaleString());
  set('m-rate',   data.successRate + '%');
}

// Auto-refresh จาก Facebook ทุกครั้งที่โหลดหน้า
(async function autoRefreshOnLoad() {
  try {
    await fetch('/api/refresh-analytics', { method: 'POST' });
    await updateNumbers();
    setLastUpdated();
  } catch {
    setLastUpdated();
  }
})();

// Poll ทุก 5 นาทีเพื่ออัปเดตตัวเลขล่าสุด
setInterval(async () => {
  try { await updateNumbers(); setLastUpdated(); } catch {}
}, POLL_MS);

/* ── สรุป Popup ── */
async function showSummaryModal() {
  const today = new Date().toISOString().slice(0, 10);

  const { value: formValues } = await Swal.fire({
    title: '<i class="fa-solid fa-chart-pie" style="color:#1877f2"></i> สรุป',
    html: `
      <div style="text-align:left;display:flex;flex-direction:column;gap:.6rem">
        <div>
          <label style="font-size:.8rem;font-weight:600;color:#555;display:block;margin-bottom:.2rem">วันที่ <span style="color:#c62828">*</span></label>
          <input id="sm-date" type="date" value="${today}"
            style="width:100%;padding:.38rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.85rem;font-family:inherit;color:#333;outline:none;box-sizing:border-box">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
          <div>
            <label style="font-size:.8rem;font-weight:600;color:#555;display:block;margin-bottom:.2rem">เวลาเริ่ม (ไม่บังคับ)</label>
            <input id="sm-tfrom" type="time"
              style="width:100%;padding:.38rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.85rem;font-family:inherit;color:#333;outline:none;box-sizing:border-box">
          </div>
          <div>
            <label style="font-size:.8rem;font-weight:600;color:#555;display:block;margin-bottom:.2rem">เวลาสิ้นสุด (ไม่บังคับ)</label>
            <input id="sm-tto" type="time"
              style="width:100%;padding:.38rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.85rem;font-family:inherit;color:#333;outline:none;box-sizing:border-box">
          </div>
        </div>
        <div style="font-size:.75rem;color:#8a8d91"><i class="fa-solid fa-circle-info"></i> ถ้ากรอกเวลาต้องกรอกวันที่ด้วย</div>
      </div>`,
    confirmButtonText: 'ดูสรุป',
    confirmButtonColor: '#1877f2',
    showCancelButton: true,
    cancelButtonText: 'ยกเลิก',
    focusConfirm: false,
    preConfirm: () => {
      const date  = document.getElementById('sm-date').value;
      const tfrom = document.getElementById('sm-tfrom').value;
      const tto   = document.getElementById('sm-tto').value;
      if (!date) { Swal.showValidationMessage('กรุณากรอกวันที่'); return false; }
      if ((tfrom || tto) && !date) { Swal.showValidationMessage('กรุณากรอกวันที่ก่อนกรอกเวลา'); return false; }
      return { date, tfrom, tto };
    },
  });
  if (!formValues) return;

  const { date, tfrom, tto } = formValues;
  Swal.fire({ title: 'กำลังโหลด...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

  try {
    const params = new URLSearchParams({ date });
    if (tfrom) params.set('timeFrom', tfrom);
    if (tto)   params.set('timeTo',   tto);
    const res = await fetch(`/api/daily-summary?${params}`);
    const d   = await res.json();

    const dateLabel = new Date(date + 'T00:00:00').toLocaleDateString('th-TH', { year:'numeric', month:'long', day:'numeric' });
    const timeLabel = tfrom ? ` เวลา ${tfrom}${tto ? '–'+tto : ''}` : '';

    const grp = d.groupStats || { total: 0, success: 0, fail: 0 };

    Swal.fire({
      title: `สรุป ${dateLabel}${timeLabel}`,
      html: `
        <div style="text-align:left">
          <div style="font-size:.75rem;font-weight:700;color:#1877f2;margin-bottom:.4rem"><i class="fa-brands fa-facebook"></i> โพสลงเพจ</div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-bottom:.8rem">
            <div style="background:#e8f4fd;border-radius:8px;padding:.5rem .6rem;text-align:center">
              <div style="font-size:1.3rem;font-weight:700;color:#1877f2">${d.totalPosts}</div>
              <div style="font-size:.72rem;color:#555">โพสต์</div>
            </div>
            <div style="background:#e8fde8;border-radius:8px;padding:.5rem .6rem;text-align:center">
              <div style="font-size:1.3rem;font-weight:700;color:#2e7d32">${d.successRate}%</div>
              <div style="font-size:.72rem;color:#555">สำเร็จ</div>
            </div>
            <div style="background:#fff8e6;border-radius:8px;padding:.5rem .6rem;text-align:center">
              <div style="font-size:1.3rem;font-weight:700;color:#f7b928">${d.totalLikes}</div>
              <div style="font-size:.72rem;color:#555">ไลค์</div>
            </div>
            <div style="background:#fff0ed;border-radius:8px;padding:.5rem .6rem;text-align:center">
              <div style="font-size:1.3rem;font-weight:700;color:#f5533d">${d.totalComments}</div>
              <div style="font-size:.72rem;color:#555">คอมเมนต์</div>
            </div>
            <div style="background:#e8faf4;border-radius:8px;padding:.5rem .6rem;text-align:center">
              <div style="font-size:1.3rem;font-weight:700;color:#09af74">${d.totalShares}</div>
              <div style="font-size:.72rem;color:#555">แชร์</div>
            </div>
            <div style="background:#f0edff;border-radius:8px;padding:.5rem .6rem;text-align:center">
              <div style="font-size:1.3rem;font-weight:700;color:#7c3aed">${d.totalReach.toLocaleString()}</div>
              <div style="font-size:.72rem;color:#555">Reach</div>
            </div>
          </div>
          <div style="font-size:.75rem;font-weight:700;color:#2e7d32;margin-bottom:.4rem"><i class="fa-solid fa-users"></i> แชร์ลงกลุ่ม</div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem">
            <div style="background:#f0fdf4;border-radius:8px;padding:.5rem .6rem;text-align:center">
              <div style="font-size:1.3rem;font-weight:700;color:#2e7d32">${grp.total}</div>
              <div style="font-size:.72rem;color:#555">งาน (Job)</div>
            </div>
            <div style="background:#e8fde8;border-radius:8px;padding:.5rem .6rem;text-align:center">
              <div style="font-size:1.3rem;font-weight:700;color:#059669">${grp.success}</div>
              <div style="font-size:.72rem;color:#555">สำเร็จ</div>
            </div>
            <div style="background:#fff5f5;border-radius:8px;padding:.5rem .6rem;text-align:center">
              <div style="font-size:1.3rem;font-weight:700;color:#c62828">${grp.fail}</div>
              <div style="font-size:.72rem;color:#555">ล้มเหลว</div>
            </div>
          </div>
        </div>`,
      confirmButtonText: 'ปิด',
      confirmButtonColor: '#1877f2',
      width: '480px',
    });
  } catch {
    Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: 'ไม่สามารถโหลดข้อมูลได้' });
  }
}

/* ── Page table: search + show-more ── */
const PAGE_LIMIT = 8;
let showingAll = false;

function applyPageVisibility(query) {
  const rows = document.querySelectorAll('.page-row');
  let visible = 0;
  rows.forEach(row => {
    const match = !query || row.dataset.name.includes(query.toLowerCase());
    const withinLimit = showingAll || parseInt(row.dataset.index) < PAGE_LIMIT;
    row.style.display = match && withinLimit ? '' : 'none';
    if (match) visible++;
  });
  const wrap = document.getElementById('show-more-wrap');
  if (wrap) wrap.style.display = (!showingAll && !query && rows.length > PAGE_LIMIT) ? '' : 'none';
}

function filterPages(q) {
  showingAll = !!q; // เมื่อค้นหา ให้แสดงทุกแถว
  applyPageVisibility(q);
}

function showAllPages() {
  showingAll = true;
  const q = document.getElementById('page-search')?.value || '';
  applyPageVisibility(q);
}

applyPageVisibility('');

/* ── Combined stats + top 5 rankings ── */
const RANK_MEDALS = ['🥇','🥈','🥉','4️⃣','5️⃣'];
function renderRankList(containerId, items, nameKey, countFn, colorClass) {
  const el = document.getElementById(containerId);
  if (!el) return;
  if (!items || !items.length) {
    el.innerHTML = '<div style="font-size:.8rem;color:#bbb;text-align:center;padding:.5rem 0">ไม่มีข้อมูล</div>';
    return;
  }
  el.innerHTML = items.map((item, i) => {
    const total = (item.success || 0) + (item.fail || 0);
    const rate  = total > 0 ? Math.round(item.success / total * 100) : 0;
    return `<div style="display:flex;align-items:center;justify-content:space-between;font-size:.82rem;padding:.2rem 0;border-bottom:1px solid #f0f2f5">
      <span>${RANK_MEDALS[i]} ${item[nameKey] || '—'}</span>
      <span style="display:flex;gap:.5rem;align-items:center">
        <span style="font-weight:700;color:#2e7d32">${item.success}</span>
        <span style="color:#bbb">/</span>
        <span style="color:#555">${total}</span>
        <span style="font-size:.73rem;background:#e8fde8;color:#2e7d32;border-radius:5px;padding:.05rem .35rem">${rate}%</span>
      </span>
    </div>`;
  }).join('');
}

async function loadCombinedStats() {
  const from = document.getElementById('csFrom')?.value || '';
  const to   = document.getElementById('csTo')?.value   || '';
  const loading = document.getElementById('csLoading');
  const results = document.getElementById('csResults');
  if (loading) loading.style.display = '';
  try {
    const params = new URLSearchParams();
    if (from) params.set('from', from);
    if (to)   params.set('to',   to);
    const res  = await fetch('/api/stats/combined?' + params);
    const data = await res.json();
    if (!data.ok) return;
    document.getElementById('cs-page-total').textContent   = data.pageStats.total;
    document.getElementById('cs-page-success').textContent = data.pageStats.success;
    document.getElementById('cs-page-fail').textContent    = data.pageStats.fail;
    document.getElementById('cs-grp-total').textContent    = data.groupStats.total;
    document.getElementById('cs-grp-success').textContent  = data.groupStats.success;
    document.getElementById('cs-grp-fail').textContent     = data.groupStats.fail;
    renderRankList('cs-top-pages',  data.topPages  || [], 'name', i => i.success + i.fail);
    renderRankList('cs-top-groups', data.topGroups || [], 'name', i => i.success + i.fail);
    const lbl = document.getElementById('csDateLabel');
    if (lbl) {
      const fmt = d => new Date(d + 'T00:00:00').toLocaleDateString('th-TH', { dateStyle:'short' });
      lbl.textContent = from || to ? `ช่วง: ${from ? fmt(from) : '—'} ถึง ${to ? fmt(to) : '—'}` : 'ข้อมูลทั้งหมด';
    }
    if (results) results.style.display = '';
  } catch(e) { alert('โหลดสถิติไม่สำเร็จ: ' + e.message); }
  finally { if (loading) loading.style.display = 'none'; }
}

function clearCombinedStats() {
  const f = document.getElementById('csFrom'); if (f) f.value = '';
  const t = document.getElementById('csTo');   if (t) t.value = '';
  const r = document.getElementById('csResults'); if (r) r.style.display = 'none';
}

/* ── Group overview (load on page load) ── */
async function loadGroupOverview() {
  try {
    const res  = await fetch('/api/stats/combined');
    const data = await res.json();
    if (!data.ok) return;
    const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    set('go-jobs',    data.groupStats.total);
    set('go-success', data.groupStats.success);
    set('go-fail',    data.groupStats.fail);
    renderRankList('go-top-groups', (data.topGroups || []).slice(0,5), 'name', i => i.success + i.fail);
  } catch {}
}
loadGroupOverview();

/* ── Chart ── */
const ctx = document.getElementById('postsChart');
if (ctx) {
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: <%- chartLabels %>,
      datasets: [{
        label: 'จำนวนโพสต์',
        data: <%- chartData %>,
        backgroundColor: 'rgba(24,119,242,.7)',
        borderColor: '#1877f2',
        borderWidth: 1,
        borderRadius: 6,
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f0f2f5' } },
        x: { grid: { display: false } }
      }
    }
  });
}
</script>
</body>
</html>
