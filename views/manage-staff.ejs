<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>จัดการบัญชีผู้ใช้งาน - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/auth-guard.js"></script>
  <script src="/js/navbar-user.js"></script>
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <% if (locals.currentStaff) { %>
      <div class="navbar-user">
        <div class="avatar avatar-blue avatar-xs"><%= currentStaff.name.charAt(0).toUpperCase() %></div>
        <span class="navbar-user-name"><%= currentStaff.name %></span>
        <i class="fa-solid fa-chevron-down navbar-user-caret"></i>
        <div class="navbar-user-menu">
          <form method="POST" action="/logout">
            <button type="submit" class="navbar-user-menu-item"><i class="fa-solid fa-right-from-bracket"></i> ออกจากระบบ</button>
          </form>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">ระบบ</div>
    <a href="/user-activity" class="sidebar-item"><i class="fa-solid fa-user-clock"></i><span>กิจกรรมพนักงาน</span></a>
    <% if (locals.currentStaff && currentStaff.canManageStaff) { %>
    <a href="/manage-staff" class="sidebar-item active"><i class="fa-solid fa-users-gear"></i><span>จัดการบัญชีผู้ใช้งาน</span></a>
    <a href="/audit-log" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติการเปลี่ยนแปลง</span></a>
    <% } %>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <div class="card" style="padding:.8rem 1.25rem">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.6rem">
        <div class="card-title" style="margin-bottom:0;font-size:1.05rem">
          <i class="fa-solid fa-users-gear"></i> จัดการบัญชีผู้ใช้งาน
          <span style="background:#e4e6ea;padding:.12rem .5rem;border-radius:999px;font-size:.78rem;font-weight:400;margin-left:.35rem">ผู้ใช้งานทั้งหมด <%= staffList.length %> บัญชี</span>
        </div>
        <div style="display:flex;gap:.5rem">
          <a href="/audit-log" style="display:inline-flex;align-items:center;gap:.4rem;background:#f0f2f5;color:#1c1e21;padding:.45rem .9rem;border-radius:8px;font-size:.86rem;font-weight:600;text-decoration:none">
            <i class="fa-solid fa-clock-rotate-left"></i> ประวัติการเปลี่ยนแปลง
          </a>
          <button class="btn-post" onclick="openAddStaff()" style="padding:.45rem 1rem;font-size:.86rem">
            <i class="fa-solid fa-user-plus"></i> เพิ่มบัญชีผู้ใช้งาน
          </button>
        </div>
      </div>
      <% if (staffList.length > 0) { %>
      <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.7rem">
        <div style="position:relative">
          <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:.6rem;top:50%;transform:translateY(-50%);color:#8a8d91;font-size:.8rem;pointer-events:none"></i>
          <input id="staffSearch" type="text" placeholder="ค้นหาชื่อ/username..." oninput="applyStaffFilter()"
            style="padding:.35rem .7rem .35rem 1.9rem;border:1px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;width:200px;outline:none;color:#333">
        </div>
        <select id="staffSort" onchange="applyStaffSort()"
          style="padding:.35rem .6rem;border:1px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#333;outline:none;cursor:pointer">
          <option value="name">เรียงตาม: ชื่อ (A-Z, ก-ฮ)</option>
          <option value="role">เรียงตาม: สิทธิ์ (แอดมินก่อน)</option>
        </select>
      </div>
      <% } %>
    </div>

    <div id="staffEmptyFiltered" class="card empty-state" style="display:none">
      <i class="fa-solid fa-magnifying-glass"></i>
      <h3>ไม่พบผู้ใช้งานที่ค้นหา</h3>
    </div>

    <div class="card">
      <% if (staffList.length === 0) { %>
      <div class="empty-state">
        <i class="fa-solid fa-users-gear"></i>
        <h3>ยังไม่มีบัญชีผู้ใช้งาน</h3>
        <p>เพิ่มบัญชีผู้ใช้งานแรกเพื่อเริ่มใช้งานระบบ</p>
      </div>
      <% } else { %>
      <div id="staffList">
      <% const colors = ['blue','green','orange','purple','red']; %>
      <% staffList.forEach((s, i) => { %>
      <div class="staff-row" data-name="<%= s.displayName.toLowerCase() %>" data-username="<%= s.username.toLowerCase() %>" data-role="<%= s.role === 'admin' ? 'admin' : 'staff' %>">
        <div class="avatar avatar-<%= colors[i%5] %>" style="width:38px;height:38px"><%= s.displayName.charAt(0).toUpperCase() %></div>
        <div style="flex:1;min-width:0">
          <div class="staff-row-name"><%= s.displayName %></div>
          <div class="staff-row-role">@<%= s.username %></div>
        </div>
        <select class="role-select" data-id="<%= s._id %>" data-name="<%= s.displayName %>" title="สิทธิ์การใช้งาน">
          <option value="staff" <%= s.role === 'admin' ? '' : 'selected' %>>พนักงาน</option>
          <option value="admin" <%= s.role === 'admin' ? 'selected' : '' %>>แอดมิน</option>
        </select>
        <div class="staff-row-actions">
          <a href="/user-activity/<%= s._id %>" class="btn-view-activity"><i class="fa-solid fa-chart-bar"></i> ดูกิจกรรม</a>
          <button class="btn-edit-staff icon-btn" data-id="<%= s._id %>" data-name="<%= s.displayName %>" data-username="<%= s.username %>" title="แก้ไขชื่อ/username">
            <i class="fa-solid fa-pen"></i>
          </button>
          <button class="btn-change-password icon-btn" data-id="<%= s._id %>" data-name="<%= s.displayName %>" title="เปลี่ยนรหัสผ่าน">
            <i class="fa-solid fa-key"></i>
          </button>
          <button class="btn-delete-staff icon-btn danger" data-id="<%= s._id %>" data-name="<%= s.displayName %>" title="ลบบัญชีผู้ใช้งาน">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>
      <% }); %>
      </div>
      <% } %>
    </div>

    <% if (locals.deletedStaffList && deletedStaffList.length > 0) { %>
    <div class="card">
      <div class="card-title" style="font-size:.95rem;color:#8a8d91">
        <i class="fa-solid fa-trash-can"></i> บัญชีที่ถูกลบ
        <span style="background:#e4e6ea;padding:.12rem .5rem;border-radius:999px;font-size:.78rem;font-weight:400;margin-left:.35rem"><%= deletedStaffList.length %> บัญชี</span>
      </div>
      <div style="margin-top:.5rem">
      <% deletedStaffList.forEach((s) => { %>
      <div class="staff-row" style="opacity:.7">
        <div class="avatar" style="width:38px;height:38px;background:#8a8d91"><%= s.displayName.charAt(0).toUpperCase() %></div>
        <div style="flex:1;min-width:0">
          <div class="staff-row-name"><%= s.displayName %></div>
          <div class="staff-row-role">@<%= s.username %> · ลบเมื่อ <%= new Date(s.deletedAt).toLocaleString('th-TH', { timeZone:'Asia/Bangkok', dateStyle:'short', timeStyle:'short' }) %></div>
        </div>
        <div class="staff-row-actions">
          <a href="/user-activity/<%= s._id %>" class="btn-view-activity"><i class="fa-solid fa-chart-bar"></i> ดูกิจกรรม</a>
          <button class="btn-restore-staff icon-btn" data-id="<%= s._id %>" data-name="<%= s.displayName %>" title="กู้คืนบัญชี" style="color:#2e7d32">
            <i class="fa-solid fa-rotate-left"></i>
          </button>
        </div>
      </div>
      <% }); %>
      </div>
    </div>
    <% } %>

  </main>

</div>

<!-- Add staff modal -->
<div id="addStaffModal" class="map-modal-overlay" style="display:none">
  <div class="map-modal-box" style="width:380px;max-width:92vw;padding:1.25rem">
    <div style="font-weight:700;font-size:1rem;margin-bottom:1rem"><i class="fa-solid fa-user-plus" style="color:#1877f2"></i> เพิ่มบัญชีผู้ใช้งานใหม่</div>
    <div style="margin-bottom:.7rem">
      <label style="font-size:.78rem;color:#65676b;display:block;margin-bottom:.25rem">ชื่อที่แสดง</label>
      <input id="newStaffDisplayName" type="text" placeholder="เช่น สมชาย" style="width:100%;padding:.5rem .7rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:inherit;font-size:.86rem;outline:none;box-sizing:border-box">
    </div>
    <div style="margin-bottom:.7rem">
      <label style="font-size:.78rem;color:#65676b;display:block;margin-bottom:.25rem">ชื่อผู้ใช้ (username)</label>
      <input id="newStaffUsername" type="text" placeholder="username" style="width:100%;padding:.5rem .7rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:inherit;font-size:.86rem;outline:none;box-sizing:border-box">
    </div>
    <div style="margin-bottom:1rem">
      <label style="font-size:.78rem;color:#65676b;display:block;margin-bottom:.25rem">รหัสผ่าน</label>
      <input id="newStaffPassword" type="password" placeholder="••••••••" style="width:100%;padding:.5rem .7rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:inherit;font-size:.86rem;outline:none;box-sizing:border-box">
    </div>
    <div style="margin-bottom:1rem">
      <label style="font-size:.78rem;color:#65676b;display:block;margin-bottom:.25rem">สิทธิ์การใช้งาน</label>
      <select id="newStaffRole" style="width:100%;padding:.5rem .7rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:inherit;font-size:.86rem;outline:none;box-sizing:border-box">
        <option value="staff" selected>พนักงาน</option>
        <option value="admin">แอดมิน</option>
      </select>
    </div>
    <div style="display:flex;gap:.5rem;justify-content:flex-end">
      <button onclick="closeAddStaff()" style="background:#f0f2f5;border:none;border-radius:8px;padding:.5rem 1rem;font-size:.84rem;cursor:pointer;font-family:inherit">ยกเลิก</button>
      <button onclick="submitAddStaff()" style="background:#1877f2;color:#fff;border:none;border-radius:8px;padding:.5rem 1rem;font-size:.84rem;cursor:pointer;font-family:inherit;font-weight:700">เพิ่ม</button>
    </div>
  </div>
</div>

<!-- Change password modal -->
<div id="changePasswordModal" class="map-modal-overlay" style="display:none">
  <div class="map-modal-box" style="width:380px;max-width:92vw;padding:1.25rem">
    <div style="font-weight:700;font-size:1rem;margin-bottom:1rem"><i class="fa-solid fa-key" style="color:#1877f2"></i> เปลี่ยนรหัสผ่าน — <span id="cpStaffName"></span></div>
    <div style="margin-bottom:1rem">
      <label style="font-size:.78rem;color:#65676b;display:block;margin-bottom:.25rem">รหัสผ่านใหม่</label>
      <input id="cpNewPassword" type="password" placeholder="••••••••" style="width:100%;padding:.5rem .7rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:inherit;font-size:.86rem;outline:none;box-sizing:border-box">
    </div>
    <div style="display:flex;gap:.5rem;justify-content:flex-end">
      <button onclick="closeChangePassword()" style="background:#f0f2f5;border:none;border-radius:8px;padding:.5rem 1rem;font-size:.84rem;cursor:pointer;font-family:inherit">ยกเลิก</button>
      <button onclick="submitChangePassword()" style="background:#1877f2;color:#fff;border:none;border-radius:8px;padding:.5rem 1rem;font-size:.84rem;cursor:pointer;font-family:inherit;font-weight:700">บันทึก</button>
    </div>
  </div>
</div>

<!-- Edit staff modal -->
<div id="editStaffModal" class="map-modal-overlay" style="display:none">
  <div class="map-modal-box" style="width:380px;max-width:92vw;padding:1.25rem">
    <div style="font-weight:700;font-size:1rem;margin-bottom:1rem"><i class="fa-solid fa-pen" style="color:#1877f2"></i> แก้ไขบัญชีผู้ใช้งาน</div>
    <div style="margin-bottom:.7rem">
      <label style="font-size:.78rem;color:#65676b;display:block;margin-bottom:.25rem">ชื่อที่แสดง</label>
      <input id="editStaffDisplayName" type="text" placeholder="เช่น สมชาย" style="width:100%;padding:.5rem .7rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:inherit;font-size:.86rem;outline:none;box-sizing:border-box">
    </div>
    <div style="margin-bottom:1rem">
      <label style="font-size:.78rem;color:#65676b;display:block;margin-bottom:.25rem">ชื่อผู้ใช้ (username)</label>
      <input id="editStaffUsername" type="text" placeholder="username" style="width:100%;padding:.5rem .7rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:inherit;font-size:.86rem;outline:none;box-sizing:border-box">
    </div>
    <div style="display:flex;gap:.5rem;justify-content:flex-end">
      <button onclick="closeEditStaff()" style="background:#f0f2f5;border:none;border-radius:8px;padding:.5rem 1rem;font-size:.84rem;cursor:pointer;font-family:inherit">ยกเลิก</button>
      <button onclick="submitEditStaff()" style="background:#1877f2;color:#fff;border:none;border-radius:8px;padding:.5rem 1rem;font-size:.84rem;cursor:pointer;font-family:inherit;font-weight:700">บันทึก</button>
    </div>
  </div>
</div>

<script>
  function openAddStaff() { document.getElementById('addStaffModal').style.display = 'flex'; }
  function closeAddStaff() { document.getElementById('addStaffModal').style.display = 'none'; }

  function applyStaffFilter() {
    const el = document.getElementById('staffSearch');
    const q = el ? el.value.toLowerCase().trim() : '';
    const rows = [...document.querySelectorAll('#staffList .staff-row')];
    let visible = 0;
    rows.forEach(r => {
      const match = r.dataset.name.includes(q) || r.dataset.username.includes(q);
      r.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    const empty = document.getElementById('staffEmptyFiltered');
    if (empty) empty.style.display = visible === 0 ? '' : 'none';
  }

  function applyStaffSort() {
    const list = document.getElementById('staffList');
    const sel = document.getElementById('staffSort');
    if (!list || !sel) return;
    const rows = [...list.querySelectorAll('.staff-row')];
    rows.sort((a, b) => {
      if (sel.value === 'role') {
        if (a.dataset.role !== b.dataset.role) return a.dataset.role === 'admin' ? -1 : 1;
        return a.dataset.name.localeCompare(b.dataset.name, 'th');
      }
      return a.dataset.name.localeCompare(b.dataset.name, 'th');
    });
    rows.forEach(r => list.appendChild(r));
  }

  async function submitAddStaff() {
    const displayName = document.getElementById('newStaffDisplayName').value.trim();
    const username    = document.getElementById('newStaffUsername').value.trim();
    const password    = document.getElementById('newStaffPassword').value;
    const role        = document.getElementById('newStaffRole').value;
    if (!displayName || !username || !password) {
      Swal.fire({ icon:'warning', title:'กรุณากรอกข้อมูลให้ครบ', confirmButtonColor:'#1877f2' });
      return;
    }
    try {
      const r = await fetch('/api/staff', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ displayName, username, password, role }),
      });
      const d = await r.json();
      if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');
      location.reload();
    } catch (e) {
      Swal.fire({ icon:'error', title:'เพิ่มไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
    }
  }

  let _cpStaffId = null;
  function openChangePassword(id, name) {
    _cpStaffId = id;
    document.getElementById('cpStaffName').textContent = name;
    document.getElementById('cpNewPassword').value = '';
    document.getElementById('changePasswordModal').style.display = 'flex';
  }
  function closeChangePassword() { document.getElementById('changePasswordModal').style.display = 'none'; }

  async function submitChangePassword() {
    const password = document.getElementById('cpNewPassword').value;
    if (!password) {
      Swal.fire({ icon:'warning', title:'กรุณากรอกรหัสผ่านใหม่', confirmButtonColor:'#1877f2' });
      return;
    }
    try {
      const r = await fetch(`/api/staff/${_cpStaffId}/password`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });
      const d = await r.json();
      if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');
      closeChangePassword();
      Swal.fire({ icon:'success', title:'เปลี่ยนรหัสผ่านสำเร็จ', confirmButtonColor:'#1877f2' });
    } catch (e) {
      Swal.fire({ icon:'error', title:'เปลี่ยนรหัสผ่านไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
    }
  }

  async function changeRole(id, name, role, selectEl) {
    const prevValue = role === 'admin' ? 'staff' : 'admin';
    const roleLabelTH = role === 'admin' ? 'แอดมิน' : 'พนักงาน';

    const { isConfirmed } = await Swal.fire({
      icon: 'warning',
      title: `เปลี่ยนสิทธิ์ "${name}" เป็น ${roleLabelTH}?`,
      text: role === 'admin'
        ? `${name} จะสามารถจัดการบัญชีผู้ใช้งานคนอื่นได้ทั้งหมด`
        : `${name} จะเข้าหน้าจัดการบัญชีผู้ใช้งานไม่ได้อีก`,
      showCancelButton: true, confirmButtonText: 'ยืนยัน', cancelButtonText: 'ยกเลิก', confirmButtonColor: '#1877f2',
    });
    if (!isConfirmed) { selectEl.value = prevValue; return; }

    try {
      const r = await fetch(`/api/staff/${id}/role`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role }),
      });
      const d = await r.json();
      if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');
    } catch (e) {
      selectEl.value = prevValue;
      Swal.fire({ icon:'error', title:'เปลี่ยนสิทธิ์ไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
    }
  }

  let _editStaffId = null;
  function openEditStaff(id, name, username) {
    _editStaffId = id;
    document.getElementById('editStaffDisplayName').value = name;
    document.getElementById('editStaffUsername').value = username;
    document.getElementById('editStaffModal').style.display = 'flex';
  }
  function closeEditStaff() { document.getElementById('editStaffModal').style.display = 'none'; }

  async function submitEditStaff() {
    const displayName = document.getElementById('editStaffDisplayName').value.trim();
    const username    = document.getElementById('editStaffUsername').value.trim();
    if (!displayName || !username) {
      Swal.fire({ icon:'warning', title:'กรุณากรอกข้อมูลให้ครบ', confirmButtonColor:'#1877f2' });
      return;
    }
    try {
      const r = await fetch(`/api/staff/${_editStaffId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ displayName, username }),
      });
      const d = await r.json();
      if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');
      location.reload();
    } catch (e) {
      Swal.fire({ icon:'error', title:'บันทึกไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
    }
  }

  async function deleteStaff(id, name) {
    const { isConfirmed } = await Swal.fire({
      icon: 'warning', title: `ลบบัญชีผู้ใช้งาน "${name}"?`,
      text: 'บัญชีจะเข้าสู่ระบบไม่ได้อีก และจะถูกซ่อนจากหน้ากิจกรรมพนักงานชั่วคราว ข้อมูลโพสต์/แชร์เก่าไม่ถูกลบ จะกลับมาแสดงตามเดิมทันทีที่กู้คืนบัญชี',
      showCancelButton: true, confirmButtonText: 'ลบ', cancelButtonText: 'ยกเลิก', confirmButtonColor: '#c62828',
    });
    if (!isConfirmed) return;
    const r = await fetch(`/api/staff/${id}`, { method: 'DELETE' });
    const d = await r.json().catch(() => ({}));
    if (!d.ok) {
      Swal.fire({ icon: 'error', title: 'ลบไม่สำเร็จ', text: d.error || 'เกิดข้อผิดพลาด', confirmButtonColor: '#1877f2' });
      return;
    }
    location.reload();
  }

  async function restoreStaff(id, name) {
    const { isConfirmed } = await Swal.fire({
      icon: 'question', title: `กู้คืนบัญชีผู้ใช้งาน "${name}"?`,
      text: 'บัญชีจะกลับมาเข้าสู่ระบบได้ตามปกติ',
      showCancelButton: true, confirmButtonText: 'กู้คืน', cancelButtonText: 'ยกเลิก', confirmButtonColor: '#2e7d32',
    });
    if (!isConfirmed) return;
    const r = await fetch(`/api/staff/${id}/restore`, { method: 'POST' });
    const d = await r.json().catch(() => ({}));
    if (!d.ok) {
      Swal.fire({ icon: 'error', title: 'กู้คืนไม่สำเร็จ', text: d.error || 'เกิดข้อผิดพลาด', confirmButtonColor: '#1877f2' });
      return;
    }
    location.reload();
  }

  // Bound via data-id/data-name (not inline onclick built from a string) so a
  // displayName containing a quote can never break out of an inline handler.
  document.querySelectorAll('.btn-delete-staff').forEach(btn => {
    btn.addEventListener('click', () => deleteStaff(btn.dataset.id, btn.dataset.name));
  });
  document.querySelectorAll('.btn-change-password').forEach(btn => {
    btn.addEventListener('click', () => openChangePassword(btn.dataset.id, btn.dataset.name));
  });
  document.querySelectorAll('.btn-edit-staff').forEach(btn => {
    btn.addEventListener('click', () => openEditStaff(btn.dataset.id, btn.dataset.name, btn.dataset.username));
  });
  document.querySelectorAll('.role-select').forEach(sel => {
    sel.addEventListener('change', () => changeRole(sel.dataset.id, sel.dataset.name, sel.value, sel));
  });
  document.querySelectorAll('.btn-restore-staff').forEach(btn => {
    btn.addEventListener('click', () => restoreStaff(btn.dataset.id, btn.dataset.name));
  });
</script>
</body>
</html>
