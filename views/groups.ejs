<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>กลุ่ม Facebook - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
  </div>
</nav>

<%
// Build catMap from merged cats list (cats passed from controller)
const catMap = {};
cats.forEach(cat => { catMap[cat] = []; });
groups.forEach(g => {
  const cat = g.category || 'ทั่วไป';
  if (!catMap[cat]) catMap[cat] = [];
  catMap[cat].push(g);
});
%>

<div class="page-wrap">
  <aside class="sidebar">
    <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <a href="/groups" class="sidebar-item active"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
  </aside>

  <main class="feed">

    <!-- How-to banner -->
    <div class="card" style="background:linear-gradient(135deg,#e8f4ff 0%,#f0f7ff 100%);border-color:#b3d4f9;padding:1rem 1.25rem">
      <div style="display:flex;align-items:center;gap:.9rem;flex-wrap:wrap">
        <div style="flex:1;min-width:200px">
          <div style="font-weight:700;color:#1877f2;margin-bottom:.4rem;font-size:.92rem">
            <i class="fa-solid fa-robot"></i> โพสลงกลุ่มต้องมี Desktop Agent
          </div>
          <div style="font-size:.82rem;color:#444;line-height:1.75">
            <span style="background:#1877f2;color:#fff;border-radius:50%;width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;margin-right:.25rem">1</span>สร้างหมวด → เพิ่มกลุ่มในหมวด
            &nbsp;<i class="fa-solid fa-arrow-right" style="font-size:.7rem;color:#aaa"></i>&nbsp;
            <span style="background:#1877f2;color:#fff;border-radius:50%;width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;margin-right:.25rem">2</span>ดาวน์โหลด &amp; ติดตั้ง Agent (ครั้งเดียว)
            &nbsp;<i class="fa-solid fa-arrow-right" style="font-size:.7rem;color:#aaa"></i>&nbsp;
            <span style="background:#1877f2;color:#fff;border-radius:50%;width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;margin-right:.25rem">3</span>Login Facebook ใน Agent แล้วสั่งโพสจาก <a href="/job-queue" style="color:#1877f2;font-weight:600">คิวโพส</a>
          </div>
        </div>
        <a href="/agent" style="display:inline-flex;align-items:center;gap:.45rem;background:#1877f2;color:#fff;padding:.52rem 1.15rem;border-radius:8px;font-weight:700;font-size:.85rem;text-decoration:none;flex-shrink:0;white-space:nowrap"
           onmouseover="this.style.background='#1461c8'" onmouseout="this.style.background='#1877f2'">
          <i class="fa-solid fa-download"></i> ดาวน์โหลด Agent
        </a>
      </div>
    </div>

    <!-- Header + action buttons -->
    <div class="card" style="padding:.85rem 1.25rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
      <div class="card-title" style="font-size:1.05rem">
        <i class="fa-solid fa-users-rectangle"></i> กลุ่ม Facebook
        <span style="background:#e4e6ea;padding:.15rem .55rem;border-radius:999px;font-size:.8rem;margin-left:.4rem"><%= groups.length %> กลุ่ม</span>
        <span style="background:#dde8ff;padding:.15rem .55rem;border-radius:999px;font-size:.8rem;margin-left:.3rem;color:#1877f2"><%= cats.length %> หมวด</span>
      </div>
      <div style="display:flex;gap:.5rem">
        <button class="btn-outline-blue" onclick="toggleCreateCatForm()">
          <i class="fa-solid fa-folder-plus"></i> สร้างหมวด
        </button>
        <button class="btn-post" style="font-size:.82rem;padding:.4rem .9rem" onclick="toggleAddGroupForm()">
          <i class="fa-solid fa-plus"></i> เพิ่มกลุ่ม
        </button>
      </div>
    </div>

    <!-- ── Create Category Form ── -->
    <div class="card" id="createCatForm" style="display:none;border-color:#1877f2">
      <div class="card-title" style="color:#1877f2"><i class="fa-solid fa-folder-plus"></i> สร้างหมวดใหม่</div>
      <div style="font-size:.84rem;color:var(--text-secondary);margin-bottom:.65rem">
        สร้างหัวข้อพื้นที่ก่อน เช่น <strong>บางแสน</strong>, <strong>พัทยา</strong> แล้วค่อยเพิ่มกลุ่มเข้าไปในแต่ละหมวด
      </div>
      <div style="display:flex;gap:.5rem;align-items:flex-end;flex-wrap:wrap">
        <div style="flex:1;min-width:180px">
          <label class="form-label">ชื่อหมวด / พื้นที่ <span style="color:#fa5252">*</span></label>
          <input type="text" id="fCatName" placeholder="เช่น บางแสน, พัทยา, ชลบุรี..." style="width:100%"
                 onkeydown="if(event.key==='Enter') createCategory()">
        </div>
        <div style="display:flex;gap:.4rem;padding-bottom:.05rem">
          <button class="btn-post" style="font-size:.85rem;padding:.45rem 1.1rem" onclick="createCategory()">
            <i class="fa-solid fa-folder-plus"></i> สร้างหมวด
          </button>
          <button class="btn-back" onclick="toggleCreateCatForm()">ยกเลิก</button>
        </div>
      </div>
    </div>

    <!-- ── Add Group Form ── -->
    <div class="card" id="addGroupForm" style="display:none">
      <div class="card-title"><i class="fa-solid fa-plus"></i> เพิ่มกลุ่มเข้าหมวด</div>
      <% if (!cats.length) { %>
      <div style="background:#fff8e1;border:1px solid #f0c36d;border-radius:8px;padding:.7rem 1rem;font-size:.85rem;color:#856404;margin-bottom:.75rem">
        <i class="fa-solid fa-triangle-exclamation"></i> ยังไม่มีหมวด — กรุณา<button onclick="toggleCreateCatForm();toggleAddGroupForm()" style="background:none;border:none;color:#1877f2;cursor:pointer;font-weight:700;font-family:inherit;padding:0 .2rem;font-size:inherit">สร้างหมวดก่อน</button>
      </div>
      <% } %>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:.75rem">
        <div>
          <label class="form-label">URL กลุ่ม หรือ Group ID <span style="color:#fa5252">*</span></label>
          <input type="text" id="fGroupUrl" placeholder="https://facebook.com/groups/123... หรือ 123456789" oninput="parseGroupUrl(this.value)">
        </div>
        <div>
          <label class="form-label">ชื่อกลุ่ม <span style="color:#fa5252">*</span></label>
          <input type="text" id="fGroupName" placeholder="ชื่อกลุ่ม">
        </div>
      </div>
      <div style="margin-bottom:.75rem">
        <label class="form-label">เพิ่มเข้าหมวด <span style="color:#fa5252">*</span></label>
        <select id="fGroupCat" style="padding:.42rem .65rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.87rem;font-family:inherit;color:#444;outline:none;min-width:200px">
          <% if (!cats.length) { %><option value="">— ยังไม่มีหมวด —</option><% } %>
          <% cats.forEach(cat => { %><option value="<%= cat %>">📍 <%= cat %></option><% }); %>
        </select>
      </div>
      <div style="display:flex;gap:.5rem">
        <button class="btn-post" style="font-size:.85rem;padding:.45rem 1rem" onclick="addGroup()">
          <i class="fa-solid fa-plus"></i> เพิ่มกลุ่ม
        </button>
        <button class="btn-back" onclick="toggleAddGroupForm()">ยกเลิก</button>
      </div>
    </div>

    <!-- ── Filter tabs ── -->
    <% if (cats.length > 0) { %>
    <div class="card" style="padding:.55rem 1rem;display:flex;gap:.4rem;flex-wrap:wrap;align-items:center">
      <span style="font-size:.78rem;color:var(--text-secondary);font-weight:600;margin-right:.2rem;flex-shrink:0">
        <i class="fa-solid fa-filter" style="font-size:.72rem"></i> ดูหมวด:
      </span>
      <button class="filter-tab active" data-cat="__all__" onclick="filterCat('__all__')">
        ทั้งหมด <span class="tab-count"><%= groups.length %></span>
      </button>
      <% cats.forEach(cat => { %>
      <button class="filter-tab" data-cat="<%= cat %>" onclick="filterCat(<%- JSON.stringify(cat) %>)">
        <i class="fa-solid fa-location-dot" style="font-size:.68rem;color:#1877f2"></i>
        <%= cat %> <span class="tab-count"><%= catMap[cat].length %></span>
      </button>
      <% }); %>
    </div>
    <% } %>

    <!-- ── Empty state (no categories yet) ── -->
    <% if (!cats.length) { %>
    <div class="card" style="text-align:center;padding:2.5rem">
      <i class="fa-solid fa-folder-open" style="font-size:2.5rem;color:#b3d4f9;margin-bottom:.8rem;display:block"></i>
      <div style="font-weight:700;font-size:1rem;margin-bottom:.4rem">เริ่มต้นด้วยการสร้างหมวด</div>
      <div style="font-size:.87rem;color:var(--text-secondary);margin-bottom:1.2rem">
        สร้างหัวข้อพื้นที่ก่อน เช่น บางแสน หรือ พัทยา<br>แล้วค่อยเพิ่มกลุ่ม Facebook เข้าไปในแต่ละหมวด
      </div>
      <button class="btn-post" onclick="toggleCreateCatForm()">
        <i class="fa-solid fa-folder-plus"></i> สร้างหมวดแรก
      </button>
    </div>

    <% } else { %>

    <!-- ── Category sections ── -->
    <% cats.forEach((cat, ci) => { %>
    <div class="card cat-section" data-cat="<%= cat %>" style="padding:0;overflow:hidden">

      <!-- Category header -->
      <div class="cat-header">
        <i class="fa-solid fa-location-dot" style="color:#1877f2;font-size:.9rem;flex-shrink:0"></i>
        <span style="font-weight:700;font-size:.97rem;flex:1"><%= cat %></span>
        <% if (catMap[cat].length > 0) { %>
        <span class="cat-badge"><%= catMap[cat].length %> กลุ่ม</span>
        <% } else { %>
        <span class="cat-badge" style="background:#fff0f0;color:#c0392b">ว่าง</span>
        <% } %>
        <button class="cat-action-btn" onclick="addGroupToCat(<%- JSON.stringify(cat) %>)" title="เพิ่มกลุ่มในหมวดนี้">
          <i class="fa-solid fa-plus"></i> เพิ่มกลุ่ม
        </button>
        <button class="cat-action-btn" onclick="renameCategory(<%- JSON.stringify(cat) %>)" title="เปลี่ยนชื่อหมวด">
          <i class="fa-solid fa-pen"></i>
        </button>
        <% if (dbCatMap[cat] && catMap[cat].length === 0) { %>
        <button class="cat-action-btn" style="color:#fa5252" onclick="deleteCategory(<%- JSON.stringify(dbCatMap[cat]) %>, <%- JSON.stringify(cat) %>)" title="ลบหมวด">
          <i class="fa-solid fa-trash"></i>
        </button>
        <% } %>
        <button class="cat-toggle-btn" onclick="toggleCatSection(<%= ci %>)" title="ยุบ/ขยาย">
          <i class="fa-solid fa-chevron-down" id="chevron_<%= ci %>" style="transition:transform .2s"></i>
        </button>
      </div>

      <!-- Groups inside -->
      <div id="catbody_<%= ci %>" class="cat-body">
        <% if (catMap[cat].length === 0) { %>
        <div style="padding:.9rem 1rem;font-size:.87rem;color:var(--text-secondary);display:flex;align-items:center;gap:.6rem">
          <i class="fa-solid fa-circle-info" style="color:#b3d4f9"></i>
          ยังไม่มีกลุ่มในหมวดนี้ —
          <button onclick="addGroupToCat(<%- JSON.stringify(cat) %>)"
                  style="background:none;border:none;color:#1877f2;cursor:pointer;font-weight:600;font-size:.87rem;font-family:inherit;padding:0">
            คลิกเพื่อเพิ่มกลุ่ม
          </button>
        </div>
        <% } %>
        <% catMap[cat].forEach(g => { %>
        <div class="group-row" id="gr_<%= g._id %>">
          <div class="group-row-indent"></div>
          <i class="fa-solid fa-users" style="color:#1877f2;width:15px;text-align:center;flex-shrink:0;font-size:.88rem"></i>
          <div style="flex:1;min-width:0">
            <div style="font-weight:600;font-size:.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= g.groupName %></div>
            <div style="font-size:.72rem;color:var(--text-secondary);font-family:monospace"><%= g.groupId %></div>
          </div>
          <% if (cats.length > 1) { %>
          <button class="cat-action-btn" style="color:#6c757d;font-size:.75rem"
                  onclick="moveGroup('<%= g._id %>', <%- JSON.stringify(g.groupName) %>, <%- JSON.stringify(cat) %>)" title="ย้ายไปหมวดอื่น">
            <i class="fa-solid fa-right-left"></i>
          </button>
          <% } %>
          <a href="https://www.facebook.com/groups/<%= g.groupId %>" target="_blank"
             style="color:var(--text-secondary);font-size:.8rem;text-decoration:none;padding:.15rem .25rem;flex-shrink:0" title="เปิดใน Facebook">
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </a>
          <button onclick="deleteGroup('<%= g._id %>')"
                  style="background:none;border:none;cursor:pointer;color:#c5c8d0;font-size:.92rem;padding:.15rem .3rem;border-radius:4px;flex-shrink:0" title="ลบ">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
        <% }); %>
      </div>

    </div>
    <% }); %>

    <% } %>

    <div class="card" style="background:#f0f7ff;border-color:#b3d4f9;font-size:.85rem;color:#1877f2;line-height:1.8">
      <strong>ℹ️ หมายเหตุ:</strong> กลุ่มที่เพิ่มที่นี่จะแสดงใน <strong>Job Queue</strong> และ <strong>Desktop Agent</strong> ของทุกคนที่เข้าระบบ
    </div>

  </main>
</div>

<style>
.form-label { display:block;font-size:.8rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.3rem }

/* Buttons */
.btn-outline-blue {
  background:#fff;border:1.5px solid #1877f2;color:#1877f2;
  border-radius:8px;padding:.4rem .85rem;font-size:.82rem;
  font-family:inherit;font-weight:700;cursor:pointer;
  display:inline-flex;align-items:center;gap:.35rem;transition:background .12s
}
.btn-outline-blue:hover { background:#e7f3ff }

/* Filter tabs */
.filter-tab {
  background:#f0f2f5;border:1.5px solid transparent;border-radius:999px;
  padding:.28rem .7rem;font-size:.82rem;cursor:pointer;font-family:inherit;
  color:#555;font-weight:500;transition:all .15s;display:inline-flex;align-items:center;gap:.3rem
}
.filter-tab:hover { background:#e4e6ea }
.filter-tab.active { background:#e7f3ff;border-color:#1877f2;color:#1877f2;font-weight:700 }
.tab-count { background:#e4e6ea;border-radius:999px;padding:.05rem .42rem;font-size:.73rem;margin-left:.1rem }
.filter-tab.active .tab-count { background:#cce0ff }

/* Category sections */
.cat-header {
  background:#f0f2f5;padding:.65rem 1rem;
  display:flex;align-items:center;gap:.45rem;
  border-bottom:1px solid var(--border-color)
}
.cat-badge {
  background:#e4e6ea;padding:.1rem .5rem;border-radius:999px;
  font-size:.76rem;color:#555;font-weight:600;white-space:nowrap;flex-shrink:0
}
.cat-action-btn {
  background:none;border:1px solid transparent;cursor:pointer;
  color:#1877f2;padding:.2rem .45rem;border-radius:6px;font-size:.78rem;
  font-family:inherit;font-weight:600;display:inline-flex;align-items:center;gap:.2rem;
  transition:background .12s;white-space:nowrap;flex-shrink:0
}
.cat-action-btn:hover { background:#e7f3ff;border-color:#b3d4f9 }
.cat-toggle-btn {
  background:none;border:none;cursor:pointer;
  color:#aaa;padding:.2rem .35rem;border-radius:5px;font-size:.85rem;flex-shrink:0
}
.cat-toggle-btn:hover { background:#e4e6ea }

/* Group rows */
.cat-body { background:#fff }
.group-row {
  display:flex;align-items:center;gap:.6rem;
  padding:.5rem .9rem .5rem 0;
  border-bottom:1px solid var(--border-color)
}
.group-row-indent {
  width:1.4rem;flex-shrink:0;
  border-left:2px solid #e4e6ea;
  height:2rem;margin-left:.9rem
}
</style>

<script>
const _cats = <%- JSON.stringify(cats) %>;
const _dbCatMap = <%- JSON.stringify(dbCatMap) %>;

/* ── Toggle forms ── */
function toggleCreateCatForm() {
  const f = document.getElementById('createCatForm');
  f.style.display = f.style.display === 'none' ? '' : 'none';
  if (f.style.display !== 'none') {
    document.getElementById('addGroupForm').style.display = 'none';
    document.getElementById('fCatName').focus();
    f.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }
}

function toggleAddGroupForm(preselect) {
  const f = document.getElementById('addGroupForm');
  f.style.display = f.style.display === 'none' ? '' : 'none';
  if (f.style.display !== 'none') {
    document.getElementById('createCatForm').style.display = 'none';
    if (preselect) {
      const sel = document.getElementById('fGroupCat');
      if (sel) for (let i = 0; i < sel.options.length; i++) {
        if (sel.options[i].value === preselect) { sel.selectedIndex = i; break; }
      }
    }
    document.getElementById('fGroupUrl').focus();
    f.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }
}

function addGroupToCat(cat) {
  toggleAddGroupForm(cat);
}

/* ── Create Category ── */
async function createCategory() {
  const name = document.getElementById('fCatName').value.trim();
  if (!name) { Swal.fire({ icon:'warning', title:'กรุณากรอกชื่อหมวด', confirmButtonColor:'#1877f2' }); return; }
  try {
    const r = await fetch('/api/agent/categories', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ name }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Delete Category ── */
async function deleteCategory(id, name) {
  const res = await Swal.fire({
    title: `ลบหมวด "${name}"?`,
    text: 'หมวดนี้ยังไม่มีกลุ่ม สามารถลบได้',
    icon:'warning', showCancelButton:true,
    confirmButtonColor:'#fa5252', confirmButtonText:'ลบ', cancelButtonText:'ยกเลิก'
  });
  if (!res.isConfirmed) return;
  await fetch(`/api/agent/categories/${id}`, { method:'DELETE' });
  location.reload();
}

/* ── Rename Category ── */
async function renameCategory(oldName) {
  const { value: newName } = await Swal.fire({
    title: 'เปลี่ยนชื่อหมวด',
    input: 'text', inputValue: oldName,
    inputLabel: 'ชื่อใหม่ของหมวด',
    showCancelButton: true,
    confirmButtonText: 'บันทึก', cancelButtonText: 'ยกเลิก',
    confirmButtonColor: '#1877f2',
    inputValidator: v => !v.trim() ? 'กรุณากรอกชื่อหมวด' : null,
  });
  if (!newName || newName.trim() === oldName) return;
  try {
    const r = await fetch('/api/agent/groups/rename-category', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ oldName, newName: newName.trim() }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Parse group URL ── */
function parseGroupUrl(val) {
  const m = val.match(/facebook\.com\/groups\/([^/?#\s]+)/);
  if (m) document.getElementById('fGroupUrl').value = m[1];
}

/* ── Add Group ── */
async function addGroup() {
  const raw  = document.getElementById('fGroupUrl').value.trim();
  const name = document.getElementById('fGroupName').value.trim();
  const cat  = document.getElementById('fGroupCat').value;

  const m = raw.match(/facebook\.com\/groups\/([^/?#\s]+)/);
  const gid = m ? m[1] : raw;

  if (!cat)  { Swal.fire({ icon:'warning', title:'กรุณาสร้างหมวดก่อน', text:'กดปุ่ม "สร้างหมวด" แล้วตั้งชื่อพื้นที่ก่อน', confirmButtonColor:'#1877f2' }); return; }
  if (!gid)  { Swal.fire({ icon:'warning', title:'กรุณากรอก Group ID', confirmButtonColor:'#1877f2' }); return; }
  if (!name) { Swal.fire({ icon:'warning', title:'กรุณากรอกชื่อกลุ่ม', confirmButtonColor:'#1877f2' }); return; }

  try {
    const r = await fetch('/api/agent/groups', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ groupId: gid, groupName: name, category: cat }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Delete Group ── */
async function deleteGroup(id) {
  const res = await Swal.fire({
    title:'ลบกลุ่มนี้?', icon:'warning',
    showCancelButton:true, confirmButtonColor:'#fa5252',
    confirmButtonText:'ลบ', cancelButtonText:'ยกเลิก'
  });
  if (!res.isConfirmed) return;
  await fetch(`/api/agent/groups/${id}`, { method:'DELETE' });
  location.reload();
}

/* ── Move Group to another category ── */
async function moveGroup(id, groupName, currentCat) {
  const otherCats = _cats.filter(c => c !== currentCat);
  if (!otherCats.length) {
    Swal.fire({ icon:'info', title:'ไม่มีหมวดอื่น', text:'กรุณาสร้างหมวดใหม่ก่อน', confirmButtonColor:'#1877f2' });
    return;
  }
  const options = otherCats.map(c => `<option value="${c}">📍 ${c}</option>`).join('');
  const { value: newCat } = await Swal.fire({
    title: `ย้าย "${groupName}"`,
    html: `<select id="moveSel" style="width:100%;padding:.45rem .6rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.9rem;font-family:inherit">${options}</select>`,
    showCancelButton:true, confirmButtonText:'ย้าย', cancelButtonText:'ยกเลิก',
    confirmButtonColor:'#1877f2',
    preConfirm: () => document.getElementById('moveSel').value,
  });
  if (!newCat) return;
  try {
    const r = await fetch(`/api/agent/groups/${id}/category`, {
      method:'PATCH', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ category: newCat }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Collapse / expand category ── */
function toggleCatSection(ci) {
  const body = document.getElementById(`catbody_${ci}`);
  const chev = document.getElementById(`chevron_${ci}`);
  if (!body) return;
  const hidden = body.style.display === 'none';
  body.style.display = hidden ? '' : 'none';
  if (chev) chev.style.transform = hidden ? '' : 'rotate(-90deg)';
}

/* ── Filter tabs ── */
function filterCat(cat) {
  document.querySelectorAll('.cat-section').forEach(el => {
    el.style.display = (cat === '__all__' || el.dataset.cat === cat) ? '' : 'none';
  });
  document.querySelectorAll('.filter-tab').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.cat === cat);
  });
}
</script>

