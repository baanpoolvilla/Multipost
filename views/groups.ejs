<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>กลุ่ม Facebook - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
  </div>
</nav>

<%
// catMap: category → groups; a group appears in ALL its categories
const catMap = {};
cats.forEach(cat => { catMap[cat] = []; });
groups.forEach(g => {
  const gcats = (g.categories && g.categories.length) ? g.categories : [g.category || 'ทั่วไป'];
  gcats.forEach(cat => {
    if (!catMap[cat]) catMap[cat] = [];
    catMap[cat].push(g);
  });
});
%>

<div class="page-wrap">
  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item active"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <!-- How-to banner -->
    <div class="card" style="background:linear-gradient(135deg,#e8f4ff 0%,#f0f7ff 100%);border-color:#b3d4f9;padding:.85rem 1.25rem">
      <div style="font-weight:700;color:#1877f2;margin-bottom:.35rem;font-size:.9rem">
        <i class="fa-solid fa-circle-info"></i> วิธีโพสลงกลุ่ม Facebook
      </div>
      <div style="font-size:.83rem;color:#444;line-height:1.9;display:flex;flex-direction:column;gap:.1rem">
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;font-size:.68rem;font-weight:700;margin-right:.3rem">1</span><strong>เพิ่มกลุ่ม</strong> ที่หน้านี้ — กดปุ่ม "+ เพิ่มกลุ่ม" ด้านบนขวา</div>
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;font-size:.68rem;font-weight:700;margin-right:.3rem">2</span><strong>ติดตั้ง Desktop Agent</strong> บนเครื่อง Windows — ทำครั้งเดียว ดูที่ <a href="/agent" style="color:#1877f2;font-weight:600">หน้าติดตั้ง Agent</a></div>
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;font-size:.68rem;font-weight:700;margin-right:.3rem">3</span><strong>เปิด Agent → Login Facebook</strong> แล้วสั่งโพสจาก <a href="/job-queue" style="color:#1877f2;font-weight:600">คิวโพส</a></div>
      </div>
    </div>

    <!-- Header + action buttons -->
    <div class="card" style="padding:.85rem 1.25rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
      <div class="card-title" style="font-size:1.05rem">
        <i class="fa-solid fa-users-rectangle"></i> กลุ่ม Facebook
        <span style="background:#e4e6ea;padding:.15rem .55rem;border-radius:999px;font-size:.8rem;margin-left:.4rem"><%= groups.length %> กลุ่ม</span>
        <span style="background:#dde8ff;padding:.15rem .55rem;border-radius:999px;font-size:.8rem;margin-left:.3rem;color:#1877f2"><%= cats.length %> หมวด</span>
      </div>
      <div style="display:flex;gap:.5rem">
        <button class="btn-outline-blue" onclick="toggleCreateCatForm()">
          <i class="fa-solid fa-folder-plus"></i> สร้างหมวด
        </button>
        <button class="btn-post" style="font-size:.82rem;padding:.4rem .9rem" onclick="toggleAddGroupForm()">
          <i class="fa-solid fa-plus"></i> เพิ่มกลุ่ม
        </button>
      </div>
    </div>

    <!-- ── Create Category Form ── -->
    <div class="card" id="createCatForm" style="display:none;border-color:#1877f2">
      <div class="card-title" style="color:#1877f2"><i class="fa-solid fa-folder-plus"></i> สร้างหมวดใหม่</div>
      <div style="font-size:.84rem;color:var(--text-secondary);margin-bottom:.65rem">
        สร้างหัวข้อพื้นที่ก่อน เช่น <strong>บางแสน</strong>, <strong>พัทยา</strong> แล้วค่อยเพิ่มกลุ่มเข้าไปในแต่ละหมวด
      </div>
      <div style="display:flex;gap:.5rem;align-items:flex-end;flex-wrap:wrap">
        <div style="flex:1;min-width:180px">
          <label class="form-label">ชื่อหมวด / พื้นที่ <span style="color:#fa5252">*</span></label>
          <input type="text" id="fCatName" placeholder="เช่น บางแสน, พัทยา, ชลบุรี..." style="width:100%"
                 onkeydown="if(event.key==='Enter') createCategory()">
        </div>
        <div style="display:flex;gap:.4rem;padding-bottom:.05rem">
          <button class="btn-post" style="font-size:.85rem;padding:.45rem 1.1rem" onclick="createCategory()">
            <i class="fa-solid fa-folder-plus"></i> สร้างหมวด
          </button>
          <button class="btn-back" onclick="toggleCreateCatForm()">ยกเลิก</button>
        </div>
      </div>
    </div>

    <!-- ── Add Group Form ── -->
    <div class="card" id="addGroupForm" style="display:none">
      <div class="card-title"><i class="fa-solid fa-plus"></i> เพิ่มกลุ่มเข้าหมวด</div>
      <% if (!cats.length) { %>
      <div style="background:#fff8e1;border:1px solid #f0c36d;border-radius:8px;padding:.7rem 1rem;font-size:.85rem;color:#856404;margin-bottom:.75rem">
        <i class="fa-solid fa-triangle-exclamation"></i> ยังไม่มีหมวด — กรุณา<button onclick="toggleCreateCatForm();toggleAddGroupForm()" style="background:none;border:none;color:#1877f2;cursor:pointer;font-weight:700;font-family:inherit;padding:0 .2rem;font-size:inherit">สร้างหมวดก่อน</button>
      </div>
      <% } %>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:.75rem">
        <div>
          <label class="form-label">URL กลุ่ม หรือ Group ID <span style="color:#fa5252">*</span></label>
          <input type="text" id="fGroupUrl" placeholder="https://facebook.com/groups/123... หรือ 123456789" oninput="parseGroupUrl(this.value)">
        </div>
        <div>
          <label class="form-label">ชื่อกลุ่ม <span style="color:#fa5252">*</span></label>
          <input type="text" id="fGroupName" placeholder="ชื่อกลุ่ม">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr auto;gap:.75rem;margin-bottom:.75rem;align-items:end">
        <div>
          <label class="form-label">หมวดเพิ่มเติม <span style="font-size:.75rem;color:#8a8d91;font-weight:400;text-transform:none">(ไม่บังคับ — กลุ่มจะอยู่ในทั่วไปเสมอ)</span></label>
          <select id="fGroupCat" style="padding:.42rem .65rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.87rem;font-family:inherit;color:#444;outline:none;min-width:200px;width:100%">
            <option value="">— ทั่วไป (ไม่เพิ่มเข้าหมวดอื่น) —</option>
            <% cats.filter(c => c !== 'ทั่วไป').forEach(cat => { %><option value="<%= cat %>">📍 <%= cat %></option><% }); %>
          </select>
        </div>
        <div>
          <label class="form-label">ประเภทกลุ่ม</label>
          <div style="display:flex;gap:.4rem;flex-wrap:wrap">
            <button type="button" id="fPrivBtn-null"   class="priv-pick active-priv" data-val=""        onclick="pickPrivacy(this)">– ไม่ระบุ</button>
            <button type="button" id="fPrivBtn-public" class="priv-pick"             data-val="public"  onclick="pickPrivacy(this)">🌐 Public</button>
            <button type="button" id="fPrivBtn-private"class="priv-pick"             data-val="private" onclick="pickPrivacy(this)">🔒 Private</button>
            <button type="button" id="fPrivBtn-paid"   class="priv-pick"             data-val="paid"    onclick="pickPrivacy(this)">💰 เสียตัง</button>
          </div>
          <input type="hidden" id="fGroupPrivacy" value="">
        </div>
      </div>
      <div style="display:flex;gap:.5rem">
        <button class="btn-post" style="font-size:.85rem;padding:.45rem 1rem" onclick="addGroup()">
          <i class="fa-solid fa-plus"></i> เพิ่มกลุ่ม
        </button>
        <button class="btn-back" onclick="toggleAddGroupForm()">ยกเลิก</button>
      </div>
    </div>

    <!-- ── Filter tabs (max 4 visible, rest in dropdown) ── -->
    <% if (cats.length > 0) { %>
    <div class="card" style="padding:.55rem 1rem;display:flex;flex-direction:column;gap:.5rem">
      <div style="display:flex;gap:.4rem;flex-wrap:wrap;align-items:center">
      <span style="font-size:.78rem;color:var(--text-secondary);font-weight:600;margin-right:.2rem;flex-shrink:0">
        <i class="fa-solid fa-filter" style="font-size:.72rem"></i> ดูหมวด:
      </span>
      <button class="filter-tab active" data-cat="__all__" data-color="#1877f2" onclick="filterCat('__all__')">
        ทั้งหมด <span class="tab-count"><%= groups.length %></span>
      </button>
      <% cats.slice(0, 4).forEach(cat => { const tc = catColorMap[cat] || '#1877f2'; %>
      <button class="filter-tab" data-cat="<%= cat %>" data-color="<%- tc %>" onclick="filterCat(this.dataset.cat)">
        <i class="fa-solid fa-location-dot" style="font-size:.68rem;color:<%- tc %>"></i>
        <%= cat %> <span class="tab-count"><%= catMap[cat].length %></span>
      </button>
      <% }); %>
      <% if (cats.length > 4) { %>
      <div style="position:relative" id="moreTabsWrap">
        <button class="filter-tab" id="moreTabsBtn" onclick="toggleMoreTabs(event)"
                style="background:#f0f2f5;gap:.3rem">
          <i class="fa-solid fa-ellipsis"></i> อีก <%= cats.length - 4 %> หมวด
          <i class="fa-solid fa-chevron-down" style="font-size:.65rem"></i>
        </button>
        <div id="moreTabsMenu" style="display:none;position:absolute;top:calc(100% + 4px);left:0;background:#fff;border:1px solid var(--border-color);border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);z-index:50;min-width:150px;padding:.3rem;overflow:hidden">
          <% cats.slice(4).forEach(cat => { const tc = catColorMap[cat] || '#1877f2'; %>
          <button class="more-tab-item" data-cat="<%= cat %>" data-color="<%- tc %>"
                  onclick="filterCat(this.dataset.cat);closeMoreTabs()">
            <i class="fa-solid fa-location-dot" style="color:<%- tc %>;font-size:.72rem"></i>
            <%= cat %> <span style="margin-left:auto;font-size:.73rem;color:#aaa"><%= catMap[cat].length %></span>
          </button>
          <% }); %>
        </div>
      </div>
      <% } %>
      </div>
      <div style="display:flex;gap:.4rem;flex-wrap:wrap;align-items:center">
        <span style="font-size:.78rem;color:var(--text-secondary);font-weight:600;margin-right:.2rem;flex-shrink:0">
          <i class="fa-solid fa-tag" style="font-size:.72rem"></i> ประเภท:
        </span>
        <button class="priv-tab active" data-priv="__all__" onclick="filterPrivacy('__all__')">ทั้งหมด</button>
        <button class="priv-tab" data-priv="public"    onclick="filterPrivacy('public')">🌐 Public</button>
        <button class="priv-tab" data-priv="private"   onclick="filterPrivacy('private')">🔒 Private</button>
        <button class="priv-tab" data-priv="paid"      onclick="filterPrivacy('paid')">💰 เสียตัง</button>
        <button class="priv-tab" data-priv="__unset__" onclick="filterPrivacy('__unset__')">– ไม่ระบุ</button>
      </div>
    </div>
    <% } %>

    <!-- ── Empty state (no categories yet) ── -->
    <% if (!cats.length) { %>
    <div class="card" style="text-align:center;padding:2.5rem">
      <i class="fa-solid fa-folder-open" style="font-size:2.5rem;color:#b3d4f9;margin-bottom:.8rem;display:block"></i>
      <div style="font-weight:700;font-size:1rem;margin-bottom:.4rem">เริ่มต้นด้วยการสร้างหมวด</div>
      <div style="font-size:.87rem;color:var(--text-secondary);margin-bottom:1.2rem">
        สร้างหัวข้อพื้นที่ก่อน เช่น บางแสน หรือ พัทยา<br>แล้วค่อยเพิ่มกลุ่ม Facebook เข้าไปในแต่ละหมวด
      </div>
      <button class="btn-post" onclick="toggleCreateCatForm()">
        <i class="fa-solid fa-folder-plus"></i> สร้างหมวดแรก
      </button>
    </div>

    <% } else { %>

    <!-- ── Category sections ── -->
    <% cats.forEach((cat, ci) => { const cc = catColorMap[cat] || '#1877f2'; %>
    <div class="card cat-section" data-cat="<%= cat %>" style="padding:0;overflow:hidden">

      <!-- Category header -->
      <div class="cat-header">
        <i class="fa-solid fa-location-dot" style="color:<%- cc %>;font-size:.9rem;flex-shrink:0"></i>
        <span style="font-weight:700;font-size:.97rem;flex:1"><%= cat %></span>
        <% if (catMap[cat].length > 0) { %>
        <span class="cat-badge"><%= catMap[cat].length %> กลุ่ม</span>
        <% } else { %>
        <span class="cat-badge" style="background:#fff0f0;color:#c0392b">ว่าง</span>
        <% } %>
        <% if (cat !== 'ทั่วไป') { %>
        <button class="cat-action-btn" data-cat="<%= cat %>" onclick="openGroupPicker(this.dataset.cat)" title="เพิ่มกลุ่มจากกลุ่มที่มีอยู่">
          <i class="fa-solid fa-plus"></i> เพิ่มกลุ่ม
        </button>
        <% } %>
        <button class="cat-action-btn" data-cat="<%= cat %>" onclick="renameCategory(this.dataset.cat)" title="เปลี่ยนชื่อหมวด">
          <i class="fa-solid fa-pen"></i>
        </button>
        <% if (cat !== 'ทั่วไป' && dbCatMap[cat]) { %>
        <button class="cat-action-btn" style="color:#fa5252"
                data-id="<%= dbCatMap[cat] %>" data-name="<%= cat %>" data-count="<%= catMap[cat].length %>"
                onclick="deleteCategory(this.dataset.id, this.dataset.name, +this.dataset.count)" title="ลบหมวด">
          <i class="fa-solid fa-trash"></i>
        </button>
        <% } %>
        <% if (cat !== 'ทั่วไป' && dbCatMap[cat]) { %>
        <button onclick="pickCategoryColor('<%- dbCatMap[cat] %>','<%- cat %>','<%- cc %>')"
                title="เปลี่ยนสีหมวด"
                style="width:16px;height:16px;border-radius:50%;border:2px solid rgba(255,255,255,.8);background:<%- cc %>;cursor:pointer;flex-shrink:0;padding:0;box-shadow:0 1px 3px rgba(0,0,0,.2)"></button>
        <% } %>
        <button class="cat-toggle-btn" onclick="toggleCatSection(<%= ci %>)" title="ยุบ/ขยาย">
          <i class="fa-solid fa-chevron-down" id="chevron_<%= ci %>" style="transition:transform .2s<% if (cat !== 'ทั่วไป') { %>;transform:rotate(-90deg)<% } %>"></i>
        </button>
      </div>

      <!-- Groups inside -->
      <div id="catbody_<%= ci %>" class="cat-body"<% if (cat !== 'ทั่วไป') { %> style="display:none"<% } %>>
        <% if (cat === 'ทั่วไป' && catMap[cat].length > 0) { %>
        <div style="padding:.35rem .75rem .3rem;background:#fafbfc;border-bottom:1px solid #f0f2f5">
          <input type="text" placeholder="🔍 ค้นหากลุ่ม..."
                 oninput="filterTallwai(this.value)"
                 style="width:100%;padding:.28rem .55rem;border:1px solid #e4e6eb;border-radius:7px;font-size:.82rem;font-family:inherit;outline:none;background:#fff;color:#333">
        </div>
        <% } %>
        <% if (catMap[cat].length === 0) { %>
        <div style="padding:.9rem 1rem;font-size:.87rem;color:var(--text-secondary);display:flex;align-items:center;gap:.6rem">
          <i class="fa-solid fa-circle-info" style="color:#b3d4f9"></i>
          ยังไม่มีกลุ่มในหมวดนี้ —
          <% if (cat !== 'ทั่วไป') { %>
          <button data-cat="<%= cat %>" onclick="openGroupPicker(this.dataset.cat)"
                  style="background:none;border:none;color:#1877f2;cursor:pointer;font-weight:600;font-size:.87rem;font-family:inherit;padding:0">
            คลิกเพื่อเพิ่มกลุ่ม
          </button>
          <% } else { %>
          <span style="color:#1877f2;font-weight:600">กด "+ เพิ่มกลุ่ม" ด้านบนเพื่อเพิ่มกลุ่มใหม่</span>
          <% } %>
        </div>
        <% } %>
        <% catMap[cat].forEach((g, gi) => {
             const otherCats = (g.categories || []).filter(c => c !== cat);
             const hiddenByLimit = cat === 'ทั่วไป' && gi >= 20;
        %>
        <div class="group-row<%= hiddenByLimit ? ' tw-more' : '' %>"
             data-privacy="<%= g.privacy || '' %>"
             style="background:<%= gi % 2 === 0 ? '#fff' : '#fafbfc' %><%= hiddenByLimit ? ';display:none' : '' %>">
          <span style="width:1.5rem;text-align:right;font-size:.73rem;color:#c0c4cc;flex-shrink:0;margin-left:.85rem;font-weight:500;font-family:monospace"><%= gi + 1 %></span>
          <div style="width:2px;height:1.8rem;background:#e8eaed;margin:0 .5rem;flex-shrink:0;border-radius:1px"></div>
          <i class="fa-solid fa-users" style="color:#1877f2;width:14px;text-align:center;flex-shrink:0;font-size:.85rem"></i>
          <div style="flex:1;min-width:0">
            <div class="grp-name" style="font-weight:600;font-size:.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= g.groupName %></div>
            <div class="grp-id" style="font-size:.71rem;color:var(--text-secondary);font-family:monospace;margin-top:.05rem"><%= g.groupId %></div>
          </div>
          <% if (cat === 'ทั่วไป' && otherCats.length > 0) { %>
          <div style="display:flex;gap:.2rem;align-items:center;justify-content:flex-end;flex-shrink:0;max-width:200px;flex-wrap:wrap">
            <% otherCats.slice(0, 2).forEach(c => { const bc = catColorMap[c] || '#1877f2'; %>
            <span style="font-size:.64rem;background:<%- bc %>18;color:<%- bc %>;border:1px solid <%- bc %>30;border-radius:4px;padding:.04rem .27rem;white-space:nowrap">📍<%= c %></span>
            <% }); %>
            <% if (otherCats.length > 2) { %>
            <span class="cats-more-btn" onclick="expandCats(this)"
              data-extra='<%- JSON.stringify(otherCats.slice(2)) %>'
              style="font-size:.62rem;background:#f0f2f5;color:#65676b;border-radius:4px;padding:.04rem .3rem;cursor:pointer;white-space:nowrap;user-select:none">
              +<%= otherCats.length - 2 %>
            </span>
            <% } %>
          </div>
          <% } %>
          <button class="privacy-btn"
                  data-id="<%= g._id %>"
                  data-privacy="<%= g.privacy || '' %>"
                  onclick="togglePrivacy(this.dataset.id, this.dataset.privacy)"
                  title="คลิกเปลี่ยน: Public / Private">
            <% if (g.privacy === 'public') { %>
              <span class="priv-badge priv-public">🌐 Public</span>
            <% } else if (g.privacy === 'private') { %>
              <span class="priv-badge priv-private">🔒 Private</span>
            <% } else if (g.privacy === 'paid') { %>
              <span class="priv-badge priv-paid">💰 เสียตัง</span>
            <% } else { %>
              <span class="priv-badge priv-unknown">– –</span>
            <% } %>
          </button>
          <div class="group-actions">
            <% if (cat !== 'ทั่วไป' && cats.filter(c=>c!=='ทั่วไป').length > 1) { %>
            <button class="row-btn"
                    data-gid="<%= g._id %>" data-gname="<%= g.groupName %>" data-gcat="<%= cat %>"
                    onclick="moveGroup(this.dataset.gid, this.dataset.gname, this.dataset.gcat)" title="ย้ายไปหมวดอื่น">
              <i class="fa-solid fa-right-left"></i>
            </button>
            <% } %>
            <a href="/job-queue" class="row-btn" title="โพสกลุ่มนี้" style="color:#2e7d32">
              <i class="fa-solid fa-paper-plane"></i>
            </a>
            <a href="https://www.facebook.com/groups/<%= g.groupId %>" target="_blank" class="row-btn" title="เปิดใน Facebook">
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
            <% if (cat === 'ทั่วไป') { %>
            <button class="row-btn row-btn-danger"
                    data-id="<%= g._id %>"
                    onclick="deleteGroup(this.dataset.id)" title="ลบกลุ่มออกจากระบบทั้งหมด">
              <i class="fa-solid fa-trash"></i>
            </button>
            <% } else { %>
            <button class="row-btn" style="color:#fd7e14"
                    data-id="<%= g._id %>" data-cat="<%= cat %>"
                    onclick="removeFromCat(this.dataset.id, this.dataset.cat)"
                    title="ออกจากหมวดนี้ (กลุ่มยังอยู่ในทั่วไป)">
              <i class="fa-solid fa-circle-minus"></i>
            </button>
            <% } %>
          </div>
        </div>
        <% }); %>
        <% if (cat === 'ทั่วไป' && catMap[cat].length > 20) { %>
        <div id="tw-show-more-wrap" style="padding:.6rem 1rem;border-top:1px solid #f0f2f5;text-align:center">
          <button onclick="showMoreTallwai()"
                  style="background:none;border:1.5px solid #e4e6eb;border-radius:8px;padding:.35rem 1.1rem;font-size:.82rem;font-family:inherit;cursor:pointer;color:#555;display:inline-flex;align-items:center;gap:.4rem;transition:border-color .12s,color .12s"
                  onmouseover="this.style.borderColor='#1877f2';this.style.color='#1877f2'"
                  onmouseout="this.style.borderColor='#e4e6eb';this.style.color='#555'">
            <i class="fa-solid fa-chevron-down" style="font-size:.72rem"></i>
            ดูเพิ่มเติม (<%= catMap[cat].length - 20 %> กลุ่ม)
          </button>
        </div>
        <% } %>
      </div>

    </div>
    <% }); %>

    <% } %>

    <div class="card" style="background:#f0f7ff;border-color:#b3d4f9;font-size:.85rem;color:#1877f2;line-height:1.8">
      <strong>ℹ️ หมายเหตุ:</strong> กลุ่มที่เพิ่มที่นี่จะแสดงใน <strong>Job Queue</strong> และ <strong>Desktop Agent</strong> ของทุกคนที่เข้าระบบ
    </div>

  </main>
</div>

<style>
.form-label { display:block;font-size:.8rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.3rem }

/* Buttons */
.btn-outline-blue {
  background:#fff;border:1.5px solid #1877f2;color:#1877f2;
  border-radius:8px;padding:.4rem .85rem;font-size:.82rem;
  font-family:inherit;font-weight:700;cursor:pointer;
  display:inline-flex;align-items:center;gap:.35rem;transition:background .12s
}
.btn-outline-blue:hover { background:#e7f3ff }

/* Filter tabs */
.filter-tab {
  background:#f0f2f5;border:1.5px solid transparent;border-radius:999px;
  padding:.28rem .7rem;font-size:.82rem;cursor:pointer;font-family:inherit;
  color:#555;font-weight:500;transition:all .15s;display:inline-flex;align-items:center;gap:.3rem
}
.filter-tab:hover { background:#e4e6ea }
.filter-tab.active { background:#e7f3ff;border-color:#1877f2;color:#1877f2;font-weight:700 }
.tab-count { background:#e4e6ea;border-radius:999px;padding:.05rem .42rem;font-size:.73rem;margin-left:.1rem }
.filter-tab.active .tab-count { background:#cce0ff }

/* Category sections */
.cat-header {
  background:#f0f2f5;padding:.65rem 1rem;
  display:flex;align-items:center;gap:.45rem;
  border-bottom:1px solid var(--border-color)
}
.cat-badge {
  background:#e4e6ea;padding:.1rem .5rem;border-radius:999px;
  font-size:.76rem;color:#555;font-weight:600;white-space:nowrap;flex-shrink:0
}
.cat-action-btn {
  background:none;border:1px solid transparent;cursor:pointer;
  color:#1877f2;padding:.2rem .45rem;border-radius:6px;font-size:.78rem;
  font-family:inherit;font-weight:600;display:inline-flex;align-items:center;gap:.2rem;
  transition:background .12s;white-space:nowrap;flex-shrink:0
}
.cat-action-btn:hover { background:#e7f3ff;border-color:#b3d4f9 }
.cat-toggle-btn {
  background:none;border:none;cursor:pointer;
  color:#aaa;padding:.2rem .35rem;border-radius:5px;font-size:.85rem;flex-shrink:0
}
.cat-toggle-btn:hover { background:#e4e6ea }

/* Group rows */
.cat-body { background:#fff }
.group-row {
  display:flex;align-items:center;gap:.5rem;
  padding:.42rem .75rem .42rem 0;
  border-bottom:1px solid #f0f2f5;
  transition:background .1s
}
.group-row:hover { background:#f0f7ff !important }
.group-actions {
  display:flex;align-items:center;gap:.15rem;
  opacity:0;transition:opacity .15s;flex-shrink:0
}
.group-row:hover .group-actions { opacity:1 }
.row-btn {
  background:none;border:none;cursor:pointer;color:#adb5bd;
  font-size:.82rem;padding:.22rem .32rem;border-radius:5px;
  text-decoration:none;display:inline-flex;align-items:center;
  transition:color .12s, background .12s
}
.row-btn:hover { color:#1877f2;background:#e7f3ff }
.row-btn-danger:hover { color:#fa5252 !important;background:#fff0f0 !important }

/* Privacy picker buttons (in form) */
.priv-pick {
  background:#f1f3f5;border:1.5px solid #dee2e6;border-radius:7px;
  padding:.3rem .65rem;font-size:.82rem;font-family:inherit;cursor:pointer;
  color:#666;transition:all .12s;white-space:nowrap
}
.priv-pick:hover { border-color:#adb5bd }
.priv-pick.active-priv[data-val=""]       { background:#f1f3f5;border-color:#adb5bd;color:#444;font-weight:700 }
.priv-pick.active-priv[data-val="public"] { background:#d3f9d8;border-color:#2f9e44;color:#2f9e44;font-weight:700 }
.priv-pick.active-priv[data-val="private"]{ background:#fff4e6;border-color:#e67700;color:#e67700;font-weight:700 }
.priv-pick.active-priv[data-val="paid"]   { background:#fff3bf;border-color:#f59f00;color:#e67700;font-weight:700 }

/* Privacy badge */
.privacy-btn {
  background:none;border:none;cursor:pointer;padding:.1rem .2rem;border-radius:5px;
  flex-shrink:0;display:flex;align-items:center;transition:background .1s
}
.privacy-btn:hover { background:#f0f2f5 }
.priv-badge {
  font-size:.67rem;border-radius:4px;padding:.06rem .32rem;
  white-space:nowrap;border:1px solid;pointer-events:none;font-weight:600
}
.priv-public  { background:#d3f9d8;color:#2f9e44;border-color:#b2f2bb }
.priv-private { background:#fff4e6;color:#e67700;border-color:#ffd8a8 }
.priv-paid    { background:#fff3bf;color:#e67700;border-color:#ffe066 }
.priv-unknown { background:#f1f3f5;color:#adb5bd;border-color:#dee2e6;font-weight:400 }

/* Privacy filter tabs */
.priv-tab {
  background:#f0f2f5;border:1.5px solid transparent;border-radius:999px;
  padding:.25rem .65rem;font-size:.8rem;cursor:pointer;font-family:inherit;
  color:#555;font-weight:500;transition:all .15s;white-space:nowrap
}
.priv-tab:hover { background:#e4e6ea }
.priv-tab.active { background:#fff8e1;border-color:#f59f00;color:#e67700;font-weight:700 }
.priv-tab[data-priv="__all__"].active { background:#e7f3ff;border-color:#1877f2;color:#1877f2 }
.priv-tab[data-priv="public"].active  { background:#d3f9d8;border-color:#2f9e44;color:#2f9e44 }
.priv-tab[data-priv="private"].active { background:#fff4e6;border-color:#e67700;color:#e67700 }
.priv-tab[data-priv="__unset__"].active { background:#f1f3f5;border-color:#adb5bd;color:#444 }

/* Hidden by privacy filter */
.priv-hidden { display:none !important }

/* More tabs dropdown */
.more-tab-item {
  display:flex;align-items:center;gap:.45rem;width:100%;
  background:none;border:none;cursor:pointer;
  padding:.38rem .65rem;border-radius:7px;font-size:.83rem;font-family:inherit;
  color:#444;text-align:left;transition:background .1s;white-space:nowrap
}
.more-tab-item:hover { background:#f0f7ff;color:#1877f2 }
</style>

<script>
const _cats      = <%- JSON.stringify(cats) %>;
const _dbCatMap  = <%- JSON.stringify(dbCatMap) %>;
const _catColorMap = <%- JSON.stringify(catColorMap) %>;
const _allGroups = <%- JSON.stringify(groups) %>;

/* ── Toggle forms ── */
function toggleCreateCatForm() {
  const f = document.getElementById('createCatForm');
  f.style.display = f.style.display === 'none' ? '' : 'none';
  if (f.style.display !== 'none') {
    document.getElementById('addGroupForm').style.display = 'none';
    document.getElementById('fCatName').focus();
    f.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }
}

function toggleAddGroupForm(preselect) {
  const f = document.getElementById('addGroupForm');
  f.style.display = f.style.display === 'none' ? '' : 'none';
  if (f.style.display !== 'none') {
    document.getElementById('createCatForm').style.display = 'none';
    if (preselect) {
      const sel = document.getElementById('fGroupCat');
      if (sel) for (let i = 0; i < sel.options.length; i++) {
        if (sel.options[i].value === preselect) { sel.selectedIndex = i; break; }
      }
    }
    document.getElementById('fGroupUrl').focus();
    f.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }
}

/* ── Expand extra category tags ── */
function expandCats(btn) {
  const cats = JSON.parse(btn.dataset.extra || '[]');
  cats.forEach(c => {
    const color = _catColorMap[c] || '#1877f2';
    const span = document.createElement('span');
    span.style.cssText = `font-size:.64rem;background:${color}18;color:${color};border:1px solid ${color}30;border-radius:4px;padding:.04rem .27rem;white-space:nowrap`;
    span.textContent = '📍' + c;
    btn.parentElement.insertBefore(span, btn);
  });
  btn.remove();
}

/* ── More tabs dropdown ── */
function toggleMoreTabs(e) {
  e && e.stopPropagation();
  const menu = document.getElementById('moreTabsMenu');
  if (!menu) return;
  menu.style.display = menu.style.display === 'none' ? '' : 'none';
}
function closeMoreTabs() {
  const menu = document.getElementById('moreTabsMenu');
  if (menu) menu.style.display = 'none';
}
document.addEventListener('click', e => {
  const wrap = document.getElementById('moreTabsWrap');
  if (wrap && !wrap.contains(e.target)) closeMoreTabs();
});

/* ── Group picker modal (เลือกจากกลุ่มที่มีอยู่) ── */
function escH(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

async function openGroupPicker(targetCat) {
  // Groups NOT already in targetCat
  const available = _allGroups.filter(g => {
    const gcats = (g.categories && g.categories.length) ? g.categories : [g.category || 'ทั่วไป'];
    return !gcats.includes(targetCat);
  });

  if (!available.length) {
    Swal.fire({ icon:'info', title:'ไม่มีกลุ่มที่จะเพิ่ม',
      text:'กลุ่มทั้งหมดอยู่ในหมวดนี้แล้ว หรือยังไม่มีกลุ่มในระบบ',
      confirmButtonColor:'#1877f2' });
    return;
  }

  // Group available groups by their first category for display
  const bycat = {};
  available.forEach(g => {
    const gcats = (g.categories && g.categories.length) ? g.categories : [g.category || 'ทั่วไป'];
    const c = gcats[0] || 'ทั่วไป';
    if (!bycat[c]) bycat[c] = [];
    bycat[c].push(g);
  });

  const html = Object.entries(bycat).map(([c, gs]) => `
    <div style="margin-bottom:.5rem">
      <div style="font-size:.75rem;font-weight:700;color:#888;text-transform:uppercase;letter-spacing:.05em;padding:.3rem .5rem .1rem">
        <i class="fa-solid fa-location-dot" style="color:#1877f2;font-size:.7rem"></i> ${escH(c)}
      </div>
      ${gs.map((g, i) => {
        const gcats = (g.categories && g.categories.length) ? g.categories : [g.category || 'ทั่วไป'];
        const tagsHtml = gcats.map(cat => {
          const color = _catColorMap[cat] || '#1877f2';
          return `<span style="display:inline-block;background:${color}18;color:${color};border:1px solid ${color}30;border-radius:4px;padding:.08rem .42rem;font-size:.67rem;font-weight:600;white-space:nowrap">${escH(cat)}</span>`;
        }).join('');
        return `
        <label style="display:flex;align-items:center;gap:.55rem;padding:.38rem .55rem;cursor:pointer;border-radius:7px;font-size:.87rem;transition:background .1s" onmouseover="this.style.background='#f0f7ff'" onmouseout="this.style.background=''">
          <input type="checkbox" data-gid="${escH(String(g._id))}" style="accent-color:#1877f2;width:15px;height:15px;flex-shrink:0">
          <div style="min-width:0;flex:1">
            <div style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escH(g.groupName)}</div>
            <div style="display:flex;align-items:center;gap:.28rem;flex-wrap:wrap;margin-top:.18rem">
              <span style="font-size:.68rem;color:#bbb;font-family:monospace;flex-shrink:0">${escH(g.groupId)}</span>
              <span style="color:#ddd">·</span>
              ${tagsHtml}
            </div>
          </div>
        </label>`;
      }).join('')}
    </div>`).join('<hr style="border:none;border-top:1px solid #f0f2f5;margin:.3rem 0">');

  const { isConfirmed, value: selectedIds } = await Swal.fire({
    title: `เพิ่มกลุ่มเข้า "${targetCat}"`,
    html: `
      <div style="text-align:left;margin-bottom:.5rem;display:flex;gap:.5rem">
        <button onclick="document.querySelectorAll('#swGroupList input[type=checkbox]').forEach(c=>c.checked=true)"
                style="background:#f0f2f5;border:none;border-radius:6px;padding:.28rem .7rem;font-size:.8rem;cursor:pointer;font-family:inherit">เลือกทั้งหมด</button>
        <button onclick="document.querySelectorAll('#swGroupList input[type=checkbox]').forEach(c=>c.checked=false)"
                style="background:#f0f2f5;border:none;border-radius:6px;padding:.28rem .7rem;font-size:.8rem;cursor:pointer;font-family:inherit">ยกเลิก</button>
      </div>
      <div id="swGroupList" style="text-align:left;max-height:460px;overflow-y:auto;border:1px solid #e4e6ea;border-radius:10px;padding:.3rem">${html}</div>`,
    showCancelButton: true,
    confirmButtonText: '<i class="fa-solid fa-plus"></i> เพิ่มเข้าหมวดนี้',
    cancelButtonText: 'ยกเลิก',
    confirmButtonColor: '#1877f2',
    width: 620,
    preConfirm: () => {
      const checked = [...document.querySelectorAll('#swGroupList input[type=checkbox]:checked')];
      if (!checked.length) { Swal.showValidationMessage('กรุณาเลือกอย่างน้อย 1 กลุ่ม'); return false; }
      return checked.map(c => c.dataset.gid);
    },
  });

  if (!isConfirmed || !selectedIds) return;

  try {
    await Promise.all(selectedIds.map(id =>
      fetch(`/api/agent/groups/${id}/category`, {
        method: 'PATCH', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ category: targetCat }),
      })
    ));
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Create Category ── */
async function createCategory() {
  const name = document.getElementById('fCatName').value.trim();
  if (!name) { Swal.fire({ icon:'warning', title:'กรุณากรอกชื่อหมวด', confirmButtonColor:'#1877f2' }); return; }
  try {
    const r = await fetch('/api/agent/categories', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ name }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Delete Category ── */
async function deleteCategory(id, name, count) {
  const detail = count > 0
    ? `<br><span style="font-size:.85rem;color:#555">กลุ่ม ${count} กลุ่มในหมวดนี้จะ<b>ยังอยู่ในหมวด "ทั่วไป"</b> ไม่หายไปไหน</span>`
    : '';
  const res = await Swal.fire({
    title: `ลบหมวด "${name}"?`,
    html: `ต้องการลบหมวดนี้ออกจากระบบ?${detail}`,
    icon:'warning', showCancelButton:true,
    confirmButtonColor:'#fa5252', confirmButtonText:'ลบหมวด', cancelButtonText:'ยกเลิก'
  });
  if (!res.isConfirmed) return;
  await fetch(`/api/agent/categories/${id}`, { method:'DELETE' });
  location.reload();
}

/* ── Rename Category ── */
async function renameCategory(oldName) {
  const { value: newName } = await Swal.fire({
    title: 'เปลี่ยนชื่อหมวด',
    input: 'text', inputValue: oldName,
    inputLabel: 'ชื่อใหม่ของหมวด',
    showCancelButton: true,
    confirmButtonText: 'บันทึก', cancelButtonText: 'ยกเลิก',
    confirmButtonColor: '#1877f2',
    inputValidator: v => !v.trim() ? 'กรุณากรอกชื่อหมวด' : null,
  });
  if (!newName || newName.trim() === oldName) return;
  try {
    const r = await fetch('/api/agent/groups/rename-category', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ oldName, newName: newName.trim() }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Parse group URL ── */
function parseGroupUrl(val) {
  const m = val.match(/facebook\.com\/groups\/([^/?#\s]+)/);
  if (m) document.getElementById('fGroupUrl').value = m[1];
}

/* ── Privacy picker (form) ── */
function pickPrivacy(btn) {
  document.querySelectorAll('.priv-pick').forEach(b => b.classList.remove('active-priv'));
  btn.classList.add('active-priv');
  document.getElementById('fGroupPrivacy').value = btn.dataset.val;
}

/* ── Add Group ── */
async function addGroup() {
  const raw     = document.getElementById('fGroupUrl').value.trim();
  const name    = document.getElementById('fGroupName').value.trim();
  const cat     = document.getElementById('fGroupCat').value;
  const privacy = document.getElementById('fGroupPrivacy').value || null;

  const m = raw.match(/facebook\.com\/groups\/([^/?#\s]+)/);
  const gid = m ? m[1] : raw;

  if (!gid)  { Swal.fire({ icon:'warning', title:'กรุณากรอก Group ID', confirmButtonColor:'#1877f2' }); return; }
  if (!name) { Swal.fire({ icon:'warning', title:'กรุณากรอกชื่อกลุ่ม', confirmButtonColor:'#1877f2' }); return; }

  try {
    const r = await fetch('/api/agent/groups', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ groupId: gid, groupName: name, category: cat || 'ทั่วไป', privacy }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Delete Group (hard delete from ทั่วไป) ── */
async function deleteGroup(id) {
  const res = await Swal.fire({
    title:'ลบกลุ่มออกจากระบบ?',
    text:'กลุ่มนี้จะถูกลบออกจากทุกหมวดหมู่อย่างถาวร',
    icon:'warning', showCancelButton:true,
    confirmButtonColor:'#fa5252', confirmButtonText:'ลบถาวร', cancelButtonText:'ยกเลิก'
  });
  if (!res.isConfirmed) return;
  await fetch(`/api/agent/groups/${id}`, { method:'DELETE' });
  location.reload();
}

/* ── Remove from category (group stays in ทั่วไป) ── */
async function removeFromCat(id, cat) {
  const res = await Swal.fire({
    title: `ออกจากหมวด "${cat}"?`,
    html: `กลุ่มนี้จะ<b>ยังอยู่ในหมวด "ทั่วไป"</b> — เฉพาะออกจาก "${cat}" เท่านั้น`,
    icon:'question', showCancelButton:true,
    confirmButtonColor:'#fd7e14', confirmButtonText:'ออกจากหมวดนี้', cancelButtonText:'ยกเลิก'
  });
  if (!res.isConfirmed) return;
  try {
    await fetch(`/api/agent/groups/${id}/category`, {
      method:'DELETE', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ category: cat }),
    });
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Move Group between non-ทั่วไป categories ── */
async function moveGroup(id, groupName, currentCat) {
  const otherCats = _cats.filter(c => c !== currentCat && c !== 'ทั่วไป');
  if (!otherCats.length) {
    Swal.fire({ icon:'info', title:'ไม่มีหมวดอื่น', text:'กรุณาสร้างหมวดใหม่ก่อน', confirmButtonColor:'#1877f2' });
    return;
  }
  const options = otherCats.map(c => `<option value="${c}">📍 ${c}</option>`).join('');
  const { value: newCat } = await Swal.fire({
    title: `ย้าย "${groupName}"`,
    html: `<select id="moveSel" style="width:100%;padding:.45rem .6rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.9rem;font-family:inherit">${options}</select>`,
    showCancelButton:true, confirmButtonText:'ย้าย', cancelButtonText:'ยกเลิก',
    confirmButtonColor:'#1877f2',
    preConfirm: () => document.getElementById('moveSel').value,
  });
  if (!newCat) return;
  try {
    await Promise.all([
      fetch(`/api/agent/groups/${id}/category`, {
        method:'PATCH', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ category: newCat }),
      }),
      fetch(`/api/agent/groups/${id}/category`, {
        method:'DELETE', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ category: currentCat }),
      }),
    ]);
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── ทั่วไป show more ── */
let _twExpanded = false;
function showMoreTallwai() {
  document.querySelectorAll('.cat-section[data-cat="ทั่วไป"] .tw-more').forEach(r => r.style.display = '');
  const wrap = document.getElementById('tw-show-more-wrap');
  if (wrap) wrap.style.display = 'none';
  _twExpanded = true;
}

/* ── Filter ทั่วไป section ── */
function filterTallwai(q) {
  const rows = document.querySelectorAll('.cat-section[data-cat="ทั่วไป"] .group-row');
  const lq = q.trim().toLowerCase();
  if (!lq) {
    // restore: hide rows beyond 20 unless already expanded
    rows.forEach(row => {
      const isMore = row.classList.contains('tw-more');
      row.style.display = (!isMore || _twExpanded) ? '' : 'none';
    });
    const wrap = document.getElementById('tw-show-more-wrap');
    if (wrap) wrap.style.display = _twExpanded ? 'none' : '';
  } else {
    // searching: show all matching, hide show-more button
    rows.forEach(row => {
      const name = row.querySelector('.grp-name')?.textContent?.toLowerCase() || '';
      const gid  = row.querySelector('.grp-id')?.textContent?.toLowerCase() || '';
      row.style.display = (name.includes(lq) || gid.includes(lq)) ? '' : 'none';
    });
    const wrap = document.getElementById('tw-show-more-wrap');
    if (wrap) wrap.style.display = 'none';
  }
}

/* ── Collapse / expand category ── */
function toggleCatSection(ci) {
  const body = document.getElementById(`catbody_${ci}`);
  const chev = document.getElementById(`chevron_${ci}`);
  if (!body) return;
  const hidden = body.style.display === 'none';
  body.style.display = hidden ? '' : 'none';
  if (chev) chev.style.transform = hidden ? '' : 'rotate(-90deg)';
}

/* ── Filter tabs ── */
function filterCat(cat) {
  document.querySelectorAll('.cat-section').forEach(el => {
    el.style.display = (cat === '__all__' || el.dataset.cat === cat) ? '' : 'none';
  });
  document.querySelectorAll('.filter-tab').forEach(btn => {
    const active = btn.dataset.cat === cat;
    btn.classList.toggle('active', active);
    const color = btn.dataset.color || '#1877f2';
    if (active) {
      btn.style.borderColor = color;
      btn.style.color       = color;
      btn.style.background  = color + '12';
    } else {
      btn.style.borderColor = '';
      btn.style.color       = '';
      btn.style.background  = '';
    }
  });
}

/* ── Privacy toggle ── */
function _privHTML(p) {
  if (p === 'public')  return '<span class="priv-badge priv-public">🌐 Public</span>';
  if (p === 'private') return '<span class="priv-badge priv-private">🔒 Private</span>';
  if (p === 'paid')    return '<span class="priv-badge priv-paid">💰 เสียตัง</span>';
  return '<span class="priv-badge priv-unknown">– –</span>';
}
async function togglePrivacy(id, current) {
  const next = current === 'public' ? 'private'
             : current === 'private' ? 'paid'
             : current === 'paid' ? null
             : 'public';
  try {
    const r = await fetch(`/api/agent/groups/${id}/privacy`, {
      method: 'PATCH', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ privacy: next }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error);
    document.querySelectorAll(`.privacy-btn[data-id="${id}"]`).forEach(btn => {
      btn.dataset.privacy = next || '';
      btn.innerHTML = _privHTML(next);
      const row = btn.closest('.group-row');
      if (row) row.dataset.privacy = next || '';
    });
    applyPrivacyFilter();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Privacy filter ── */
let _activePrivacy = '__all__';
function applyPrivacyFilter() {
  document.querySelectorAll('.group-row').forEach(row => {
    if (_activePrivacy === '__all__') {
      row.classList.remove('priv-hidden');
    } else {
      const p = row.dataset.privacy || '';
      const match = _activePrivacy === '__unset__' ? !p : p === _activePrivacy;
      row.classList.toggle('priv-hidden', !match);
    }
  });
}
function filterPrivacy(type) {
  _activePrivacy = type;
  document.querySelectorAll('.priv-tab').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.priv === type);
  });
  applyPrivacyFilter();
}

/* ── Category color picker ── */
const CAT_PALETTE = ['#1877f2','#e03131','#f76707','#f59f00','#2f9e44','#0c8599','#7048e8','#c2255c','#364fc7','#868e96'];
async function pickCategoryColor(id, name, currentColor) {
  const swatches = CAT_PALETTE.map(c => `
    <button type="button"
      onclick="document.getElementById('_pickedColor').value='${c}';document.querySelectorAll('.cpSwatch').forEach(b=>{b.style.outline='none';b.style.outlineOffset='0'});this.style.outline='3px solid ${c}';this.style.outlineOffset='2px'"
      class="cpSwatch"
      style="width:34px;height:34px;border-radius:50%;background:${c};border:none;cursor:pointer;outline:${c===currentColor?'3px solid '+c:'none'};outline-offset:${c===currentColor?'2px':'0'};transition:transform .1s"
      onmouseover="this.style.transform='scale(1.15)'" onmouseout="this.style.transform=''">
    </button>`).join('');
  const { isConfirmed, value: color } = await Swal.fire({
    title: `สีหมวด "${name}"`,
    html: `<input type="hidden" id="_pickedColor" value="${currentColor}">
           <div style="display:flex;flex-wrap:wrap;gap:.6rem;justify-content:center;padding:.6rem 0">${swatches}</div>`,
    showCancelButton: true,
    confirmButtonText: 'บันทึก', cancelButtonText: 'ยกเลิก',
    confirmButtonColor: currentColor,
    width: 340,
    preConfirm: () => document.getElementById('_pickedColor').value,
  });
  if (!isConfirmed || !color) return;
  await fetch(`/api/agent/categories/${id}/color`, {
    method: 'PATCH', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ color }),
  });
  location.reload();
}
</script>

