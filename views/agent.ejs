<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Desktop Agent - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <% if (locals.currentStaff) { %>
      <span style="font-size:.82rem;color:#65676b;margin-right:.6rem"><i class="fa-solid fa-user-circle"></i> <%= currentStaff.name %></span>
      <form method="POST" action="/logout" style="display:inline">
        <button type="submit" class="btn-back" style="border:none;cursor:pointer;background:none"><i class="fa-solid fa-right-from-bracket"></i> ออกจากระบบ</button>
      </form>
      <% } %>
    </div>

  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item active"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">ระบบ</div>
    <a href="/user-activity" class="sidebar-item"><i class="fa-solid fa-user-clock"></i><span>ใครทำอะไร</span></a>
    <a href="/manage-staff" class="sidebar-item"><i class="fa-solid fa-users-gear"></i><span>จัดการผู้ใช้งาน</span></a>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <!-- Download card -->
    <div class="card" style="padding:1.25rem 1.5rem">
      <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
        <div style="flex:1;min-width:200px">
          <div style="font-size:1rem;font-weight:700;color:var(--text-primary);margin-bottom:.35rem">
            <i class="fa-solid fa-robot" style="color:#1877f2"></i> MultiPost Desktop Agent
            <span style="font-size:.75rem;font-weight:500;color:var(--text-secondary);margin-left:.4rem">v2.0.0</span>
          </div>
          <div style="font-size:.83rem;color:var(--text-secondary);line-height:1.65">
            โปรแกรมสำหรับโพสต์ Facebook กลุ่ม — ติดตั้งบนเครื่อง Windows ของคุณ<br>
            <span style="color:#42b72a"><i class="fa-solid fa-circle-check" style="font-size:.75rem"></i> ไม่ต้องติดตั้ง Node.js แยก — ตัวติดตั้งจัดการให้อัตโนมัติ</span>
          </div>
        </div>
        <a href="/download/agent"
           style="display:inline-flex;align-items:center;gap:.5rem;background:#1877f2;color:#fff;padding:.65rem 1.4rem;border-radius:8px;font-weight:700;font-size:.92rem;text-decoration:none;white-space:nowrap;flex-shrink:0"
           onmouseover="this.style.background='#1461c8'" onmouseout="this.style.background='#1877f2'">
          <i class="fa-solid fa-download"></i> ดาวน์โหลด Agent
        </a>
      </div>

      <hr style="border:none;border-top:1px solid #e4e6eb;margin:.9rem 0">

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.5rem .75rem;font-size:.82rem;color:var(--text-secondary)">
        <div><span style="color:#42b72a;font-weight:700">① </span>แตกไฟล์ zip</div>
        <div><span style="color:#42b72a;font-weight:700">② </span>ดับเบิลคลิก <code>ติดตั้ง.bat</code> (ครั้งแรกเท่านั้น)</div>
        <div><span style="color:#42b72a;font-weight:700">③ </span>ดับเบิลคลิก <code>เปิด Agent.bat</code></div>
        <div><span style="color:#42b72a;font-weight:700">④ </span>ไปที่แท็บ บัญชี Facebook → เข้าสู่ระบบ</div>
      </div>
    </div>

    <!-- Install once notice -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
      <div class="card" style="background:#f0fff4;border-color:#a3cfbb;padding:1rem 1.1rem">
        <div style="font-weight:700;color:#0a3622;margin-bottom:.35rem;font-size:.88rem">
          <i class="fa-solid fa-circle-check" style="color:#42b72a"></i> ติดตั้งครั้งเดียว ใช้ได้เลย
        </div>
        <div style="font-size:.8rem;color:#2d6a4f;line-height:1.7">
          รัน <code>ติดตั้ง.bat</code> แค่ครั้งแรกครั้งเดียว — หลังจากนั้นแค่ดับเบิลคลิก <code>เปิด Agent.bat</code> ได้เลย ไม่ต้องทำซ้ำ
        </div>
      </div>
      <div class="card" style="background:#fff8e1;border-color:#f0c36d;padding:1rem 1.1rem">
        <div style="font-weight:700;color:#856404;margin-bottom:.35rem;font-size:.88rem">
          <i class="fa-solid fa-rotate" style="color:#f7b928"></i> เมื่อมีการอัปเดตเวอร์ชันใหม่
        </div>
        <div style="font-size:.8rem;color:#6b5005;line-height:1.7">
          ดาวน์โหลด Agent ใหม่ → แตกไฟล์ทับโฟลเดอร์เดิม → รัน <code>ติดตั้ง.bat</code> อีกครั้ง<br>
          <span style="color:#42b72a"><i class="fa-solid fa-circle-check" style="font-size:.72rem"></i> ข้อมูลและกลุ่มทั้งหมดไม่หาย</span>
        </div>
      </div>
    </div>

    <!-- Status cards -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem">
      <div class="card" style="text-align:center;padding:1.25rem .75rem">
        <div style="font-size:1.8rem;margin-bottom:.4rem" id="agentIcon">🔴</div>
        <div style="font-weight:700;color:var(--text-primary)" id="agentStatus">ออฟไลน์</div>
        <div style="font-size:.78rem;color:var(--text-secondary);margin-top:.2rem">สถานะ Agent</div>
      </div>
      <div class="card" style="text-align:center;padding:1.25rem .75rem">
        <div style="font-size:1.8rem;margin-bottom:.4rem" id="runnerIcon">⏹</div>
        <div style="font-weight:700;color:var(--text-primary)" id="runnerStatus">หยุด</div>
        <div style="font-size:.78rem;color:var(--text-secondary);margin-top:.2rem">Job Runner</div>
      </div>
      <div class="card" style="text-align:center;padding:1.25rem .75rem">
        <div style="font-size:1.8rem;margin-bottom:.4rem" id="dbIcon">🔴</div>
        <div style="font-weight:700;color:var(--text-primary)" id="dbStatus">—</div>
        <div style="font-size:.78rem;color:var(--text-secondary);margin-top:.2rem">Database</div>
      </div>
    </div>
    <div id="retryBar" style="text-align:center">
      <button onclick="checkAgent()" id="retryBtn"
        style="background:#fa5252;color:#fff;border:none;border-radius:8px;padding:.55rem 1.4rem;font-size:.88rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.45rem"
        onmouseover="this.style.background='#e03131'" onmouseout="this.style.background='#fa5252'">
        <i class="fa-solid fa-rotate-right"></i> ตรวจสอบอีกครั้ง
      </button>
    </div>

    <div class="card">
      <div class="card-title"><i class="fa-solid fa-circle-info"></i> วิธีใช้งาน (ครั้งแรก)</div>
      <div style="line-height:1.85;color:var(--text-secondary);font-size:.88rem">
        <p><strong style="color:var(--text-primary)">1.</strong> แตกไฟล์ zip → ดับเบิลคลิก <strong>ติดตั้ง.bat</strong> และรอให้ติดตั้งเสร็จ <span style="color:#42b72a;font-size:.82rem">(ทำแค่ครั้งแรกครั้งเดียว)</span></p>
        <p><strong style="color:var(--text-primary)">2.</strong> ดับเบิลคลิก <strong>เปิด Agent.bat</strong> เพื่อเริ่มโปรแกรม</p>
        <p><strong style="color:var(--text-primary)">3.</strong> ในโปรแกรม Agent → ไปแท็บ <strong>บัญชี Facebook</strong> → กรอกอีเมลและรหัสผ่าน → กด <strong>เข้าสู่ระบบ</strong></p>
        <p><strong style="color:var(--text-primary)">4.</strong> รอจนสถานะแสดง <strong style="color:#42b72a">"เข้าสู่ระบบแล้ว"</strong></p>
        <p><strong style="color:var(--text-primary)">5.</strong> กลับมาที่เว็บนี้ → <a href="/job-queue" style="color:#1877f2">คิวโพส</a> → สร้างงานโพสต์ → Agent จะรับงานและโพสอัตโนมัติ</p>
      </div>
    </div>

    <div class="card">
      <div class="card-title"><i class="fa-solid fa-plug"></i> การเชื่อมต่อ Agent <small style="font-weight:400;color:var(--text-secondary)">(localhost:3001)</small></div>
      <div id="agentDetails" style="color:var(--text-secondary);font-size:.88rem">กำลังตรวจสอบ...</div>
    </div>

  </main>
</div>

<style>
code { background:#f0f2f5;padding:.1rem .4rem;border-radius:4px;font-size:.82rem;font-family:monospace }
</style>

<script>
async function checkAgent() {
  const btn = document.getElementById('retryBtn');
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-rotate-right fa-spin"></i> กำลังตรวจสอบ...'; }
  try {
    const r   = await fetch('http://localhost:3001/api/status', { signal: AbortSignal.timeout(3000) });
    const d   = await r.json();
    document.getElementById('agentIcon').textContent    = '🟢';
    document.getElementById('agentStatus').textContent  = 'ออนไลน์';
    document.getElementById('runnerIcon').textContent   = d.running ? '▶' : '⏹';
    document.getElementById('runnerStatus').textContent = d.running ? 'กำลังทำงาน' : 'หยุด';
    document.getElementById('dbIcon').textContent       = d.dbConnected ? '🟢' : '🔴';
    document.getElementById('dbStatus').textContent     = d.dbConnected ? 'Connected' : 'Offline';
    document.getElementById('agentDetails').innerHTML   =
      `<span style="color:#42b72a;font-weight:600">✓ เชื่อมต่อสำเร็จ</span> · API version ${d.version||'—'} · Uptime: ${fmtUptime(d.uptime)} · Jobs: ${d.jobCount||0}`;
    document.getElementById('retryBar').style.display = 'none';
  } catch {
    document.getElementById('agentIcon').textContent    = '🔴';
    document.getElementById('agentStatus').textContent  = 'ออฟไลน์';
    document.getElementById('runnerIcon').textContent   = '⏹';
    document.getElementById('runnerStatus').textContent = 'หยุด';
    document.getElementById('dbIcon').textContent       = '—';
    document.getElementById('dbStatus').textContent     = '—';
    document.getElementById('agentDetails').innerHTML   =
      '<span style="color:#fa5252">✗ ไม่พบ Agent</span> — กรุณาเปิด <strong>เปิด Agent.bat</strong> ก่อน';
    document.getElementById('retryBar').style.display = 'block';
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-rotate-right"></i> ตรวจสอบอีกครั้ง'; }
  }
}
function fmtUptime(s){if(!s)return'—';const h=Math.floor(s/3600),m=Math.floor((s%3600)/60);return h?`${h}h ${m}m`:`${m}m`;}
checkAgent();
setInterval(checkAgent, 6000);
</script>

</body>
</html>
