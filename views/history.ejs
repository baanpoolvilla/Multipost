<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ประวัติโพสต์ - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.11.0/dist/tabler-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/auth-guard.js"></script>
  <script src="/js/navbar-user.js"></script>
</head>
<body class="eb">

<div class="app">

  <%- include('partials/sidebar', { active: 'phistory' }) %>

  <div class="main">

    <div class="card" style="padding:.85rem 1.25rem;display:flex;align-items:center;justify-content:space-between">
      <div class="card-title">
        <i class="fa-solid fa-clock-rotate-left"></i>
        ประวัติการโพสต์
        <span id="historyCount" style="background:#e4e6ea;padding:.15rem .55rem;border-radius:999px;font-size:.8rem;margin-left:.4rem"><%= posts.length %></span>
      </div>
    </div>

    <% if (posts.length > 0) { %>
    <!-- Filter bar -->
    <div class="card" style="padding:.85rem 1.25rem">
      <!-- Header row -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem">
        <span style="font-weight:700;font-size:.88rem;color:#444">
          <i class="fa-solid fa-filter" style="color:#1877f2;font-size:.8rem;margin-right:.3rem"></i>ค้นหาและกรอง
        </span>
        <div style="display:flex;gap:.4rem">
          <button onclick="toggleTimelineView()" id="btnTimelineView"
            style="background:#fff3cd;border:1px solid #ffe08a;border-radius:7px;padding:.22rem .6rem;font-size:.77rem;font-family:inherit;color:#856404;cursor:pointer;font-weight:600">
            <i class="fa-solid fa-calendar-days"></i> ปฏิทิน
          </button>
          <button onclick="clearFilters()" id="btnClearFilter"
            style="background:#fff0f0;border:1px solid #fcc;border-radius:7px;padding:.22rem .6rem;font-size:.77rem;font-family:inherit;color:#c62828;cursor:pointer;font-weight:600;transition:opacity .15s;opacity:.35;pointer-events:none">
            <i class="fa-solid fa-rotate-left"></i> ล้างตัวกรอง
          </button>
        </div>
      </div>

      <!-- Main filters grid -->
      <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:.65rem;margin-bottom:.65rem">
        <!-- Search -->
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-magnifying-glass" style="width:12px"></i> ค้นหาข้อความ
          </div>
          <div style="position:relative">
            <input id="hSearch" type="text" placeholder="พิมพ์คำค้น..." oninput="applyFilters()"
              style="width:100%;padding:.42rem .75rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;outline:none;box-sizing:border-box;transition:border-color .15s"
              onfocus="this.style.borderColor='#1877f2'" onblur="this.style.borderColor='#e4e6eb'">
          </div>
        </div>
        <!-- Status -->
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-circle-dot" style="width:12px"></i> สถานะ
          </div>
          <select id="hStatus" onchange="applyFilters()"
            style="width:100%;padding:.42rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;color:#444;background:#fff;cursor:pointer;outline:none">
            <option value="">ทั้งหมด</option>
            <option value="success">สำเร็จทั้งหมด</option>
            <option value="partial">มีล้มเหลว</option>
            <option value="scheduled">รอโพส</option>
          </select>
        </div>
        <!-- Page -->
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-brands fa-facebook" style="width:12px"></i> เพจ
          </div>
          <select id="hPage" onchange="applyFilters()"
            style="width:100%;padding:.42rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;color:#444;background:#fff;cursor:pointer;outline:none">
            <option value="">ทุกเพจ</option>
          </select>
        </div>
        <!-- Staff -->
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-user" style="width:12px"></i> พนักงาน
          </div>
          <select id="hStaff" onchange="applyFilters()"
            style="width:100%;padding:.42rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;color:#444;background:#fff;cursor:pointer;outline:none">
            <option value="">ทุกคน</option>
          </select>
        </div>
      </div>

      <!-- Date + time range row -->
      <div style="display:flex;align-items:flex-end;gap:.5rem;flex-wrap:wrap">
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-calendar-days" style="width:12px"></i> ตั้งแต่วันที่
          </div>
          <input type="date" lang="en-GB" id="hDateFrom" onchange="applyFilters()" title="ตั้งแต่วันที่"
            style="padding:.4rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#444;outline:none;cursor:pointer">
        </div>
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-clock" style="width:12px"></i> เวลา
          </div>
          <div class="dt24-wrap">
            <input type="number" id="hTimeFrom_h" min="0" max="23" placeholder="ชม." onchange="applyFilters()">
            <span>:</span>
            <input type="number" id="hTimeFrom_m" min="0" max="59" placeholder="นาที" onchange="applyFilters()">
          </div>
        </div>
        <div style="padding-bottom:.5rem;color:#bbb;font-size:.9rem">—</div>
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">ถึงวันที่</div>
          <input type="date" lang="en-GB" id="hDateTo" onchange="applyFilters()" title="ถึงวันที่"
            style="padding:.4rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#444;outline:none;cursor:pointer">
        </div>
        <div>
          <div style="font-size:.73rem;color:#8a8d91;font-weight:600;margin-bottom:.28rem">
            <i class="fa-solid fa-clock" style="width:12px"></i> เวลา
          </div>
          <div class="dt24-wrap">
            <input type="number" id="hTimeTo_h" min="0" max="23" placeholder="ชม." onchange="applyFilters()">
            <span>:</span>
            <input type="number" id="hTimeTo_m" min="0" max="59" placeholder="นาที" onchange="applyFilters()">
          </div>
        </div>
        <div id="hDateRangeErr" style="display:none;font-size:.75rem;color:#c62828;font-weight:600;align-self:flex-end;padding-bottom:.35rem">⚠️ วันที่เริ่มต้องไม่เกินวันที่สิ้นสุด</div>
      </div>

      <!-- Result info -->
      <div id="hFilterInfo" style="display:none;margin-top:.6rem;padding-top:.5rem;border-top:1px solid #f0f2f5;font-size:.79rem;color:#8a8d91">
        <i class="fa-solid fa-circle-info" style="color:#1877f2;margin-right:.3rem"></i>
        แสดง <strong id="hShown" style="color:#1877f2">0</strong> จาก <strong><%= posts.length %></strong> โพสต์
      </div>

      <!-- Bulk reschedule bar — shown only when filtering by "รอโพส" and items selected -->
      <div id="hBulkBar" style="display:none;margin-top:.6rem;padding-top:.6rem;border-top:1px solid #f0f2f5;align-items:center;gap:.5rem;flex-wrap:wrap">
        <span style="font-size:.8rem;color:#856404;font-weight:600">
          <i class="fa-solid fa-clock"></i> เลือกแล้ว <strong id="hSelCount">0</strong> รายการ
        </span>
        <button onclick="bulkReschedule()"
          style="background:#856404;color:#fff;border:none;border-radius:7px;padding:.32rem .7rem;font-size:.79rem;font-weight:600;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-clock-rotate-left"></i> เลื่อนเวลาทั้งหมด
        </button>
        <button onclick="clearSelection()"
          style="background:#f0f2f5;border:none;border-radius:7px;padding:.32rem .7rem;font-size:.79rem;cursor:pointer;color:#65676b;font-family:inherit">
          ล้างที่เลือก
        </button>
      </div>
    </div>
    <% } %>

    <div id="hTimelineView" class="card" style="display:none;padding:1rem 1.25rem;overflow-x:auto"></div>

    <% if (posts.length === 0) { %>
    <div class="card empty-state">
      <i class="fa-regular fa-face-meh-blank"></i>
      <h3>ยังไม่มีประวัติการโพสต์</h3>
      <p>เริ่มโพสต์ครั้งแรกได้เลย!</p>
      <a href="/" class="btn-post" style="text-decoration:none;margin-top:1rem">
        <i class="fa-solid fa-paper-plane"></i> เริ่มโพสต์
      </a>
    </div>
    <% } %>

    <% const colors = ['purple','green','orange','blue','red']; %>
    <% posts.forEach(post => { %>
    <% const isScheduled = post.status === 'pending'; %>
    <div class="card history-card" id="card-<%= post.id %>">

      <!-- Card header -->
      <div class="fb-post-header">
        <div class="avatar avatar-<%= isScheduled ? 'orange' : 'blue' %>">
          <i class="fa-solid fa-<%= isScheduled ? 'clock' : 'building' %>"></i>
        </div>
        <div style="flex:1">
          <div class="fb-post-author">
            <%= post.staffName || 'ไม่ระบุตัวตน' %>
            <% if (isScheduled) { %>
            <span style="background:#fff3cd;color:#856404;border-radius:999px;font-size:.7rem;padding:.1rem .45rem;font-weight:700;margin-left:.35rem">
              <i class="fa-solid fa-clock" style="font-size:.65rem"></i> รอโพส
            </span>
            <% } else if (post.feeling) { %>
            <span class="inline-feeling">รู้สึก <%= post.feeling.emoji %> <%= post.feeling.label %></span>
            <% } %>
          </div>
          <div class="fb-post-time">
            <% if (isScheduled) { %>
            <i class="fa-solid fa-calendar-clock"></i>
            โพสอัตโนมัติ <%= new Date(post.scheduledAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok', dateStyle:'short', timeStyle:'short' }) %>
            <% } else { %>
            <i class="fa-solid fa-earth-asia"></i>
            <%= new Date(post.lastAttemptAt || post.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok', dateStyle:'short', timeStyle:'short', hour12:false }) %>
            <% if (post.location) { %>
            &nbsp;·&nbsp;<i class="fa-solid fa-location-dot" style="color:#f5533d"></i> <%= post.location %>
            <% } %>
            <% } %>
          </div>
        </div>
        <div class="history-actions">
          <% if (!isScheduled) { %>
          <a href="/result/<%= post.id %>"
             style="display:inline-flex;align-items:center;gap:.28rem;background:#e7f0fd;color:#1877f2;border:none;border-radius:7px;padding:.28rem .65rem;font-size:.78rem;font-weight:700;text-decoration:none;transition:background .15s"
             onmouseover="this.style.background='#cfe2ff'" onmouseout="this.style.background='#e7f0fd'"
             title="ดูรายงานการโพส">
            <i class="fa-solid fa-chart-bar"></i> รายงาน
          </a>
          <% } %>
          <% if (isScheduled) { %>
          <input type="checkbox" class="hSelCb" data-id="<%= post.id %>" onchange="updateSelection()"
            style="accent-color:#856404;cursor:pointer;width:16px;height:16px" title="เลือกเพื่อเลื่อนเวลาทั้งหมด">
          <button onclick="reschedulePost('<%= post.id %>', '<%= post.scheduledAt || '' %>')"
            style="background:none;border:none;cursor:pointer;color:#856404;font-size:.85rem;padding:.1rem .3rem;border-radius:4px" title="แก้ไขเวลาโพส">
            <i class="fa-solid fa-clock"></i>
          </button>
          <% } %>
          <button class="icon-btn danger" title="ลบ" onclick="deletePost('<%= post.id %>', this)">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>

      <!-- Message -->
      <div class="history-message">
        <% const msg = post.message; %>
        <% if (msg.length > 200) { %>
          <span class="msg-short"><%= msg.slice(0, 200) %>...<button class="read-more-btn" onclick="toggleMsg(this)"> อ่านเพิ่มเติม</button></span>
          <span class="msg-full" style="display:none"><%= msg %><button class="read-more-btn" onclick="toggleMsg(this)"> ย่อ</button></span>
        <% } else { %>
          <%= msg %>
        <% } %>
      </div>

      <!-- Images / Videos -->
      <% if (post.images && post.images.length > 0) { %>
      <div class="post-img-grid post-img-<%= Math.min(post.images.length, 4) %>">
        <% post.images.slice(0, 4).forEach((img, i) => { %>
        <% const imgSrc = img.startsWith('http') ? img : '/uploads/' + img; %>
        <% const isVid  = /\.(mp4|mov|avi|webm)$/i.test(img); %>
        <div class="post-img-item <%= (i === 3 && post.images.length > 4) ? 'has-more' : '' %>"
             onclick="<%= isVid ? `viewVideo('${imgSrc}')` : `viewImage('${imgSrc}')` %>">
          <% if (isVid) { %>
          <video src="<%= imgSrc %>" style="width:100%;height:100%;object-fit:cover" muted playsinline
                 onerror="this.closest('.post-img-item').style.display='none'"></video>
          <% } else { %>
          <img src="<%= imgSrc %>" alt="รูปภาพ" loading="lazy"
               onerror="this.closest('.post-img-item').style.display='none'">
          <% } %>
          <% if (i === 3 && post.images.length > 4) { %>
          <div class="img-more-overlay">+<%= post.images.length - 4 %></div>
          <% } %>
        </div>
        <% }); %>
      </div>
      <% } %>

      <!-- Footer stats -->
      <div class="history-footer" <% if (isScheduled) { %>style="opacity:.5"<% } %>>
        <div class="history-pages" style="flex:1">
          <% const MAX_B = 8; %>
          <% post.results.slice(0, MAX_B).forEach((r, i) => { %>
          <span class="mini-page-badge <%= r.status %>">
            <div class="avatar avatar-<%= colors[i%5] %>" style="width:18px;height:18px;font-size:.6rem"><%= r.pageName.slice(-1) %></div>
            <%= r.pageName %>
            <i class="fa-solid fa-<%= r.status === 'success' ? 'check' : 'xmark' %>"></i>
          </span>
          <% }); %>
          <% if (post.results.length > MAX_B) { %>
          <button class="mini-more-btn" onclick="toggleMoreBadges(this, '<%= post.id %>')">
            + <%= post.results.length - MAX_B %> เพจ
          </button>
          <span class="mini-more-group" id="mb-<%= post.id %>" style="display:none;flex-wrap:wrap;gap:.25rem">
            <% post.results.slice(MAX_B).forEach((r, i) => { %>
            <span class="mini-page-badge <%= r.status %>">
              <div class="avatar avatar-<%= colors[(i+MAX_B)%5] %>" style="width:18px;height:18px;font-size:.6rem"><%= r.pageName.slice(-1) %></div>
              <%= r.pageName %>
              <i class="fa-solid fa-<%= r.status === 'success' ? 'check' : 'xmark' %>"></i>
            </span>
            <% }); %>
          </span>
          <% } %>
        </div>
        <div class="history-summary">
          <span class="pill pill-success" style="font-size:.75rem;padding:.2rem .6rem">
            <i class="fa-solid fa-check"></i> <%= post.successCount %>
          </span>
          <% if (post.failCount > 0) { %>
          <span class="pill pill-fail" style="font-size:.75rem;padding:.2rem .6rem">
            <i class="fa-solid fa-xmark"></i> <%= post.failCount %>
          </span>
          <% } %>
        </div>
      </div>

    </div>
    <% }); %>

  </div>

  <aside class="right-panel">
    <div class="card stats-card" onclick="showSummaryModal()" style="cursor:pointer;transition:box-shadow .15s" onmouseover="this.style.boxShadow='0 0 0 2px #1877f2'" onmouseout="this.style.boxShadow=''">
      <div class="stats-title" style="display:flex;align-items:center;justify-content:space-between">
        <span><i class="fa-solid fa-chart-simple"></i> สถิติรวม</span>
      </div>
      <%
        const totalPosts = posts.length;
        const totalSuccess = posts.reduce((s, p) => s + p.successCount, 0);
        const totalFail = posts.reduce((s, p) => s + p.failCount, 0);
      %>
      <div class="stats-row"><span>โพสต์ทั้งหมด</span><span class="stats-val blue" id="statPosts"><%= totalPosts %></span></div>
      <div class="stats-row"><span>ส่งสำเร็จ</span><span class="stats-val green" id="statSuccess"><%= totalSuccess %></span></div>
      <div class="stats-row"><span>ล้มเหลว</span><span class="stats-val red" id="statFail"><%= totalFail %></span></div>
    </div>
  </aside>

</div>

<script>
  function dt24Get(prefix) {
    const d = document.getElementById(prefix+'_d')?.value;
    if (!d) return '';
    const h = String(document.getElementById(prefix+'_h').value||0).padStart(2,'0');
    const m = String(document.getElementById(prefix+'_m').value||0).padStart(2,'0');
    return `${d}T${h}:${m}`;
  }
  function _fpSetDate(el, dateStr) {
    if (!el) return;
    if (el._flatpickr) el._flatpickr.setDate(dateStr || null, false);
    else el.value = dateStr || '';
  }
  function dt24Set(prefix, localStr) {
    const [d,t] = (localStr||'').split('T');
    _fpSetDate(document.getElementById(prefix+'_d'), d);
    const [h,m] = (t||'').split(':');
    document.getElementById(prefix+'_h').value = h||'';
    document.getElementById(prefix+'_m').value = m||'';
  }
  function t24Get(prefix) {
    const h = document.getElementById(prefix+'_h')?.value;
    if (h === '' || h == null) return '';
    const m = document.getElementById(prefix+'_m')?.value;
    return `${String(h).padStart(2,'0')}:${String(m||0).padStart(2,'0')}`;
  }
  function t24Set(prefix, hhmm) {
    const [h,m] = (hhmm||'').split(':');
    document.getElementById(prefix+'_h').value = h||'';
    document.getElementById(prefix+'_m').value = m||'';
  }

  // Embedded post data for client-side filtering
  const _hPosts = <%- JSON.stringify(posts.map(p => ({
    id:      p.id,
    msg:     p.message || '',
    at:      p.status === 'pending' ? p.scheduledAt : (p.lastAttemptAt || p.createdAt),
    success: p.successCount || 0,
    fail:    p.failCount || 0,
    status:  p.status || 'success',
    pages:   (p.results || []).map(r => r.pageName),
    staffId:   p.staffId || null,
    staffName: p.staffName || 'ไม่ระบุตัวตน',
  }))) %>;

  // Populate page select
  (function() {
    const sel = document.getElementById('hPage');
    if (!sel) return;
    const pgs = new Set();
    _hPosts.forEach(p => p.pages.forEach(pg => pgs.add(pg)));
    [...pgs].sort().forEach(pg => {
      const o = document.createElement('option');
      o.value = o.textContent = pg;
      sel.appendChild(o);
    });
  })();

  // Populate staff select (only names that actually appear in this data)
  (function() {
    const sel = document.getElementById('hStaff');
    if (!sel) return;
    const seen = new Map();
    _hPosts.forEach(p => seen.set(p.staffId || '__unassigned__', p.staffName));
    [...seen.entries()].sort((a,b) => a[1].localeCompare(b[1], 'th')).forEach(([id, name]) => {
      const o = document.createElement('option');
      o.value = id; o.textContent = name;
      sel.appendChild(o);
    });
  })();

  function applyFilters() {
    const q         = (document.getElementById('hSearch')?.value || '').toLowerCase().trim();
    const st        = document.getElementById('hStatus')?.value   || '';
    const fromVal   = document.getElementById('hDateFrom')?.value || '';
    const toVal     = document.getElementById('hDateTo')?.value   || '';
    const timeFrom  = t24Get('hTimeFrom');
    const timeTo    = t24Get('hTimeTo');
    const pg        = document.getElementById('hPage')?.value     || '';
    const staff     = document.getElementById('hStaff')?.value    || '';

    // Date range validation
    const _drBad = fromVal && toVal && fromVal > toVal;
    document.getElementById('hDateFrom').style.borderColor = _drBad ? '#c62828' : '';
    document.getElementById('hDateTo').style.borderColor   = _drBad ? '#c62828' : '';
    document.getElementById('hDateRangeErr').style.display = _drBad ? 'flex' : 'none';
    if (_drBad) return;

    let fromTs = null, toTs = null;
    if (fromVal) {
      const [fh, fm] = timeFrom ? timeFrom.split(':').map(Number) : [0, 0];
      fromTs = new Date(fromVal).setHours(fh, fm, 0, 0);
    }
    if (toVal) {
      const [th, tm] = timeTo ? timeTo.split(':').map(Number) : [23, 59];
      toTs = new Date(toVal).setHours(th, tm, 59, 999);
    }
    // Time-only filter (no date): filter by time-of-day across all dates
    const timeOnlyFrom = !fromVal && timeFrom ? timeFrom : null;
    const timeOnlyTo   = !toVal   && timeTo   ? timeTo   : null;
    let shown = 0, sumSuccess = 0, sumFail = 0;

    _hPosts.forEach(p => {
      const card = document.getElementById('card-' + p.id);
      if (!card) return;
      let ok = true;
      if (q  && !p.msg.toLowerCase().includes(q))       ok = false;
      if (st === 'success'   && p.fail > 0)              ok = false;
      if (st === 'partial'   && p.fail === 0)            ok = false;
      if (st === 'scheduled' && p.status !== 'pending') ok = false;
      const postDate = new Date(p.at);
      const postTs   = postDate.getTime();
      if (fromTs !== null && postTs < fromTs)       ok = false;
      if (toTs   !== null && postTs > toTs)         ok = false;
      if (timeOnlyFrom) {
        const postTime = postDate.toTimeString().slice(0,5);
        if (postTime < timeOnlyFrom)                ok = false;
      }
      if (timeOnlyTo) {
        const postTime = postDate.toTimeString().slice(0,5);
        if (postTime > timeOnlyTo)                  ok = false;
      }
      if (pg && !p.pages.includes(pg))              ok = false;
      if (staff && (p.staffId || '__unassigned__') !== staff) ok = false;
      card.style.display = ok ? '' : 'none';
      if (ok) { shown++; sumSuccess += p.success; sumFail += p.fail; }
    });

    const hasFilter = q || st || fromVal || toVal || timeFrom || timeTo || pg || staff;
    const info = document.getElementById('hFilterInfo');
    if (info) {
      info.style.display = hasFilter ? 'block' : 'none';
      const el = document.getElementById('hShown');
      if (el) el.textContent = shown;
    }
    const cnt = document.getElementById('historyCount');
    if (cnt) cnt.textContent = hasFilter ? shown : _hPosts.length;
    // Update right-panel stats dynamically
    const sP = document.getElementById('statPosts');   if (sP) sP.textContent = shown;
    const sS = document.getElementById('statSuccess'); if (sS) sS.textContent = hasFilter ? sumSuccess : <%- posts.reduce((s,p)=>s+p.successCount,0) %>;
    const sF = document.getElementById('statFail');    if (sF) sF.textContent = hasFilter ? sumFail : <%- posts.reduce((s,p)=>s+p.failCount,0) %>;
    const btnClear = document.getElementById('btnClearFilter');
    if (btnClear) {
      btnClear.style.opacity = hasFilter ? '1' : '.35';
      btnClear.style.pointerEvents = hasFilter ? '' : 'none';
    }
    updateSelection();
  }

  function clearFilters() {
    ['hSearch','hStatus','hDateFrom','hDateTo','hPage','hStaff'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    t24Set('hTimeFrom', ''); t24Set('hTimeTo', '');
    applyFilters();
  }

  function updateSelection() {
    const checked = [...document.querySelectorAll('.hSelCb')].filter(cb => cb.checked && cb.closest('.history-card').style.display !== 'none');
    const bar = document.getElementById('hBulkBar');
    if (bar) bar.style.display = checked.length ? 'flex' : 'none';
    const cnt = document.getElementById('hSelCount');
    if (cnt) cnt.textContent = checked.length;
  }

  function clearSelection() {
    document.querySelectorAll('.hSelCb').forEach(cb => cb.checked = false);
    updateSelection();
  }

  async function bulkReschedule() {
    const ids = [...document.querySelectorAll('.hSelCb')].filter(cb => cb.checked).map(cb => cb.dataset.id);
    if (!ids.length) return;
    const { value, isConfirmed } = await Swal.fire({
      title: `<i class="fa-solid fa-clock" style="color:#856404"></i> เลื่อนเวลาโพส ${ids.length} รายการ`,
      html: `<div style="text-align:left;display:flex;flex-direction:column;gap:.4rem">
        <label style="font-size:.8rem;font-weight:600;color:#555">วันที่และเวลาใหม่ (ใช้กับทุกรายการที่เลือก)</label>
        <div class="dt24-wrap">
          <input type="date" lang="en-GB" id="swal-bulkAt_d">
          <input type="number" id="swal-bulkAt_h" min="0" max="23" placeholder="ชม.">
          <span>:</span>
          <input type="number" id="swal-bulkAt_m" min="0" max="59" placeholder="นาที">
        </div>
      </div>`,
      confirmButtonText: 'บันทึกทั้งหมด', confirmButtonColor: '#856404',
      showCancelButton: true, cancelButtonText: 'ยกเลิก', focusConfirm: false,
      preConfirm: () => {
        const v = dt24Get('swal-bulkAt');
        if (!v) { Swal.showValidationMessage('กรุณาเลือกวันที่และเวลา'); return false; }
        return v;
      },
    });
    if (!isConfirmed) return;
    const scheduledAt = new Date(value + ':00+07:00').toISOString();
    try {
      await Promise.all(ids.map(id => fetch(`/posts/${id}/reschedule`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ scheduledAt }),
      })));
      location.reload();
    } catch(e) {
      Swal.fire({ icon: 'error', title: 'เลื่อนเวลาไม่สำเร็จ', text: e.message, confirmButtonColor: '#1877f2' });
    }
  }

  function viewImage(src) {
    Swal.fire({ imageUrl: src, imageAlt: 'รูปภาพ', showConfirmButton: false, showCloseButton: true, width: 'auto' });
  }

  function viewVideo(src) {
