<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ภาพรวมแชร์กลุ่ม - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <a href="/" class="btn-back"><i class="fa-solid fa-plus"></i> โพสต์ใหม่</a>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-calendar-days"></i><span>Schedule Center</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/group-overview" class="sidebar-item active"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <!-- Header -->
    <div class="card" style="padding:.8rem 1.25rem">
      <div class="card-title" style="font-size:1.05rem;display:flex;align-items:center;flex-wrap:wrap;gap:.5rem;justify-content:space-between">
        <div style="display:flex;align-items:center;gap:.5rem">
          <i class="fa-solid fa-users-rectangle" style="color:#2e7d32"></i>
          ภาพรวมแชร์กลุ่ม
        </div>
        <div style="display:flex;gap:.4rem;flex-wrap:wrap">
          <button onclick="showGroupRangeModal()" style="background:#e8fde8;color:#2e7d32;border:1.5px solid #2e7d32;border-radius:8px;padding:.35rem .85rem;font-size:.82rem;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:.4rem">
            <i class="fa-solid fa-chart-bar"></i> สรุปช่วงเวลา
          </button>
        </div>
      </div>
    </div>

    <!-- Metric cards -->
    <div class="overview-grid">
      <div class="metric-card green">
        <div class="metric-icon"><i class="fa-solid fa-list-check"></i></div>
        <div class="metric-body">
          <div class="metric-val"><%= totalJobs %></div>
          <div class="metric-label">งานทั้งหมด</div>
        </div>
      </div>
      <div class="metric-card green" style="border:2px solid #059669;background:#f0fdf4">
        <div class="metric-icon" style="background:#059669"><i class="fa-solid fa-circle-check"></i></div>
        <div class="metric-body">
          <div class="metric-val" style="color:#059669"><%= totalSuccess %></div>
          <div class="metric-label">โพสกลุ่มสำเร็จ</div>
        </div>
      </div>
      <div class="metric-card red">
        <div class="metric-icon"><i class="fa-solid fa-circle-xmark"></i></div>
        <div class="metric-body">
          <div class="metric-val"><%= totalFail %></div>
          <div class="metric-label">ล้มเหลว</div>
        </div>
      </div>
      <div class="metric-card green" style="border:2px solid #2e7d32;background:#f0fff4">
        <div class="metric-icon" style="background:#2e7d32"><i class="fa-solid fa-chart-pie"></i></div>
        <div class="metric-body">
          <div class="metric-val" style="color:#2e7d32"><%= successRate %>%</div>
          <div class="metric-label">อัตราสำเร็จ</div>
        </div>
      </div>
    </div>

    <!-- Group stats table -->
    <% if (allGroupStats.length > 0) { %>
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.6rem;margin-bottom:1rem">
        <div class="card-title" style="margin-bottom:0">
          <i class="fa-solid fa-layer-group"></i> สถิติแต่ละกลุ่ม
        </div>
        <div style="position:relative">
          <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:.6rem;top:50%;transform:translateY(-50%);color:#8a8d91;font-size:.8rem;pointer-events:none"></i>
          <input id="grp-search" type="text" placeholder="ค้นหาชื่อกลุ่ม..." oninput="filterGrpTable(this.value)"
            style="padding:.35rem .7rem .35rem 1.9rem;border:1px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;width:180px;outline:none;color:#333">
        </div>
      </div>
      <div class="overview-table-wrap">
        <table class="overview-table">
          <thead>
            <tr>
              <th>กลุ่ม</th>
              <th><i class="fa-solid fa-paper-plane"></i> แชร์</th>
              <th><i class="fa-solid fa-circle-check" style="color:#2e7d32"></i> สำเร็จ</th>
              <th><i class="fa-solid fa-circle-xmark" style="color:#c62828"></i> ล้มเหลว</th>
              <th><i class="fa-solid fa-thumbs-up" style="color:#8b5cf6"></i> ไลค์</th>
              <th><i class="fa-solid fa-comment" style="color:#f59e0b"></i> คอม</th>
              <th><i class="fa-solid fa-share-nodes" style="color:#0891b2"></i> แชร์</th>
              <th>อัตราสำเร็จ</th>
            </tr>
          </thead>
          <tbody id="grp-tbody">
            <%
              const totalAllSuccess = allGroupStats.reduce((s,g)=>s+g.success,0);
              const totalAllFail    = allGroupStats.reduce((s,g)=>s+g.fail,0);
              const totalAllTotal   = totalAllSuccess + totalAllFail;
              const totalAllRate    = totalAllTotal > 0 ? Math.round(totalAllSuccess/totalAllTotal*100) : 0;
              const totalAllLikes   = allGroupStats.reduce((s,g)=>s+(g.likes||0),0);
              const totalAllCom     = allGroupStats.reduce((s,g)=>s+(g.comments||0),0);
              const totalAllShares  = allGroupStats.reduce((s,g)=>s+(g.shares||0),0);
            %>
            <!-- Summary row -->
            <tr style="background:#f0fdf4;font-weight:700">
              <td><i class="fa-solid fa-sigma" style="color:#2e7d32;margin-right:.35rem"></i>สรุปรวม (<%= allGroupStats.length %> กลุ่ม)</td>
              <td class="num"><%= totalAllTotal %></td>
              <td class="num" style="color:#2e7d32"><%= totalAllSuccess %></td>
              <td class="num" style="color:#c62828"><%= totalAllFail %></td>
              <td class="num" style="color:#8b5cf6"><%= totalAllLikes > 0 ? totalAllLikes.toLocaleString() : '—' %></td>
              <td class="num" style="color:#f59e0b"><%= totalAllCom > 0 ? totalAllCom.toLocaleString() : '—' %></td>
              <td class="num" style="color:#0891b2"><%= totalAllShares > 0 ? totalAllShares.toLocaleString() : '—' %></td>
              <td>
                <div class="rate-bar-wrap">
                  <div class="rate-bar" style="width:<%= totalAllRate %>%;background:#2e7d32"></div>
                  <span class="rate-text"><%= totalAllRate %>%</span>
                </div>
              </td>
            </tr>
            <% allGroupStats.forEach((g, i) => { %>
            <% const total = g.success + g.fail; const rate = total > 0 ? Math.round(g.success/total*100) : 0; %>
            <tr class="grp-row" data-name="<%= g.name.toLowerCase() %>" data-index="<%= i %>">
              <td>
                <div style="display:flex;align-items:center;gap:.5rem">
                  <div class="avatar avatar-green avatar-sm" style="background:#2e7d32"><%= g.name.slice(0,1).toUpperCase() %></div>
                  <span style="font-weight:600"><%= g.name %></span>
                </div>
              </td>
              <td class="num"><%= total %></td>
              <td class="num" style="color:#2e7d32"><%= g.success %></td>
              <td class="num" style="color:#c62828"><%= g.fail %></td>
              <td class="num" style="color:#8b5cf6"><%= (g.likes||0) > 0 ? (g.likes||0).toLocaleString() : '—' %></td>
              <td class="num" style="color:#f59e0b"><%= (g.comments||0) > 0 ? (g.comments||0).toLocaleString() : '—' %></td>
              <td class="num" style="color:#0891b2"><%= (g.shares||0) > 0 ? (g.shares||0).toLocaleString() : '—' %></td>
              <td>
                <div class="rate-bar-wrap">
                  <div class="rate-bar" style="width:<%= rate %>%;background:#2e7d32"></div>
                  <span class="rate-text"><%= rate %>%</span>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (allGroupStats.length > 8) { %>
      <div id="grp-show-more" style="text-align:center;margin-top:.75rem">
        <button onclick="showAllGrps()" style="background:none;border:1px solid #2e7d32;color:#2e7d32;border-radius:8px;padding:.35rem 1.1rem;font-size:.82rem;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-chevron-down"></i> ดูทั้งหมด
        </button>
      </div>
      <% } %>
    </div>
    <% } %>

    <!-- Chart -->
    <div class="card">
      <div class="card-title" style="margin-bottom:1rem">
        <i class="fa-solid fa-chart-bar"></i> งานแชร์กลุ่ม 7 วันที่ผ่านมา
      </div>
      <canvas id="grpChart" height="90"></canvas>
    </div>

    <!-- Recent jobs -->
    <% if (recentJobs.length > 0) { %>
    <div class="card">
      <div class="card-title" style="margin-bottom:.85rem">
        <i class="fa-solid fa-clock-rotate-left"></i> งานล่าสุด
      </div>
      <% recentJobs.forEach(job => { %>
      <%
        const allOk   = job.successCount > 0 && job.failCount === 0;
        const allFail = job.successCount === 0;
        const jmsg    = (job.message || '');
        const jdisplay = jmsg.includes('|||') ? (jmsg.slice(0, jmsg.indexOf('|||')).trim() || jmsg.slice(jmsg.indexOf('|||')+3).trim()) : jmsg;
      %>
      <div class="overview-post-row">
        <div class="overview-post-msg">
          <div style="display:flex;align-items:center;gap:.4rem;margin-bottom:.2rem">
            <span style="background:<%= allOk?'#d1e7dd':allFail?'#f8d7da':'#fff3cd' %>;color:<%= allOk?'#0a3622':allFail?'#842029':'#856404' %>;border-radius:999px;font-size:.7rem;padding:.08rem .45rem;font-weight:700">
              <%= allOk?'สำเร็จทั้งหมด':allFail?'ล้มเหลว':`${job.successCount}/${job.groupCount} กลุ่ม` %>
            </span>
            <a href="/group-result/<%= job._id %>" style="color:#1877f2;font-size:.75rem;text-decoration:none"><i class="fa-solid fa-chart-bar"></i> รายงาน</a>
          </div>
          <div style="font-size:.85rem;color:var(--text);line-height:1.4"><%= jdisplay.length>80?jdisplay.slice(0,80)+'…':jdisplay %></div>
          <div style="font-size:.75rem;color:var(--text3);margin-top:.2rem">
            <i class="fa-regular fa-clock"></i> <%= new Date(job.createdAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}) %>
            &nbsp;·&nbsp;<i class="fa-solid fa-users"></i> <%= job.groupCount %> กลุ่ม
          </div>
        </div>
        <div class="overview-post-stats">
          <span style="color:#2e7d32;font-weight:700"><i class="fa-solid fa-circle-check"></i> <%= job.successCount %></span>
          <span style="color:#c62828"><i class="fa-solid fa-circle-xmark"></i> <%= job.failCount %></span>
        </div>
      </div>
      <% }); %>
      <div style="text-align:center;margin-top:.75rem">
        <a href="/group-history" style="color:#2e7d32;font-size:.83rem;font-weight:600;text-decoration:none">
          <i class="fa-solid fa-chevron-down"></i> ดูประวัติทั้งหมด
        </a>
      </div>
    </div>
    <% } else { %>
    <div class="card empty-state">
      <i class="fa-solid fa-users-rectangle"></i>
      <h3>ยังไม่มีข้อมูลแชร์กลุ่ม</h3>
      <p>ติดตั้ง Desktop Agent แล้วเริ่มแชร์ลงกลุ่มได้เลย</p>
      <a href="/agent" class="btn-post" style="text-decoration:none;margin-top:1rem">
        <i class="fa-solid fa-robot"></i> ติดตั้ง Desktop Agent
      </a>
    </div>
    <% } %>

  </main>

  <aside class="right-panel">
    <div class="card stats-card">
      <div class="stats-title">
        <span><i class="fa-solid fa-ranking-star" style="color:#f7b928"></i> Top กลุ่ม</span>
      </div>
      <% if (allGroupStats.length === 0) { %>
      <p style="font-size:.82rem;color:#8a8d91;margin-top:.4rem">ยังไม่มีข้อมูล</p>
      <% } %>
      <% const medals = ['🥇','🥈','🥉','4️⃣','5️⃣']; %>
      <%
        const topSorted = [...allGroupStats].sort((a,b) => {
          const ta = a.success+a.fail, tb = b.success+b.fail;
          return (tb>0?b.success/tb:0)-(ta>0?a.success/ta:0);
        }).slice(0,3);
      %>
      <% topSorted.forEach((g, i) => { %>
      <% const gtot = g.success + g.fail; const grate = gtot > 0 ? Math.round(g.success/gtot*100) : 0; %>
      <div style="padding:.5rem 0;border-bottom:1px solid var(--border)">
        <div style="display:flex;align-items:center;gap:.35rem;margin-bottom:.25rem">
          <span><%= medals[i] %></span>
          <span style="font-weight:600;font-size:.83rem;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= g.name %></span>
          <span style="font-size:.7rem;color:#888"><%= grate %>%</span>
        </div>
        <div style="display:flex;gap:.75rem;font-size:.75rem;color:var(--text3)">
          <span>✅ <b style="color:#2e7d32"><%= g.success %></b></span>
          <span>❌ <b style="color:#c62828"><%= g.fail %></b></span>
        </div>
      </div>
      <% }); %>
    </div>
  </aside>

</div>

<script>
function t24Get(prefix) {
  const h = document.getElementById(prefix+'_h')?.value;
  if (h === '' || h == null) return '';
  const m = document.getElementById(prefix+'_m')?.value;
  return `${String(h).padStart(2,'0')}:${String(m||0).padStart(2,'0')}`;
}
function t24Set(prefix, hhmm) {
  const [h,m] = (hhmm||'').split(':');
  document.getElementById(prefix+'_h').value = h||'';
  document.getElementById(prefix+'_m').value = m||'';
}

const RANK_MEDALS = ['🥇','🥈','🥉','4️⃣','5️⃣'];

/* ── Group table filter + show-more ── */
const GRP_LIMIT = 8;
let grpShowAll = false;
function applyGrpVisibility(q) {
  const rows = document.querySelectorAll('.grp-row');
  rows.forEach(r => {
    const match = !q || r.dataset.name.includes(q);
    const withinLimit = grpShowAll || parseInt(r.dataset.index) < GRP_LIMIT;
    r.style.display = match && withinLimit ? '' : 'none';
  });
  const wrap = document.getElementById('grp-show-more');
  if (wrap) wrap.style.display = (!grpShowAll && !q && rows.length > GRP_LIMIT) ? '' : 'none';
}
function filterGrpTable(q) { grpShowAll = !!q; applyGrpVisibility(q.toLowerCase()); }
function showAllGrps() { grpShowAll = true; applyGrpVisibility((document.getElementById('grp-search')?.value||'').toLowerCase()); }
applyGrpVisibility('');

function _fmtDateTH(d) {
  return new Date(d + 'T00:00:00').toLocaleDateString('th-TH', { dateStyle:'short' });
}

function _rankRowsHtml(items) {
  if (!items || !items.length) return '<div style="font-size:.8rem;color:#bbb;text-align:center;padding:.4rem 0">ไม่มีข้อมูล</div>';
  return items.map((item, i) => {
    const total = (item.success||0) + (item.fail||0);
    const rate  = total > 0 ? Math.round(item.success/total*100) : 0;
    return `<div style="display:flex;align-items:center;justify-content:space-between;font-size:.82rem;padding:.2rem 0;border-bottom:1px solid #f0f2f5">
      <span>${RANK_MEDALS[i]} ${item.name||'—'}</span>
      <span><b style="color:#2e7d32">${item.success}</b><span style="color:#bbb">/</span><span style="color:#555">${total}</span> <span style="font-size:.7rem;background:#e8fde8;color:#2e7d32;border-radius:4px;padding:.05rem .3rem">${rate}%</span></span>
    </div>`;
  }).join('');
}

async function showGroupRangeModal() {
  const _is = 'width:100%;padding:.38rem .55rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.85rem;font-family:inherit;color:#333;outline:none;box-sizing:border-box';
  const _ls = 'font-size:.8rem;font-weight:600;color:#555;display:block;margin-bottom:.2rem';
  const { value: dates } = await Swal.fire({
    title: '<i class="fa-solid fa-users" style="color:#2e7d32"></i> สถิติแชร์กลุ่มตามช่วงเวลา',
    html: `<div style="text-align:left;display:flex;flex-direction:column;gap:.55rem">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
        <div><label style="${_ls}">วันที่เริ่ม</label>
          <input id="gr-from" type="date" lang="en-GB" style="${_is}"></div>
        <div><label style="${_ls}">วันที่สิ้นสุด</label>
          <input id="gr-to" type="date" lang="en-GB" style="${_is}"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
        <div><label style="${_ls}">เวลาเริ่ม (ไม่บังคับ)</label>
          <div class="dt24-wrap"><input type="number" id="gr-tfrom_h" min="0" max="23" placeholder="ชม."><span>:</span><input type="number" id="gr-tfrom_m" min="0" max="59" placeholder="นาที"></div></div>
        <div><label style="${_ls}">เวลาสิ้นสุด (ไม่บังคับ)</label>
          <div class="dt24-wrap"><input type="number" id="gr-tto_h" min="0" max="23" placeholder="ชม."><span>:</span><input type="number" id="gr-tto_m" min="0" max="59" placeholder="นาที"></div></div>
      </div>
    </div>`,
    confirmButtonText: 'ดูสถิติ', confirmButtonColor: '#2e7d32',
    showCancelButton: true, cancelButtonText: 'ยกเลิก', focusConfirm: false,
    didOpen: () => {
      const _bkk = () => new Date(new Date().toLocaleString('en-US', { timeZone:'Asia/Bangkok' }));
      const _pad = n => String(n).padStart(2,'0');
      const _now = _bkk();
      const _today = `${_now.getFullYear()}-${_pad(_now.getMonth()+1)}-${_pad(_now.getDate())}`;
      const _fillTime = (hId, mId) => { const n=_bkk(); document.getElementById(hId).value=n.getHours(); document.getElementById(mId).value=n.getMinutes(); };
      document.getElementById('gr-from').addEventListener('change', e => { if(e.target.value===_today) _fillTime('gr-tfrom_h','gr-tfrom_m'); });
      document.getElementById('gr-to').addEventListener('change',   e => { if(e.target.value===_today) _fillTime('gr-tto_h','gr-tto_m'); });
    },
    preConfirm: () => {
      const from  = document.getElementById('gr-from').value;
      const to    = document.getElementById('gr-to').value;
      const tfrom = t24Get('gr-tfrom');
      const tto   = t24Get('gr-tto');
      if (from && to && from > to) { Swal.showValidationMessage('⚠️ วันที่เริ่มต้องไม่เกินวันที่สิ้นสุด'); return false; }
      if (from && to && from === to && tfrom && tto && tfrom > tto) { Swal.showValidationMessage('⚠️ เวลาเริ่มต้องไม่เกินเวลาสิ้นสุด'); return false; }
      return { from, to, tfrom, tto };
    },
  });
  if (!dates) return;
  Swal.fire({ title: 'กำลังโหลด...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
  try {
    const params = new URLSearchParams();
    if (dates.from)  params.set('from', dates.from);
    if (dates.to)    params.set('to',   dates.to);
    if (dates.tfrom) params.set('timeFrom', dates.tfrom);
    if (dates.tto)   params.set('timeTo',   dates.tto);
    const res  = await fetch('/api/stats/combined?' + params);
    const data = await res.json();
    if (!data.ok) throw new Error('API error');
    const g = data.groupStats;
    const dateLabel = dates.from || dates.to
      ? `${dates.from ? _fmtDateTH(dates.from) : '—'} ถึง ${dates.to ? _fmtDateTH(dates.to) : '—'}`
      : 'ข้อมูลทั้งหมด';
    const timeLabel = dates.tfrom ? ` เวลา ${dates.tfrom}${dates.tto ? '–'+dates.tto : ''}` : '';
    const label = (dates.from || dates.to) ? `ช่วง: ${dateLabel}${timeLabel}` : 'ข้อมูลทั้งหมด';
    Swal.fire({
      title: `<i class="fa-solid fa-users" style="color:#2e7d32"></i> แชร์ลงกลุ่ม`,
      html: `<div style="text-align:left">
        <div style="font-size:.78rem;color:#8a8d91;margin-bottom:.6rem">${label}</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-bottom:.8rem">
          <div style="background:#f0fdf4;border-radius:8px;padding:.5rem .6rem;text-align:center">
            <div style="font-size:1.3rem;font-weight:700;color:#2e7d32">${g.total}</div>
            <div style="font-size:.72rem;color:#555">งาน (Job)</div>
          </div>
          <div style="background:#e8fde8;border-radius:8px;padding:.5rem .6rem;text-align:center">
            <div style="font-size:1.3rem;font-weight:700;color:#059669">${g.success}</div>
            <div style="font-size:.72rem;color:#555">สำเร็จ</div>
          </div>
          <div style="background:#fff5f5;border-radius:8px;padding:.5rem .6rem;text-align:center">
            <div style="font-size:1.3rem;font-weight:700;color:#c62828">${g.fail}</div>
            <div style="font-size:.72rem;color:#555">ล้มเหลว</div>
          </div>
        </div>
        <div style="font-size:.75rem;font-weight:700;color:#555;margin-bottom:.4rem"><i class="fa-solid fa-ranking-star" style="color:#1877f2"></i> 5 อันดับกลุ่ม</div>
        ${_rankRowsHtml(data.topGroups)}
      </div>`,
      confirmButtonText: 'ปิด', confirmButtonColor: '#2e7d32', width: '440px',
    });
  } catch { Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: 'ไม่สามารถโหลดข้อมูลได้' }); }
}

/* ── Chart ── */
const ctx = document.getElementById('grpChart');
if (ctx) {
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: <%- chartLabels %>,
      datasets: [{
        label: 'งานแชร์กลุ่ม',
        data: <%- chartData %>,
        backgroundColor: 'rgba(46,125,50,.7)',
        borderColor: '#2e7d32',
        borderWidth: 1,
        borderRadius: 6,
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f0f2f5' } },
        x: { grid: { display: false } }
      }
    }
  });
}
</script>
