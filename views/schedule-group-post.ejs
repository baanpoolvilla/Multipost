<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>โพสตั้งเวลากลุ่ม - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <div class="nav-avatar"><i class="fa-solid fa-user"></i></div>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <!-- Sidebar -->
  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item active"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <!-- Feed -->
  <main class="feed">

    <!-- Back breadcrumb -->
    <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.6rem">
      <a href="/job-queue"
        style="display:inline-flex;align-items:center;gap:.35rem;color:#65676b;font-size:.82rem;text-decoration:none;padding:.25rem .55rem;border-radius:8px;transition:background .14s"
        onmouseover="this.style.background='#f0f2f5'" onmouseout="this.style.background='transparent'">
        <i class="fa-solid fa-arrow-left"></i> คิวโพสกลุ่ม
      </a>
      <i class="fa-solid fa-chevron-right" style="font-size:.6rem;color:#bbb"></i>
      <span style="font-size:.82rem;color:#2e7d32;font-weight:700">
        <i class="fa-solid fa-calendar-clock"></i> โพสตั้งเวลากลุ่ม
      </span>
    </div>

    <!-- Scheduled-only notice -->
    <div style="display:flex;align-items:center;gap:.75rem;background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1.5px solid #86efac;border-radius:12px;padding:.75rem 1rem;margin-bottom:.75rem">
      <div style="background:#2e7d32;border-radius:10px;width:36px;height:36px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
        <i class="fa-solid fa-calendar-clock" style="color:#fff;font-size:1rem"></i>
      </div>
      <div style="flex:1">
        <div style="font-weight:800;color:#166534;font-size:.9rem;margin-bottom:.18rem">หน้านี้สำหรับตั้งเวลาโพสกลุ่มเท่านั้น</div>
        <div style="font-size:.78rem;color:#15803d;line-height:1.5">Job <strong>จะไม่เริ่มทันที</strong> — Agent จะโพสอัตโนมัติตามวันและเวลาที่กำหนด &nbsp;·&nbsp; หากต้องการโพสทันที กรุณาไปที่ <a href="/job-queue" style="color:#15803d;font-weight:700;text-decoration:underline">คิวโพสกลุ่ม</a> แล้วกด "+ สร้าง Job"</div>
      </div>
      <div id="agentStatusBadge" style="flex-shrink:0;font-size:.75rem;font-weight:700;border-radius:8px;padding:.25rem .6rem;background:#f0f2f5;color:#65676b">
        <i class="fa-solid fa-circle-notch fa-spin"></i> กำลังตรวจสอบ Agent...
      </div>
    </div>

    <!-- Composer card -->
    <div class="card post-composer">
      <div class="composer-header">
        <div class="avatar avatar-green"><i class="fa-solid fa-users-rectangle"></i></div>
        <div class="composer-meta">
          <span class="composer-name">โพส&amp;แชร์ลงกลุ่ม</span>
          <div class="audience-badge" style="background:#e8f5e9;color:#2e7d32;border-color:#a5d6a7">
            <i class="fa-solid fa-robot"></i>
            <span>ผ่าน Desktop Agent</span>
          </div>
        </div>
      </div>

      <!-- Textarea -->
      <div class="composer-textarea-wrap">
        <textarea id="sgMsg" placeholder="พิมพ์ข้อความที่ต้องการโพสลงกลุ่ม..." rows="5"></textarea>
        <div class="emoji-strip">
          <% ['😊','🔥','❤️','👍','🎉','✨','📣','💎','🏖️','🌟'].forEach(e => { %>
          <button type="button" class="emoji-btn" onclick="insertSgEmoji('<%= e %>')"><%= e %></button>
          <% }); %>
        </div>
      </div>
      <div class="char-bar"><span id="sgCharCount">0</span> ตัวอักษร</div>

      <!-- Group selector -->
      <%
      const sgCatMap = {};
      groups.forEach((g, i) => {
        const gcats = (g.categories && g.categories.length) ? g.categories : [g.category || 'ทั่วไป'];
        const primaryCat = gcats.find(c => c !== 'ทั่วไป') || 'ทั่วไป';
        if (!sgCatMap[primaryCat]) sgCatMap[primaryCat] = [];
        sgCatMap[primaryCat].push({ groupId: g.groupId, groupName: g.groupName, _id: String(g._id || ''), _idx: i });
      });
      const sgCatSet = new Set(Object.keys(sgCatMap));
      const sgCats = [
        ...(sgCatSet.has('ทั่วไป') ? ['ทั่วไป'] : []),
        ...[...sgCatSet].filter(c => c !== 'ทั่วไป').sort()
      ];
      %>
      <div style="margin:.75rem 0 .5rem">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.4rem">
          <span style="font-size:.8rem;font-weight:700;color:#1c1e21">
            <i class="fa-solid fa-users-rectangle" style="color:#2e7d32"></i> กลุ่ม <span style="color:#fa5252">*</span>
            <span id="sgSelCount" style="font-size:.75rem;color:#2e7d32;font-weight:700;margin-left:.4rem"></span>
          </span>
          <span style="display:flex;gap:.3rem">
            <button class="btn-link-sm" onclick="sgSelAll()">ทั้งหมด</button>
            <button class="btn-link-sm" onclick="sgSelNone()">ยกเลิก</button>
          </span>
        </div>
        <div style="border:1.5px solid var(--border-color);border-radius:10px;max-height:260px;overflow-y:auto">
          <% if (groups.length === 0) { %>
          <div style="text-align:center;padding:1.5rem;color:#8a8d91;font-size:.85rem">
            <i class="fa-solid fa-users-rectangle" style="font-size:1.5rem;display:block;margin-bottom:.4rem;color:#ccc"></i>
            ยังไม่มีกลุ่ม — <a href="/groups" style="color:#1877f2;font-weight:600">เพิ่มกลุ่มก่อน</a>
          </div>
          <% } %>
          <% sgCats.forEach((cat, ci) => { %>
          <div class="jq-cat-hd" id="sgCatHd_<%= ci %>">
            <label style="display:flex;align-items:center;gap:.5rem;flex:1;cursor:pointer;min-width:0" onclick="event.stopPropagation()">
              <input type="checkbox" id="sgCatcb_<%= ci %>"
                     style="accent-color:#2e7d32;width:15px;height:15px;cursor:pointer;flex-shrink:0"
                     onchange="sgToggleCatAll(<%= ci %>, this.checked)" checked>
              <i class="fa-solid fa-location-dot" style="color:<%- (catColorMap && catColorMap[cat]) || '#2e7d32' %>;font-size:.78rem;flex-shrink:0"></i>
              <span style="font-weight:700;font-size:.85rem;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= cat %></span>
              <span style="font-size:.74rem;color:var(--text-secondary);white-space:nowrap;margin-right:.2rem"><%= sgCatMap[cat].length %> กลุ่ม</span>
            </label>
            <button style="background:none;border:none;cursor:pointer;color:#aaa;padding:.15rem .3rem;flex-shrink:0"
                    onclick="sgToggleCat(<%= ci %>)">
              <i class="fa-solid fa-chevron-down" id="sgChev_<%= ci %>" style="font-size:.74rem;transition:transform .2s"></i>
            </button>
          </div>
          <div id="sgCatBody_<%= ci %>">
            <% sgCatMap[cat].forEach(g => { %>
            <label class="jq-group-row">
              <span class="jq-indent"></span>
              <input type="checkbox" id="sgGc_<%= g._idx %>" data-group-id="<%= g.groupId %>" data-group-name="<%= g.groupName %>" data-cat="<%= ci %>"
                     style="accent-color:#2e7d32;flex-shrink:0" checked
                     onchange="sgOnGroupChange(<%= ci %>)">
              <span style="flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:.87rem"><%= g.groupName %></span>
            </label>
            <% }); %>
          </div>
          <% }); %>
        </div>
      </div>

      <!-- Delay -->
      <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;padding:.45rem 0;border-top:1px solid var(--border-color);margin-top:.5rem">
        <i class="fa-solid fa-stopwatch" style="color:#8a8d91;font-size:.8rem"></i>
        <span style="font-size:.78rem;color:#65676b;white-space:nowrap">หน่วงเวลาระหว่างกลุ่ม</span>
        <input type="number" id="sgDelay" value="30" min="1" max="120"
          style="width:54px;padding:.28rem .4rem;border:1.5px solid #e4e6eb;border-radius:7px;font-size:.82rem;font-family:inherit;outline:none;text-align:center">
        <span style="font-size:.78rem;color:#8a8d91">วิ</span>
        <span style="font-size:.73rem;color:#42b72a;font-weight:600;white-space:nowrap">(แนะนำ 30-60)</span>
      </div>

      <!-- Schedule datetime (always visible, required) -->
      <div id="sgSchedWrap" style="border:2px solid #2e7d32;background:#f0fdf4;border-radius:12px;padding:.85rem 1rem;margin-top:.5rem">
        <div style="font-size:.8rem;font-weight:700;color:#2e7d32;margin-bottom:.55rem">
          <i class="fa-solid fa-calendar-clock"></i> วันที่และเวลาที่ต้องการโพส <span style="color:#c62828">*</span>
        </div>
        <div class="dt24-wrap">
          <input type="date" lang="en-GB" id="sgSchedAt_d" style="cursor:pointer">
          <input type="number" id="sgSchedAt_h" min="0" max="23" placeholder="ชม.">
          <span style="font-size:.9rem;font-weight:700;color:#555">:</span>
          <input type="number" id="sgSchedAt_m" min="0" max="59" placeholder="น.">
        </div>
        <div style="display:flex;gap:.28rem;flex-wrap:wrap;margin-top:.45rem">
          <button type="button" onclick="dtToday('sgSchedAt')"
            style="background:#e8f5e9;border:none;border-radius:7px;padding:.26rem .65rem;font-size:.73rem;cursor:pointer;color:#2e7d32;font-family:inherit;font-weight:600">วันนี้ตอนนี้</button>
          <button type="button" onclick="dtQuick('sgSchedAt',60)"
            style="background:#f0f2f5;border:none;border-radius:7px;padding:.26rem .6rem;font-size:.73rem;cursor:pointer;color:#444;font-family:inherit">+1 ชม.</button>
          <button type="button" onclick="dtQuick('sgSchedAt',180)"
            style="background:#f0f2f5;border:none;border-radius:7px;padding:.26rem .6rem;font-size:.73rem;cursor:pointer;color:#444;font-family:inherit">+3 ชม.</button>
          <button type="button" onclick="dtQuick('sgSchedAt',1440)"
            style="background:#f0f2f5;border:none;border-radius:7px;padding:.26rem .6rem;font-size:.73rem;cursor:pointer;color:#444;font-family:inherit">+1 วัน</button>
        </div>
      </div>

      <!-- Submit row -->
      <div class="composer-submit-row" style="margin-top:.85rem">
        <div class="pages-badge" style="color:#2e7d32">
          <i class="fa-solid fa-users-rectangle"></i>
          <span id="sgGroupCountLabel">โพสไปยัง <span id="sgGroupNum"><%= groups.length %></span> กลุ่ม</span>
        </div>
        <button type="button" id="sgSubmitBtn" onclick="submitSgJob()"
          style="display:inline-flex;align-items:center;gap:.4rem;background:linear-gradient(135deg,#2e7d32,#1b5e20);color:#fff;border:none;border-radius:10px;padding:.55rem 1.1rem;font-size:.88rem;cursor:pointer;font-family:inherit;font-weight:700">
          <i class="fa-solid fa-calendar-check"></i> ตั้งเวลาโพสกลุ่ม
        </button>
      </div>
    </div>

  </main>

  <!-- Right panel -->
  <aside class="right-panel">
    <div class="card" id="agentStatusCard">
      <div class="stats-title"><i class="fa-solid fa-robot"></i> สถานะ Agent</div>
      <div id="agentStatusBody" style="font-size:.83rem;color:#8a8d91;margin-top:.4rem">
        <i class="fa-solid fa-circle-notch fa-spin"></i> กำลังตรวจสอบ...
      </div>
      <a href="/agent" style="display:inline-flex;align-items:center;gap:.35rem;margin-top:.75rem;font-size:.8rem;color:#1877f2;font-weight:600;text-decoration:none">
        <i class="fa-solid fa-download"></i> ดาวน์โหลด / เปิด Agent
      </a>
    </div>

    <div class="card" style="margin-top:.75rem;padding:1rem 1.1rem">
      <div class="stats-title" style="margin-bottom:.65rem"><i class="fa-solid fa-circle-question"></i> วิธีใช้งาน</div>
      <div style="font-size:.83rem;color:var(--text-secondary);line-height:1.8">
        <div style="display:flex;gap:.5rem;align-items:flex-start;margin-bottom:.55rem;padding-bottom:.55rem;border-bottom:1px solid var(--border-color)">
          <i class="fa-solid fa-calendar-clock" style="color:#2e7d32;margin-top:.15rem;flex-shrink:0"></i>
          <div><strong style="color:var(--text-primary)">ตั้งเวลาโพส</strong><br>Agent จะเริ่มโพสอัตโนมัติตามเวลาที่กำหนด — Agent ต้องออนไลน์ตอนนั้น</div>
        </div>
        <div style="display:flex;gap:.5rem;align-items:flex-start">
          <i class="fa-solid fa-list-check" style="color:#1877f2;margin-top:.15rem;flex-shrink:0"></i>
          <div><strong style="color:var(--text-primary)">ติดตาม Job</strong><br>ดูสถานะได้ที่ <a href="/job-queue" style="color:#1877f2;font-weight:600;text-decoration:none">คิวโพสกลุ่ม</a></div>
        </div>
      </div>
    </div>
  </aside>

</div>

<script>
// ── Emoji ──
document.getElementById('sgMsg').addEventListener('input', function() {
  document.getElementById('sgCharCount').textContent = this.value.length;
});
function insertSgEmoji(e) {
  const t = document.getElementById('sgMsg');
  t.value += e;
  t.dispatchEvent(new Event('input'));
  t.focus();
}

// ── Agent status ──
(async function checkAgent() {
  const badge = document.getElementById('agentStatusBadge');
  const body  = document.getElementById('agentStatusBody');
  try {
    const r = await fetch('http://localhost:3001/api/status', { signal: AbortSignal.timeout(3000) });
    const d = await r.json();
    badge.style.background = '#e8f5e9'; badge.style.color = '#2e7d32';
    badge.innerHTML = `<i class="fa-solid fa-circle" style="font-size:.5rem;margin-right:.3rem"></i> Agent ออนไลน์`;
    body.innerHTML  = `<span style="color:#2e7d32;font-weight:700"><i class="fa-solid fa-circle" style="font-size:.5rem;margin-right:.3rem"></i> Agent ออนไลน์</span><br><span style="color:#65676b">Runner: ${d.running ? '<strong>กำลังโพส ▶</strong>' : 'หยุด ⏹'}</span>`;
  } catch {
    badge.style.background = '#fff3cd'; badge.style.color = '#856404';
    badge.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Agent ออฟไลน์';
    body.innerHTML  = '<span style="color:#856404;font-weight:700"><i class="fa-solid fa-triangle-exclamation"></i> Agent ออฟไลน์</span><br><span style="color:#65676b;font-size:.79rem">Job จะถูกบันทึกไว้ก่อน — Agent ต้องออนไลน์ตอนถึงเวลา</span>';
  }
})();

// ── Date/time helpers ──
function _fpSetDate(el, dateStr) {
  if (!el) return;
  if (el._flatpickr) el._flatpickr.setDate(dateStr || null, false);
  else el.value = dateStr || '';
}
function dt24Get(prefix) {
  const d = document.getElementById(prefix+'_d')?.value;
  if (!d) return '';
  const h = String(document.getElementById(prefix+'_h').value||0).padStart(2,'0');
  const m = String(document.getElementById(prefix+'_m').value||0).padStart(2,'0');
  return `${d}T${h}:${m}`;
}
function dtQuick(prefix, minutes) {
  const dEl = document.getElementById(prefix+'_d');
  const hEl = document.getElementById(prefix+'_h');
  const mEl = document.getElementById(prefix+'_m');
  if (!dEl||!hEl||!mEl) return;
  const base = new Date(); base.setMinutes(base.getMinutes() + minutes);
  const bkk = new Date(base.toLocaleString('en-US', { timeZone:'Asia/Bangkok' }));
  const pad = n => String(n).padStart(2,'0');
  _fpSetDate(dEl, `${bkk.getFullYear()}-${pad(bkk.getMonth()+1)}-${pad(bkk.getDate())}`);
  hEl.value = bkk.getHours(); mEl.value = bkk.getMinutes();
}
function dtToday(prefix) {
  const bkk = new Date(new Date().toLocaleString('en-US', { timeZone:'Asia/Bangkok' }));
  const pad = n => String(n).padStart(2,'0');
  _fpSetDate(document.getElementById(prefix+'_d'), `${bkk.getFullYear()}-${pad(bkk.getMonth()+1)}-${pad(bkk.getDate())}`);
  document.getElementById(prefix+'_h').value = bkk.getHours();
  document.getElementById(prefix+'_m').value = bkk.getMinutes();
}

// ── Group selection ──
const _SG_GROUPS = <%- JSON.stringify(groups) %>;
const _SG_CATMAP = <%- JSON.stringify(Object.fromEntries(sgCats.map((cat, ci) => [ci, sgCatMap[cat].map(g => g._idx)]))) %>;

function sgUpdateCount() {
  const total   = document.querySelectorAll('[id^="sgGc_"]').length;
  const checked = document.querySelectorAll('[id^="sgGc_"]:checked').length;
  const el = document.getElementById('sgSelCount');
  if (el) el.textContent = `(เลือก ${checked}/${total})`;
  const num = document.getElementById('sgGroupNum');
  if (num) num.textContent = checked;
}
function sgSelAll() {
  document.querySelectorAll('[id^="sgGc_"]').forEach(c => c.checked = true);
  Object.keys(_SG_CATMAP).forEach(ci => sgSyncCatCb(parseInt(ci)));
  sgUpdateCount();
}
function sgSelNone() {
  document.querySelectorAll('[id^="sgGc_"]').forEach(c => c.checked = false);
  Object.keys(_SG_CATMAP).forEach(ci => sgSyncCatCb(parseInt(ci)));
  sgUpdateCount();
}
function sgToggleCatAll(ci, checked) {
  (_SG_CATMAP[ci]||[]).forEach(i => { const el = document.getElementById(`sgGc_${i}`); if(el) el.checked = checked; });
  sgUpdateCount();
}
function sgOnGroupChange(ci) { sgSyncCatCb(ci); sgUpdateCount(); }
function sgSyncCatCb(ci) {
  const cbs = (_SG_CATMAP[ci]||[]).map(i => document.getElementById(`sgGc_${i}`)).filter(Boolean);
  const n = cbs.filter(c => c.checked).length;
  const catCb = document.getElementById(`sgCatcb_${ci}`);
  if (!catCb) return;
  if (n === cbs.length) { catCb.checked = true; catCb.indeterminate = false; }
  else if (n === 0)     { catCb.checked = false; catCb.indeterminate = false; }
  else                  { catCb.checked = false; catCb.indeterminate = true; }
}
function sgToggleCat(ci) {
  const body = document.getElementById(`sgCatBody_${ci}`);
  const chev = document.getElementById(`sgChev_${ci}`);
  if (!body) return;
  const hidden = body.style.display === 'none';
  body.style.display = hidden ? '' : 'none';
  if (chev) chev.style.transform = hidden ? '' : 'rotate(-90deg)';
}
(function initSg() {
  Object.keys(_SG_CATMAP).forEach(ci => sgSyncCatCb(parseInt(ci)));
  sgUpdateCount();
})();

// ── Submit ──
async function submitSgJob() {
  const msg     = document.getElementById('sgMsg').value.trim();
  const delay   = parseInt(document.getElementById('sgDelay').value) || 30;
  const schedAt = dt24Get('sgSchedAt');
  const sel     = _SG_GROUPS.filter((_, i) => document.getElementById(`sgGc_${i}`)?.checked)
                             .map(g => ({ groupId: g.groupId, groupName: g.groupName }));

  if (!msg) {
    Swal.fire({ icon:'warning', title:'กรุณากรอกข้อความ', confirmButtonColor:'#2e7d32' }); return;
  }
  if (!sel.length) {
    Swal.fire({ icon:'warning', title:'กรุณาเลือกกลุ่มอย่างน้อย 1 กลุ่ม', confirmButtonColor:'#2e7d32' }); return;
  }
  if (!schedAt) {
    Swal.fire({ icon:'warning', title:'กรุณาเลือกวันที่และเวลา', confirmButtonColor:'#2e7d32' });
    document.getElementById('sgSchedWrap')?.scrollIntoView({ behavior:'smooth', block:'center' }); return;
  }
  if (new Date(schedAt) <= new Date()) {
    Swal.fire({ icon:'warning', title:'กรุณาเลือกเวลาในอนาคต', confirmButtonColor:'#2e7d32' }); return;
  }

  const btn = document.getElementById('sgSubmitBtn');
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังบันทึก...'; }

  try {
    const r = await fetch('/api/agent/jobs', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        message: msg,
        groups: sel,
        delaySeconds: delay,
        scheduledAt: new Date(schedAt.slice(0,16) + ':00+07:00').toISOString(),
      }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'เกิดข้อผิดพลาด');

    const dt = new Date(schedAt.slice(0,16) + ':00+07:00').toLocaleString('th-TH', { timeZone:'Asia/Bangkok', dateStyle:'short', timeStyle:'short' });
    await Swal.fire({
      icon:'success', title:'ตั้งเวลาโพสกลุ่มแล้ว!',
      html: `<p style="color:#65676b">Agent จะโพสอัตโนมัติ <strong>${dt}</strong><br>ไปยัง <strong>${sel.length} กลุ่ม</strong></p>`,
      confirmButtonColor:'#2e7d32', confirmButtonText:'ดูคิวโพส',
      showCancelButton: true, cancelButtonText: 'ตั้งเวลาเพิ่ม',
    }).then(res => {
      if (res.isConfirmed) location.href = '/job-queue';
      else {
        document.getElementById('sgMsg').value = '';
        document.getElementById('sgCharCount').textContent = '0';
        ['sgSchedAt_d','sgSchedAt_h','sgSchedAt_m'].forEach(id => { const el = document.getElementById(id); if(el) el.value = ''; });
      }
    });
  } catch(e) {
    Swal.fire({ icon:'error', title:'บันทึกไม่สำเร็จ', text:e.message, confirmButtonColor:'#2e7d32' });
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-calendar-check"></i> ตั้งเวลาโพสกลุ่ม'; }
  }
}
</script>

