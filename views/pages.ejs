<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>จัดการเพจ - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <a href="/" class="btn-back"><i class="fa-solid fa-house"></i> หน้าหลัก</a>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/" class="sidebar-item"><i class="fa-solid fa-house"></i><span>หน้าหลัก</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสต์</span></a>
    <a href="/pages" class="sidebar-item active"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
  </aside>

  <main class="feed">

    <!-- Header -->
    <div class="card" style="padding:.8rem 1.25rem;display:flex;align-items:center;justify-content:space-between">
      <div class="card-title" style="font-size:1.05rem">
        <i class="fa-brands fa-facebook"></i> จัดการเพจ
        <span style="background:#e4e6ea;padding:.12rem .5rem;border-radius:999px;font-size:.78rem;font-weight:400;margin-left:.35rem" id="pageCountBadge"><%= pages.length %> เพจ</span>
      </div>
      <button class="btn-post" onclick="openAddPage()" style="padding:.45rem 1rem;font-size:.86rem">
        <i class="fa-solid fa-plus"></i> เพิ่มเพจใหม่
      </button>
    </div>

    <!-- Token status summary -->
    <div class="token-summary" id="tokenSummary">
      <!-- filled by JS -->
    </div>

    <!-- Page list -->
    <div id="pageList">
      <% const colors = ['purple','green','orange','blue','red']; %>
      <% pages.forEach((p, i) => { %>
      <div class="card page-manage-card" id="pcard-<%= p.pageId %>" data-expiry="<%= p.tokenExpiry || '' %>">
        <div class="page-manage-header">
          <div class="avatar avatar-<%= colors[i%5] %>"><%= p.pageName.slice(-1) %></div>
          <div class="page-manage-info">
            <div class="page-manage-name"><%= p.pageName %></div>
            <div class="page-manage-id">Page ID: <code><%= p.pageId %></code></div>
          </div>
          <div class="page-manage-actions">
            <button class="icon-btn" title="แก้ไข Token" onclick="openEditPage('<%= p.pageId %>','<%= p.pageName %>','<%= p.accessToken || '' %>','<%= p.tokenExpiry || '' %>')">
              <i class="fa-solid fa-pen"></i>
            </button>
            <button class="icon-btn danger" title="ลบเพจ" onclick="deletePage('<%= p.pageId %>', '<%= p.pageName %>', this)">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>

        <div class="page-manage-token">
          <% if (p.accessToken) { %>
          <div class="token-field">
            <i class="fa-solid fa-key" style="color:#f7b928"></i>
            <span class="token-masked"><%= p.accessToken.slice(0,12) %>••••••••••••</span>
            <button class="token-copy-btn" onclick="copyToken('<%= p.accessToken %>', this)" title="คัดลอก Token">
              <i class="fa-regular fa-copy"></i>
            </button>
          </div>
          <% } else { %>
          <div class="token-field" style="color:#8a8d91">
            <i class="fa-solid fa-key"></i> <span>ยังไม่มี Access Token</span>
          </div>
          <% } %>
        </div>

        <div class="token-status-row">
          <% if (p.tokenExpiry) { %>
          <div class="token-status-badge" data-expiry="<%= p.tokenExpiry %>">
            <!-- filled by JS -->
          </div>
          <div class="token-expiry-date" style="font-size:.75rem;color:#8a8d91">
            หมดอายุ: <%= new Date(p.tokenExpiry).toLocaleDateString('th-TH', {year:'numeric',month:'long',day:'numeric'}) %>
          </div>
          <% } else { %>
          <div class="token-status-badge" style="background:#f0f2f5;color:#8a8d91;padding:.25rem .7rem;border-radius:999px;font-size:.8rem;font-weight:600;display:inline-flex;align-items:center;gap:.3rem">
            <i class="fa-solid fa-circle-question"></i> ไม่ระบุวันหมดอายุ
          </div>
          <% } %>
        </div>
      </div>
      <% }); %>
    </div>

  </main>

  <aside class="right-panel">
    <div class="card stats-card">
      <div class="stats-title"><i class="fa-solid fa-shield-halved" style="color:#1877f2"></i> สถานะ Token</div>
      <div class="stats-row"><span>🟢 ปกติ</span><span class="stats-val green" id="countActive">—</span></div>
      <div class="stats-row"><span>🟡 ใกล้หมด</span><span class="stats-val orange-text" id="countWarning">—</span></div>
      <div class="stats-row"><span>🔴 หมดแล้ว</span><span class="stats-val red" id="countExpired">—</span></div>
    </div>
  </aside>

</div>

<script>
/* ── Token status logic ── */
function getDaysLeft(expiryISO) {
  if (!expiryISO) return null;
  const diff = new Date(expiryISO) - new Date();
  return Math.ceil(diff / 86400000);
}

function statusConfig(days) {
  if (days === null) return { cls: 'token-unknown',   icon: 'fa-circle-question', color: '#8a8d91', bg: '#f0f2f5', label: 'ไม่ระบุ' };
  if (days < 0)     return { cls: 'token-expired',    icon: 'fa-circle-xmark',    color: '#c62828', bg: '#fdecea', label: `หมดอายุแล้ว ${Math.abs(days)} วัน` };
  if (days <= 7)    return { cls: 'token-critical',   icon: 'fa-triangle-exclamation', color: '#c62828', bg: '#fdecea', label: `หมดใน ${days} วัน ⚠️` };
  if (days <= 30)   return { cls: 'token-warning',    icon: 'fa-clock',           color: '#e65100', bg: '#fff3e0', label: `หมดใน ${days} วัน` };
  return           { cls: 'token-active',    icon: 'fa-circle-check',    color: '#2e7d32', bg: '#e8f5e9', label: `ปกติ · ${days} วัน` };
}

function renderTokenBadge(el, expiryISO) {
  const days   = getDaysLeft(expiryISO);
  const cfg    = statusConfig(days);
  el.style.cssText = `background:${cfg.bg};color:${cfg.color};padding:.25rem .75rem;border-radius:999px;font-size:.8rem;font-weight:700;display:inline-flex;align-items:center;gap:.3rem`;
  el.innerHTML = `<i class="fa-solid ${cfg.icon}"></i> ${cfg.label}`;
}

function updateAll() {
  let active = 0, warning = 0, expired = 0;
  document.querySelectorAll('.token-status-badge[data-expiry]').forEach(el => {
    const expiry = el.dataset.expiry;
    if (!expiry) return;
    renderTokenBadge(el, expiry);
    const days = getDaysLeft(expiry);
    if (days === null) return;
    if (days < 0)    expired++;
    else if (days <= 30) warning++;
    else             active++;
  });
  document.getElementById('countActive').textContent  = active;
  document.getElementById('countWarning').textContent = warning;
  document.getElementById('countExpired').textContent = expired;

  // Summary banner
  const summary = document.getElementById('tokenSummary');
  if (expired > 0 || warning > 0) {
    summary.innerHTML = `
      <div class="card" style="background:${expired>0?'#fdecea':'#fff3e0'};border:1px solid ${expired>0?'#f5c6cb':'#ffe0b2'};padding:.75rem 1.1rem;display:flex;align-items:center;gap:.75rem">
        <i class="fa-solid fa-triangle-exclamation" style="font-size:1.4rem;color:${expired>0?'#c62828':'#e65100'}"></i>
        <div>
          ${expired > 0 ? `<strong style="color:#c62828">${expired} เพจ Token หมดอายุแล้ว</strong> — กรุณาอัปเดต Token ด่วน<br>` : ''}
          ${warning > 0 ? `<span style="color:#e65100">${warning} เพจ Token ใกล้หมดอายุ</span> — ควรต่ออายุเร็วๆ นี้` : ''}
        </div>
      </div>`;
  } else {
    summary.innerHTML = '';
  }
}

// Run now and every 60s
updateAll();
setInterval(updateAll, 60000);

/* ── CRUD ── */
async function openAddPage() {
  const { value } = await Swal.fire({
    title: '<i class="fa-solid fa-plus" style="color:#1877f2"></i> เพิ่มเพจใหม่',
    html: `
      <input id="sw-name"   class="swal2-input" placeholder="ชื่อเพจ เช่น Pool Villa X">
      <input id="sw-id"     class="swal2-input" placeholder="Page ID เช่น 1014">
      <input id="sw-token"  class="swal2-input" placeholder="Access Token (ถ้ามี)">
      <input id="sw-expiry" class="swal2-input" type="date" placeholder="วันหมดอายุ">`,
    showCancelButton: true,
    confirmButtonColor: '#1877f2',
    confirmButtonText: 'เพิ่มเพจ',
    cancelButtonText: 'ยกเลิก',
    focusConfirm: false,
    preConfirm: () => {
      const name = document.getElementById('sw-name').value.trim();
      const id   = document.getElementById('sw-id').value.trim();
      if (!name || !id) { Swal.showValidationMessage('กรุณากรอกชื่อเพจและ Page ID'); return false; }
      return {
        pageName: name, pageId: id,
        accessToken:  document.getElementById('sw-token').value.trim(),
        tokenExpiry:  document.getElementById('sw-expiry').value ? new Date(document.getElementById('sw-expiry').value).toISOString() : null,
      };
    },
  });
  if (!value) return;

  const res  = await fetch('/pages', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(value) });
  const data = await res.json();
  if (data.error) { Swal.fire({ icon:'error', title: data.error }); return; }
  Swal.fire({ icon:'success', title:'เพิ่มเพจสำเร็จ', timer:1500, showConfirmButton:false });
  setTimeout(() => location.reload(), 1500);
}

async function openEditPage(pageId, pageName, token, expiry) {
  const defDate = expiry ? expiry.slice(0,10) : '';
  const { value } = await Swal.fire({
    title: `<i class="fa-solid fa-pen" style="color:#1877f2"></i> แก้ไข ${pageName}`,
    html: `
      <input id="sw-name"   class="swal2-input" value="${pageName}" placeholder="ชื่อเพจ">
      <input id="sw-token"  class="swal2-input" value="${token}" placeholder="Access Token">
      <label style="font-size:.82rem;color:#65676b;display:block;margin:.4rem 0 .1rem;text-align:left;padding:0 .6rem">วันหมดอายุ Token</label>
      <input id="sw-expiry" class="swal2-input" type="date" value="${defDate}">`,
    showCancelButton: true,
    confirmButtonColor: '#1877f2',
    confirmButtonText: 'บันทึก',
    cancelButtonText: 'ยกเลิก',
    focusConfirm: false,
    preConfirm: () => ({
      pageName:     document.getElementById('sw-name').value.trim() || pageName,
      accessToken:  document.getElementById('sw-token').value.trim(),
      tokenExpiry:  document.getElementById('sw-expiry').value ? new Date(document.getElementById('sw-expiry').value).toISOString() : null,
    }),
  });
  if (!value) return;

  const res  = await fetch(`/pages/${pageId}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(value) });
  const data = await res.json();
  if (!data.ok) { Swal.fire({ icon:'error', title:'ไม่สามารถอัปเดตได้' }); return; }
  Swal.fire({ icon:'success', title:'บันทึกสำเร็จ', timer:1200, showConfirmButton:false });
  setTimeout(() => location.reload(), 1200);
}

async function deletePage(pageId, pageName, btn) {
  const conf = await Swal.fire({
    title: `ลบเพจ "${pageName}"?`,
    text: 'จะไม่สามารถโพสต์ไปยังเพจนี้ได้อีก',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#c62828',
    cancelButtonColor: '#65676b',
    confirmButtonText: 'ลบเลย',
    cancelButtonText: 'ยกเลิก',
  });
  if (!conf.isConfirmed) return;

  const res  = await fetch(`/pages/${pageId}`, { method:'DELETE' });
  const data = await res.json();
  if (data.success) {
    const card = document.getElementById(`pcard-${pageId}`);
    card.style.transition = 'opacity .3s,transform .3s';
    card.style.opacity = '0'; card.style.transform = 'translateX(20px)';
    setTimeout(() => { card.remove(); updateAll(); }, 320);
    Swal.fire({ icon:'success', title:'ลบแล้ว', timer:1200, showConfirmButton:false });
  }
}

function copyToken(token, btn) {
  navigator.clipboard.writeText(token).then(() => {
    btn.innerHTML = '<i class="fa-solid fa-check" style="color:#2e7d32"></i>';
    setTimeout(() => btn.innerHTML = '<i class="fa-regular fa-copy"></i>', 1500);
  });
}
</script>
</body>
</html>
