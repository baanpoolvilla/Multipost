async function lookupTokenInModal() {
  const token = document.getElementById('sw-token').value.trim();
  if (!token) { Swal.showValidationMessage('กรุณาวาง Token ก่อน'); return; }
  const btn = document.getElementById('sw-lookup-btn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
  try {
    const res  = await fetch('/pages/lookup-token?token=' + encodeURIComponent(token));
    const data = await res.json();
    if (data.error) throw new Error(data.error);
    document.getElementById('sw-id').value   = data.id;
    document.getElementById('sw-name').value = data.name;
  } catch (err) {
    Swal.showValidationMessage('Token ผิดพลาด: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-magnifying-glass"></i> ตรวจสอบ';
