function _parseGroupId(input) {
  input = (input || '').trim();
  const m = input.match(/facebook\.com\/groups\/([^/?&#]+)/i);
  return m ? m[1] : input;
}

async function gpAdd() {
  const { value } = await Swal.fire({
    title: 'เพิ่มกลุ่ม',
    html: `
      <p style="font-size:.82rem;color:#555;margin:0 0 .4rem;text-align:left">วาง URL หรือพิมพ์ Group ID:</p>
      <input id="sw-gurl" class="swal2-input" placeholder="facebook.com/groups/... หรือตัวเลข ID">
      <div id="sw-name-row" style="display:none;margin:.4rem .5rem 0;text-align:left">
        <label style="font-size:.78rem;color:#555">ชื่อกลุ่ม:</label>
        <input id="sw-gname" class="swal2-input" style="margin:.2rem 0 0" placeholder="กรอกชื่อกลุ่ม">
      </div>
      <div id="sw-fetched" style="display:none;margin:.5rem .5rem 0;padding:.4rem .6rem;background:#f0f7ff;border-radius:7px;font-size:.82rem;color:#1877f2;text-align:left">
        <i class="fa-solid fa-check-circle"></i> <span id="sw-fetched-name"></span>
      </div>
      <p id="sw-hint" style="font-size:.73rem;color:#8a8d91;margin:.35rem .6rem 0;text-align:left">
        วาง URL แล้วระบบดึงชื่อให้อัตโนมัติ
      </p>`,
    showCancelButton: true,
    confirmButtonColor: '#1877f2',
    confirmButtonText: 'เพิ่ม',
    cancelButtonText: 'ยกเลิก',
    focusConfirm: false,
    didOpen: () => {
      const inp = document.getElementById('sw-gurl');
      inp.addEventListener('paste', async () => {
        await new Promise(r => setTimeout(r, 60));
        const id = _parseGroupId(inp.value);
        inp.value = id;
        if (!id) return;
        document.getElementById('sw-hint').textContent = 'กำลังดึงชื่อกลุ่ม...';
        try {
          const r = await fetch(`/pages/${_gpPageId}/groups/lookup?groupId=${encodeURIComponent(id)}`);
          const d = await r.json();
          if (d.name) {
            document.getElementById('sw-fetched-name').textContent = d.name;
            document.getElementById('sw-fetched').style.display = 'block';
            document.getElementById('sw-name-row').style.display = 'none';
            document.getElementById('sw-hint').textContent = '';
            inp.dataset.fetchedName = d.name;
          } else {
            document.getElementById('sw-name-row').style.display = 'block';
            document.getElementById('sw-hint').textContent = 'ไม่พบชื่ออัตโนมัติ — กรอกชื่อกลุ่มด้านล่าง';
            document.getElementById('sw-gname').focus();
          }
        } catch {
          document.getElementById('sw-name-row').style.display = 'block';
          document.getElementById('sw-hint').textContent = 'กรอกชื่อกลุ่มด้านล่าง';
        }
      });
    },
    preConfirm: () => {
      const groupId = _parseGroupId(document.getElementById('sw-gurl').value);
      if (!groupId) { Swal.showValidationMessage('กรุณากรอก Group ID หรือลิงก์กลุ่ม'); return false; }
      const fetched = document.getElementById('sw-gurl').dataset.fetchedName || '';
      const manual  = (document.getElementById('sw-gname')?.value || '').trim();
      const groupName = fetched || manual;
      if (!groupName) { Swal.showValidationMessage('กรุณากรอกชื่อกลุ่ม'); return false; }
      return { groupId, groupName };
    },
  });
  if (!value) return _showGroupModal(_gpPageName);
  const res  = await fetch(`/pages/${_gpPageId}/groups`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(value),
  });
  const data = await res.json();
  if (data.ok) {
    _gpGroups = data.groups;
    updateGroupBadge(_gpPageId, _gpGroups);
    _pageGroupsData[_gpPageId] = _gpGroups;
  } else {
    await Swal.fire({ icon: 'error', title: data.error, timer: 1500, showConfirmButton: false });
  }
  _showGroupModal(_gpPageName);
}

async function gpRemove(groupId) {
  const group = _gpGroups.find(g => g.groupId === groupId);
  const conf = await Swal.fire({
    title: 'ลบกลุ่มนี้?',
    text: group?.groupName || groupId,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#c62828',
    cancelButtonColor: '#65676b',
    confirmButtonText: '<i class="fa-solid fa-trash-can"></i> ลบเลย',
    cancelButtonText: 'ยกเลิก',
  });
  if (!conf.isConfirmed) return _showGroupModal(_gpPageName);
  const res  = await fetch(`/pages/${_gpPageId}/groups/${groupId}`, { method: 'DELETE' });
  const data = await res.json();
  if (data.ok) {
    _gpGroups = data.groups;
    updateGroupBadge(_gpPageId, _gpGroups);
    _pageGroupsData[_gpPageId] = _gpGroups;
  }
  _showGroupModal(_gpPageName);
}

async function gpToggle(groupId, enabled) {
  const res  = await fetch(`/pages/${_gpPageId}/groups/${groupId}`, {
    method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ enabled }),
  });
  const data = await res.json();
  if (data.ok) _gpGroups = data.groups;
}

/* ── Exchange token → long-lived (60 วัน) ── */
async function exchangeToken(pageId, pageName, btn) {
  const conf = await Swal.fire({
    title: `ต่ออายุ Token — ${pageName}`,
    html: `<p style="font-size:.88rem;color:#555;margin:.4rem 0">
      ระบบจะแลก Token ปัจจุบันเป็น <strong>Long-lived Token (60 วัน)</strong><br>
      ถ้า Token เป็นแบบ Page Token จะได้ <strong>ไม่มีวันหมดอายุ</strong>
    </p>`,
    icon: 'question',
    showCancelButton: true,
    confirmButtonColor: '#2e7d32',
    cancelButtonColor: '#65676b',
    confirmButtonText: '<i class="fa-solid fa-rotate"></i> ต่ออายุเลย',
    cancelButtonText: 'ยกเลิก',
  });
  if (!conf.isConfirmed) return;

  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

  try {
    const res  = await fetch('/api/exchange-token', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pageId }),
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error);

    const msg = data.neverExpires
      ? '✅ ได้ Page Token แบบ <strong>ไม่มีวันหมดอายุ</strong>'
      : `✅ Token ใหม่หมดอายุ <strong>${new Date(data.expiryDate).toLocaleDateString('th-TH', {year:'numeric',month:'long',day:'numeric'})}</strong>`;
    await Swal.fire({ icon: 'success', title: 'ต่ออายุสำเร็จ', html: msg, confirmButtonColor: '#1877f2' });
    location.reload();
  } catch (err) {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-rotate"></i>';

    // Offer direct token paste as fallback
    Swal.fire({
      icon: 'warning',
      title: 'ต้องใส่ Token ใหม่',
      html: `
        <div style="text-align:left;font-size:.83rem;color:#444">
          <div style="background:#fff3e0;border-radius:6px;padding:.55rem .7rem;margin-bottom:.7rem;color:#e65100">
            <b>สาเหตุ:</b> ${err.message}
          </div>
          <b>วิธีได้ Token ใหม่:</b>
          <ol style="margin:.35rem 0 .7rem;padding-left:1.3rem;line-height:1.8">
            <li>เปิด <a href="https://developers.facebook.com/tools/explorer/" target="_blank" style="color:#1877f2;font-weight:600">Graph API Explorer</a></li>
            <li>เลือก App ที่ตรงกับ App ID ในการตั้งค่า</li>
            <li>กด <b>"Generate Access Token"</b></li>
            <li>Copy token แล้ววางด้านล่าง</li>
          </ol>
          <textarea id="fallback-token-${pageId}"
            placeholder="วาง User Access Token ที่ copy มา..."
            style="width:100%;height:68px;padding:.55rem .7rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:monospace;font-size:.74rem;resize:none;outline:none;box-sizing:border-box"></textarea>
          <button type="button" id="applyTokenBtn-${pageId}" onclick="applyNewToken('${pageId}')"
            style="margin-top:.45rem;width:100%;padding:.55rem;background:#1877f2;color:#fff;border:none;border-radius:8px;font-size:.86rem;cursor:pointer;font-family:inherit;font-weight:700;display:flex;align-items:center;justify-content:center;gap:.4rem">
            <i class="fa-solid fa-floppy-disk"></i> บันทึกและต่ออายุ
          </button>
        </div>`,
      showCancelButton: true,
      showConfirmButton: false,
      cancelButtonText: 'ปิด',
      cancelButtonColor: '#65676b',
      width: 520,
    });
  }
}

async function applyNewToken(pageId) {
  const inp   = document.getElementById(`fallback-token-${pageId}`);
  const token = inp?.value.trim();
  if (!token) {
    inp?.focus();
    inp && (inp.style.borderColor = '#c62828');
    setTimeout(() => inp && (inp.style.borderColor = '#dbe0e6'), 2000);
    return;
  }

  // Show spinner in button
  const applyBtn = document.getElementById(`applyTokenBtn-${pageId}`) || inp?.nextElementSibling;
  if (applyBtn) { applyBtn.disabled = true; applyBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังบันทึก...'; }

  // Save the new token to the page record
  const saveRes  = await fetch(`/pages/${pageId}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ accessToken: token }),
  });
  const saveData = await saveRes.json();
  if (!saveData.ok) {
    Swal.fire({ icon: 'error', title: 'บันทึกไม่สำเร็จ', confirmButtonColor: '#1877f2' });
    return;
  }

  // Now try to exchange for long-lived token
  const exchRes  = await fetch('/api/exchange-token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ pageId }),
  });
  const exchData = await exchRes.json();

  Swal.close();

  if (exchData.ok) {
    const msg = exchData.neverExpires
      ? '✅ ได้ Page Token แบบ <strong>ไม่มีวันหมดอายุ</strong>'
      : `✅ Token ใหม่หมดอายุ <strong>${new Date(exchData.expiryDate).toLocaleDateString('th-TH', {year:'numeric',month:'long',day:'numeric'})}</strong>`;
    await Swal.fire({ icon: 'success', title: 'ต่ออายุสำเร็จ!', html: msg, confirmButtonColor: '#1877f2' });
  } else {
    await Swal.fire({
      icon: 'success', title: 'บันทึก Token ใหม่แล้ว',
      text: 'บันทึกสำเร็จ (ต่ออายุอัตโนมัติไม่ได้ แต่ใช้งานได้ปกติ)',
      confirmButtonColor: '#1877f2',
    });
  }
  location.reload();
}

/* ── Import from Token ── */
let _importCandidates = [];

function openImportModal() {
  document.getElementById('tokenImportModal').style.display = 'flex';
}
function closeImportModal() {
  document.getElementById('tokenImportModal').style.display = 'none';
  document.getElementById('importPageList').innerHTML = '';
  document.getElementById('importTokenInput').value = '';
  document.getElementById('importFooter').style.display = 'none';
  _importCandidates = [];
}
function closeImportOnBg(e) {
  if (e.target.id === 'tokenImportModal') closeImportModal();
}

async function fetchImportPages() {
  const token = document.getElementById('importTokenInput').value.trim();
  if (!token) {
    Swal.fire({ icon:'warning', title:'กรุณาใส่ Token', timer:1500, showConfirmButton:false });
    return;
  }
  const btn = document.getElementById('fetchTokenBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังดึง...';

  try {
    const res  = await fetch('/pages/from-token?token=' + encodeURIComponent(token));
    const data = await res.json();
    if (data.error) throw new Error(data.error);
    renderImportList(data.pages);
  } catch (err) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text: err.message });
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-magnifying-glass"></i> ดึงเพจ';
  }
}

function renderImportList(pages) {
  _importCandidates = pages;
  const list   = document.getElementById('importPageList');
  const footer = document.getElementById('importFooter');

  if (!pages || pages.length === 0) {
    list.innerHTML = '<p style="text-align:center;color:#8a8d91;padding:1.5rem 0">ไม่พบเพจที่ดูแล</p>';
    footer.style.display = 'none';
    return;
  }

  const colors  = ['purple','green','orange','blue','red'];
  const existing = pages.filter(p => EXISTING_PAGE_IDS.has(p.id));
  const newPages = pages.filter(p => !EXISTING_PAGE_IDS.has(p.id));

  list.innerHTML = pages.map((p, i) => {
    const isExisting = EXISTING_PAGE_IDS.has(p.id);
    return `
    <div style="display:flex;align-items:center;gap:.75rem;padding:.65rem .4rem;border-bottom:1px solid #f0f2f5">
      ${isExisting
        ? `<span style="font-size:.72rem;background:#e7f3ff;color:#1877f2;padding:.2rem .5rem;border-radius:4px;flex-shrink:0;white-space:nowrap"><i class="fa-solid fa-rotate"></i> มีอยู่แล้ว</span>`
        : `<input type="checkbox" class="import-chk" data-idx="${i}" onchange="updateImportCount()" checked
             style="width:16px;height:16px;cursor:pointer;accent-color:#1877f2;flex-shrink:0">`}
      <div class="avatar avatar-${colors[i%5]}" style="flex-shrink:0">${p.name.slice(-1)}</div>
      <div style="flex:1;min-width:0">
        <div style="font-weight:600;font-size:.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${p.name}</div>
        <div style="font-size:.78rem;color:#65676b">ID: ${p.id}</div>
      </div>
      ${p.access_token ? '<span style="font-size:.72rem;color:#2e7d32;background:#e8f5e9;padding:.15rem .5rem;border-radius:4px"><i class="fa-solid fa-key"></i> มี Token</span>' : ''}
    </div>`;
  }).join('');

  footer.style.display = 'flex';
  updateImportCount();

  // Show "refresh all" button if there are existing pages
  const refreshBtn = document.getElementById('refreshAllTokensBtn');
  if (refreshBtn) refreshBtn.style.display = existing.length ? 'inline-flex' : 'none';
}

function updateImportCount() {
  const n = document.querySelectorAll('.import-chk:checked').length;
  document.getElementById('importSelectCount').textContent = `เพิ่มใหม่ ${n} เพจ`;
}

async function doImportPages() {
  const selected = [...document.querySelectorAll('.import-chk:checked')]
    .map(el => _importCandidates[+el.dataset.idx]);
  if (!selected.length) {
    Swal.fire({ icon: 'warning', title: 'ไม่มีเพจใหม่ที่เลือก', timer: 1500, showConfirmButton: false });
    return;
  }

  let imported = 0, failed = 0;
  for (const p of selected) {
    const res  = await fetch('/pages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pageId: p.id, pageName: p.name, accessToken: p.access_token || '', tokenExpiry: null }),
    });
    const data = await res.json();
    if (data.ok) imported++; else failed++;
  }

  closeImportModal();
  await Swal.fire({
    icon: 'success',
    title: `นำเข้าสำเร็จ ${imported} เพจ` + (failed ? ` (ผิดพลาด ${failed})` : ''),
    timer: 2000, showConfirmButton: false,
  });
  location.reload();
}

async function refreshAllTokens() {
  const existing = _importCandidates.filter(p => EXISTING_PAGE_IDS.has(p.id) && p.access_token);
  if (!existing.length) {
    Swal.fire({ icon: 'warning', title: 'ไม่พบเพจที่ต้องอัปเดต', timer: 1500, showConfirmButton: false });
    return;
  }

  const btn = document.getElementById('refreshAllTokensBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังรีเฟรช...';

  let updated = 0, failed = 0;
  for (const p of existing) {
    const res  = await fetch(`/pages/${p.id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ accessToken: p.access_token, tokenExpiry: null }),
    });
    const data = await res.json();
    if (data.ok) updated++; else failed++;
  }

  closeImportModal();
  await Swal.fire({
    icon: 'success',
    title: `รีเฟรช Token สำเร็จ ${updated} เพจ` + (failed ? ` (ผิดพลาด ${failed})` : ''),
    html: '<small style="color:#65676b">Token ใหม่เป็นแบบถาวร (ดึงจาก Long-lived Token)</small>',
    confirmButtonColor: '#1877f2',
  });
  location.reload();
}
</script>
