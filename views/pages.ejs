<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>จัดการเพจ - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/auth-guard.js"></script>
  <script src="/js/navbar-user.js"></script>
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <% if (locals.currentStaff) { %>
      <div class="navbar-user">
        <div class="avatar avatar-blue avatar-xs"><%= currentStaff.name.charAt(0).toUpperCase() %></div>
        <span class="navbar-user-name"><%= currentStaff.name %></span>
        <i class="fa-solid fa-chevron-down navbar-user-caret"></i>
        <div class="navbar-user-menu">
          <form method="POST" action="/logout">
            <button type="submit" class="navbar-user-menu-item"><i class="fa-solid fa-right-from-bracket"></i> ออกจากระบบ</button>
          </form>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item active"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">ระบบ</div>
    <a href="/user-activity" class="sidebar-item"><i class="fa-solid fa-user-clock"></i><span>กิจกรรมพนักงาน</span></a>
    <% if (locals.currentStaff && currentStaff.canManageStaff) { %>
    <a href="/manage-staff" class="sidebar-item"><i class="fa-solid fa-users-gear"></i><span>จัดการบัญชีผู้ใช้งาน</span></a>
    <% } %>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <!-- Header -->
    <div class="card" style="padding:.8rem 1.25rem;display:flex;align-items:center;justify-content:space-between">
      <div class="card-title" style="font-size:1.05rem">
        <i class="fa-brands fa-facebook"></i> จัดการเพจ
        <span style="background:#e4e6ea;padding:.12rem .5rem;border-radius:999px;font-size:.78rem;font-weight:400;margin-left:.35rem" id="pageCountBadge"><%= pages.length %> เพจ</span>
      </div>
      <div style="display:flex;gap:.5rem">
        <button class="btn-post" onclick="openImportModal()" style="padding:.45rem 1rem;font-size:.86rem;background:#42b72a">
          <i class="fa-solid fa-file-import"></i> นำเข้าจาก Token
        </button>
        <button class="btn-post" onclick="openAddPage()" style="padding:.45rem 1rem;font-size:.86rem">
          <i class="fa-solid fa-plus"></i> เพิ่มเพจใหม่
        </button>
      </div>
    </div>

    <!-- App Settings Card -->
    <div class="card" id="settingsCard" style="border:1.5px solid #e4e6eb">
      <div style="display:flex;align-items:center;justify-content:space-between;cursor:pointer" onclick="toggleSettings()">
        <div class="card-title" style="margin:0;font-size:.95rem">
          <i class="fa-solid fa-gear" style="color:#1877f2"></i> ตั้งค่า Facebook App
          <span id="settingsSavedBadge" style="display:none;font-size:.72rem;background:#e8f5e9;color:#2e7d32;padding:.15rem .5rem;border-radius:999px;font-weight:600;margin-left:.4rem">
            <i class="fa-solid fa-circle-check"></i> บันทึกแล้ว
          </span>
        </div>
        <i class="fa-solid fa-chevron-down" id="settingsChevron" style="color:#8a8d91;transition:.2s"></i>
      </div>
      <div id="settingsBody" style="display:none;margin-top:1rem">
        <p style="font-size:.82rem;color:#65676b;margin:0 0 .75rem">
          ใช้สำหรับ <strong>ต่ออายุ Token อัตโนมัติ</strong> — หาได้ที่
          <a href="https://developers.facebook.com" target="_blank" rel="noopener" style="color:#1877f2">developers.facebook.com</a>
          → เลือก App → Settings → Basic
        </p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.6rem">
          <div>
            <label style="font-size:.78rem;color:#65676b;display:block;margin-bottom:.25rem">App ID</label>
            <input id="cfg-app-id" type="text" placeholder="เช่น 2015668002373717"
              style="width:100%;padding:.5rem .7rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:inherit;font-size:.84rem;outline:none;box-sizing:border-box">
          </div>
          <div>
            <label style="font-size:.78rem;color:#65676b;display:block;margin-bottom:.25rem">App Secret</label>
            <div style="position:relative">
              <input id="cfg-app-secret" type="password" placeholder="••••••••••••••••"
                style="width:100%;padding:.5rem 2rem .5rem .7rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:inherit;font-size:.84rem;outline:none;box-sizing:border-box">
              <button onclick="toggleSecret()" title="แสดง/ซ่อน"
                style="position:absolute;right:.5rem;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#8a8d91;font-size:.85rem;padding:0">
                <i class="fa-solid fa-eye" id="secretEyeIcon"></i>
              </button>
            </div>
          </div>
        </div>
        <div style="margin-top:.75rem;padding-top:.75rem;border-top:1px dashed #e4e6eb">
          <label style="font-size:.78rem;color:#65676b;display:block;margin-bottom:.25rem">
            <i class="fa-solid fa-people-group" style="color:#42b72a"></i>
            User Access Token สำหรับโพสต์กลุ่ม
            <span style="background:#fff3e0;color:#e65100;padding:.1rem .4rem;border-radius:4px;font-size:.7rem;margin-left:.3rem">ต้องมี publish_to_groups</span>
          </label>
          <div style="position:relative">
            <input id="cfg-group-token" type="password" placeholder="วาง User Access Token ที่มี publish_to_groups permission"
              style="width:100%;padding:.5rem 2rem .5rem .7rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:inherit;font-size:.84rem;outline:none;box-sizing:border-box">
            <button onclick="toggleGroupToken()" title="แสดง/ซ่อน"
              style="position:absolute;right:.5rem;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#8a8d91;font-size:.85rem;padding:0">
              <i class="fa-solid fa-eye" id="groupTokenEyeIcon"></i>
            </button>
          </div>
          <p style="font-size:.74rem;color:#8a8d91;margin:.35rem 0 0">
            ไปที่ Graph API Explorer → เลือก "โทเค็นการเข้าถึงของผู้ใช้" → เพิ่ม <code>publish_to_groups</code> → Generate Token
          </p>
        </div>
        <div style="display:flex;justify-content:flex-end;margin-top:.75rem">
          <button onclick="saveSettings()"
            style="background:#1877f2;color:#fff;border:none;border-radius:8px;padding:.45rem 1.1rem;font-size:.84rem;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:.4rem">
            <i class="fa-solid fa-floppy-disk"></i> บันทึก
          </button>
        </div>
      </div>
    </div>

    <!-- Token status summary -->
    <div class="token-summary" id="tokenSummary">
      <!-- filled by JS -->
    </div>

    <!-- Page list -->
    <div id="pageList">
      <% const colors = ['purple','green','orange','blue','red']; %>
      <% pages.forEach((p, i) => { %>
      <div class="card page-manage-card" id="pcard-<%= p.pageId %>" data-expiry="<%= p.tokenExpiry || '' %>" data-enabled="<%= p.enabled === false ? 'false' : 'true' %>" style="<%= p.enabled === false ? 'opacity:.55' : '' %>">
        <div class="page-manage-header">
          <div class="avatar avatar-<%= colors[i%5] %>"><%= p.pageName.slice(-1) %></div>
          <div class="page-manage-info">
            <div class="page-manage-name" style="display:flex;align-items:center;gap:.5rem;cursor:pointer" onclick="window.location.href='/page-activity/<%= encodeURIComponent(p.pageId) %>'">
              <%= p.pageName %>
              <span id="live-<%= p.pageId %>" style="font-size:.72rem;padding:.18rem .55rem;border-radius:999px;background:#f0f2f5;color:#8a8d91;display:inline-flex;align-items:center;gap:.25rem;font-weight:600">
                <i class="fa-solid fa-spinner fa-spin" style="font-size:.65rem"></i> ตรวจสอบ...
              </span>
            </div>
            <div class="page-manage-id">Page ID: <code><%= p.pageId %></code></div>
          </div>
          <div class="page-manage-actions">
            <button class="icon-btn toggle-page-btn" title="เปิด/ปิดใช้งานเพจนี้"
              id="tbtn-<%= p.pageId %>" data-id="<%= p.pageId %>"
              onclick="togglePage(this.dataset.id)"
              style="<%= p.enabled === false ? 'color:#8a8d91;border-color:#ccc' : 'color:#1877f2;border-color:#90caf9' %>">
              <i class="fa-solid <%= p.enabled === false ? 'fa-toggle-off' : 'fa-toggle-on' %>"></i>
            </button>
            <button class="icon-btn" title="ต่ออายุ Token 60 วัน"
              id="exchbtn-<%= p.pageId %>"
              data-id="<%= p.pageId %>" data-name="<%= p.pageName %>"
              onclick="exchangeToken(this.dataset.id, this.dataset.name, this)"
              style="color:#2e7d32;border-color:#a5d6a7<%= p.enabled === false ? ';opacity:.3;pointer-events:none' : '' %>">
              <i class="fa-solid fa-rotate"></i>
            </button>
            <button class="icon-btn" title="แก้ไข Token"
              data-id="<%= p.pageId %>" data-name="<%= p.pageName %>"
              data-token="<%= p.accessToken || '' %>" data-expiry="<%= p.tokenExpiry || '' %>"
              onclick="openEditPage(this.dataset.id,this.dataset.name,this.dataset.token,this.dataset.expiry)">
              <i class="fa-solid fa-pen"></i>
            </button>
            <button class="icon-btn danger" title="ลบเพจ"
              data-id="<%= p.pageId %>" data-name="<%= p.pageName %>"
              onclick="deletePage(this.dataset.id,this.dataset.name,this)">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>

        <div class="page-manage-token">
          <% if (p.accessToken) { %>
          <div class="token-field">
            <i class="fa-solid fa-key" style="color:#f7b928"></i>
            <span class="token-masked"><%= p.accessToken.slice(0,12) %>••••••••••••</span>
            <button class="token-copy-btn" onclick="copyToken('<%= p.accessToken %>', this)" title="คัดลอก Token">
              <i class="fa-regular fa-copy"></i>
            </button>
          </div>
          <% } else { %>
          <div class="token-field" style="color:#8a8d91">
            <i class="fa-solid fa-key"></i> <span>ยังไม่มี Access Token</span>
          </div>
          <% } %>
        </div>

        <div class="token-status-row">
          <div class="token-status-badge" data-expiry="<%= p.tokenExpiry || '' %>">
            <!-- filled by JS -->
          </div>
          <% if (p.tokenExpiry) { %>
          <div class="token-expiry-date" style="font-size:.75rem;color:#8a8d91">
            หมดอายุ: <%= new Date(p.tokenExpiry).toLocaleDateString('th-TH', {year:'numeric',month:'long',day:'numeric'}) %>
          </div>
          <% } %>
        </div>
      </div>
      <% }); %>
    </div>

  </main>

  <aside class="right-panel">
    <div class="card stats-card">
      <div class="stats-title"><i class="fa-solid fa-shield-halved" style="color:#1877f2"></i> สถานะ Token</div>
      <div class="stats-row"><span>🟢 ใช้งานได้</span><span class="stats-val green" id="countActive">—</span></div>
      <div class="stats-row"><span>🟡 ตรวจสอบ</span><span class="stats-val orange-text" id="countWarning">—</span></div>
      <div class="stats-row"><span>🔴 ใช้ไม่ได้</span><span class="stats-val" style="color:#c62828" id="countExpired">—</span></div>
    </div>
  </aside>

</div>

<!-- ── Import from Token Modal ── -->
<div id="tokenImportModal" class="map-modal-overlay" style="display:none" onclick="closeImportOnBg(event)">
  <div class="map-modal-box" style="width:520px;max-width:95vw">
    <div class="map-modal-header">
      <span><i class="fa-brands fa-facebook" style="color:#1877f2"></i> นำเข้าเพจจาก Facebook Token</span>
      <button class="map-close-btn" onclick="closeImportModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="map-modal-body" style="padding:1rem 1.25rem">
      <p style="font-size:.83rem;color:#65676b;margin:0 0 .75rem">
        ใส่ <strong>User Access Token</strong> จาก
        <a href="https://developers.facebook.com/tools/explorer/" target="_blank" rel="noopener" style="color:#1877f2">Graph API Explorer</a>
        เพื่อดึงรายการเพจที่คุณดูแล
      </p>
      <div style="display:flex;gap:.5rem;margin-bottom:.75rem">
        <input id="importTokenInput" type="text"
          placeholder="วาง User Access Token ที่นี่..."
          style="flex:1;padding:.55rem .75rem;border:1.5px solid #dbe0e6;border-radius:8px;font-family:inherit;font-size:.84rem;outline:none">
        <button class="btn-post" onclick="fetchImportPages()" id="fetchTokenBtn"
          style="padding:.5rem .9rem;font-size:.84rem;white-space:nowrap">
          <i class="fa-solid fa-magnifying-glass"></i> ดึงเพจ
        </button>
      </div>
      <div id="importPageList" style="max-height:320px;overflow-y:auto;border-radius:8px"></div>
    </div>
    <div class="map-modal-footer" id="importFooter" style="display:none">
      <span id="importSelectCount" style="font-size:.85rem;color:#65676b">เพิ่มใหม่ 0 เพจ</span>
      <div style="display:flex;gap:.5rem">
        <button id="refreshAllTokensBtn" onclick="refreshAllTokens()" style="display:none;padding:.5rem 1rem;background:#2e7d32;color:#fff;border:none;border-radius:8px;font-size:.84rem;cursor:pointer;align-items:center;gap:.4rem;font-family:inherit">
          <i class="fa-solid fa-rotate"></i> รีเฟรช Token เพจที่มีอยู่
        </button>
        <button class="btn-post" onclick="doImportPages()" style="padding:.5rem 1.1rem">
          <i class="fa-solid fa-file-import"></i> นำเข้าเพจใหม่
        </button>
      </div>
    </div>
  </div>
</div>

<script>
/* ── Pre-loaded data from server ── */
const _pageGroupsData = {};
const EXISTING_PAGE_IDS = new Set([<%- pages.map(p=>`'${p.pageId}'`).join(',') %>]);
<% pages.forEach(p => { %>
_pageGroupsData['<%= p.pageId %>'] = <%- JSON.stringify(p.groups || []) %>;
<% }); %>

/* ── App Settings ── */
async function loadSettings() {
  const res  = await fetch('/api/settings');
  const data = await res.json();
  if (data.fbAppId)     document.getElementById('cfg-app-id').value     = data.fbAppId;
  if (data.fbAppSecret) document.getElementById('cfg-app-secret').value = data.fbAppSecret;
  if (data.groupToken)  document.getElementById('cfg-group-token').value = data.groupToken;
  if (data.fbAppId || data.fbAppSecret || data.groupToken) {
    document.getElementById('settingsSavedBadge').style.display = '';
  }
}

function toggleGroupToken() {
  const inp  = document.getElementById('cfg-group-token');
  const icon = document.getElementById('groupTokenEyeIcon');
  if (inp.type === 'password') { inp.type = 'text';     icon.className = 'fa-solid fa-eye-slash'; }
  else                         { inp.type = 'password'; icon.className = 'fa-solid fa-eye'; }
}

function toggleSettings() {
  const body     = document.getElementById('settingsBody');
  const chevron  = document.getElementById('settingsChevron');
  const open     = body.style.display === 'none';
  body.style.display    = open ? '' : 'none';
  chevron.style.transform = open ? 'rotate(180deg)' : '';
  if (open) loadSettings();
}

function toggleSecret() {
  const inp  = document.getElementById('cfg-app-secret');
  const icon = document.getElementById('secretEyeIcon');
  if (inp.type === 'password') { inp.type = 'text';     icon.className = 'fa-solid fa-eye-slash'; }
  else                         { inp.type = 'password'; icon.className = 'fa-solid fa-eye'; }
}

async function saveSettings() {
  const fbAppId     = document.getElementById('cfg-app-id').value.trim();
  const fbAppSecret = document.getElementById('cfg-app-secret').value.trim();
  const groupToken  = document.getElementById('cfg-group-token').value.trim();
  if (!fbAppId || !fbAppSecret) {
    Swal.fire({ icon:'warning', title:'กรุณากรอกให้ครบ', text:'ต้องมีทั้ง App ID และ App Secret', confirmButtonColor:'#1877f2' });
    return;
  }
  await fetch('/api/settings', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ fbAppId, fbAppSecret, groupToken }),
  });
  document.getElementById('settingsSavedBadge').style.display = '';
  Swal.fire({ icon:'success', title:'บันทึกสำเร็จ', timer:1200, showConfirmButton:false });
}

loadSettings();

/* ── Token status logic ── */
function getDaysLeft(expiryISO) {
  if (!expiryISO) return null;
  const diff = new Date(expiryISO) - new Date();
  return Math.ceil(diff / 86400000);
}

function statusConfig(days) {
  if (days === null) return { cls: 'token-permanent', icon: 'fa-infinity',        color: '#1565c0', bg: '#e3f2fd', label: 'ถาวร ✓' };
  if (days < 0)     return { cls: 'token-expired',   icon: 'fa-circle-xmark',    color: '#c62828', bg: '#fdecea', label: `หมดอายุแล้ว ${Math.abs(days)} วัน` };
  if (days <= 7)    return { cls: 'token-critical',  icon: 'fa-triangle-exclamation', color: '#c62828', bg: '#fdecea', label: `หมดใน ${days} วัน ⚠️` };
  if (days <= 30)   return { cls: 'token-warning',   icon: 'fa-clock',           color: '#e65100', bg: '#fff3e0', label: `หมดใน ${days} วัน` };
  return            { cls: 'token-active',   icon: 'fa-circle-check',    color: '#2e7d32', bg: '#e8f5e9', label: `ปกติ · ${days} วัน` };
}

function renderTokenBadge(el, expiryISO) {
  const days   = getDaysLeft(expiryISO);
  const cfg    = statusConfig(days);
  el.style.cssText = `background:${cfg.bg};color:${cfg.color};padding:.25rem .75rem;border-radius:999px;font-size:.8rem;font-weight:700;display:inline-flex;align-items:center;gap:.3rem`;
  el.innerHTML = `<i class="fa-solid ${cfg.icon}"></i> ${cfg.label}`;
}

function updateAll() {
  let active = 0, warning = 0, expired = 0;
  document.querySelectorAll('.token-status-badge[data-expiry]').forEach(el => {
    const expiry = el.dataset.expiry;
    renderTokenBadge(el, expiry || null);
    const days = getDaysLeft(expiry || null);
    if (days === null) { active++; return; }   // null = permanent → count as active
    if (days < 0)    expired++;
    else if (days <= 30) warning++;
    else             active++;
  });
  document.getElementById('countActive').textContent  = active;
  document.getElementById('countWarning').textContent = warning;
  document.getElementById('countExpired').textContent = expired;

  // Summary banner
  const summary = document.getElementById('tokenSummary');
  if (expired > 0 || warning > 0) {
    summary.innerHTML = `
      <div class="card" style="background:${expired>0?'#fdecea':'#fff3e0'};border:1px solid ${expired>0?'#f5c6cb':'#ffe0b2'};padding:.75rem 1.1rem;display:flex;align-items:center;gap:.75rem">
        <i class="fa-solid fa-triangle-exclamation" style="font-size:1.4rem;color:${expired>0?'#c62828':'#e65100'}"></i>
        <div>
          ${expired > 0 ? `<strong style="color:#c62828">${expired} เพจ Token หมดอายุแล้ว</strong> — กรุณาอัปเดต Token ด่วน<br>` : ''}
          ${warning > 0 ? `<span style="color:#e65100">${warning} เพจ Token ใกล้หมดอายุ</span> — ควรต่ออายุเร็วๆ นี้` : ''}
        </div>
      </div>`;
  } else {
    summary.innerHTML = '';
  }
}

// Run now and every 60s
updateAll();
setInterval(updateAll, 60000);

/* ── Live token ping (auto on load) ── */
async function checkAllTokens() {
  let liveOk = 0, liveFail = 0;
  const TIMEOUT_MS = 5000;
  const timeoutId = setTimeout(() => {
    document.querySelectorAll('[id^="live-"]').forEach(el => {
      if (el.innerHTML.includes('fa-spin')) {
        el.style.background = '#f0f2f5'; el.style.color = '#8a8d91';
        el.innerHTML = '<i class="fa-solid fa-question-circle"></i> ตรวจสอบไม่ได้';
      }
    });
  }, TIMEOUT_MS);
  try {
    const res     = await fetch('/api/check-tokens', { signal: AbortSignal.timeout(TIMEOUT_MS) });
    clearTimeout(timeoutId);
    const { results } = await res.json();
    results.forEach(r => {
      const el = document.getElementById(`live-${r.pageId}`);
      if (!el) return;
      if (r.valid) {
        el.style.background = '#e8f5e9'; el.style.color = '#2e7d32';
        el.innerHTML = `<i class="fa-solid fa-circle-check"></i> ใช้งานได้`;
        liveOk++;
      } else {
        el.style.background = '#fdecea'; el.style.color = '#c62828';
        el.title = r.error || '';
        el.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> ใช้ไม่ได้`;
        liveFail++;
      }
    });
    // Update right panel with live counts
    document.getElementById('countActive').textContent  = liveOk;
    document.getElementById('countExpired').textContent = liveFail;
    document.getElementById('countWarning').textContent = '—';

    if (liveFail > 0) {
      const s = document.getElementById('tokenSummary');
      s.innerHTML = `
        <div class="card" style="background:#fdecea;border:1px solid #f5c6cb;padding:.75rem 1.1rem;display:flex;align-items:center;gap:.75rem">
          <i class="fa-solid fa-triangle-exclamation" style="font-size:1.4rem;color:#c62828"></i>
          <div>
            <strong style="color:#c62828">${liveFail} เพจ Token ใช้งานไม่ได้</strong> — กรุณาอัปเดต Token ใหม่
          </div>
        </div>`;
    }
  } catch {
    clearTimeout(timeoutId);
    document.querySelectorAll('[id^="live-"]').forEach(el => {
      if (el.innerHTML.includes('fa-spin')) {
        el.style.background = '#f0f2f5'; el.style.color = '#8a8d91';
        el.innerHTML = '<i class="fa-solid fa-question-circle"></i> ตรวจสอบไม่ได้';
      }
    });
  }
}

