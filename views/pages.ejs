async function togglePage(pageId) {
  const card = document.getElementById(`pcard-${pageId}`);
  const btn  = document.getElementById(`tbtn-${pageId}`);
  const currentEnabled = card.dataset.enabled !== 'false';
  const newEnabled = !currentEnabled;

  const res = await fetch(`/pages/${pageId}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ enabled: newEnabled }),
  });
  if (!res.ok) return;

  card.dataset.enabled = newEnabled ? 'true' : 'false';
  card.style.opacity   = newEnabled ? '' : '.55';
  btn.style.color       = newEnabled ? '#1877f2' : '#8a8d91';
  btn.style.borderColor = newEnabled ? '#90caf9' : '#ccc';
  btn.querySelector('i').className = `fa-solid ${newEnabled ? 'fa-toggle-on' : 'fa-toggle-off'}`;
  btn.title = newEnabled ? 'เปิดใช้งานอยู่ — คลิกเพื่อปิด' : 'ปิดใช้งานอยู่ — คลิกเพื่อเปิด';
  const exchBtn = document.getElementById(`exchbtn-${pageId}`);
  if (exchBtn) { exchBtn.style.opacity = newEnabled ? '' : '.3'; exchBtn.style.pointerEvents = newEnabled ? '' : 'none'; }
}

