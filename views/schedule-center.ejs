<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/auth-guard.js"></script>
  <script src="/js/navbar-user.js"></script>
  <style>
    :root {
      --c-blue:   #1877f2;
      --c-green:  #2e7d32;
      --c-purple: #7048e8;
      --c-amber:  #f59f00;
      --c-red:    #e03131;
      --shadow:   0 2px 16px rgba(0,0,0,.07);
    }

    /* ── Cards ── */
    .db-card { background:#fff; border-radius:16px; padding:1rem 1.15rem; box-shadow:var(--shadow); border:1px solid #f0f2f5 }

    /* ── KPI ── */
    .kpi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:.7rem }
    .kpi-card {
      background:#fff; border-radius:16px; padding:1.1rem 1.1rem 1rem;
      box-shadow:var(--shadow); border:1px solid #f0f2f5;
      position:relative; overflow:hidden; cursor:default
    }
    .kpi-card::before {
      content:''; position:absolute; top:0; left:0; right:0; height:3px;
      background:var(--kpi-c,#1877f2); border-radius:16px 16px 0 0
    }
    .kpi-top  { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:.5rem }
    .kpi-icon { width:40px; height:40px; border-radius:11px; display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0 }
    .kpi-lbl  { font-size:.7rem; color:#8a8d91; font-weight:600; line-height:1.3; text-align:right; max-width:80px }
    .kpi-val  { font-size:2rem; font-weight:900; line-height:1; color:#1c1e21; margin-bottom:.25rem }
    .kpi-sub  { font-size:.68rem; color:#aaa }

    /* ── Layout rows ── */
    .row-2  { display:grid; gap:.7rem }
    .col-21 { grid-template-columns:2fr 1fr }
    .col-11 { grid-template-columns:1fr 1fr }

    /* ── Section heading ── */
    .s-hd   { display:flex; align-items:center; justify-content:space-between; margin-bottom:.75rem }
    .s-hd-l { display:flex; align-items:center; gap:.45rem; font-size:.82rem; font-weight:700; color:#444 }
    .s-link { font-size:.73rem; font-weight:600; text-decoration:none; opacity:.75 }

    /* ── Engagement boxes ── */
    .eng-grid { display:grid; grid-template-columns:1fr 1fr; gap:.55rem }
    .eng-box  { border-radius:12px; padding:.75rem .85rem; border:1.5px solid #f0f2f5; background:#fafbfc }
    .eng-num  { font-size:1.25rem; font-weight:900; line-height:1 }
    .eng-lbl  { font-size:.68rem; color:#8a8d91; margin-top:.2rem }

    /* ── Agent list ── */
    .agent-row { padding:.6rem 0; border-bottom:1px solid #f2f4f5 }
    .agent-row:last-child { border-bottom:none; padding-bottom:0 }
    .ag-name { font-size:.78rem; font-weight:700; font-family:monospace; color:#1c1e21; margin-bottom:.28rem }
    .ag-sub  { font-size:.7rem; color:#8a8d91; margin-bottom:.32rem; line-height:1.6 }
    .rate-trk { background:#e9ecef; border-radius:999px; height:7px; overflow:hidden }
    .rate-fil { height:7px; border-radius:999px; transition:width .55s }

    /* ── Donut ── */
    .d-legend    { display:flex; flex-direction:column; gap:.38rem; margin-top:.6rem }
    .d-leg-row   { display:flex; align-items:center; gap:.5rem; font-size:.74rem }
    .d-dot       { width:10px; height:10px; border-radius:3px; flex-shrink:0 }

    /* ── Table ── */
    .tbl-wrap { overflow-x:auto }
    .db-tbl   { width:100%; border-collapse:collapse; font-size:.77rem }
    .db-tbl th { background:#f5f7fb; color:#65676b; font-weight:700; font-size:.71rem; padding:.48rem .65rem; text-align:left; border-bottom:2px solid #e8eaf0; white-space:nowrap }
    .db-tbl td { padding:.44rem .65rem; border-bottom:1px solid #f2f4f5; vertical-align:middle }
    .db-tbl tbody tr:last-child td { border-bottom:none }
    .db-tbl tbody tr:hover td { background:#f8faff }
    .db-tbl .tc { text-align:center }
    .mini-rt  { display:inline-flex; align-items:center; gap:.3rem }
    .mini-bg  { width:42px; height:5px; background:#e9ecef; border-radius:999px; overflow:hidden }
    .mini-fg  { height:5px; border-radius:999px }
    .bdg      { display:inline-block; padding:.1rem .42rem; border-radius:5px; font-size:.67rem; font-weight:700 }
    .bdg-ok   { background:#e8f5e9; color:#2e7d32 }
    .bdg-err  { background:#ffebee; color:#c62828 }
    .bdg-pnd  { background:#fffde7; color:#856404 }
    .bdg-oth  { background:#f3f4f6; color:#888 }

    /* ── Filter bar ── */
    .fb-row   { display:flex; align-items:center; gap:.4rem; flex-wrap:nowrap }
    .fb-sep   { width:1px; height:18px; background:#e8eaed; flex-shrink:0 }
    .fpill    { padding:.24rem .65rem; border-radius:20px; border:1.5px solid #dde1e7; font-size:.73rem; font-family:inherit; cursor:pointer; background:#fff; color:#555; font-weight:600; transition:background .12s,color .12s,border-color .12s; white-space:nowrap }
    .fpill.active { background:var(--c-blue); color:#fff; border-color:var(--c-blue) }
    .fpill.type-active { background:var(--c-blue); color:#fff; border-color:var(--c-blue) }
    .db-sel   { border:1.5px solid #dde1e7; border-radius:8px; padding:.27rem .55rem; font-size:.73rem; font-family:inherit; background:#fff; cursor:pointer; outline:none }
    .db-sel:focus { border-color:var(--c-blue) }
    .srch-w   { position:relative; flex:1; min-width:0 }
    .srch-w i { position:absolute; left:.55rem; top:50%; transform:translateY(-50%); color:#ccc; font-size:.7rem; pointer-events:none }
    .srch-i   { width:100%; box-sizing:border-box; border:1.5px solid #dde1e7; border-radius:8px; padding:.27rem .6rem .27rem 1.55rem; font-size:.73rem; font-family:inherit; outline:none }
    .srch-i:focus { border-color:var(--c-blue) }

    /* ── No data ── */
    .no-data { text-align:center; color:#ccc; font-size:.78rem; padding:1.6rem 0 }

    /* ── Clickable rows ── */
    .db-tbl tbody tr.clickable { cursor:pointer }
    .db-tbl tbody tr.clickable:hover td { background:#f0f7ff }
    .kpi-card.clickable:hover { box-shadow:0 4px 20px rgba(24,119,242,.13); transform:translateY(-1px); transition:box-shadow .15s,transform .15s }
    .kpi-card.clickable { cursor:pointer; transition:box-shadow .15s,transform .15s }
    .agent-row.clickable { cursor:pointer }
    .agent-row.clickable:hover { background:#f8faff; border-radius:8px; margin:0 -.5rem; padding-left:.5rem; padding-right:.5rem }

    /* ── Active filter indicator ── */
    .filter-active-dot { display:none; width:6px; height:6px; background:var(--c-red); border-radius:50%; margin-left:.3rem }
    .has-filter .filter-active-dot { display:inline-block }
  </style>
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <% if (locals.currentStaff) { %>
      <div class="navbar-user">
        <div class="avatar avatar-blue avatar-xs"><%= currentStaff.name.charAt(0).toUpperCase() %></div>
        <span class="navbar-user-name"><%= currentStaff.name %></span>
        <i class="fa-solid fa-chevron-down navbar-user-caret"></i>
        <div class="navbar-user-menu">
          <form method="POST" action="/logout">
            <button type="submit" class="navbar-user-menu-item"><i class="fa-solid fa-right-from-bracket"></i> ออกจากระบบ</button>
          </form>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</nav>

<div class="page-wrap">
  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item active"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">ระบบ</div>
    <a href="/user-activity" class="sidebar-item"><i class="fa-solid fa-user-clock"></i><span>กิจกรรมพนักงาน</span></a>
    <% if (locals.currentStaff && currentStaff.canManageStaff) { %>
    <a href="/manage-staff" class="sidebar-item"><i class="fa-solid fa-users-gear"></i><span>จัดการบัญชีผู้ใช้งาน</span></a>
    <a href="/audit-log" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติการเปลี่ยนแปลง</span></a>
    <% } %>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed" style="display:flex;flex-direction:column;gap:.7rem">

    <!-- ══ Header + Filter ══ -->
    <div class="db-card" style="padding:.85rem 1.15rem">

      <!-- Title row -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.65rem">
        <div style="display:flex;align-items:center;gap:.45rem">
          <i class="fa-solid fa-house" style="color:var(--c-blue)"></i>
          <span style="font-weight:800;font-size:1rem;color:#1c1e21">Dashboard</span>
          <div class="filter-active-dot" id="filter-dot"></div>
        </div>
        <div style="display:flex;align-items:center;gap:.55rem">
          <span id="last-update" style="font-size:.68rem;color:#ccc"></span>
          <button class="btn-link-sm" onclick="scRefresh()" id="refresh-btn">
            <i class="fa-solid fa-rotate-right"></i> รีเฟรช
          </button>
        </div>
      </div>

      <!-- Filter row 1: Date · Type · Status -->
      <div class="fb-row" style="margin-bottom:.4rem">
        <i class="fa-solid fa-calendar-days" style="color:#bbb;font-size:.72rem;flex-shrink:0"></i>
        <div style="display:flex;gap:.22rem;flex-shrink:0">
          <button class="fpill active" data-range="all"   onclick="setRange('all')">ทั้งหมด</button>
          <button class="fpill"        data-range="today" onclick="setRange('today')">วันนี้</button>
          <button class="fpill"        data-range="7d"    onclick="setRange('7d')">7 วัน</button>
          <button class="fpill"        data-range="30d"   onclick="setRange('30d')">30 วัน</button>
        </div>
        <div class="fb-sep"></div>
        <i class="fa-solid fa-layer-group" style="color:#bbb;font-size:.72rem;flex-shrink:0"></i>
        <div style="display:flex;gap:.22rem;flex-shrink:0">
          <button class="fpill type-active" data-type=""      onclick="setType('')">ทั้งหมด</button>
          <button class="fpill"             data-type="page"  onclick="setType('page')">📄 เพจ</button>
          <button class="fpill"             data-type="group" onclick="setType('group')">👥 กลุ่ม</button>
        </div>
        <div class="fb-sep"></div>
        <select id="sc-status" class="db-sel">
          <option value="">🏷 ทุกสถานะ</option>
          <option value="success">✅ สำเร็จ</option>
          <option value="failed">❌ ล้มเหลว</option>
          <option value="pending">⏳ รอดำเนินการ</option>
          <option value="running">🔄 กำลังทำงาน</option>
          <option value="expired">⏰ หมดเวลา</option>
          <option value="cancelled">🚫 ยกเลิก</option>
        </select>
      </div>

      <!-- Filter row 2: Search · Page · Agent · Clear -->
      <div class="fb-row">
        <div class="srch-w" style="max-width:200px">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input id="sc-search" class="srch-i" type="text" placeholder="ค้นหาข้อความโพส...">
        </div>
        <select id="sc-page"  class="db-sel" style="min-width:100px">
          <option value="">📄 ทุกเพจ</option>
        </select>
        <select id="sc-agent" class="db-sel" style="min-width:105px">
          <option value="">🤖 ทุกคน</option>
        </select>
        <select id="sc-privacy" class="db-sel" style="min-width:115px">
          <option value="">👥 ทุกประเภท</option>
          <option value="public">🌐 สาธารณะ</option>
          <option value="private">🔒 ส่วนตัว</option>
          <option value="paid">💰 เสียตัง</option>
        </select>
        <button class="btn-link-sm" onclick="clearFilters()" style="color:#bbb;white-space:nowrap;flex-shrink:0">
          <i class="fa-solid fa-rotate-left"></i> ล้างทั้งหมด
        </button>
      </div>
    </div>

    <!-- ══ KPI Row ══ -->
    <div class="kpi-grid">

      <!-- โพสลงเพจ -->
      <div id="kc-page-total" class="kpi-card clickable" style="--kpi-c:var(--c-blue)" onclick="window.location='/history'" title="ดูประวัติโพสเพจ">
        <div class="kpi-top">
          <div class="kpi-icon" style="background:#e7f3ff">
            <i class="fa-solid fa-pen-to-square" style="color:var(--c-blue)"></i>
          </div>
          <div class="kpi-lbl">โพสลงเพจ</div>
        </div>
        <div class="kpi-val" id="k-p-total">—</div>
        <div class="kpi-sub">
          ✅ <span id="k-p-succ" style="color:var(--c-green);font-weight:700">—</span>
          &nbsp;❌ <span id="k-p-fail" style="color:var(--c-red);font-weight:700">—</span>
          &nbsp;⏳ <span id="k-p-pend" style="font-weight:600">—</span>
        </div>
      </div>

      <!-- ผลสำเร็จ -->
      <div id="kc-page-results" class="kpi-card clickable" style="--kpi-c:var(--c-green)" onclick="window.location='/overview'" title="ดูภาพรวมโพสเพจ">
        <div class="kpi-top">
          <div class="kpi-icon" style="background:#e8fde8">
            <i class="fa-solid fa-circle-check" style="color:var(--c-green)"></i>
          </div>
          <div class="kpi-lbl">ผลโพสสำเร็จ (ครั้ง)</div>
        </div>
        <div class="kpi-val" id="k-p-results">—</div>
        <div class="kpi-sub">ใน <span id="k-p-pages" style="color:var(--c-blue);font-weight:700">—</span> เพจ · อัตรา <span id="k-p-rate" style="font-weight:700">—</span></div>
      </div>

      <!-- งานแชร์กลุ่ม -->
      <div id="kc-group-jobs" class="kpi-card clickable" style="--kpi-c:var(--c-purple)" onclick="window.location='/job-queue'" title="ดูคิวโพสกลุ่ม">
        <div class="kpi-top">
          <div class="kpi-icon" style="background:#f5f0ff">
            <i class="fa-solid fa-users-rectangle" style="color:var(--c-purple)"></i>
          </div>
          <div class="kpi-lbl">งานแชร์กลุ่ม</div>
        </div>
        <div class="kpi-val" id="k-g-jobs">—</div>
        <div class="kpi-sub">ระบบมี <strong style="color:var(--c-purple)"><%= gTotal %></strong> กลุ่ม · โพสไป <span id="k-g-grpcount" style="font-weight:700;color:var(--c-purple)">—</span> กลุ่ม · <span id="k-g-posted" style="font-weight:700">—</span> ครั้ง</div>
      </div>

      <!-- อัตราสำเร็จกลุ่ม -->
      <div id="kc-group-rate" class="kpi-card clickable" style="--kpi-c:var(--c-amber)" onclick="window.location='/group-overview'" title="ดูภาพรวมกลุ่ม">
        <div class="kpi-top">
          <div class="kpi-icon" style="background:#fffde7">
            <i class="fa-solid fa-chart-pie" style="color:var(--c-amber)"></i>
          </div>
          <div class="kpi-lbl">อัตราสำเร็จกลุ่ม</div>
        </div>
        <div class="kpi-val" id="k-g-rate" style="font-size:2rem">—</div>
        <div class="kpi-sub">✅ <span id="k-g-succ" style="color:var(--c-green);font-weight:700">—</span> &nbsp;❌ <span id="k-g-fail" style="color:var(--c-red);font-weight:700">—</span></div>
      </div>
    </div>

    <!-- ══ Chart (2/3) + Agent (1/3) ══ -->
    <div class="row-2 col-21">

      <!-- Activity chart -->
      <div class="db-card">
        <div class="s-hd" style="margin-bottom:.6rem">
          <div class="s-hd-l">
            <i class="fa-solid fa-chart-column" style="color:var(--c-blue)"></i>
            กิจกรรมรวม
          </div>
          <div class="status-filter" style="gap:.22rem">
            <button class="filter-btn active" data-cu="day"   onclick="setChartUnit('day')">วัน</button>
            <button class="filter-btn"        data-cu="month" onclick="setChartUnit('month')">เดือน</button>
            <button class="filter-btn"        data-cu="year"  onclick="setChartUnit('year')">ปี</button>
          </div>
        </div>
        <div id="actWrapPage" style="margin-bottom:.9rem;display:none">
          <div style="font-size:.72rem;font-weight:700;color:var(--c-blue);margin-bottom:.3rem">
            <span style="display:inline-block;width:8px;height:8px;background:var(--c-blue);border-radius:2px;margin-right:4px;vertical-align:middle"></span>โพสเพจ
          </div>
          <canvas id="actChartPage" height="75"></canvas>
        </div>
        <div id="actWrapGroup" style="display:none">
          <div style="font-size:.72rem;font-weight:700;color:var(--c-green);margin-bottom:.3rem">
            <span style="display:inline-block;width:8px;height:8px;background:var(--c-green);border-radius:2px;margin-right:4px;vertical-align:middle"></span>แชร์กลุ่ม
          </div>
          <canvas id="actChartGroup" height="75"></canvas>
        </div>
        <div id="actNoData" style="display:none;text-align:center;padding:1.5rem;color:#aaa;font-size:.8rem">
          <i class="fa-solid fa-chart-column" style="font-size:1.5rem;opacity:.3;display:block;margin-bottom:.4rem"></i>
          ไม่มีข้อมูลในช่วงเวลาที่เลือก
        </div>
      </div>

      <!-- Staff breakdown (which staff member ran each group-share job) -->
      <div id="card-agent" class="db-card" style="display:flex;flex-direction:column">
        <div class="s-hd">
          <div class="s-hd-l">
            <i class="fa-solid fa-user-clock" style="color:var(--c-purple)"></i>
            แยกตามพนักงาน
          </div>
          <a href="/group-overview" class="s-link" style="color:var(--c-purple)">ดูเพิ่ม →</a>
        </div>
        <div id="agent-list" style="overflow-y:auto;flex:1">
          <div class="no-data">กำลังโหลด...</div>
        </div>
      </div>
    </div>

    <!-- ══ Group Donut (1/3) + Group Table (2/3) ══ -->
    <div id="row-group-bottom" class="row-2" style="grid-template-columns:1fr 2fr;display:none">

      <!-- Group status donut -->
      <div class="db-card" style="display:flex;flex-direction:column">
        <div class="s-hd">
          <div class="s-hd-l">
            <i class="fa-solid fa-circle-half-stroke" style="color:var(--c-purple)"></i>
            สัดส่วนงานกลุ่ม
          </div>
        </div>
        <div style="flex:1;display:flex;align-items:center;justify-content:center;min-height:130px;position:relative">
          <canvas id="groupDonutChart" style="max-height:120px;max-width:120px"></canvas>
          <div style="position:absolute;text-align:center;pointer-events:none">
            <div id="group-donut-total" style="font-size:1.5rem;font-weight:900;color:#333;line-height:1">—</div>
            <div style="font-size:.62rem;color:#aaa">งานทั้งหมด</div>
          </div>
        </div>
        <div class="d-legend" id="group-donut-legend"></div>
      </div>

      <!-- Per-group table -->
      <div class="db-card">
        <div class="s-hd">
          <div class="s-hd-l">
            <i class="fa-solid fa-table-cells" style="color:var(--c-green)"></i>
            ภาพรวมแต่ละกลุ่ม
          </div>
          <a href="/group-overview" class="s-link" style="color:var(--c-green)">ดูรายละเอียด →</a>
        </div>
        <div class="tbl-wrap" id="group-table-wrap">
          <div class="no-data">กำลังโหลด...</div>
        </div>
      </div>
    </div>

    <!-- ══ Donut (1/3) + Engagement (2/3) ══ -->
    <div id="row-donut-eng" class="row-2" style="grid-template-columns:1fr 2fr">

      <!-- Status donut -->
      <div class="db-card" style="display:flex;flex-direction:column">
        <div class="s-hd">
          <div class="s-hd-l">
            <i class="fa-solid fa-circle-half-stroke" style="color:var(--c-purple)"></i>
            สัดส่วนโพสเพจ
          </div>
        </div>
        <div style="flex:1;display:flex;align-items:center;justify-content:center;min-height:130px;position:relative">
          <canvas id="donutChart" style="max-height:120px;max-width:120px"></canvas>
          <div style="position:absolute;text-align:center;pointer-events:none">
            <div id="donut-total" style="font-size:1.5rem;font-weight:900;color:#333;line-height:1">—</div>
            <div style="font-size:.62rem;color:#aaa">โพสทั้งหมด</div>
          </div>
        </div>
        <div class="d-legend" id="donut-legend"></div>
      </div>

      <!-- Engagement -->
      <div class="db-card">
        <div class="s-hd">
          <div class="s-hd-l">
            <i class="fa-solid fa-fire" style="color:var(--c-amber)"></i>
            Engagement
            <span style="font-size:.68rem;font-weight:400;color:#aaa">(จากโพสเพจ)</span>
          </div>
          <a href="/overview" class="s-link" style="color:var(--c-blue)">ดูรายละเอียด →</a>
        </div>
        <div class="eng-grid">
          <div class="eng-box" style="border-color:#c8d8f5">
            <div class="eng-num" id="e-likes" style="color:var(--c-blue)">—</div>
            <div class="eng-lbl">👍 ไลค์</div>
          </div>
          <div class="eng-box" style="border-color:#ffd9a0">
            <div class="eng-num" id="e-comments" style="color:#e67700">—</div>
            <div class="eng-lbl">💬 คอมเมนต์</div>
          </div>
          <div class="eng-box" style="border-color:#c8e6c9">
            <div class="eng-num" id="e-shares" style="color:var(--c-green)">—</div>
            <div class="eng-lbl">🔁 แชร์</div>
          </div>
          <div class="eng-box" style="border-color:#d4c5f9">
            <div class="eng-num" id="e-reach" style="color:var(--c-purple)">—</div>
            <div class="eng-lbl">👀 Reach</div>
          </div>
        </div>
        <!-- Page success rate -->
        <div style="margin-top:.9rem;padding-top:.8rem;border-top:1px solid #f2f4f5">
          <div style="display:flex;justify-content:space-between;margin-bottom:.35rem">
            <span style="font-size:.72rem;color:#aaa;font-weight:600">อัตราสำเร็จโพสเพจ</span>
            <span id="e-prate" style="font-size:.85rem;font-weight:800;color:var(--c-green)">—</span>
          </div>
          <div class="rate-trk"><div class="rate-fil" id="e-prate-bar" style="background:var(--c-green);width:0%"></div></div>
        </div>
      </div>
    </div>

    <!-- ══ Per-page table ══ -->
    <div id="card-page-table" class="db-card">
      <div class="s-hd">
        <div class="s-hd-l">
          <i class="fa-solid fa-table-cells" style="color:var(--c-blue)"></i>
          ภาพรวมแต่ละเพจ
        </div>
        <a href="/overview" class="s-link" style="color:var(--c-blue)">ดูรายละเอียด →</a>
      </div>
      <div class="tbl-wrap" id="page-table-wrap">
        <div class="no-data">กำลังโหลด...</div>
      </div>
    </div>

  </main>
</div>

<script>
let _items           = <%- JSON.stringify(items) %>;
let _groupPrivacyMap = <%- JSON.stringify(groupPrivacyMap) %>;
let _range     = 'all';
let _type      = '';
let _chartUnit = 'day';
let _actChartPage  = null;
let _actChartGroup = null;
let _donut      = null;
let _groupDonut = null;

const fmt = n   => Number(n).toLocaleString();
const set = (id,v) => { const e=document.getElementById(id); if(e) e.textContent=v; };
const esc = s   => String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
const rateColor = r => r>=80?'var(--c-green)':r>=50?'var(--c-amber)':'var(--c-red)';

/* ── Populate dropdowns ── */
function populateFilters() {
  const pages=new Set(), staffMap=new Map();
  _items.forEach(i=>{
    if(i.type==='page') (i.targetPages||[]).forEach(p=>pages.add(p));
    staffMap.set(i.staffId||'__unassigned__', i.staffName||'ไม่ระบุตัวตน');
  });
  const pgS=document.getElementById('sc-page'), agS=document.getElementById('sc-agent');
  const pv=pgS.value, av=agS.value;
  pgS.innerHTML='<option value="">📄 ทุกเพจ</option>'+[...pages].sort().map(p=>`<option value="${esc(p)}">${esc(p)}</option>`).join('');
  agS.innerHTML='<option value="">🤖 ทุกคน</option>'+[...staffMap.entries()].sort((a,b)=>a[1].localeCompare(b[1],'th')).map(([id,name])=>`<option value="${esc(id)}">${esc(name)}</option>`).join('');
  pgS.value=pv; agS.value=av;
}

/* ── Filter ── */
function filterByRange(items) {
  if(_range==='all') return items;
  const now=Date.now();
  const cut=_range==='today'
    ?(()=>{const d=new Date();d.setHours(0,0,0,0);return d.getTime();})()
    :_range==='7d'?now-7*86400000:now-30*86400000;
  return items.filter(i=>new Date(i.createdAt).getTime()>=cut);
}

function getFiltered() {
  const q       = document.getElementById('sc-search').value.toLowerCase().trim();
  const pg      = document.getElementById('sc-page').value;
  const ag      = document.getElementById('sc-agent').value;
  const status  = document.getElementById('sc-status').value;
  const privacy = document.getElementById('sc-privacy').value;
  return filterByRange(_items).filter(i=>{
    if(_type && i.type!==_type) return false;
    if(q && !i.message.toLowerCase().includes(q)) return false;
    if(i.type==='page'  && pg && !(i.targetPages||[]).includes(pg)) return false;
    if(ag && (i.staffId||'__unassigned__')!==ag) return false;
    if(status && i.status!==status) return false;
    if(privacy && i.type==='group') {
      const hasMatch=(i.targetGroups||[]).some(g=>_groupPrivacyMap[g]===privacy);
      if(!hasMatch) return false;
    }
    return true;
  });
}

function updateFilterDot() {
  const q  =document.getElementById('sc-search').value.trim();
  const pg =document.getElementById('sc-page').value;
  const ag =document.getElementById('sc-agent').value;
  const st =document.getElementById('sc-status').value;
  const pv =document.getElementById('sc-privacy').value;
  const active=q||pg||ag||st||pv||_range!=='all'||_type!=='';
  document.getElementById('filter-dot').style.display=active?'inline-block':'none';
}

/* ── KPI ── */
function renderKPI(all) {
  const pi=all.filter(i=>i.type==='page');
  const gi=all.filter(i=>i.type==='group');
  const pSucc   =pi.filter(i=>i.status==='success').length;
  const pFail   =pi.filter(i=>i.status==='failed').length;
  const pPend   =pi.filter(i=>['pending','running'].includes(i.status)).length;
  const pResults=pi.reduce((s,i)=>s+(i.successCount||0),0);
  const pPages  =new Set(pi.flatMap(i=>i.targetPages||[])).size;
  const pRate   =pi.length>0?Math.round(pSucc/pi.length*100):0;
  const gJobs   =gi.length;
  const gSuccess=gi.reduce((s,i)=>s+(i.successCount||0),0);
  const gFailed =gi.reduce((s,i)=>s+(i.failCount||0),0);
  const gPosted =gSuccess+gFailed;
  const gRate   =gPosted>0?Math.round(gSuccess/gPosted*100):0;

  set('k-p-total',   fmt(pi.length));
  set('k-p-succ',    fmt(pSucc));
  set('k-p-fail',    fmt(pFail));
  set('k-p-pend',    fmt(pPend));
  set('k-p-results', fmt(pResults));
  set('k-p-pages',   fmt(pPages));
  set('k-p-rate',    pRate+'%');
  const gDistinctGroups = new Set(gi.flatMap(i=>i.targetGroups||[])).size;
  set('k-g-jobs',     fmt(gJobs));
  set('k-g-grpcount', fmt(gDistinctGroups));
  set('k-g-posted',   fmt(gPosted));
  set('k-g-succ',    fmt(gSuccess));
  set('k-g-fail',    fmt(gFailed));
  set('k-g-rate',    gRate+'%');

  const rEl=document.getElementById('k-g-rate');
  if(rEl) rEl.style.color=rateColor(gRate);
  const rpEl=document.getElementById('k-p-rate');
  if(rpEl) rpEl.style.color=rateColor(pRate);
}

/* ── Engagement ── */
function renderEngagement(all) {
  const pi=all.filter(i=>i.type==='page');
  let lk=0,co=0,sh=0,re=0;
  pi.forEach(i=>{const a=i.analytics||{};lk+=a.likes||0;co+=a.comments||0;sh+=a.shares||0;re+=a.reach||0;});
  set('e-likes',fmt(lk)); set('e-comments',fmt(co)); set('e-shares',fmt(sh)); set('e-reach',fmt(re));
  const pSucc=pi.filter(i=>i.status==='success').length;
  const pRate=pi.length>0?Math.round(pSucc/pi.length*100):0;
  const col=rateColor(pRate);
  set('e-prate', pRate+'%');
  const rEl=document.getElementById('e-prate');
  const bar=document.getElementById('e-prate-bar');
  if(rEl)rEl.style.color=col;
  if(bar){bar.style.width=pRate+'%';bar.style.background=col;}
}

/* ── Donut ── */
function renderDonut(all) {
  const pi=all.filter(i=>i.type==='page');
  const data=[
    pi.filter(i=>i.status==='success').length,
    pi.filter(i=>i.status==='failed').length,
    pi.filter(i=>['pending','running'].includes(i.status)).length,
    pi.filter(i=>['expired','cancelled'].includes(i.status)).length,
  ];
  const labels=['สำเร็จ','ล้มเหลว','รอ/กำลัง','อื่นๆ'];
  const colors=['#2e7d32','#e03131','#f59f00','#ccc'];
  const total=pi.length;
  set('donut-total', fmt(total));
  const ctx=document.getElementById('donutChart');
  if(_donut)_donut.destroy();
  _donut=new Chart(ctx,{
    type:'doughnut',
    data:{labels,datasets:[{data,backgroundColor:colors,borderWidth:2,borderColor:'#fff',hoverBorderColor:'#fff'}]},
    options:{
      cutout:'64%',responsive:true,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>`${c.label}: ${c.raw} (${total>0?Math.round(c.raw/total*100):0}%)`}}}
    }
  });
  document.getElementById('donut-legend').innerHTML=labels.map((l,i)=>
    `<div class="d-leg-row">
      <div class="d-dot" style="background:${colors[i]}"></div>
      <span style="color:#555;flex:1">${l}</span>
      <span style="font-weight:700;color:#333;min-width:24px;text-align:right">${data[i]}</span>
      <span style="color:#bbb;font-size:.68rem;min-width:30px;text-align:right">${total>0?Math.round(data[i]/total*100):0}%</span>
    </div>`
  ).join('');
}

/* ── Staff breakdown ── */
// Grouped by each job's own staffId (set once at creation, never rewritten)
// -- NOT by which Agent machine ran it, since the same physical Desktop
// Agent install can be shared by different staff at different times, and
// grouping by machine would misattribute one person's older jobs to
// whoever used that computer most recently.
function renderAgentList(all) {
  // Soft-deleted staff are hidden here (not shown as "ไม่ระบุตัวตน") until
  // restored — their other numbers (KPIs, charts, tables) are unaffected,
  // only this per-person breakdown skips them.
  const items=all.filter(i=>(i.type==='group'||i.type==='page')&&!i.staffDeleted);
  const wrap=document.getElementById('agent-list');
  if(!items.length){wrap.innerHTML='<div class="no-data">ไม่มีข้อมูล</div>';return;}
  const map={};
  items.forEach(item=>{
    const key=item.staffId||'__unassigned__';
    if(!map[key])map[key]={label:item.staffName||'ไม่ระบุตัวตน',staffId:item.staffId||null,pagePosts:0,groupJobs:0,groups:new Set(),success:0,fail:0,pending:0};
    const d=map[key];
    if(item.type==='page') d.pagePosts++; else d.groupJobs++;
    (item.targetGroups||[]).forEach(g=>d.groups.add(g));
    d.success+=item.successCount||0;
    d.fail   +=item.failCount||0;
    if(['pending','running'].includes(item.status))d.pending++;
  });
  wrap.innerHTML=Object.entries(map)
    .sort((a,b)=>(b[1].pagePosts+b[1].groupJobs)-(a[1].pagePosts+a[1].groupJobs))
    .map(([key,d],idx)=>{
      const t=d.success+d.fail;
      const r=t>0?Math.round(d.success/t*100):0;
      const col=rateColor(r);
      const target=`/user-activity/${d.staffId||'unassigned'}`;
      return `<div class="agent-row clickable" onclick="window.location='${target}'">
        <div class="ag-name">
          <span style="display:inline-block;width:17px;height:17px;background:#f0f2f5;border-radius:5px;text-align:center;font-size:.65rem;line-height:17px;font-style:normal;margin-right:.35rem;font-family:sans-serif">${idx+1}</span>
          <i class="fa-solid fa-user-clock" style="color:var(--c-purple);font-size:.7rem;margin-right:.3rem"></i>${esc(d.label)}
        </div>
        <div class="ag-sub">
          ${d.pagePosts} โพสต์เพจ · ${d.groupJobs} แชร์กลุ่ม${d.groups.size?` (${d.groups.size} กลุ่ม)`:''}
          ${d.pending?`· <span style="color:var(--c-amber)">⏳ ${d.pending} รอ</span>`:''}
          · <span style="color:var(--c-green)">✅ ${d.success}</span>
          · <span style="color:var(--c-red)">❌ ${d.fail}</span>
          · <strong style="color:${col}">${r}%</strong>
        </div>
        <div class="rate-trk"><div class="rate-fil" style="width:${r}%;background:${col}"></div></div>
      </div>`;
    }).join('');
}

/* ── Per-page table ── */
function renderPageTable(all) {
  const pi=all.filter(i=>i.type==='page');
  const wrap=document.getElementById('page-table-wrap');
  if(!pi.length){wrap.innerHTML='<div class="no-data">ไม่มีข้อมูลในช่วงที่เลือก</div>';return;}
  const map={};
  pi.forEach(item=>{
    const pgs=(item.targetPages||[]).length?item.targetPages:['(ไม่ระบุ)'];
    pgs.forEach(pg=>{
      if(!map[pg])map[pg]={posts:0,success:0,failed:0,pending:0,lk:0,co:0,sh:0,re:0};
      map[pg].posts++;
      if(item.status==='success')                          map[pg].success++;
      else if(item.status==='failed')                      map[pg].failed++;
      else if(['pending','running'].includes(item.status)) map[pg].pending++;
      const a=item.analytics||{};
      map[pg].lk+=a.likes||0;map[pg].co+=a.comments||0;map[pg].sh+=a.shares||0;map[pg].re+=a.reach||0;
    });
  });
  const rows=Object.entries(map)
    .sort((a,b)=>b[1].posts-a[1].posts)
    .map(([pg,d])=>{
      const r=d.posts>0?Math.round(d.success/d.posts*100):0;
      const col=rateColor(r);
      const badge=d.failed>0?'<span class="bdg bdg-err">มีล้มเหลว</span>'
                 :d.pending>0?'<span class="bdg bdg-pnd">รออยู่</span>'
                 :d.success>0?'<span class="bdg bdg-ok">ปกติ</span>'
                 :'<span class="bdg bdg-oth">—</span>';
      return `<tr class="clickable" onclick="window.location='/overview'">
        <td style="font-weight:600;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(pg)}">${esc(pg)}</td>
        <td>${badge}</td>
        <td class="tc" style="font-weight:800">${d.posts}</td>
        <td class="tc" style="color:var(--c-green);font-weight:700">${d.success}</td>
        <td class="tc" style="color:var(--c-red)">${d.failed}</td>
        <td class="tc" style="color:var(--c-amber)">${d.pending}</td>
        <td class="tc" style="color:var(--c-blue)">${fmt(d.lk)}</td>
        <td class="tc" style="color:#e67700">${fmt(d.co)}</td>
        <td class="tc" style="color:var(--c-green)">${fmt(d.sh)}</td>
        <td class="tc" style="color:var(--c-purple)">${fmt(d.re)}</td>
        <td class="tc">
          <div class="mini-rt">
            <div class="mini-bg"><div class="mini-fg" style="width:${r}%;background:${col}"></div></div>
            <span style="color:${col};font-weight:700;min-width:30px">${r}%</span>
          </div>
        </td>
      </tr>`;
    }).join('');
  wrap.innerHTML=`<table class="db-tbl"><thead><tr>
    <th>เพจ</th><th>สถานะ</th>
    <th class="tc">โพส</th><th class="tc">✅</th><th class="tc">❌</th><th class="tc">⏳</th>
    <th class="tc">👍</th><th class="tc">💬</th><th class="tc">🔁</th><th class="tc">👀</th>
    <th class="tc">อัตราสำเร็จ</th>
  </tr></thead><tbody>${rows}</tbody></table>`;
}

/* ── Group Donut ── */
function renderGroupDonut(all) {
  const gi=all.filter(i=>i.type==='group');
  const data=[
    gi.filter(i=>i.status==='success').length,
    gi.filter(i=>i.status==='failed').length,
    gi.filter(i=>['pending','running'].includes(i.status)).length,
    gi.filter(i=>['expired','cancelled'].includes(i.status)).length,
  ];
  const labels=['สำเร็จ','ล้มเหลว','รอ/กำลัง','อื่นๆ'];
  const colors=['#2e7d32','#e03131','#f59f00','#ccc'];
  const total=gi.length;
  set('group-donut-total', fmt(total));
  const ctx=document.getElementById('groupDonutChart');
  if(!ctx) return;
  if(_groupDonut)_groupDonut.destroy();
  _groupDonut=new Chart(ctx,{
    type:'doughnut',
    data:{labels,datasets:[{data,backgroundColor:colors,borderWidth:2,borderColor:'#fff',hoverBorderColor:'#fff'}]},
    options:{
      cutout:'64%',responsive:true,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>`${c.label}: ${c.raw} (${total>0?Math.round(c.raw/total*100):0}%)`}}}
    }
  });
  const leg=document.getElementById('group-donut-legend');
  if(leg) leg.innerHTML=labels.map((l,i)=>
    `<div class="d-leg-row">
      <div class="d-dot" style="background:${colors[i]}"></div>
      <span style="color:#555;flex:1">${l}</span>
      <span style="font-weight:700;color:#333;min-width:24px;text-align:right">${data[i]}</span>
      <span style="color:#bbb;font-size:.68rem;min-width:30px;text-align:right">${total>0?Math.round(data[i]/total*100):0}%</span>
    </div>`
  ).join('');
}

/* ── Per-group table ── */
function renderGroupTable(all) {
  const gi=all.filter(i=>i.type==='group');
  const wrap=document.getElementById('group-table-wrap');
  if(!wrap) return;
  if(!gi.length){wrap.innerHTML='<div class="no-data">ไม่มีข้อมูลในช่วงที่เลือก</div>';return;}
  const map={};
  gi.forEach(item=>{
    const groups=(item.targetGroups||[]).length?item.targetGroups:['(ไม่ระบุ)'];
    groups.forEach(g=>{
      if(!map[g])map[g]={jobs:0,success:0,fail:0,pending:0};
      map[g].jobs++;
      if(item.status==='success')                            map[g].success++;
      else if(item.status==='failed')                        map[g].fail++;
      else if(['pending','running'].includes(item.status))   map[g].pending++;
    });
  });
  const pvBadge = p =>
    p==='public'  ? '<span style="display:inline-block;padding:.1rem .38rem;border-radius:5px;font-size:.67rem;font-weight:700;background:#d3f9d8;color:#2f9e44;border:1px solid #b2f2bb">🌐 สาธารณะ</span>'
    :p==='private'? '<span style="display:inline-block;padding:.1rem .38rem;border-radius:5px;font-size:.67rem;font-weight:700;background:#fff4e6;color:#e67700;border:1px solid #ffd8a8">🔒 ส่วนตัว</span>'
    :p==='paid'   ? '<span style="display:inline-block;padding:.1rem .38rem;border-radius:5px;font-size:.67rem;font-weight:700;background:#fff3bf;color:#e67700;border:1px solid #ffe066">💰 เสียตัง</span>'
    : '<span style="display:inline-block;padding:.1rem .38rem;border-radius:5px;font-size:.67rem;background:#f1f3f5;color:#adb5bd;border:1px solid #dee2e6">– –</span>';
  const rows=Object.entries(map)
    .sort((a,b)=>b[1].jobs-a[1].jobs)
    .slice(0,8)
    .map(([g,d])=>{
      const t=d.success+d.fail;
      const r=t>0?Math.round(d.success/t*100):0;
      const col=rateColor(r);
      const statBadge=d.fail>0?'<span class="bdg bdg-err">มีล้มเหลว</span>'
                     :d.pending>0?'<span class="bdg bdg-pnd">รออยู่</span>'
                     :d.success>0?'<span class="bdg bdg-ok">ปกติ</span>'
                     :'<span class="bdg bdg-oth">—</span>';
      const pv=_groupPrivacyMap[g]||null;
      return `<tr class="clickable" onclick="window.location='/group-overview'">
        <td style="font-weight:600;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(g)}">${esc(g)}</td>
        <td>${pvBadge(pv)}</td>
        <td>${statBadge}</td>
        <td class="tc" style="font-weight:800">${d.jobs}</td>
        <td class="tc" style="color:var(--c-green);font-weight:700">${d.success}</td>
        <td class="tc" style="color:var(--c-red)">${d.fail}</td>
        <td class="tc" style="color:var(--c-amber)">${d.pending||0}</td>
        <td class="tc">
          <div class="mini-rt">
            <div class="mini-bg"><div class="mini-fg" style="width:${r}%;background:${col}"></div></div>
            <span style="color:${col};font-weight:700;min-width:30px">${r}%</span>
          </div>
        </td>
      </tr>`;
    }).join('');
  wrap.innerHTML=`<table class="db-tbl"><thead><tr>
    <th>กลุ่ม</th><th>ประเภท</th><th>สถานะ</th>
    <th class="tc">งาน</th><th class="tc">✅</th><th class="tc">❌</th><th class="tc">⏳</th>
    <th class="tc">อัตราสำเร็จ</th>
  </tr></thead><tbody>${rows}</tbody></table>`;
}

/* ── Activity chart ── */
function bucketKey(at,unit) {
  const d=new Date(at);
  if(unit==='day')   return d.toLocaleDateString('en-CA');
  if(unit==='month') return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
  return String(d.getFullYear());
}
function setChartUnit(u) {
  _chartUnit=u;
  document.querySelectorAll('[data-cu]').forEach(b=>b.classList.toggle('active',b.dataset.cu===u));
  renderActChart(getFiltered());
}
function _makeChart(canvasId, data, color, prev) {
  const ctx = document.getElementById(canvasId);
  if (!ctx) return null;
  if (prev) prev.destroy();
  return new Chart(ctx, {
    type: 'bar',
    data: { labels: data.keys, datasets: [{
      data: data.vals, backgroundColor: color,
      borderRadius: 5, borderSkipped: false,
    }]},
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false }, ticks: { font: { size: 10 }, maxRotation: 30 } },
        y: { beginAtZero: true, ticks: { precision: 0, font: { size: 10 } }, grid: { color: '#f2f4f5' } },
      },
    },
  });
}
function _setChartSection(wrapperId, hasData) {
  const el = document.getElementById(wrapperId);
  if (el) el.style.display = hasData ? '' : 'none';
}
function renderActChart(all) {
  if (typeof Chart === 'undefined') return;
  const pi = all.filter(i => i.type === 'page'  && (i.scheduledAt || i.createdAt));
  const gi = all.filter(i => i.type === 'group' && (i.scheduledAt || i.createdAt));
  const pB = {}, gB = {};
  pi.forEach(i => { const k = bucketKey(i.scheduledAt||i.createdAt, _chartUnit); pB[k] = (pB[k]||0)+1; });
  gi.forEach(i => { const k = bucketKey(i.scheduledAt||i.createdAt, _chartUnit); gB[k] = (gB[k]||0)+1; });
  const pKeys = Object.keys(pB).sort().slice(-30);
  const gKeys = Object.keys(gB).sort().slice(-30);
  _setChartSection('actWrapPage',  pKeys.length > 0);
  _setChartSection('actWrapGroup', gKeys.length > 0);
  const noDataEl = document.getElementById('actNoData');
  if (noDataEl) noDataEl.style.display = (pKeys.length === 0 && gKeys.length === 0) ? '' : 'none';
  if (_actChartPage)  { _actChartPage.destroy();  _actChartPage  = null; }
  if (_actChartGroup) { _actChartGroup.destroy(); _actChartGroup = null; }
  if (pKeys.length > 0) _actChartPage  = _makeChart('actChartPage',  { keys: pKeys, vals: pKeys.map(k => pB[k]) }, 'rgba(24,119,242,.75)', null);
  if (gKeys.length > 0) _actChartGroup = _makeChart('actChartGroup', { keys: gKeys, vals: gKeys.map(k => gB[k]) }, 'rgba(46,125,50,.75)',  null);
}

/* ── Main render ── */
function render() {
  const f=getFiltered();
  renderKPI(f);
  renderEngagement(f);
  renderDonut(f);
  renderAgentList(f);
  renderGroupDonut(f);
  renderGroupTable(f);
  renderPageTable(f);
  renderActChart(f);
  updateFilterDot();
  set('last-update','อัปเดต '+new Date().toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'}));
}

/* ── Controls ── */
function setRange(r) {
  _range=r;
  document.querySelectorAll('[data-range]').forEach(b=>b.classList.toggle('active',b.dataset.range===r));
  render();
}
function updateSections(type) {
  const showPage  = type !== 'group';
  const showGroup = type !== 'page';
  const _s = (id, show) => { const el=document.getElementById(id); if(el) el.style.display = show ? '' : 'none'; };
  _s('kc-page-total',   showPage);
  _s('kc-page-results', showPage);
  _s('kc-group-jobs',   showGroup);
  _s('kc-group-rate',   showGroup);
  _s('card-agent',       showGroup);
  _s('row-group-bottom', showGroup);
  _s('row-donut-eng',    showPage);
  _s('card-page-table', showPage);
}
function setType(t) {
  _type=t;
  document.querySelectorAll('[data-type]').forEach(b=>b.classList.toggle('type-active',b.dataset.type===t));
  updateSections(t);
  render();
}
function clearFilters() {
  _range='all'; _type='';
  updateSections('');
  document.querySelectorAll('[data-range]').forEach(b=>b.classList.toggle('active',b.dataset.range==='all'));
  document.querySelectorAll('[data-type]').forEach(b=>b.classList.toggle('type-active',b.dataset.type===''));
  document.getElementById('sc-search').value='';
  document.getElementById('sc-page').value='';
  document.getElementById('sc-agent').value='';
  document.getElementById('sc-status').value='';
  document.getElementById('sc-privacy').value='';
  render();
}
async function scRefresh() {
  const btn=document.getElementById('refresh-btn');
  if(btn)btn.innerHTML='<i class="fa-solid fa-rotate-right fa-spin"></i> รีเฟรช...';
  try{
    const r=await fetch('/api/schedule-center/items');
    _items=await r.json();
    populateFilters();
    render();
  }catch{}
  if(btn)btn.innerHTML='<i class="fa-solid fa-rotate-right"></i> รีเฟรช';
}

['sc-search','sc-page','sc-agent','sc-status','sc-privacy'].forEach(id=>{
  const el=document.getElementById(id);
  if(el) el.addEventListener(id==='sc-search'?'input':'change', render);
});

// Deep-link support, e.g. /schedule-center?status=expired from the
// "หมดเวลา" reminder modal on the dashboard — lands the user straight on
// the filtered list instead of the generic unfiltered view.
const _deepLinkStatus = new URLSearchParams(location.search).get('status');
if (_deepLinkStatus) document.getElementById('sc-status').value = _deepLinkStatus;

populateFilters();
render();
setInterval(scRefresh, 60000);
</script>

