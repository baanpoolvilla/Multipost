<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item active"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <!-- Header -->
    <div class="card" style="padding:.85rem 1.25rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
      <div class="card-title" style="font-size:1.05rem">
        <i class="fa-solid fa-house"></i> Dashboard
      </div>
      <button class="btn-link-sm" onclick="scRefresh()"><i class="fa-solid fa-rotate-right"></i> รีเฟรช</button>
    </div>

    <!-- ── โพสลงเพจ ─────────────────────────────────────────────── -->
    <div class="card" style="padding:1rem 1.25rem">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;margin-bottom:.85rem">
        <div class="card-title" style="font-size:.95rem;margin-bottom:0">
          <i class="fa-solid fa-pen-to-square" style="color:#1877f2"></i> โพสลงเพจ
          <span style="background:#e7f3ff;color:#1877f2;border-radius:999px;padding:.1rem .5rem;font-size:.78rem;font-weight:700;margin-left:.3rem" id="db-p-total"><%= pTotal %></span>
          <span style="font-size:.75rem;font-weight:400;color:#8a8d91;margin-left:.5rem">
            โพสถึง <span id="db-p-pages"><%= pPageCount %></span> เพจ
          </span>
        </div>
        <div style="display:flex;gap:.4rem;flex-wrap:wrap">
          <a href="/post-queue" class="btn-link-sm"><i class="fa-solid fa-list-check"></i> คิวโพส</a>
          <a href="/history" class="btn-link-sm"><i class="fa-solid fa-clock-rotate-left"></i> ประวัติ</a>
          <a href="/overview" class="btn-link-sm"><i class="fa-solid fa-chart-line"></i> ภาพรวม</a>
          <a href="/" class="btn-link-sm" style="color:#1877f2;font-weight:700"><i class="fa-solid fa-plus"></i> โพสใหม่</a>
        </div>
      </div>

      <!-- Status row -->
      <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:.4rem;margin-bottom:.85rem">
        <div class="db-stat-box" style="background:#fff3cd">
          <div class="db-stat-num" style="color:#856404" id="db-p-pending"><%= pPending %></div>
          <div class="db-stat-lbl" style="color:#856404">รอ</div>
        </div>
        <div class="db-stat-box" style="background:#cfe2ff">
          <div class="db-stat-num" style="color:#084298" id="db-p-running"><%= pRunning %></div>
          <div class="db-stat-lbl" style="color:#084298">กำลังโพส</div>
        </div>
        <div class="db-stat-box" style="background:#d1e7dd">
          <div class="db-stat-num" style="color:#0a3622" id="db-p-success"><%= pSuccess %></div>
          <div class="db-stat-lbl" style="color:#0a3622">สำเร็จ</div>
        </div>
        <div class="db-stat-box" style="background:#f8d7da">
          <div class="db-stat-num" style="color:#842029" id="db-p-failed"><%= pFailed %></div>
          <div class="db-stat-lbl" style="color:#842029">ล้มเหลว</div>
        </div>
        <div class="db-stat-box" style="background:#fde8cd">
          <div class="db-stat-num" style="color:#854d0e" id="db-p-expired"><%= pExpired %></div>
          <div class="db-stat-lbl" style="color:#854d0e">หมดเวลา</div>
        </div>
        <div class="db-stat-box" style="background:#f1f3f5">
          <div class="db-stat-num" style="color:#666" id="db-p-cancelled"><%= pCancelled %></div>
          <div class="db-stat-lbl" style="color:#666">ยกเลิก</div>
        </div>
      </div>

      <!-- Engagement row -->
      <div style="border-top:1px solid var(--border-color);padding-top:.75rem">
        <div style="font-size:.73rem;font-weight:700;color:#8a8d91;margin-bottom:.45rem;text-transform:uppercase;letter-spacing:.04em">
          Engagement (จากผลโพสสำเร็จ · <%= pTotalSuccess %> ครั้ง)
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem">
          <div class="db-stat-box" style="background:#f0f7ff">
            <div class="db-stat-num" style="color:#1877f2;font-size:1.1rem"><%= pLikes.toLocaleString() %></div>
            <div class="db-stat-lbl" style="color:#1877f2">👍 ไลค์</div>
          </div>
          <div class="db-stat-box" style="background:#fff8f0">
            <div class="db-stat-num" style="color:#e67700;font-size:1.1rem"><%= pComments.toLocaleString() %></div>
            <div class="db-stat-lbl" style="color:#e67700">💬 คอมเมนต์</div>
          </div>
          <div class="db-stat-box" style="background:#f0fdf4">
            <div class="db-stat-num" style="color:#2e7d32;font-size:1.1rem"><%= pShares.toLocaleString() %></div>
            <div class="db-stat-lbl" style="color:#2e7d32">🔁 แชร์</div>
          </div>
          <div class="db-stat-box" style="background:#f9f0ff">
            <div class="db-stat-num" style="color:#7048e8;font-size:1.1rem"><%= pReach.toLocaleString() %></div>
            <div class="db-stat-lbl" style="color:#7048e8">👀 Reach</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── แชร์กลุ่ม ──────────────────────────────────────────────── -->
    <div class="card" style="padding:1rem 1.25rem">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;margin-bottom:.85rem">
        <div class="card-title" style="font-size:.95rem;margin-bottom:0">
          <i class="fa-solid fa-users-rectangle" style="color:#2e7d32"></i> แชร์กลุ่ม
          <span style="background:#e8fde8;color:#2e7d32;border-radius:999px;padding:.1rem .5rem;font-size:.78rem;font-weight:700;margin-left:.3rem" id="db-g-jobs"><%= gJobs %></span>
          <span style="font-size:.75rem;font-weight:400;color:#8a8d91;margin-left:.5rem">
            กลุ่มในระบบ <span id="db-g-total"><%= gTotal %></span> กลุ่ม
          </span>
        </div>
        <div style="display:flex;gap:.4rem;flex-wrap:wrap">
          <a href="/job-queue" class="btn-link-sm"><i class="fa-solid fa-list-check"></i> คิวกลุ่ม</a>
          <a href="/group-history" class="btn-link-sm"><i class="fa-solid fa-clock-rotate-left"></i> ประวัติ</a>
          <a href="/group-overview" class="btn-link-sm" style="color:#2e7d32;font-weight:700"><i class="fa-solid fa-chart-bar"></i> ภาพรวม</a>
          <a href="/groups" class="btn-link-sm"><i class="fa-solid fa-users-rectangle"></i> จัดการกลุ่ม</a>
        </div>
      </div>

      <!-- Stats row -->
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem;margin-bottom:.75rem">
        <div class="db-stat-box" style="background:#f0fdf4">
          <div class="db-stat-num" style="color:#2e7d32" id="db-g-jobs2"><%= gJobs %></div>
          <div class="db-stat-lbl" style="color:#2e7d32">งานทั้งหมด</div>
        </div>
        <div class="db-stat-box" style="background:#fff3cd">
          <div class="db-stat-num" style="color:#856404" id="db-g-pending"><%= gPending %></div>
          <div class="db-stat-lbl" style="color:#856404">รอโพส</div>
        </div>
        <div class="db-stat-box" style="background:#d1e7dd">
          <div class="db-stat-num" style="color:#0a3622" id="db-g-success"><%= gSuccess %></div>
          <div class="db-stat-lbl" style="color:#0a3622">แชร์สำเร็จ</div>
        </div>
        <div class="db-stat-box" style="background:#f8d7da">
          <div class="db-stat-num" style="color:#842029" id="db-g-failed"><%= gFailed %></div>
          <div class="db-stat-lbl" style="color:#842029">แชร์ล้มเหลว</div>
        </div>
      </div>

      <!-- Rate bar -->
      <div style="border-top:1px solid var(--border-color);padding-top:.7rem">
        <div style="display:flex;justify-content:space-between;align-items:center;font-size:.8rem;font-weight:700;color:#555;margin-bottom:.3rem">
          <span>อัตราสำเร็จ &nbsp;·&nbsp; โพสถึงกลุ่มแล้ว <span id="db-g-posted" style="color:#1877f2"><%= gPosted %></span> ครั้ง</span>
          <span id="db-g-rate" style="color:<%= gRate>=80?'#2e7d32':gRate>=50?'#f59f00':'#c62828' %>;font-size:.95rem"><%= gRate %>%</span>
        </div>
        <div style="background:#e9ecef;border-radius:999px;height:10px">
          <div id="db-g-rate-bar" style="background:<%= gRate>=80?'#2e7d32':gRate>=50?'#f59f00':'#c62828' %>;border-radius:999px;height:10px;width:<%= gRate %>%;transition:width .5s"></div>
        </div>
      </div>
    </div>

    <!-- ── Combined chart ──────────────────────────────────────────── -->
    <div class="card" style="padding:.85rem 1rem">
      <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.4rem;flex-wrap:wrap">
        <strong style="font-size:.85rem;color:#555">
          <i class="fa-solid fa-chart-column" style="color:#1877f2;font-size:.78rem"></i>
          กิจกรรมรวม
        </strong>
        <span style="font-size:.75rem;color:#aaa">
          <span style="display:inline-block;width:10px;height:10px;background:#1877f2;border-radius:2px;margin-right:3px"></span>โพสเพจ
          <span style="display:inline-block;width:10px;height:10px;background:#2e7d32;border-radius:2px;margin:0 3px 0 10px"></span>แชร์กลุ่ม
        </span>
        <div class="status-filter" style="margin-left:auto">
          <button class="filter-btn active" data-chartunit="day"   onclick="scSetChartUnit('day')">รายวัน</button>
          <button class="filter-btn"        data-chartunit="month" onclick="scSetChartUnit('month')">รายเดือน</button>
          <button class="filter-btn"        data-chartunit="year"  onclick="scSetChartUnit('year')">รายปี</button>
        </div>
      </div>
      <canvas id="scChart" height="70"></canvas>
    </div>

  </main>
</div>

<style>
.db-stat-box { border-radius:8px; padding:.45rem .6rem; text-align:center }
.db-stat-num { font-size:1.3rem; font-weight:800; line-height:1.2 }
.db-stat-lbl { font-size:.7rem; font-weight:600; margin-top:.1rem }
</style>

<script>
let _scItems = <%- JSON.stringify(items) %>;
let _scChartUnit = 'day';
let _scChart = null;

function displayAt(it) { return it.scheduledAt || it.createdAt; }
function dayKey(s) { return new Date(s).toLocaleDateString('en-CA'); }

/* ── Stats (dynamic refresh) ── */
function scRenderStats() {
  const pi = _scItems.filter(i => i.type === 'page');
  const gi = _scItems.filter(i => i.type === 'group');

  const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
  set('db-p-total',     pi.length);
  set('db-p-pending',   pi.filter(i => i.status === 'pending').length);
  set('db-p-running',   pi.filter(i => i.status === 'running').length);
  set('db-p-success',   pi.filter(i => i.status === 'success').length);
  set('db-p-failed',    pi.filter(i => i.status === 'failed').length);
  set('db-p-expired',   pi.filter(i => i.status === 'expired').length);
  set('db-p-cancelled', pi.filter(i => i.status === 'cancelled').length);

  const gJobs    = gi.length;
  const gPending = gi.filter(i => ['pending','running'].includes(i.status)).length;
  const gSuccess = gi.reduce((s, i) => s + (i.successCount || 0), 0);
  const gFailed  = gi.reduce((s, i) => s + (i.failCount    || 0), 0);
  const gPosted  = gSuccess + gFailed;
  const gRate    = gPosted > 0 ? Math.round(gSuccess / gPosted * 100) : 0;
  const rc       = gRate >= 80 ? '#2e7d32' : gRate >= 50 ? '#f59f00' : '#c62828';

  set('db-g-jobs',     gJobs);
  set('db-g-jobs2',    gJobs);
  set('db-g-pending',  gPending);
  set('db-g-success',  gSuccess);
  set('db-g-failed',   gFailed);
  set('db-g-posted',   gPosted);
  set('db-g-rate',     gRate + '%');

  const bar = document.getElementById('db-g-rate-bar');
  const rEl = document.getElementById('db-g-rate');
  if (bar) { bar.style.width = gRate + '%'; bar.style.background = rc; }
  if (rEl)   rEl.style.color = rc;
}

/* ── Chart ── */
function scChartBucketKey(at, unit) {
  const d = new Date(at);
  if (unit === 'day')   return d.toLocaleDateString('en-CA');
  if (unit === 'month') return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
  return String(d.getFullYear());
}
function scSetChartUnit(u) {
  _scChartUnit = u;
  document.querySelectorAll('[data-chartunit]').forEach(b => b.classList.toggle('active', b.dataset.chartunit===u));
  scRenderChart();
}
function scRenderChart() {
  if (typeof Chart === 'undefined') return;
  const pi = _scItems.filter(i => i.type === 'page'  && displayAt(i));
  const gi = _scItems.filter(i => i.type === 'group' && displayAt(i));
  const pB = {}, gB = {};
  pi.forEach(it => { const k = scChartBucketKey(displayAt(it), _scChartUnit); pB[k] = (pB[k]||0)+1; });
  gi.forEach(it => { const k = scChartBucketKey(displayAt(it), _scChartUnit); gB[k] = (gB[k]||0)+1; });
  const keys = [...new Set([...Object.keys(pB), ...Object.keys(gB)])].sort().slice(-30);
  const ctx  = document.getElementById('scChart');
  if (_scChart) _scChart.destroy();
  _scChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: keys,
      datasets: [
        { label: 'โพสเพจ',    data: keys.map(k => pB[k]||0), backgroundColor: '#1877f2', borderRadius: 3 },
        { label: 'แชร์กลุ่ม', data: keys.map(k => gB[k]||0), backgroundColor: '#2e7d32', borderRadius: 3 },
      ],
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: { x: { stacked: false }, y: { beginAtZero: true, ticks: { precision: 0 } } },
    },
  });
}

/* ── Render & Refresh ── */
function scRender() { scRenderStats(); scRenderChart(); }
async function scRefresh() {
  try {
    const r = await fetch('/api/schedule-center/items');
    _scItems = await r.json();
    scRender();
  } catch {}
}

scRender();
setInterval(scRefresh, 30000);
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>(function(){var O={dateFormat:'Y-m-d',altInput:true,altFormat:'d/m/Y',allowInput:true,disableMobile:true};function I(e){if(e._flatpickr)return;flatpickr(e,O);var ai=e._flatpickr&&e._flatpickr.altInput;if(ai){var s=e.getAttribute('style');if(s)ai.style.cssText=s;ai.style.cursor='pointer';ai.placeholder=e.getAttribute('title')||e.getAttribute('placeholder')||'วว/ดด/ปปปป';}}document.querySelectorAll('input[type="date"]').forEach(I);new MutationObserver(function(m){m.forEach(function(r){r.addedNodes.forEach(function(n){if(n.nodeType!==1)return;if(n.matches&&n.matches('input[type="date"]'))I(n);n.querySelectorAll&&n.querySelectorAll('input[type="date"]').forEach(I)})})}).observe(document.body,{childList:true,subtree:true});})()</script>
</body>
</html>
