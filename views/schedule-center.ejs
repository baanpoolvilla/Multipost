<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .db-stat-grid   { display:grid; grid-template-columns:repeat(6,1fr); gap:.45rem; margin-bottom:.9rem }
    .db-stat-grid-4 { display:grid; grid-template-columns:repeat(4,1fr); gap:.45rem; margin-bottom:.9rem }
    .db-box { background:#f8f9fa; border-radius:10px; padding:.55rem .4rem; text-align:center; border:1.5px solid #eee }
    .db-box-g { background:#f0fdf4; border-color:#c8e6c9 }
    .db-box-r { background:#fff5f5; border-color:#ffcdd2 }
    .db-box-y { background:#fffde7; border-color:#fff9c4 }
    .db-num { font-size:1.4rem; font-weight:900; line-height:1; color:#333 }
    .db-lbl { font-size:.66rem; color:#8a8d91; margin-top:.2rem; white-space:nowrap }

    .eng-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:.5rem }
    .eng-item { display:flex; align-items:center; gap:.5rem }
    .eng-icon { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:.9rem }
    .eng-num  { font-size:1.05rem; font-weight:800; line-height:1.1 }
    .eng-sub  { font-size:.68rem; color:#8a8d91 }

    .rate-bar-wrap { background:#e9ecef; border-radius:999px; height:9px; overflow:hidden; margin-top:.4rem }
    .rate-bar-fill { border-radius:999px; height:9px; transition:width .6s ease }

    .db-table-wrap { overflow-x:auto; margin-top:.7rem }
    .db-table { width:100%; border-collapse:collapse; font-size:.78rem }
    .db-table th {
      background:#f4f6fa; color:#555; font-weight:700; padding:.45rem .55rem;
      text-align:left; border-bottom:2px solid #e4e6ea; white-space:nowrap
    }
    .db-table td { padding:.42rem .55rem; border-bottom:1px solid #f0f2f5; vertical-align:middle }
    .db-table tbody tr:last-child td { border-bottom:none }
    .db-table tbody tr:hover td { background:#f8faff }
    .db-table .tc { text-align:center }
    .mini-rate { display:inline-flex; align-items:center; gap:.35rem }
    .mini-bar  { width:44px; height:6px; background:#e9ecef; border-radius:999px; overflow:hidden; display:inline-block }
    .mini-fill { height:6px; border-radius:999px }

    .sec-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:.85rem }
    .sec-head-left { display:flex; align-items:center; gap:.6rem }
    .sec-icon { width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0 }
    .sec-title { font-weight:700; font-size:.93rem }
    .sec-sub   { font-size:.72rem; color:var(--text-secondary) }
    .sec-link  { font-size:.78rem; font-weight:600; text-decoration:none; opacity:.8 }

    .filter-bar-card { padding:.65rem 1rem; display:flex; align-items:center; gap:.5rem; flex-wrap:wrap }
    .filter-bar-sep  { width:1px; height:20px; background:#ddd; flex-shrink:0 }
    .db-select {
      border:1.5px solid #dde1e7; border-radius:8px; padding:.3rem .6rem;
      font-size:.78rem; font-family:inherit; background:#fff; color:#333;
      cursor:pointer; outline:none; min-width:110px
    }
    .db-select:focus { border-color:#1877f2 }
    .db-search-wrap { position:relative; flex:1; min-width:130px; max-width:240px }
    .db-search-wrap i { position:absolute; left:.55rem; top:50%; transform:translateY(-50%); color:#bbb; font-size:.72rem; pointer-events:none }
    .db-search {
      width:100%; box-sizing:border-box; border:1.5px solid #dde1e7; border-radius:8px;
      padding:.3rem .65rem .3rem 1.6rem; font-size:.78rem; font-family:inherit; outline:none
    }
    .db-search:focus { border-color:#1877f2 }

    .range-tabs { display:flex; gap:.3rem }
    .filter-tab {
      padding:.26rem .68rem; border-radius:7px; border:1.5px solid #dde1e7;
      font-size:.75rem; font-family:inherit; cursor:pointer; background:#fff; color:#555; font-weight:600
    }
    .filter-tab.active { background:#1877f2; color:#fff; border-color:#1877f2 }

    .no-data { text-align:center; color:#bbb; font-size:.8rem; padding:1.2rem 0 }
    .db-divider { border:none; border-top:1px solid var(--border-color); margin:.85rem 0 }
    .sec-label { font-size:.72rem; font-weight:700; color:#aaa; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.1rem }
  </style>
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
  </div>
</nav>

<div class="page-wrap">
  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item active"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <!-- Header -->
    <div class="card" style="padding:.7rem 1.1rem;display:flex;align-items:center;justify-content:space-between">
      <span style="font-weight:700;font-size:1rem"><i class="fa-solid fa-house" style="color:#1877f2"></i> Dashboard</span>
      <div style="display:flex;align-items:center;gap:.7rem">
        <span id="last-update" style="font-size:.7rem;color:#bbb"></span>
        <button class="btn-link-sm" onclick="scRefresh()" id="refresh-btn">
          <i class="fa-solid fa-rotate-right"></i> รีเฟรช
        </button>
      </div>
    </div>

    <!-- Filter bar -->
    <div class="card filter-bar-card">
      <div class="range-tabs">
        <button class="filter-tab active" data-range="all"   onclick="setRange('all')">ทั้งหมด</button>
        <button class="filter-tab"        data-range="today" onclick="setRange('today')">วันนี้</button>
        <button class="filter-tab"        data-range="7d"    onclick="setRange('7d')">7 วัน</button>
        <button class="filter-tab"        data-range="30d"   onclick="setRange('30d')">30 วัน</button>
      </div>
      <div class="filter-bar-sep"></div>
      <div class="db-search-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input id="sc-search" class="db-search" type="text" placeholder="ค้นหาข้อความ...">
      </div>
      <div class="filter-bar-sep"></div>
      <select id="sc-page"  class="db-select"><option value="">📄 ทุกเพจ</option></select>
      <select id="sc-agent" class="db-select"><option value="">🤖 ทุก Agent</option></select>
      <button class="btn-link-sm" onclick="clearFilters()" style="color:#999;white-space:nowrap">
        <i class="fa-solid fa-xmark"></i> ล้าง
      </button>
    </div>

    <!-- โพสลงเพจ -->
    <div class="card" style="padding:1.1rem 1.2rem">
      <div class="sec-head">
        <div class="sec-head-left">
          <div class="sec-icon" style="background:#e7f3ff">
            <i class="fa-solid fa-pen-to-square" style="color:#1877f2;font-size:.9rem"></i>
          </div>
          <div>
            <div class="sec-title">โพสลงเพจ</div>
            <div class="sec-sub">
              <span id="p-total" style="color:#1877f2;font-weight:700">—</span> โพส ·
              โพสถึง <span id="p-pages" style="color:#1877f2;font-weight:700">—</span> เพจ ·
              ผลสำเร็จ <span id="p-results" style="font-weight:600">—</span> ครั้ง
            </div>
          </div>
        </div>
        <a href="/overview" class="sec-link" style="color:#1877f2">ดูรายละเอียด →</a>
      </div>

      <div class="db-stat-grid">
        <div class="db-box"><div class="db-num" id="p-pending">—</div><div class="db-lbl">⏳ รอ</div></div>
        <div class="db-box" style="border-color:#c8d8f5"><div class="db-num" id="p-running" style="color:#084298">—</div><div class="db-lbl">🔄 กำลังโพส</div></div>
        <div class="db-box db-box-g"><div class="db-num" id="p-success" style="color:#2e7d32">—</div><div class="db-lbl">✅ สำเร็จ</div></div>
        <div class="db-box db-box-r"><div class="db-num" id="p-failed"  style="color:#c62828">—</div><div class="db-lbl">❌ ล้มเหลว</div></div>
        <div class="db-box db-box-y"><div class="db-num" id="p-expired" style="color:#854d0e">—</div><div class="db-lbl">⏰ หมดเวลา</div></div>
        <div class="db-box"><div class="db-num" id="p-cancelled" style="color:#999">—</div><div class="db-lbl">🚫 ยกเลิก</div></div>
      </div>

      <div class="eng-grid">
        <div class="eng-item">
          <div class="eng-icon" style="background:#e7f3ff">👍</div>
          <div><div class="eng-num" id="p-likes" style="color:#1877f2">—</div><div class="eng-sub">ไลค์</div></div>
        </div>
        <div class="eng-item">
          <div class="eng-icon" style="background:#fff8f0">💬</div>
          <div><div class="eng-num" id="p-comments" style="color:#e67700">—</div><div class="eng-sub">คอมเมนต์</div></div>
        </div>
        <div class="eng-item">
          <div class="eng-icon" style="background:#f0fdf4">🔁</div>
          <div><div class="eng-num" id="p-shares" style="color:#2e7d32">—</div><div class="eng-sub">แชร์</div></div>
        </div>
        <div class="eng-item">
          <div class="eng-icon" style="background:#f5f0ff">👀</div>
          <div><div class="eng-num" id="p-reach" style="color:#7048e8">—</div><div class="eng-sub">Reach</div></div>
        </div>
      </div>

      <hr class="db-divider">
      <div class="sec-label">แยกตามเพจ</div>
      <div class="db-table-wrap" id="page-table-wrap"><div class="no-data">กำลังโหลด...</div></div>
    </div>

    <!-- แชร์กลุ่ม -->
    <div class="card" style="padding:1.1rem 1.2rem">
      <div class="sec-head">
        <div class="sec-head-left">
          <div class="sec-icon" style="background:#e8fde8">
            <i class="fa-solid fa-users-rectangle" style="color:#2e7d32;font-size:.9rem"></i>
          </div>
          <div>
            <div class="sec-title">แชร์กลุ่ม</div>
            <div class="sec-sub">
              <span id="g-jobs" style="color:#2e7d32;font-weight:700">—</span> งาน ·
              กลุ่มในระบบ <strong style="color:#2e7d32"><%= gTotal %></strong> กลุ่ม ·
              โพสแล้ว <span id="g-posted" style="font-weight:600">—</span> ครั้ง
            </div>
          </div>
        </div>
        <a href="/group-overview" class="sec-link" style="color:#2e7d32">ดูรายละเอียด →</a>
      </div>

      <div class="db-stat-grid-4">
        <div class="db-box"><div class="db-num" id="g-total-jobs" style="color:#2e7d32">—</div><div class="db-lbl">📋 งานทั้งหมด</div></div>
        <div class="db-box db-box-y"><div class="db-num" id="g-pending" style="color:#856404">—</div><div class="db-lbl">⏳ รอโพส</div></div>
        <div class="db-box db-box-g"><div class="db-num" id="g-success" style="color:#2e7d32">—</div><div class="db-lbl">✅ แชร์สำเร็จ</div></div>
        <div class="db-box db-box-r"><div class="db-num" id="g-failed"  style="color:#c62828">—</div><div class="db-lbl">❌ ล้มเหลว</div></div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.3rem">
        <span class="sec-label" style="margin:0">อัตราสำเร็จรวม</span>
        <span id="g-rate" style="font-size:1.2rem;font-weight:900;color:#2e7d32">—</span>
      </div>
      <div class="rate-bar-wrap">
        <div class="rate-bar-fill" id="g-rate-bar" style="background:#2e7d32;width:0%"></div>
      </div>

      <hr class="db-divider">
      <div class="sec-label">แยกตาม Agent</div>
      <div class="db-table-wrap" id="agent-table-wrap"><div class="no-data">กำลังโหลด...</div></div>
    </div>

    <!-- Chart -->
    <div class="card" style="padding:.9rem 1rem">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.4rem;margin-bottom:.5rem">
        <div style="font-size:.85rem;font-weight:700;color:#444;display:flex;align-items:center;gap:.6rem">
          <i class="fa-solid fa-chart-column" style="color:#1877f2;font-size:.8rem"></i>
          กิจกรรมรวม
          <span style="font-weight:400;font-size:.72rem;color:#bbb">
            <span style="display:inline-block;width:9px;height:9px;background:#1877f2;border-radius:2px;margin-right:3px"></span>โพสเพจ
            <span style="display:inline-block;width:9px;height:9px;background:#2e7d32;border-radius:2px;margin:0 3px 0 8px"></span>แชร์กลุ่ม
          </span>
        </div>
        <div class="status-filter">
          <button class="filter-btn active" data-chartunit="day"   onclick="setChartUnit('day')">รายวัน</button>
          <button class="filter-btn"        data-chartunit="month" onclick="setChartUnit('month')">รายเดือน</button>
          <button class="filter-btn"        data-chartunit="year"  onclick="setChartUnit('year')">รายปี</button>
        </div>
      </div>
      <canvas id="dbChart" height="75"></canvas>
    </div>

  </main>
</div>

<script>
const _gTotal = <%= gTotal %>;
let _items    = <%- JSON.stringify(items) %>;
let _range    = 'all';
let _chartUnit = 'day';
let _chart    = null;

const fmt = n  => Number(n).toLocaleString();
const set = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
const esc = s  => String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');

/* ── Populate dropdowns ── */
function populateFilters() {
  const pages  = new Set();
  const agents = new Set();
  _items.forEach(i => {
    if (i.type === 'page')  (i.targetPages || []).forEach(p => pages.add(p));
    if (i.type === 'group' && i.agentId) agents.add(i.agentId);
  });
  const pgSel = document.getElementById('sc-page');
  const agSel = document.getElementById('sc-agent');
  const pgV = pgSel.value, agV = agSel.value;
  pgSel.innerHTML = '<option value="">📄 ทุกเพจ</option>' +
    [...pages].sort().map(p => `<option value="${esc(p)}">${esc(p)}</option>`).join('');
  agSel.innerHTML = '<option value="">🤖 ทุก Agent</option>' +
    [...agents].sort().map(a => `<option value="${esc(a)}">${esc(a)}</option>`).join('');
  pgSel.value = pgV; agSel.value = agV;
}

/* ── Filter ── */
function filterByRange(items) {
  if (_range === 'all') return items;
  const now = Date.now();
  const cut = _range === 'today'
    ? (() => { const d = new Date(); d.setHours(0,0,0,0); return d.getTime(); })()
    : _range === '7d' ? now - 7*86400000 : now - 30*86400000;
  return items.filter(i => new Date(i.createdAt).getTime() >= cut);
}

function getFiltered() {
  const q  = document.getElementById('sc-search').value.toLowerCase().trim();
  const pg = document.getElementById('sc-page').value;
  const ag = document.getElementById('sc-agent').value;
  return filterByRange(_items).filter(i => {
    if (q  && !i.message.toLowerCase().includes(q)) return false;
    if (i.type === 'page'  && pg && !(i.targetPages || []).includes(pg)) return false;
    if (i.type === 'group' && ag && i.agentId !== ag) return false;
    return true;
  });
}

/* ── Stats ── */
function renderStats(all) {
  const pi = all.filter(i => i.type === 'page');
  const gi = all.filter(i => i.type === 'group');

  const pPages   = new Set(pi.flatMap(i => i.targetPages || [])).size;
  const pResults = pi.reduce((s, i) => s + (i.successCount || 0), 0);
  set('p-total',     fmt(pi.length));
  set('p-pages',     fmt(pPages));
  set('p-results',   fmt(pResults));
  set('p-pending',   fmt(pi.filter(i => i.status === 'pending').length));
  set('p-running',   fmt(pi.filter(i => i.status === 'running').length));
  set('p-success',   fmt(pi.filter(i => i.status === 'success').length));
  set('p-failed',    fmt(pi.filter(i => i.status === 'failed').length));
  set('p-expired',   fmt(pi.filter(i => i.status === 'expired').length));
  set('p-cancelled', fmt(pi.filter(i => i.status === 'cancelled').length));

  let lk=0, co=0, sh=0, re=0;
  pi.forEach(i => { const a=i.analytics||{}; lk+=a.likes||0; co+=a.comments||0; sh+=a.shares||0; re+=a.reach||0; });
  set('p-likes',fmt(lk)); set('p-comments',fmt(co)); set('p-shares',fmt(sh)); set('p-reach',fmt(re));

  const gJobs    = gi.length;
  const gPending = gi.filter(i => ['pending','running'].includes(i.status)).length;
  const gSuccess = gi.reduce((s,i) => s+(i.successCount||0), 0);
  const gFailed  = gi.reduce((s,i) => s+(i.failCount||0),    0);
  const gPosted  = gSuccess + gFailed;
  const gRate    = gPosted > 0 ? Math.round(gSuccess/gPosted*100) : 0;
  const rc = gRate>=80?'#2e7d32':gRate>=50?'#f59f00':'#c62828';
  set('g-jobs',       fmt(gJobs));
  set('g-total-jobs', fmt(gJobs));
  set('g-pending',    fmt(gPending));
  set('g-success',    fmt(gSuccess));
  set('g-failed',     fmt(gFailed));
  set('g-posted',     fmt(gPosted));
  set('g-rate',       gRate+'%');
  const bar=document.getElementById('g-rate-bar'), rEl=document.getElementById('g-rate');
  if(bar){bar.style.width=gRate+'%';bar.style.background=rc;}
  if(rEl)rEl.style.color=rc;
}

/* ── Per-page table ── */
function renderPageTable(all) {
  const pi   = all.filter(i => i.type === 'page');
  const wrap = document.getElementById('page-table-wrap');
  if (!pi.length) { wrap.innerHTML='<div class="no-data">ไม่มีข้อมูลในช่วงที่เลือก</div>'; return; }

  const map = {};
  pi.forEach(item => {
    const pgs = (item.targetPages||[]).length ? item.targetPages : ['(ไม่ระบุ)'];
    pgs.forEach(pg => {
      if(!map[pg]) map[pg]={posts:0,success:0,failed:0,pending:0,lk:0,co:0,sh:0,re:0};
      map[pg].posts++;
      if(item.status==='success')              map[pg].success++;
      else if(item.status==='failed')          map[pg].failed++;
      else if(['pending','running'].includes(item.status)) map[pg].pending++;
      const a=item.analytics||{};
      map[pg].lk+=a.likes||0; map[pg].co+=a.comments||0;
      map[pg].sh+=a.shares||0; map[pg].re+=a.reach||0;
    });
  });

  const rows = Object.entries(map)
    .sort((a,b) => b[1].posts-a[1].posts)
    .map(([pg,d]) => {
      const rate = d.posts>0 ? Math.round(d.success/d.posts*100) : 0;
      const rc   = rate>=80?'#2e7d32':rate>=50?'#f59f00':'#c62828';
      return `<tr>
        <td style="font-weight:600;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(pg)}">${esc(pg)}</td>
        <td class="tc" style="font-weight:700">${d.posts}</td>
        <td class="tc" style="color:#2e7d32">${d.success}</td>
        <td class="tc" style="color:#c62828">${d.failed}</td>
        <td class="tc" style="color:#856404">${d.pending}</td>
        <td class="tc" style="color:#1877f2">${fmt(d.lk)}</td>
        <td class="tc" style="color:#e67700">${fmt(d.co)}</td>
        <td class="tc" style="color:#2e7d32">${fmt(d.sh)}</td>
        <td class="tc" style="color:#7048e8">${fmt(d.re)}</td>
        <td class="tc"><div class="mini-rate"><div class="mini-bar"><div class="mini-fill" style="width:${rate}%;background:${rc}"></div></div><span style="color:${rc};font-weight:700;font-size:.78rem">${rate}%</span></div></td>
      </tr>`;
    }).join('');

  wrap.innerHTML=`<table class="db-table"><thead><tr>
    <th>เพจ</th><th class="tc">โพส</th><th class="tc">✅</th><th class="tc">❌</th><th class="tc">⏳</th>
    <th class="tc">👍</th><th class="tc">💬</th><th class="tc">🔁</th><th class="tc">👀</th><th class="tc">อัตรา</th>
  </tr></thead><tbody>${rows}</tbody></table>`;
}

/* ── Per-agent table ── */
function renderAgentTable(all) {
  const gi   = all.filter(i => i.type === 'group');
  const wrap = document.getElementById('agent-table-wrap');
  if (!gi.length) { wrap.innerHTML='<div class="no-data">ไม่มีข้อมูลในช่วงที่เลือก</div>'; return; }

  const map = {};
  gi.forEach(item => {
    const ag = item.agentId || '(ไม่ระบุ)';
    if(!map[ag]) map[ag]={jobs:0,groups:new Set(),success:0,fail:0,pending:0};
    map[ag].jobs++;
    (item.targetGroups||[]).forEach(g => map[ag].groups.add(g));
    map[ag].success += item.successCount||0;
    map[ag].fail    += item.failCount||0;
    if(['pending','running'].includes(item.status)) map[ag].pending++;
  });

  const rows = Object.entries(map)
    .sort((a,b) => b[1].jobs-a[1].jobs)
    .map(([ag,d]) => {
      const total = d.success+d.fail;
      const rate  = total>0 ? Math.round(d.success/total*100) : 0;
      const rc    = rate>=80?'#2e7d32':rate>=50?'#f59f00':'#c62828';
      return `<tr>
        <td style="font-weight:700;font-family:monospace;font-size:.77rem">${esc(ag)}</td>
        <td class="tc">${d.jobs}</td>
        <td class="tc" style="color:#1877f2">${d.groups.size}</td>
        <td class="tc" style="color:#856404">${d.pending}</td>
        <td class="tc" style="color:#2e7d32">${d.success}</td>
        <td class="tc" style="color:#c62828">${d.fail}</td>
        <td class="tc"><div class="mini-rate"><div class="mini-bar"><div class="mini-fill" style="width:${rate}%;background:${rc}"></div></div><span style="color:${rc};font-weight:700;font-size:.78rem">${rate}%</span></div></td>
      </tr>`;
    }).join('');

  wrap.innerHTML=`<table class="db-table"><thead><tr>
    <th>Agent</th><th class="tc">งาน</th><th class="tc">กลุ่ม</th><th class="tc">⏳</th>
    <th class="tc">✅</th><th class="tc">❌</th><th class="tc">อัตรา</th>
  </tr></thead><tbody>${rows}</tbody></table>`;
}

/* ── Chart ── */
function bucketKey(at,unit) {
  const d=new Date(at);
  if(unit==='day')   return d.toLocaleDateString('en-CA');
  if(unit==='month') return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
  return String(d.getFullYear());
}
function setChartUnit(u) {
  _chartUnit=u;
  document.querySelectorAll('[data-chartunit]').forEach(b=>b.classList.toggle('active',b.dataset.chartunit===u));
  renderChart(getFiltered());
}
function renderChart(all) {
  if(typeof Chart==='undefined') return;
  const pi=all.filter(i=>i.type==='page'  && (i.scheduledAt||i.createdAt));
  const gi=all.filter(i=>i.type==='group' && (i.scheduledAt||i.createdAt));
  const pB={},gB={};
  pi.forEach(i=>{const k=bucketKey(i.scheduledAt||i.createdAt,_chartUnit);pB[k]=(pB[k]||0)+1;});
  gi.forEach(i=>{const k=bucketKey(i.scheduledAt||i.createdAt,_chartUnit);gB[k]=(gB[k]||0)+1;});
  const keys=[...new Set([...Object.keys(pB),...Object.keys(gB)])].sort().slice(-30);
  const ctx=document.getElementById('dbChart');
  if(_chart)_chart.destroy();
  _chart=new Chart(ctx,{
    type:'bar',
    data:{labels:keys,datasets:[
      {label:'โพสเพจ',    data:keys.map(k=>pB[k]||0),backgroundColor:'#1877f2',borderRadius:4},
      {label:'แชร์กลุ่ม', data:keys.map(k=>gB[k]||0),backgroundColor:'#2e7d32',borderRadius:4},
    ]},
    options:{responsive:true,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{precision:0}}}},
  });
}

/* ── Render all ── */
function render() {
  const filtered = getFiltered();
  renderStats(filtered);
  renderPageTable(filtered);
  renderAgentTable(filtered);
  renderChart(filtered);
  const now = new Date().toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'});
  set('last-update','อัปเดต '+now);
}

function setRange(r) {
  _range=r;
  document.querySelectorAll('[data-range]').forEach(b=>b.classList.toggle('active',b.dataset.range===r));
  render();
}
function clearFilters() {
  _range='all';
  document.querySelectorAll('[data-range]').forEach(b=>b.classList.toggle('active',b.dataset.range==='all'));
  document.getElementById('sc-search').value='';
  document.getElementById('sc-page').value='';
  document.getElementById('sc-agent').value='';
  render();
}
async function scRefresh() {
  const btn=document.getElementById('refresh-btn');
  if(btn) btn.innerHTML='<i class="fa-solid fa-rotate-right fa-spin"></i> รีเฟรช...';
  try {
    const r=await fetch('/api/schedule-center/items');
    _items=await r.json();
    populateFilters();
    render();
  } catch {}
  if(btn) btn.innerHTML='<i class="fa-solid fa-rotate-right"></i> รีเฟรช';
}

document.getElementById('sc-search').addEventListener('input', render);
document.getElementById('sc-page').addEventListener('change', render);
document.getElementById('sc-agent').addEventListener('change', render);

populateFilters();
render();
setInterval(scRefresh, 60000);
</script>

