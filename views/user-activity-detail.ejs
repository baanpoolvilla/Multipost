<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= staffInfo.displayName %> – กิจกรรม</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/auth-guard.js"></script>
  <script src="/js/navbar-user.js"></script>
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <% if (locals.currentStaff) { %>
      <div class="navbar-user">
        <div class="avatar avatar-blue avatar-xs"><%= currentStaff.name.charAt(0).toUpperCase() %></div>
        <span class="navbar-user-name"><%= currentStaff.name %></span>
        <i class="fa-solid fa-chevron-down navbar-user-caret"></i>
        <div class="navbar-user-menu">
          <form method="POST" action="/logout">
            <button type="submit" class="navbar-user-menu-item"><i class="fa-solid fa-right-from-bracket"></i> ออกจากระบบ</button>
          </form>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">ระบบ</div>
    <a href="/user-activity" class="sidebar-item active"><i class="fa-solid fa-user-clock"></i><span>กิจกรรมพนักงาน</span></a>
    <% if (locals.currentStaff && currentStaff.canManageStaff) { %>
    <a href="/manage-staff" class="sidebar-item"><i class="fa-solid fa-users-gear"></i><span>จัดการบัญชีผู้ใช้งาน</span></a>
    <a href="/audit-log" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติการเปลี่ยนแปลง</span></a>
    <% } %>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <!-- Header banner -->
    <div class="card" style="padding:1rem 1.25rem;display:flex;align-items:center;gap:.85rem">
      <div class="avatar avatar-<%= staffInfo.id === 'unassigned' ? 'red' : 'blue' %>" style="width:44px;height:44px;font-size:1.1rem;flex-shrink:0">
        <% if (staffInfo.id === 'unassigned') { %><i class="fa-solid fa-question"></i><% } else { %><%= staffInfo.displayName.charAt(0).toUpperCase() %><% } %>
      </div>
      <div style="flex:1;min-width:0">
        <div style="font-size:1.05rem;font-weight:700;color:#1c1e21"><%= staffInfo.displayName %></div>
        <div style="font-size:.78rem;color:#8a8d91;margin-top:.1rem">
          <span style="color:#1877f2"><%= posts.length %> โพสต์เพจ</span>
          &nbsp;·&nbsp;
          <span style="color:#2e7d32"><%= jobs.length %> แชร์กลุ่ม</span>
        </div>
      </div>
    </div>

    <!-- Tab bar + filter -->
    <div style="display:flex;gap:0;border-bottom:2px solid #e4e6ea;margin-bottom:.5rem">
      <button id="tabBtnPage" onclick="switchTab('page')"
        style="padding:.55rem 1.2rem;background:none;border:none;border-bottom:2.5px solid #1877f2;margin-bottom:-2px;font-size:.88rem;font-weight:700;color:#1877f2;cursor:pointer;font-family:inherit">
        <i class="fa-brands fa-facebook"></i> โพสลงเพจ <span id="cntPage">(<%= posts.length %>)</span>
      </button>
      <button id="tabBtnGrp" onclick="switchTab('grp')"
        style="padding:.55rem 1.2rem;background:none;border:none;border-bottom:2.5px solid transparent;margin-bottom:-2px;font-size:.88rem;font-weight:600;color:#8a8d91;cursor:pointer;font-family:inherit">
        <i class="fa-solid fa-users"></i> แชร์ลงกลุ่ม <span id="cntGrp">(<%= jobs.length %>)</span>
      </button>
    </div>

    <!-- Filter bar -->
    <div class="card" style="padding:.6rem .85rem;display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;margin-bottom:.1rem">
      <input id="uaSearch" type="text" placeholder="🔍 ค้นหาข้อความ..." oninput="applyUaFilter()"
        style="flex:2;min-width:130px;padding:.35rem .65rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;color:#333;outline:none">
      <input id="uaFrom" type="date" lang="en-GB" onchange="applyUaFilter()" title="ตั้งแต่วันที่"
        style="padding:.35rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#333;outline:none;cursor:pointer">
      <span style="color:#bbb">—</span>
      <input id="uaTo" type="date" lang="en-GB" onchange="applyUaFilter()" title="ถึงวันที่"
        style="padding:.35rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#333;outline:none;cursor:pointer">
      <span id="uaDateRangeErr" style="display:none;font-size:.75rem;color:#c62828;font-weight:600">⚠️ วันที่เริ่มต้องไม่เกินวันที่สิ้นสุด</span>
      <select id="uaStatusSelect" onchange="applyUaFilter()"
        style="padding:.35rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#333;outline:none;cursor:pointer">
        <option value="">ทุกสถานะ</option>
        <option value="pending">รอดำเนินการ</option>
        <option value="running">กำลังทำ</option>
        <option value="success">สำเร็จ</option>
        <option value="failed">ล้มเหลว</option>
        <option value="expired">หมดเวลา</option>
        <option value="cancelled">ยกเลิก</option>
      </select>
      <% if (pageStats.length > 0) { %>
      <select id="uaPageSelect" onchange="applyPageFilterValue(this.value)"
        style="padding:.35rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#333;outline:none;cursor:pointer">
        <option value="">ทุกเพจ</option>
        <% pageStats.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }); %>
      </select>
      <% } %>
      <% if (groupStats.length > 0) { %>
      <select id="uaCatSelect" onchange="applyCategoryFilterValue(this.value)" style="display:none;padding:.35rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#333;outline:none;cursor:pointer">
        <option value="">ทุกหมวดหมู่</option>
        <% categoryStats.forEach(c => { %><option value="<%= c.name %>"><%= c.name %></option><% }); %>
      </select>
      <select id="uaGroupSelect" onchange="applyGroupFilterValue(this.value)" style="display:none;padding:.35rem .5rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;color:#333;outline:none;cursor:pointer">
        <option value="">ทุกกลุ่ม</option>
        <% groupStats.forEach(g => { %><option value="<%= g.id %>"><%= g.name %></option><% }); %>
      </select>
      <% } %>
      <button onclick="clearUaFilter()" style="padding:.35rem .6rem;background:#f0f2f5;border:none;border-radius:8px;font-size:.82rem;cursor:pointer;color:#666;font-family:inherit">✕ ล้าง</button>
    </div>

    <%
      // Shared badge lookup for both tabs -- a pending/running/expired/
      // cancelled item has no meaningful success/fail split yet (or ever,
      // for cancelled), so those statuses must be checked before falling
      // back to the success/fail count-based badge used for finished work.
      function statusBadge(status, successCount, failCount, total) {
        const map = {
          pending:   { bg:'#fff3cd', color:'#856404', icon:'clock',               text:'รอดำเนินการ', avatar:'orange' },
          running:   { bg:'#cfe2ff', color:'#084298', icon:'spinner fa-spin',     text:'กำลังทำ',      avatar:'blue'   },
          expired:   { bg:'#f8d7da', color:'#842029', icon:'clock',               text:'หมดเวลา',      avatar:'red'    },
          cancelled: { bg:'#e2e3e5', color:'#41464b', icon:'ban',                 text:'ยกเลิก',       avatar:'red'    },
        };
        if (map[status]) return map[status];
        const allOk   = (successCount||0) > 0 && (failCount||0) === 0;
        const allFail = (successCount||0) === 0 && (failCount||0) > 0;
        if (allOk)   return { bg:'#d1e7dd', color:'#0a3622', icon:'check',  text:'สำเร็จทั้งหมด', avatar:'green' };
        if (allFail) return { bg:'#f8d7da', color:'#842029', icon:'xmark', text:'ล้มเหลว',        avatar:'red'   };
        return { bg:'#fff3cd', color:'#856404', icon:'triangle-exclamation', text:`สำเร็จ ${successCount}/${total}`, avatar:'orange' };
      }
    %>

    <!-- ── PAGE POSTS TAB ── -->
    <div id="tabPage" style="display:flex;flex-direction:column;gap:1rem">

    <!-- Per-page breakdown (same table style as /page-summary) -->
    <% if (pageStats.length > 0) { %>
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.6rem;margin-bottom:1rem">
        <div class="card-title" style="margin-bottom:0">
          <i class="fa-brands fa-facebook" style="color:#1877f2"></i> สถิติแต่ละเพจ
          <span style="font-size:.8rem;font-weight:400;color:#8a8d91;margin-left:.4rem">(<%= pageStats.length %> เพจ)</span>
        </div>
        <div style="position:relative">
          <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:.6rem;top:50%;transform:translateY(-50%);color:#8a8d91;font-size:.8rem;pointer-events:none"></i>
          <input id="pageTblSearch" type="text" placeholder="ค้นหาชื่อเพจ..." oninput="filterPageTable(this.value)"
            style="padding:.35rem .7rem .35rem 1.9rem;border:1px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;width:180px;outline:none;color:#333">
        </div>
      </div>
      <div class="overview-table-wrap">
        <table class="overview-table">
          <thead>
            <tr>
              <th>เพจ</th>
              <th><i class="fa-solid fa-paper-plane"></i> โพส</th>
              <th><i class="fa-solid fa-circle-check" style="color:#2e7d32"></i> สำเร็จ</th>
              <th><i class="fa-solid fa-circle-xmark" style="color:#c62828"></i> ล้มเหลว</th>
              <th>อัตราสำเร็จ</th>
            </tr>
          </thead>
          <tbody>
            <% pageStats.forEach((p, i) => {
                 const tot = p.success + p.fail;
                 const rate = tot > 0 ? Math.round(p.success/tot*100) : 0;
            %>
            <tr class="page-tbl-row" data-name="<%= p.name.toLowerCase() %>" data-id="<%= p.id %>" onclick="filterByPageEl(this)" style="cursor:pointer;<%= i >= 5 ? 'display:none' : '' %>">
              <td>
                <div style="display:flex;align-items:center;gap:.5rem">
                  <div class="avatar avatar-blue avatar-sm"><%= p.name.slice(0,1).toUpperCase() %></div>
                  <span style="font-weight:600"><%= p.name %></span>
                </div>
              </td>
              <td class="num"><%= tot %></td>
              <td class="num" style="color:#2e7d32"><%= p.success %></td>
              <td class="num" style="color:#c62828"><%= p.fail %></td>
              <td>
                <div class="rate-bar-wrap">
                  <div class="rate-bar" style="width:<%= rate %>%;background:#1877f2"></div>
                  <span class="rate-text"><%= rate %>%</span>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (pageStats.length > 5) { %>
      <div id="pageTblMoreBtn" style="text-align:center;margin-top:.75rem">
        <button onclick="_pageTblExpanded=true;filterPageTable(document.getElementById('pageTblSearch').value)" style="background:#e7f0fd;color:#1877f2;border:1.5px solid #1877f2;border-radius:8px;padding:.4rem 1.2rem;font-size:.82rem;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-chevron-down"></i> ดูเพิ่มเติม (<%= pageStats.length - 5 %> เพจ)
        </button>
      </div>
      <% } %>
      <div id="pageFilterBadge" style="margin-top:.5rem"></div>
    </div>
    <% } %>

    <div id="emptyPage" class="card" style="display:none"><div class="empty-state">ไม่พบโพสที่ตรงกับเงื่อนไข</div></div>
    <% if (posts.length === 0) { %>
    <div class="card"><div class="empty-state">ยังไม่มีโพสลงเพจของคนนี้</div></div>
    <% } else { %>
    <% posts.forEach(post => { %>
    <%
      const total   = (post.results || []).length;
      const pStatus = post.status || 'success';
      const badge   = statusBadge(pStatus, post.successCount||0, post.failCount||0, total);
      const msg     = (post.message || '');
      const display = msg.includes('|||') ? (msg.slice(0, msg.indexOf('|||')).trim() || msg.slice(msg.indexOf('|||')+3).trim()) : msg;
      const imgs    = (post.images || []).filter(img => img && !img.startsWith('localpath::') && !/^[A-Za-z]:[\\\/]/.test(img));
    %>
    <div class="card history-card ua-card-page" data-at="<%= post.lastAttemptAt || post.createdAt %>" data-msg="<%= (display||'').toLowerCase().replace(/"/g,'') %>" data-ok="<%= post.successCount||0 %>" data-fail="<%= post.failCount||0 %>" data-pages="<%= (post.results||[]).map(r=>r.pageId||r.pageName).join(',') %>" data-status="<%= pStatus %>">
      <div class="fb-post-header">
        <div class="avatar avatar-<%= badge.avatar %>">
          <i class="fa-brands fa-facebook"></i>
        </div>
        <div style="flex:1">
          <div class="fb-post-author">
            โพสลงเพจ
            <span style="background:<%= badge.bg %>;color:<%= badge.color %>;border-radius:999px;font-size:.7rem;padding:.1rem .5rem;font-weight:700;margin-left:.35rem">
              <i class="fa-solid fa-<%= badge.icon %>" style="font-size:.65rem"></i> <%= badge.text %>
            </span>
          </div>
          <div class="fb-post-time">
            <i class="fa-solid fa-clock"></i>
            <%= new Date(post.lastAttemptAt || post.createdAt).toLocaleString('th-TH', { timeZone:'Asia/Bangkok', dateStyle:'short', timeStyle:'short', hour12:false }) %>
          </div>
        </div>
        <a href="/result/<%= post.id %>" style="display:inline-flex;align-items:center;gap:.28rem;background:#e7f0fd;color:#1877f2;border-radius:7px;padding:.28rem .65rem;font-size:.78rem;font-weight:700;text-decoration:none">
          <i class="fa-solid fa-chart-bar"></i> รายงาน
        </a>
      </div>

      <div class="history-message" style="margin:.6rem 0">
        <% if (display.length > 200) { %>
        <span class="msg-short"><%= display.slice(0, 200) %>…</span>
        <span class="msg-full" style="display:none"><%= display %></span>
        <button onclick="this.previousElementSibling.style.display='';this.previousElementSibling.previousElementSibling.style.display='none';this.style.display='none'" style="background:none;border:none;color:#1877f2;font-size:.78rem;cursor:pointer;font-family:inherit">ดูทั้งหมด</button>
        <% } else { %>
        <%= display %>
        <% } %>
      </div>

      <% if (imgs.length > 0) { %>
      <div class="post-img-grid post-img-<%= Math.min(imgs.length,4) %>" style="margin-bottom:.5rem">
        <% imgs.slice(0,4).forEach((img,i) => { %>
        <% const src = img.startsWith('http') ? img : '/uploads/' + img; %>
        <% const isVid = /\.(mp4|mov|avi|webm)$/i.test(img); %>
        <div class="post-img-item" onclick="<%= isVid ? `viewVideo('${src}')` : `viewImage('${src}')` %>">
          <% if (isVid) { %>
          <video src="<%= src %>" style="width:100%;height:100%;object-fit:cover" muted playsinline preload="metadata"></video>
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center">
            <div style="width:32px;height:32px;background:rgba(0,0,0,.55);border-radius:50%;display:flex;align-items:center;justify-content:center">
              <svg width="12" height="14" viewBox="0 0 14 16" fill="white"><polygon points="2,1 13,8 2,15"/></svg>
            </div>
          </div>
          <% } else { %>
          <img src="<%= src %>" alt="" loading="lazy" onerror="this.closest('.post-img-item').style.display='none'">
          <% } %>
          <% if (i===3 && imgs.length>4) { %><div class="img-more-overlay">+<%= imgs.length-4 %></div><% } %>
        </div>
        <% }); %>
      </div>
      <% } %>

      <!-- Pages this post went to -->
      <% const pageResults = post.results || []; %>
      <% if (pageResults.length > 0) { %>
      <div style="display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.3rem">
        <% pageResults.slice(0,8).forEach(r => { %>
        <span style="background:<%= r.status==='success' ? '#d1e7dd' : '#f8d7da' %>;color:<%= r.status==='success' ? '#0a3622' : '#842029' %>;border-radius:999px;font-size:.7rem;padding:.1rem .5rem">
          <%= r.status==='success' ? '✓' : '✕' %> <%= r.pageName || r.pageId %>
        </span>
        <% }); %>
        <% if (pageResults.length > 8) { %><span style="font-size:.7rem;color:#8a8d91">+<%= pageResults.length-8 %> เพจ</span><% } %>
      </div>
      <% } %>
    </div>
    <% }); %>
    <% } %>
    </div>

    <!-- ── GROUP SHARES TAB ── -->
    <div id="tabGrp" style="display:none;flex-direction:column;gap:1rem">

    <!-- Category cards (same clickable-filter pattern as /group-summary's privacy cards) -->
    <% if (categoryStats.length > 0) { %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:.6rem;margin-bottom:.75rem">
      <% categoryStats.forEach(cat => {
           const tot = cat.success + cat.fail;
           const rate = tot > 0 ? Math.round(cat.success/tot*100) : 0;
      %>
      <div id="catCard-<%= cat.name %>" data-cat="<%= cat.name %>" onclick="filterByCategory(this.dataset.cat)" style="background:#f0fff4;border:1.5px solid #a7d7b5;border-radius:14px;padding:.75rem .9rem;cursor:pointer;transition:box-shadow .15s,transform .15s">
        <div style="font-size:.78rem;font-weight:700;color:#2e7d32;margin-bottom:.4rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= cat.name %></div>
        <div style="display:flex;gap:.4rem;align-items:flex-end">
          <div>
            <div style="font-size:1.15rem;font-weight:800;color:#2e7d32;line-height:1"><%= cat.success %></div>
            <div style="font-size:.65rem;color:#2e7d32">สำเร็จ</div>
          </div>
          <div style="font-size:.85rem;color:#ccc">/</div>
          <div>
            <div style="font-size:1.15rem;font-weight:800;color:#c62828;line-height:1"><%= cat.fail %></div>
            <div style="font-size:.65rem;color:#c62828">ล้มเหลว</div>
          </div>
          <div style="margin-left:auto;font-size:.9rem;font-weight:800;color:#2e7d32"><%= rate %>%</div>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>

    <!-- Per-group breakdown (same table style as /group-summary) -->
    <% if (groupStats.length > 0) { %>
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.6rem;margin-bottom:1rem">
        <div class="card-title" style="margin-bottom:0">
          <i class="fa-solid fa-layer-group" style="color:#2e7d32"></i> สถิติแต่ละกลุ่ม
          <span id="catFilterBadge" style="margin-left:.4rem"></span>
          <span style="font-size:.8rem;font-weight:400;color:#8a8d91;margin-left:.4rem">(<%= groupStats.length %> กลุ่ม)</span>
        </div>
        <div style="position:relative">
          <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:.6rem;top:50%;transform:translateY(-50%);color:#8a8d91;font-size:.8rem;pointer-events:none"></i>
          <input id="grpTblSearch" type="text" placeholder="ค้นหาชื่อกลุ่ม..." oninput="filterGrpTable(this.value)"
            style="padding:.35rem .7rem .35rem 1.9rem;border:1px solid #e4e6eb;border-radius:8px;font-size:.82rem;font-family:inherit;width:180px;outline:none;color:#333">
        </div>
      </div>
      <div class="overview-table-wrap">
        <table class="overview-table">
          <thead>
            <tr>
              <th>กลุ่ม</th>
              <th>หมวดหมู่</th>
              <th><i class="fa-solid fa-paper-plane"></i> แชร์</th>
              <th><i class="fa-solid fa-circle-check" style="color:#2e7d32"></i> สำเร็จ</th>
              <th><i class="fa-solid fa-circle-xmark" style="color:#c62828"></i> ล้มเหลว</th>
              <th>อัตราสำเร็จ</th>
            </tr>
          </thead>
          <tbody id="grpTblBody">
            <% groupStats.forEach((g, i) => {
                 const tot = g.success + g.fail;
                 const rate = tot > 0 ? Math.round(g.success/tot*100) : 0;
            %>
            <tr class="grp-tbl-row" data-name="<%= g.name.toLowerCase() %>" data-id="<%= g.id %>" data-cats="<%= g.categories.join(',') %>" onclick="filterByGroupEl(this)" style="cursor:pointer;<%= i >= 5 ? 'display:none' : '' %>">
              <td>
                <div style="display:flex;align-items:center;gap:.5rem">
                  <div class="avatar avatar-green avatar-sm" style="background:#2e7d32"><%= g.name.slice(0,1).toUpperCase() %></div>
                  <span style="font-weight:600"><%= g.name %></span>
                </div>
              </td>
              <td style="font-size:.78rem;color:#8a8d91"><%= g.categories.join(', ') %></td>
              <td class="num"><%= tot %></td>
              <td class="num" style="color:#2e7d32"><%= g.success %></td>
              <td class="num" style="color:#c62828"><%= g.fail %></td>
              <td>
                <div class="rate-bar-wrap">
                  <div class="rate-bar" style="width:<%= rate %>%;background:#2e7d32"></div>
                  <span class="rate-text"><%= rate %>%</span>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (groupStats.length > 5) { %>
      <div id="grpTblMoreBtn" style="text-align:center;margin-top:.75rem">
        <button onclick="grpTableExpand()" style="background:#f0fdf4;color:#2e7d32;border:1.5px solid #2e7d32;border-radius:8px;padding:.4rem 1.2rem;font-size:.82rem;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-chevron-down"></i> ดูเพิ่มเติม (<%= groupStats.length - 5 %> กลุ่ม)
        </button>
      </div>
      <% } %>
    </div>
    <% } %>

    <div id="emptyGrp" class="card" style="display:none"><div class="empty-state">ไม่พบรายการที่ตรงกับเงื่อนไข</div></div>
    <% if (jobs.length === 0) { %>
    <div class="card"><div class="empty-state">ยังไม่มีการแชร์ลงกลุ่มของคนนี้</div></div>
    <% } else { %>
    <% jobs.forEach(job => { %>
    <%
      const jStatus  = job.status || 'success';
      const jbadge   = statusBadge(jStatus, job.successCount, job.failCount, job.groupCount);
      const jmsg    = (job.message || '');
      const jdisplay = jmsg.includes('|||') ? (jmsg.slice(0, jmsg.indexOf('|||')).trim() || jmsg.slice(jmsg.indexOf('|||')+3).trim()) : jmsg;
    %>
    <div class="card history-card ua-card-grp" data-at="<%= job.lastAttemptAt || job.createdAt %>" data-msg="<%= (jdisplay||'').toLowerCase().replace(/"/g,'') %>" data-ok="<%= job.successCount %>" data-fail="<%= job.failCount %>" data-groups="<%= (job.groups||[]).map(g=>g.groupId||g.groupName).join(',') %>" data-cats="<%= job.categories.join(',') %>" data-status="<%= jStatus %>">
      <div class="fb-post-header">
        <div class="avatar avatar-<%= jbadge.avatar %>">
          <i class="fa-solid fa-users"></i>
        </div>
        <div style="flex:1">
          <div class="fb-post-author">
            แชร์ลงกลุ่ม
            <span style="background:<%= jbadge.bg %>;color:<%= jbadge.color %>;border-radius:999px;font-size:.7rem;padding:.1rem .5rem;font-weight:700;margin-left:.35rem">
              <i class="fa-solid fa-<%= jbadge.icon %>" style="font-size:.65rem"></i> <%= jbadge.text %>
            </span>
          </div>
          <div class="fb-post-time">
            <i class="fa-solid fa-clock"></i>
            <%= new Date(job.lastAttemptAt || job.createdAt).toLocaleString('th-TH', { timeZone:'Asia/Bangkok', dateStyle:'short', timeStyle:'short', hour12:false }) %>
            &nbsp;·&nbsp;<i class="fa-solid fa-users" style="color:#1877f2"></i> <%= job.groupCount %> กลุ่ม
          </div>
        </div>
        <a href="/group-result/<%= job._id %>" style="display:inline-flex;align-items:center;gap:.28rem;background:#e7f0fd;color:#1877f2;border-radius:7px;padding:.28rem .65rem;font-size:.78rem;font-weight:700;text-decoration:none">
          <i class="fa-solid fa-chart-bar"></i> รายงาน
        </a>
      </div>
      <div class="history-message" style="margin:.6rem 0">
        <%= jdisplay.length > 200 ? jdisplay.slice(0,200) + '…' : jdisplay %>
      </div>
      <% const allJobGroups = job.groups || []; %>
      <% if (allJobGroups.length > 0) { %>
      <div style="display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.3rem">
        <% allJobGroups.slice(0,8).forEach(g => { %>
        <span style="background:#f0f2f5;border-radius:999px;font-size:.7rem;padding:.1rem .5rem;color:#65676b"><%= g.groupName || g.groupId %></span>
        <% }); %>
        <% if (allJobGroups.length > 8) { %><span style="font-size:.7rem;color:#8a8d91">+<%= allJobGroups.length-8 %> กลุ่ม</span><% } %>
      </div>
      <% } %>
    </div>
    <% }); %>
    <% } %>
    </div>

  </main>

  <aside class="right-panel">
    <div class="card stats-card">
      <div class="stats-title"><i class="fa-solid fa-chart-simple"></i> สถิติ</div>
      <div style="font-size:.72rem;font-weight:700;color:#1877f2;margin:.5rem 0 .25rem">โพสลงเพจ</div>
      <div class="stats-row"><span>โพสทั้งหมด</span><span id="stPageTotal"   class="stats-val blue"><%= posts.length %></span></div>
      <div class="stats-row"><span>สำเร็จ</span>    <span id="stPageSuccess" class="stats-val green"><%= pageSuccess %></span></div>
      <div class="stats-row"><span>ล้มเหลว</span>  <span id="stPageFail"    class="stats-val red"><%= pageFail %></span></div>
      <% if (pagePending > 0) { %>
      <div class="stats-row"><span>รอดำเนินการ</span><span id="stPagePending" class="stats-val" style="color:#856404"><%= pagePending %></span></div>
      <% } %>
      <div style="font-size:.72rem;font-weight:700;color:#2e7d32;margin:.75rem 0 .25rem">แชร์ลงกลุ่ม</div>
      <div class="stats-row"><span>งาน (Job)</span>  <span id="stGrpTotal"   class="stats-val green"><%= jobs.length %></span></div>
      <div class="stats-row"><span>โพสสำเร็จ</span> <span id="stGrpSuccess" class="stats-val green"><%= grpSuccess %></span></div>
      <div class="stats-row"><span>ล้มเหลว</span>   <span id="stGrpFail"    class="stats-val red"><%= grpFail %></span></div>
      <% if (grpPending > 0) { %>
      <div class="stats-row"><span>รอดำเนินการ</span><span id="stGrpPending" class="stats-val" style="color:#856404"><%= grpPending %></span></div>
      <% } %>
    </div>
  </aside>

</div>

<script>
  let _curTab = 'page';
  let _pageFilter = null;     // page-post tab: filter to posts that included this page
  let _categoryFilter = null; // group-share tab: filter to jobs with a group in this category
  let _groupFilter = null;    // group-share tab: filter to jobs that included this specific group

  function switchTab(t) {
    _curTab = t;
    document.getElementById('tabPage').style.display = t === 'page' ? 'flex' : 'none';
    document.getElementById('tabGrp').style.display  = t === 'grp'  ? 'flex' : 'none';
    const bp = document.getElementById('tabBtnPage');
    const bg = document.getElementById('tabBtnGrp');
    bp.style.borderBottomColor = t==='page' ? '#1877f2' : 'transparent';
    bp.style.color             = t==='page' ? '#1877f2' : '#8a8d91';
    bp.style.fontWeight        = t==='page' ? '700' : '600';
    bg.style.borderBottomColor = t==='grp'  ? '#1877f2' : 'transparent';
    bg.style.color             = t==='grp'  ? '#1877f2' : '#8a8d91';
    bg.style.fontWeight        = t==='grp'  ? '700' : '600';

    const pageSel = document.getElementById('uaPageSelect');
    const catSel  = document.getElementById('uaCatSelect');
    const grpSel  = document.getElementById('uaGroupSelect');
    if (pageSel) pageSel.style.display = t === 'page' ? '' : 'none';
    if (catSel)  catSel.style.display  = t === 'grp'  ? '' : 'none';
    if (grpSel)  grpSel.style.display  = t === 'grp'  ? '' : 'none';

    applyUaFilter();
  }

  function applyUaFilter() {
    const q       = (document.getElementById('uaSearch')?.value || '').toLowerCase().trim();
    const fromVal = document.getElementById('uaFrom')?.value || '';
    const toVal   = document.getElementById('uaTo')?.value   || '';
    const status  = document.getElementById('uaStatusSelect')?.value || '';

    const _drBad = fromVal && toVal && fromVal > toVal;
    document.getElementById('uaFrom').style.borderColor        = _drBad ? '#c62828' : '';
    document.getElementById('uaTo').style.borderColor          = _drBad ? '#c62828' : '';
    document.getElementById('uaDateRangeErr').style.display    = _drBad ? 'inline' : 'none';
    if (_drBad) return;

    const fromMs  = fromVal ? new Date(fromVal + 'T00:00:00+07:00').getTime() : 0;
    const toMs    = toVal   ? new Date(toVal   + 'T23:59:59+07:00').getTime() : Infinity;

    let pageShown = 0, pageSuccess = 0, pageFail = 0, pagePending = 0;
    document.querySelectorAll('.ua-card-page').forEach(el => {
      const msg = el.dataset.msg || '';
      const ts  = new Date(el.dataset.at).getTime();
      const pageOk = !_pageFilter || (el.dataset.pages || '').split(',').includes(_pageFilter);
      const statusOk = !status || el.dataset.status === status;
      const ok  = (!q || msg.includes(q)) && ts >= fromMs && ts <= toMs && pageOk && statusOk;
      el.style.display = ok ? '' : 'none';
      if (ok) {
        pageShown++; pageSuccess += parseInt(el.dataset.ok||0); pageFail += parseInt(el.dataset.fail||0);
        if (el.dataset.status === 'pending' || el.dataset.status === 'running') pagePending++;
      }
    });

    let grpShown = 0, grpSuccess = 0, grpFail = 0, grpPending = 0;
    document.querySelectorAll('.ua-card-grp').forEach(el => {
      const msg = el.dataset.msg || '';
      const ts  = new Date(el.dataset.at).getTime();
      const catOk   = !_categoryFilter || (el.dataset.cats || '').split(',').includes(_categoryFilter);
      const groupOk = !_groupFilter || (el.dataset.groups || '').split(',').includes(_groupFilter);
      const statusOk = !status || el.dataset.status === status;
      const ok  = (!q || msg.includes(q)) && ts >= fromMs && ts <= toMs && catOk && groupOk && statusOk;
      el.style.display = ok ? '' : 'none';
      if (ok) {
        grpShown++; grpSuccess += parseInt(el.dataset.ok || 0); grpFail += parseInt(el.dataset.fail || 0);
        if (el.dataset.status === 'pending' || el.dataset.status === 'running') grpPending++;
      }
    });

    const hasFilter = q || fromVal || toVal || status || _pageFilter || _categoryFilter || _groupFilter;

    document.getElementById('cntPage').textContent = `(${pageShown})`;
    document.getElementById('cntGrp').textContent  = `(${grpShown})`;

    const ep = document.getElementById('emptyPage');
    const eg = document.getElementById('emptyGrp');
    if (ep) ep.style.display = (hasFilter && pageShown === 0 && <%- posts.length %> > 0) ? '' : 'none';
    if (eg) eg.style.display = (hasFilter && grpShown  === 0 && <%- jobs.length  %> > 0) ? '' : 'none';

    document.getElementById('stPageTotal').textContent   = pageShown;
    document.getElementById('stPageSuccess').textContent = pageSuccess;
    document.getElementById('stPageFail').textContent    = pageFail;
    document.getElementById('stGrpTotal').textContent    = grpShown;
    document.getElementById('stGrpSuccess').textContent  = grpSuccess;
    document.getElementById('stGrpFail').textContent     = grpFail;
    // These rows only exist in the DOM if there was pending work at page
    // load -- filtering can only narrow that count, never create pending
    // work that wasn't already there, so a missing element just means 0.
    const stPP = document.getElementById('stPagePending'); if (stPP) stPP.textContent = pagePending;
    const stGP = document.getElementById('stGrpPending');  if (stGP) stGP.textContent  = grpPending;
  }

  function clearUaFilter() {
    const s = document.getElementById('uaSearch'); if (s) s.value = '';
    const f = document.getElementById('uaFrom');   if (f) { f.value = ''; f.style.borderColor = ''; }
    const t = document.getElementById('uaTo');     if (t) { t.value = ''; t.style.borderColor = ''; }
    const st = document.getElementById('uaStatusSelect'); if (st) st.value = '';
    document.getElementById('uaDateRangeErr').style.display = 'none';

    applyPageFilterValue('');
    applyGroupFilterValue('');
    applyCategoryFilterValue(''); // also re-runs filterGrpTable('') and applyUaFilter()
  }

  // ── Per-page breakdown table: search + click-a-row-to-filter ───
  let _pageTblExpanded = false;
  function filterPageTable(q) {
    q = q.toLowerCase();
    const moreBtn = document.getElementById('pageTblMoreBtn');
    document.querySelectorAll('.page-tbl-row').forEach((r, i) => {
      const nameOk = !q || r.dataset.name.includes(q);
      r.style.display = nameOk && (q || _pageTblExpanded || i < 5) ? '' : 'none';
    });
    if (moreBtn) moreBtn.style.display = (q || _pageTblExpanded) ? 'none' : '';
  }

  function filterByPageEl(rowEl) { applyPageFilterValue(_pageFilter === rowEl.dataset.id ? '' : rowEl.dataset.id); }

  // Single source of truth for the page filter — called by the dropdown's
  // onchange, by clicking a table row, and by the badge's "×" button, so all
  // three stay in sync no matter which one triggered the change.
  function applyPageFilterValue(val) {
    _pageFilter = val || null;
    const sel = document.getElementById('uaPageSelect');
    if (sel) sel.value = _pageFilter || '';
    document.querySelectorAll('.page-tbl-row').forEach(r => {
      r.style.boxShadow  = (r.dataset.id === _pageFilter) ? 'inset 3px 0 0 #1877f2' : '';
      r.style.background = (r.dataset.id === _pageFilter) ? '#f0f7ff' : '';
    });
    const badge = document.getElementById('pageFilterBadge');
    if (badge) {
      const name = _pageFilter ? (document.querySelector(`.page-tbl-row[data-id="${_pageFilter}"] span`)?.textContent || _pageFilter) : '';
      badge.innerHTML = _pageFilter
        ? `<span style="background:#e7f0fd;color:#1877f2;border-radius:999px;padding:.2rem .65rem;font-size:.78rem;font-weight:600;display:inline-flex;align-items:center;gap:.4rem">
             กรองเฉพาะเพจ "${name}"
             <span onclick="applyPageFilterValue('')" style="cursor:pointer;font-weight:800">×</span>
           </span>`
        : '';
    }
    applyUaFilter();
  }

  // ── Per-group breakdown table: search + expand ──────────────────
  function filterGrpTable(q) {
    q = q.toLowerCase();
    const moreBtn = document.getElementById('grpTblMoreBtn');
    document.querySelectorAll('.grp-tbl-row').forEach((r, i) => {
      const nameOk = !q || r.dataset.name.includes(q);
      const catOk  = !_categoryFilter || (r.dataset.cats || '').split(',').includes(_categoryFilter);
      const show   = nameOk && catOk && (q || _categoryFilter || _grpTblExpanded || i < 5);
      r.style.display = show ? '' : 'none';
    });
    if (moreBtn) moreBtn.style.display = (q || _categoryFilter || _grpTblExpanded) ? 'none' : '';
  }

  let _grpTblExpanded = false;
  function grpTableExpand() { _grpTblExpanded = true; filterGrpTable(document.getElementById('grpTblSearch')?.value || ''); }

  function filterByGroupEl(rowEl) { applyGroupFilterValue(_groupFilter === rowEl.dataset.id ? '' : rowEl.dataset.id); }

  function applyGroupFilterValue(val) {
    _groupFilter = val || null;
    const sel = document.getElementById('uaGroupSelect');
    if (sel) sel.value = _groupFilter || '';
    document.querySelectorAll('.grp-tbl-row').forEach(r => {
      r.style.boxShadow  = (r.dataset.id === _groupFilter) ? 'inset 3px 0 0 #2e7d32' : '';
      r.style.background = (r.dataset.id === _groupFilter) ? '#f0fdf4' : '';
    });
    applyUaFilter();
  }

  // ── Category cards / dropdown: filter both the group table and the job cards ──
  function filterByCategory(cat) { applyCategoryFilterValue(_categoryFilter === cat ? '' : cat); }

  function applyCategoryFilterValue(val) {
    _categoryFilter = val || null;
    const sel = document.getElementById('uaCatSelect');
    if (sel) sel.value = _categoryFilter || '';
    document.querySelectorAll('[id^="catCard-"]').forEach(card => {
      const active = card.id === 'catCard-' + _categoryFilter;
      card.style.boxShadow = active ? '0 0 0 3px #2e7d32' : '';
      card.style.transform  = active ? 'scale(1.03)' : '';
    });
    const badge = document.getElementById('catFilterBadge');
    if (badge) {
      badge.innerHTML = _categoryFilter
        ? `<span style="background:#fff;border:1px solid #ccc;border-radius:6px;padding:.1rem .5rem;font-size:.75rem;display:inline-flex;align-items:center;gap:.3rem;vertical-align:middle">
             ${_categoryFilter}
             <span onclick="applyCategoryFilterValue('')" style="cursor:pointer;color:#c62828;font-weight:700">×</span>
           </span>`
        : '';
    }
    filterGrpTable(document.getElementById('grpTblSearch')?.value || '');
    applyUaFilter();
  }

  function viewImage(src) {
    Swal.fire({ imageUrl: src, imageAlt: '', showConfirmButton:false, showCloseButton:true, width:'auto' });
  }
  function viewVideo(src) {
    Swal.fire({ html:`<video src="${src}" controls autoplay style="max-width:100%;max-height:70vh;border-radius:8px"></video>`, showConfirmButton:false, showCloseButton:true, width:'auto', background:'#000', padding:'1rem' });
  }
</script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>(function(){var O={dateFormat:'Y-m-d',altInput:true,altFormat:'d/m/Y',allowInput:true,disableMobile:true};function I(e){if(e._flatpickr)return;flatpickr(e,O);var ai=e._flatpickr&&e._flatpickr.altInput;if(ai){var s=e.getAttribute('style');if(s)ai.style.cssText=s;ai.style.cursor='pointer';ai.placeholder=e.getAttribute('title')||e.getAttribute('placeholder')||'วว/ดด/ปปปป';}}document.querySelectorAll('input[type="date"]').forEach(I);new MutationObserver(function(m){m.forEach(function(r){r.addedNodes.forEach(function(n){if(n.nodeType!==1)return;if(n.matches&&n.matches('input[type="date"]'))I(n);n.querySelectorAll&&n.querySelectorAll('input[type="date"]').forEach(I)})})}).observe(document.body,{childList:true,subtree:true});})()</script>
</body>
</html>
