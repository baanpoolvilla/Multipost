<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ผลการส่ง - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <a href="/history" class="btn-back"><i class="fa-solid fa-clock-rotate-left"></i> ประวัติ</a>
      <a href="/" class="btn-back" style="margin-left:.5rem"><i class="fa-solid fa-plus"></i> โพสต์ใหม่</a>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/" class="sidebar-item"><i class="fa-solid fa-house"></i><span>หน้าหลัก</span></a>
    <a href="/group-post" class="sidebar-item"><i class="fa-solid fa-people-group"></i><span>โพสต์กลุ่ม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสต์</span></a>
    <div class="sidebar-item active"><i class="fa-solid fa-circle-check"></i><span>ผลการส่ง</span></div>
  </aside>

  <main class="feed">

    <%
      const sc = post.successCount;
      const fc = post.failCount;
      const total = post.results.length;
      const allOk = fc === 0;
    %>

    <!-- Summary banner -->
    <div class="card summary-banner <%= allOk ? 'all-success' : 'has-fail' %>">
      <div class="summary-icon">
        <% if (allOk) { %><i class="fa-solid fa-circle-check"></i><% } else { %><i class="fa-solid fa-triangle-exclamation"></i><% } %>
      </div>
      <div class="summary-text">
        <h2><%= allOk ? 'โพสต์สำเร็จทุกเพจ! 🎉' : `สำเร็จ ${sc} จาก ${total} เพจ` %></h2>
        <p><%= new Date(post.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></p>
      </div>
      <div class="summary-pills">
        <span class="pill pill-success"><i class="fa-solid fa-check"></i> <%= sc %></span>
        <% if (fc > 0) { %><span class="pill pill-fail"><i class="fa-solid fa-xmark"></i> <%= fc %></span><% } %>
      </div>
    </div>

    <!-- FB-style post preview -->
    <div class="card fb-post-card">
      <div class="fb-post-header">
        <div class="avatar avatar-blue"><i class="fa-solid fa-building"></i></div>
        <div>
          <div class="fb-post-author">
            Admin
            <% if (post.feeling) { %>
              <span class="inline-feeling">รู้สึก <%= post.feeling.emoji %> <%= post.feeling.label %></span>
            <% } %>
          </div>
          <div class="fb-post-time">
            <i class="fa-solid fa-earth-asia"></i>
            <%= new Date(post.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
            <% if (post.location) { %>
              &nbsp;·&nbsp;<i class="fa-solid fa-location-dot" style="color:#f5533d"></i> <%= post.location %>
            <% } %>
          </div>
        </div>
      </div>

      <div class="fb-post-body"><%= post.message %></div>

      <!-- Images -->
      <% if (post.images && post.images.length > 0) { %>
      <div class="post-img-grid post-img-<%= Math.min(post.images.length, 4) %>">
        <% post.images.slice(0, 4).forEach((img, i) => { %>
        <div class="post-img-item <%= (i === 3 && post.images.length > 4) ? 'has-more' : '' %>"
             onclick="viewImage('/uploads/<%= img %>')">
          <img src="/uploads/<%= img %>" alt="รูปภาพ">
          <% if (i === 3 && post.images.length > 4) { %>
          <div class="img-more-overlay">+<%= post.images.length - 4 %></div>
          <% } %>
        </div>
        <% }); %>
      </div>
      <% } %>

      <div class="fb-post-footer">
        <span><i class="fa-solid fa-layer-group" style="color:#1877f2"></i> <%= total %> เพจได้รับโพสต์</span>
        <span class="pill pill-<%= allOk ? 'success' : 'fail' %>" style="font-size:.8rem">
          <%= allOk ? 'สำเร็จทั้งหมด' : `สำเร็จ ${sc}/${total}` %>
        </span>
      </div>
    </div>

    <%
      const pageResults  = post.results.filter(r => r.type !== 'group');
      const groupResults = post.results.filter(r => r.type === 'group');
      const successPagePosts = pageResults.filter(r => r.status === 'success');
      const failedGroups     = groupResults.filter(r => r.status === 'failed');
    %>

    <!-- Per-page results -->
    <div class="card">
      <div class="card-title" style="margin-bottom:1rem">
        <i class="fa-solid fa-layer-group"></i> ผลลัพธ์แต่ละเพจ
        <span style="margin-left:auto;font-size:.8rem;font-weight:400;color:#65676b"><%= pageResults.length %> เพจ</span>
      </div>
      <% const colors = ['purple','green','orange','blue','red']; %>
      <% const SHOW = 5; %>
      <% pageResults.forEach((r, i) => { %>
      <div class="result-row<%= i >= SHOW ? ' result-row-hidden' : '' %>" style="<%= i >= SHOW ? 'display:none' : '' %>">
        <div class="avatar avatar-<%= colors[i % colors.length] %> avatar-sm"><%= r.pageName.slice(-1) %></div>
        <div class="result-info">
          <div class="result-page-name"><%= r.pageName %></div>
          <div class="result-time">
            <i class="fa-regular fa-clock"></i> <%= new Date(r.timestamp).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
            <% if (r.error) { %>
              &nbsp;·&nbsp;<span style="color:#c62828;font-size:.78rem"><%= r.error %></span>
            <% } %>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:.5rem">
          <% if (r.status === 'success' && r.postUrl) { %>
          <a href="<%= r.postUrl %>" target="_blank" rel="noopener"
             style="font-size:.8rem;color:#1877f2;text-decoration:none;display:flex;align-items:center;gap:.25rem">
            <i class="fa-brands fa-facebook"></i> ดูโพสต์
          </a>
          <% } %>
          <span class="status-badge <%= r.status %>">
            <% if (r.status === 'success') { %>
              <i class="fa-solid fa-circle-check"></i> สำเร็จ
            <% } else { %>
              <i class="fa-solid fa-circle-xmark"></i> ล้มเหลว
            <% } %>
          </span>
        </div>
      </div>
      <% }); %>

      <% if (pageResults.length > SHOW) { %>
      <button id="showMoreResults" class="show-more-btn" onclick="toggleResultRows(this)">
        <i class="fa-solid fa-chevron-down"></i>
        ดูเพิ่มเติม <%= pageResults.length - SHOW %> เพจ
      </button>
      <% } %>
    </div>

    <!-- Group results (success) -->
    <% if (groupResults.filter(r => r.status==='success').length > 0) { %>
    <div class="card">
      <div class="card-title" style="margin-bottom:.8rem">
        <i class="fa-solid fa-people-group" style="color:#42b72a"></i> ผลกลุ่มที่โพสต์สำเร็จ
      </div>
      <% groupResults.filter(r => r.status==='success').forEach((r, i) => { %>
      <div class="result-row">
        <div class="avatar avatar-green avatar-sm"><i class="fa-solid fa-people-group" style="font-size:.65rem"></i></div>
        <div class="result-info">
          <div class="result-page-name"><%= r.pageName %></div>
          <div class="result-time">
            <i class="fa-regular fa-clock"></i> <%= new Date(r.timestamp).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:.5rem">
          <a href="<%= r.postUrl %>" target="_blank" rel="noopener"
             style="font-size:.8rem;color:#1877f2;text-decoration:none;display:flex;align-items:center;gap:.25rem">
            <i class="fa-solid fa-people-group"></i> ดูกลุ่ม
          </a>
          <span class="status-badge success"><i class="fa-solid fa-circle-check"></i> สำเร็จ</span>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>

    <!-- ── Share to Groups (YADEEP-style) ── -->
    <% if (failedGroups.length > 0) { %>
    <div class="card" style="border-top:3px solid #1877f2">
      <div class="card-title" style="margin-bottom:.85rem">
        <i class="fa-brands fa-facebook" style="color:#1877f2"></i> แชร์โพสต์ไปยังกลุ่ม
        <span style="font-size:.75rem;color:#8a8d91;font-weight:400;margin-left:.4rem">(<%= failedGroups.length %> กลุ่ม)</span>
      </div>

      <% if (successPagePosts.length > 0) { %>

      <!-- Source post selector (if multiple page posts succeeded) -->
      <% if (successPagePosts.length > 1) { %>
      <div style="display:flex;gap:.35rem;flex-wrap:wrap;align-items:center;margin-bottom:.65rem">
        <span style="font-size:.78rem;color:#65676b;flex-shrink:0">โพสต์จากเพจ:</span>
        <% successPagePosts.forEach((r, i) => { %>
        <button onclick="switchSourcePost('<%= r.postUrl %>',this)"
          data-url="<%= r.postUrl %>"
          style="border:1.5px solid <%= i===0 ? '#1877f2' : '#e4e6eb' %>;background:<%= i===0 ? '#e7f3ff' : '#fff' %>;color:<%= i===0 ? '#1877f2' : '#65676b' %>;border-radius:999px;padding:.22rem .65rem;font-size:.76rem;cursor:pointer;font-family:inherit">
          <%= r.pageName %>
        </button>
        <% }); %>
      </div>
      <% } %>

      <!-- Big primary action: share via Facebook dialog -->
      <button onclick="fbShareAll()"
        style="width:100%;background:#1877f2;color:#fff;border:none;border-radius:10px;padding:.7rem;font-size:.92rem;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:.5rem;margin-bottom:.75rem">
        <i class="fa-brands fa-facebook"></i> แชร์โพสต์บน Facebook
        <span style="font-size:.75rem;font-weight:400;opacity:.85">(เปิด dialog แชร์)</span>
      </button>

      <!-- Copy URL row -->
      <div style="display:flex;align-items:center;gap:.5rem;background:#f8f9fa;border-radius:8px;padding:.5rem .75rem;margin-bottom:.8rem;flex-wrap:wrap">
        <i class="fa-solid fa-link" style="color:#8a8d91;font-size:.8rem;flex-shrink:0"></i>
        <span id="srcUrlDisplay" style="font-size:.76rem;color:#65676b;flex:1;word-break:break-all;min-width:0"><%= successPagePosts[0].postUrl %></span>
        <button onclick="copyLink()" id="copyBtn"
          style="background:#e4e6eb;color:#1c1e21;border:none;border-radius:6px;padding:.3rem .7rem;font-size:.76rem;cursor:pointer;font-family:inherit;font-weight:600;flex-shrink:0;display:flex;align-items:center;gap:.3rem">
          <i class="fa-solid fa-copy"></i> คัดลอก URL
        </button>
      </div>

      <!-- Group rows -->
      <% failedGroups.forEach((g, i) => { %>
      <div style="display:flex;align-items:center;gap:.6rem;padding:.5rem 0;<%= i < failedGroups.length-1 ? 'border-bottom:1px solid #f0f2f5' : '' %>">
        <div style="width:32px;height:32px;background:#e8f5e9;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <i class="fa-solid fa-people-group" style="color:#2e7d32;font-size:.75rem"></i>
        </div>
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;font-size:.86rem;color:#1c1e21"><%= g.pageName %></div>
          <div style="font-size:.7rem;color:#8a8d91">ID: <%= g.groupId %></div>
        </div>
        <!-- Share popup button -->
        <button onclick="fbShareOne()"
          style="background:#1877f2;color:#fff;border:none;border-radius:7px;padding:.38rem .75rem;font-size:.78rem;cursor:pointer;font-family:inherit;font-weight:600;display:flex;align-items:center;gap:.3rem;flex-shrink:0">
          <i class="fa-brands fa-facebook"></i> แชร์
        </button>
        <!-- Open group tab + copy -->
        <button onclick="openGroupTab('https://www.facebook.com/groups/<%= g.groupId %>')"
          style="background:#42b72a;color:#fff;border:none;border-radius:7px;padding:.38rem .75rem;font-size:.78rem;cursor:pointer;font-family:inherit;font-weight:600;display:flex;align-items:center;gap:.3rem;flex-shrink:0">
          <i class="fa-solid fa-arrow-up-right-from-square"></i> เปิดกลุ่ม
        </button>
      </div>
      <% }); %>

      <% } else { %>
      <div style="background:#fff3e0;border-radius:8px;padding:.6rem .85rem;font-size:.83rem;color:#e65100">
        <i class="fa-solid fa-triangle-exclamation"></i>
        ยังไม่มีเพจที่โพสต์สำเร็จ กรุณาโพสต์ไปยังเพจก่อน
      </div>
      <% } %>

      <div style="margin-top:.75rem;border-top:1px solid #f0f2f5;padding-top:.65rem;font-size:.77rem;color:#8a8d91;line-height:1.65">
        <strong style="color:#1c1e21">วิธีที่ 1 (แนะนำ):</strong>
        กด <strong>"แชร์โพสต์บน Facebook"</strong> → เลือก "แชร์ในกลุ่ม" ใน popup → เลือกกลุ่มที่ต้องการ<br>
        <strong style="color:#1c1e21">วิธีที่ 2:</strong>
        กด <strong>"คัดลอก URL"</strong> → กด <strong>"เปิดกลุ่ม"</strong> → วาง URL แล้วกด Post
      </div>
    </div>
    <% } %>

    <div style="text-align:center;margin-top:1rem;display:flex;gap:.75rem;justify-content:center">
      <a href="/" class="btn-post" style="text-decoration:none">
        <i class="fa-solid fa-paper-plane"></i> โพสต์อีกครั้ง
      </a>
      <a href="/history" class="btn-post" style="text-decoration:none;background:#65676b">
        <i class="fa-solid fa-clock-rotate-left"></i> ดูประวัติ
      </a>
    </div>

  </main>

  <aside class="right-panel">
    <div class="card stats-card">
      <div class="stats-title"><i class="fa-solid fa-chart-simple"></i> สรุปผล</div>
      <div class="stats-row"><span>สำเร็จ</span><span class="stats-val green"><%= sc %></span></div>
      <div class="stats-row"><span>ล้มเหลว</span><span class="stats-val red"><%= fc %></span></div>
      <div class="stats-row"><span>ทั้งหมด</span><span class="stats-val blue"><%= total %></span></div>
    </div>
  </aside>

</div>

<script>
  const successCount = <%- sc %>;
  const failCount    = <%- fc %>;
  const total        = <%- total %>;

  let _srcUrl = '<%- (successPagePosts[0]?.postUrl || "").replace(/'/g, "\\'") %>';

  function viewImage(src) {
    Swal.fire({ imageUrl: src, imageAlt: 'รูปภาพ', showConfirmButton: false, showCloseButton: true, width: 'auto' });
  }

  /* ── Copy URL ── */
  function copyLink() {
    if (!_srcUrl) return;
    const doFeedback = () => {
      const btn = document.getElementById('copyBtn');
      if (!btn) return;
      const orig = btn.innerHTML;
      btn.innerHTML = '<i class="fa-solid fa-check"></i> คัดลอกแล้ว!';
      btn.style.background = '#2e7d32'; btn.style.color = '#fff';
      setTimeout(() => { btn.innerHTML = orig; btn.style.background = ''; btn.style.color = ''; }, 2200);
    };
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(_srcUrl).then(doFeedback).catch(() => fallbackCopy(_srcUrl, doFeedback));
    } else {
      fallbackCopy(_srcUrl, doFeedback);
    }
  }

  function fallbackCopy(text, cb) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0';
    document.body.appendChild(ta);
    ta.focus(); ta.select();
    try { document.execCommand('copy'); cb && cb(); } catch {}
    document.body.removeChild(ta);
  }

  /* ── Switch source post ── */
  function switchSourcePost(url, btn) {
    _srcUrl = url;
    const el = document.getElementById('srcUrlDisplay');
    if (el) el.textContent = url;
    document.querySelectorAll('[data-url]').forEach(b => {
      const active = b === btn;
      b.style.borderColor = active ? '#1877f2' : '#e4e6eb';
      b.style.background  = active ? '#e7f3ff' : '#fff';
      b.style.color       = active ? '#1877f2' : '#65676b';
    });
  }

  /* ── Facebook Share dialog ── */
  function fbShareDialog(postUrl) {
    if (!postUrl) return;
    const url = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(postUrl);
    const popup = window.open(url, 'fb-share-dialog', 'width=580,height=475,toolbar=0,status=0,menubar=0,scrollbars=1');
    if (!popup) {
      Swal.fire({
        title: 'popup ถูกบล็อก',
        html: `กด <a href="${url}" target="_blank" style="color:#1877f2;font-weight:700">ที่นี่เพื่อเปิดหน้าแชร์</a>`,
        icon: 'warning',
        confirmButtonColor: '#1877f2',
      });
    }
  }

  function fbShareAll() { fbShareDialog(_srcUrl); }
  function fbShareOne() { fbShareDialog(_srcUrl); }

  /* ── Open group tab + copy ── */
  function openGroupTab(groupUrl) {
    copyLink();
    window.open(groupUrl, '_blank', 'noopener');
    setTimeout(() => {
      Swal.fire({
        icon: 'success',
        title: 'คัดลอก URL แล้ว',
        html: 'วาง URL ในช่องโพสต์ของกลุ่มแล้วกด <strong>Share</strong>',
        timer: 2800,
        showConfirmButton: false,
        position: 'bottom-end',
        toast: true,
      });
    }, 300);
  }
</script>
<script src="/js/app.js"></script>
</body>
</html>
