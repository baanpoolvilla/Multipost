<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>รายงานการโพส - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/auth-guard.js"></script>
  <script src="/js/navbar-user.js"></script>
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <% if (locals.currentStaff) { %>
      <div class="navbar-user">
        <div class="avatar avatar-blue avatar-xs"><%= currentStaff.name.charAt(0).toUpperCase() %></div>
        <span class="navbar-user-name"><%= currentStaff.name %></span>
        <i class="fa-solid fa-chevron-down navbar-user-caret"></i>
        <div class="navbar-user-menu">
          <form method="POST" action="/logout">
            <button type="submit" class="navbar-user-menu-item"><i class="fa-solid fa-right-from-bracket"></i> ออกจากระบบ</button>
          </form>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <div class="sidebar-item active" style="padding-left:2.5rem;font-size:.83rem">
      <i class="fa-solid fa-chart-bar" style="font-size:.78rem"></i><span>รายงานการโพส</span>
    </div>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">ระบบ</div>
    <a href="/user-activity" class="sidebar-item"><i class="fa-solid fa-user-clock"></i><span>กิจกรรมพนักงาน</span></a>
    <a href="/manage-staff" class="sidebar-item"><i class="fa-solid fa-users-gear"></i><span>จัดการบัญชีผู้ใช้งาน</span></a>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <%
      const sc    = post.successCount;
      const fc    = post.failCount;
      const total = post.results.length;
      const allOk = fc === 0;
    %>

    <!-- Summary banner -->
    <div class="card summary-banner <%= allOk ? 'all-success' : 'has-fail' %>">
      <div class="summary-icon">
        <% if (allOk) { %><i class="fa-solid fa-circle-check"></i><% } else { %><i class="fa-solid fa-triangle-exclamation"></i><% } %>
      </div>
      <div class="summary-text">
        <h2><%= allOk ? 'โพสต์สำเร็จทุกเพจ! 🎉' : `สำเร็จ ${sc} จาก ${total} เพจ` %></h2>
        <p><%= new Date(post.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></p>
      </div>
      <div class="summary-pills">
        <span class="pill pill-success"><i class="fa-solid fa-check"></i> <%= sc %></span>
        <% if (fc > 0) { %><span class="pill pill-fail"><i class="fa-solid fa-xmark"></i> <%= fc %></span><% } %>
      </div>
    </div>

    <!-- FB-style post preview -->
    <div class="card fb-post-card">
      <div class="fb-post-header">
        <div class="avatar avatar-blue"><i class="fa-solid fa-building"></i></div>
        <div>
          <div class="fb-post-author">
            Admin
            <% if (post.feeling) { %>
              <span class="inline-feeling">รู้สึก <%= post.feeling.emoji %> <%= post.feeling.label %></span>
            <% } %>
          </div>
          <div class="fb-post-time">
            <i class="fa-solid fa-earth-asia"></i>
            <%= new Date(post.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
            <% if (post.location) { %>
              &nbsp;·&nbsp;<i class="fa-solid fa-location-dot" style="color:#f5533d"></i> <%= post.location %>
            <% } %>
          </div>
        </div>
      </div>

      <div class="fb-post-body"><%= post.message %></div>

      <!-- Images / Videos -->
      <% if (post.images && post.images.length > 0) { %>
      <div class="post-img-grid post-img-<%= Math.min(post.images.length, 4) %>">
        <% post.images.slice(0, 4).forEach((img, i) => { %>
        <% const imgSrc = img.startsWith('http') ? img : '/uploads/' + img; %>
        <% const isVid  = /\.(mp4|mov|avi|webm)$/i.test(img); %>
        <div class="post-img-item <%= (i === 3 && post.images.length > 4) ? 'has-more' : '' %>"
             onclick="<%= isVid ? `viewVideo('${imgSrc}')` : `viewImage('${imgSrc}')` %>">
          <% if (isVid) { %>
          <video src="<%= imgSrc %>" style="width:100%;height:100%;object-fit:cover" muted playsinline
                 onerror="this.closest('.post-img-item').style.display='none'"></video>
          <% } else { %>
          <img src="<%= imgSrc %>" alt="รูปภาพ" loading="lazy"
               onerror="this.closest('.post-img-item').style.display='none'">
          <% } %>
          <% if (i === 3 && post.images.length > 4) { %>
          <div class="img-more-overlay">+<%= post.images.length - 4 %></div>
          <% } %>
        </div>
        <% }); %>
      </div>
      <% } %>

      <div class="fb-post-footer">
        <span><i class="fa-solid fa-layer-group" style="color:#1877f2"></i> <%= total %> เพจได้รับโพสต์</span>
        <span class="pill pill-<%= allOk ? 'success' : 'fail' %>" style="font-size:.8rem">
          <%= allOk ? 'สำเร็จทั้งหมด' : `สำเร็จ ${sc}/${total}` %>
        </span>
      </div>
    </div>

    <% const colors = ['purple','green','orange','blue','red']; %>
    <% const SHOW = 5; %>

    <!-- Per-page results -->
    <div class="card">
      <div class="card-title" style="margin-bottom:1rem">
        <i class="fa-solid fa-layer-group"></i> ผลลัพธ์แต่ละเพจ
        <span style="margin-left:auto;font-size:.8rem;font-weight:400;color:#65676b"><%= post.results.length %> เพจ</span>
      </div>
      <% post.results.forEach((r, i) => { %>
      <div class="result-row<%= i >= SHOW ? ' result-row-hidden' : '' %>" style="<%= i >= SHOW ? 'display:none' : '' %>">
        <div class="avatar avatar-<%= colors[i % colors.length] %> avatar-sm"><%= r.pageName.slice(-1) %></div>
        <div class="result-info">
          <div class="result-page-name"><%= r.pageName %></div>
          <div class="result-time">
            <i class="fa-regular fa-clock"></i> <%= new Date(r.timestamp).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
            <% if (r.error) { %>&nbsp;·&nbsp;<span style="color:#c62828;font-size:.78rem"><%= r.error %></span><% } %>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:.5rem">
          <% if (r.status === 'success' && r.postUrl) { %>
          <a href="<%= r.postUrl %>" target="_blank" rel="noopener"
             style="font-size:.8rem;color:#1877f2;text-decoration:none;display:flex;align-items:center;gap:.25rem">
            <i class="fa-brands fa-facebook"></i> ดูโพสต์
          </a>
          <% } %>
          <span class="status-badge <%= r.status %>">
            <% if (r.status === 'success') { %><i class="fa-solid fa-circle-check"></i> สำเร็จ
            <% } else { %><i class="fa-solid fa-circle-xmark"></i> ล้มเหลว<% } %>
          </span>
        </div>
      </div>
      <% }); %>
      <% if (post.results.length > SHOW) { %>
      <button id="showMoreResults" class="show-more-btn" onclick="toggleResultRows(this)">
        <i class="fa-solid fa-chevron-down"></i> ดูเพิ่มเติม <%= post.results.length - SHOW %> เพจ
      </button>
      <% } %>
    </div>

    <div style="text-align:center;margin-top:1rem;display:flex;gap:.75rem;justify-content:center">
      <button onclick="repostAgain()" class="btn-post">
        <i class="fa-solid fa-paper-plane"></i> โพสต์อีกครั้ง
      </button>
      <a href="/history" class="btn-post" style="text-decoration:none;background:#65676b">
        <i class="fa-solid fa-clock-rotate-left"></i> ดูประวัติ
      </a>
    </div>

  </main>

  <aside class="right-panel">
    <div class="card stats-card">
      <div class="stats-title"><i class="fa-solid fa-chart-simple"></i> สรุปผล</div>
      <div class="stats-row"><span>สำเร็จ</span><span class="stats-val green"><%= sc %></span></div>
      <div class="stats-row"><span>ล้มเหลว</span><span class="stats-val red"><%= fc %></span></div>
      <div class="stats-row"><span>ทั้งหมด</span><span class="stats-val blue"><%= total %></span></div>
    </div>
  </aside>

</div>

<script>
  const _POST_DATA = <%- JSON.stringify({
    message:         post.message,
    feeling:         post.feeling  || null,
    location:        post.location || null,
    images:          post.images   || [],
    selectedPageIds: post.selectedPageIds || null,
  }) %>;

  function viewImage(src) {
    Swal.fire({ imageUrl: src, imageAlt: 'รูปภาพ', showConfirmButton: false, showCloseButton: true, width: 'auto' });
  }

  function viewVideo(src) {
    Swal.fire({
      html: `<video src="${src}" controls autoplay style="max-width:100%;max-height:70vh;border-radius:8px"></video>`,
      showConfirmButton: false, showCloseButton: true, width: 'auto', background: '#000', padding: '1rem',
    });
  }

  function toggleResultRows(btn) {
    const hidden = document.querySelectorAll('.result-row-hidden');
    const isHidden = hidden[0]?.style.display === 'none';
    hidden.forEach(r => r.style.display = isHidden ? 'flex' : 'none');
    btn.innerHTML = isHidden
      ? '<i class="fa-solid fa-chevron-up"></i> ซ่อน'
      : `<i class="fa-solid fa-chevron-down"></i> ดูเพิ่มเติม ${hidden.length} เพจ`;
  }

  async function repostAgain() {
    const choice = await Swal.fire({
      title: 'โพสต์อีกครั้ง',
      text: 'เลือกวิธีโพสต์เนื้อหาเดิม',
      showConfirmButton: true,
      showDenyButton: true,
      showCancelButton: true,
      confirmButtonText: '<i class="fa-solid fa-paper-plane"></i> โพสเลย',
      denyButtonText: '<i class="fa-solid fa-clock"></i> ตั้งเวลา',
      cancelButtonText: 'ยกเลิก',
      confirmButtonColor: '#1877f2',
      denyButtonColor: '#f59e0b',
    });

    if (choice.isDismissed) return;

    let scheduledAt = null;
    if (choice.isDenied) {
      // Default to current Bangkok time (same approach as main post page)
      const defStr = new Date().toLocaleString('sv', { timeZone: 'Asia/Bangkok' }).replace(' ', 'T').slice(0, 16);

      const picker = await Swal.fire({
        title: 'เลือกเวลาที่จะโพสต์',
        input: 'datetime-local',
        inputValue: defStr,
        showCancelButton: true,
        confirmButtonText: 'ยืนยัน',
        cancelButtonText: 'กลับ',
        confirmButtonColor: '#1877f2',
        inputValidator: v => {
          if (!v) return 'กรุณาเลือกวันและเวลา';
          if (new Date(v) <= new Date()) return 'กรุณาเลือกเวลาในอนาคต';
        },
      });
      if (!picker.isConfirmed) return;
      scheduledAt = new Date(picker.value + ':00+07:00').toISOString();
    }

    const data = new FormData();
    data.append('message', _POST_DATA.message);
    if (_POST_DATA.feeling) {
      data.append('feelingEmoji', _POST_DATA.feeling.emoji);
      data.append('feelingLabel', _POST_DATA.feeling.label);
    }
    if (_POST_DATA.location) data.append('location', _POST_DATA.location);
    if (scheduledAt)         data.append('scheduledAt', scheduledAt);
    (_POST_DATA.images || []).forEach(img => data.append('templateImages', img));
    if (_POST_DATA.selectedPageIds) {
      _POST_DATA.selectedPageIds.forEach(id => data.append('selectedPages', id));
    }

    Swal.fire({
      title: scheduledAt ? 'กำลังตั้งเวลา...' : 'กำลังโพสต์...',
      allowOutsideClick: false,
      showConfirmButton: false,
      didOpen: () => Swal.showLoading(),
    });

    try {
      const resp = await fetch('/send', { method: 'POST', body: data });
      let json;
      try { json = await resp.json(); }
      catch {
        const errHtml = resp.status === 413
          ? `<p>ขนาดไฟล์รวมใหญ่เกินไป กรุณาลดขนาดหรือจำนวนไฟล์แล้วลองใหม่</p>
             <p style="margin-top:.5rem;font-size:.82rem;color:#65676b;border-top:1px solid #e4e6ea;padding-top:.5rem">
               📌 ขีดจำกัด Facebook: รูปภาพ <b>4 MB</b>/ไฟล์ · วิดีโอ <b>1 GB</b>/ไฟล์
             </p>`
          : `เกิดข้อผิดพลาดจากเซิร์ฟเวอร์ (HTTP ${resp.status})`;
        Swal.fire({ icon: 'error', title: 'ส่งไม่สำเร็จ', html: errHtml, confirmButtonColor: '#1877f2' });
        return;
      }
      if (!resp.ok) throw new Error(json.error || 'เกิดข้อผิดพลาด');

      if (json.scheduled) {
        const d = new Date(json.scheduledAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' });
        const done = await Swal.fire({
          icon: 'success',
          title: 'ตั้งเวลาสำเร็จ!',
          text: 'จะโพสต์ในวันที่ ' + d,
          confirmButtonText: 'ดูประวัติ',
          showCancelButton: true,
          cancelButtonText: 'อยู่หน้านี้',
          confirmButtonColor: '#1877f2',
        });
        if (done.isConfirmed) location.href = '/history';
      } else {
        location.href = '/result/' + json.id;
      }
    } catch (e) {
      Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: e.message });
    }
  }
</script>
<script src="/js/app.js"></script>
</body>
</html>
