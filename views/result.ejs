<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ผลการส่ง - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <a href="/history" class="btn-back"><i class="fa-solid fa-clock-rotate-left"></i> ประวัติ</a>
      <a href="/" class="btn-back" style="margin-left:.5rem"><i class="fa-solid fa-plus"></i> โพสต์ใหม่</a>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/" class="sidebar-item"><i class="fa-solid fa-house"></i><span>หน้าหลัก</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสต์</span></a>
    <div class="sidebar-item active"><i class="fa-solid fa-circle-check"></i><span>ผลการส่ง</span></div>
  </aside>

  <main class="feed">

    <%
      const sc = post.successCount;
      const fc = post.failCount;
      const total = post.results.length;
      const allOk = fc === 0;
    %>

    <!-- Summary banner -->
    <div class="card summary-banner <%= allOk ? 'all-success' : 'has-fail' %>">
      <div class="summary-icon">
        <% if (allOk) { %><i class="fa-solid fa-circle-check"></i><% } else { %><i class="fa-solid fa-triangle-exclamation"></i><% } %>
      </div>
      <div class="summary-text">
        <h2><%= allOk ? 'โพสต์สำเร็จทุกเพจ! 🎉' : `สำเร็จ ${sc} จาก ${total} เพจ` %></h2>
        <p><%= new Date(post.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %></p>
      </div>
      <div class="summary-pills">
        <span class="pill pill-success"><i class="fa-solid fa-check"></i> <%= sc %></span>
        <% if (fc > 0) { %><span class="pill pill-fail"><i class="fa-solid fa-xmark"></i> <%= fc %></span><% } %>
      </div>
    </div>

    <!-- FB-style post preview -->
    <div class="card fb-post-card">
      <div class="fb-post-header">
        <div class="avatar avatar-blue"><i class="fa-solid fa-building"></i></div>
        <div>
          <div class="fb-post-author">
            Admin
            <% if (post.feeling) { %>
              <span class="inline-feeling">รู้สึก <%= post.feeling.emoji %> <%= post.feeling.label %></span>
            <% } %>
          </div>
          <div class="fb-post-time">
            <i class="fa-solid fa-earth-asia"></i>
            <%= new Date(post.createdAt).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
            <% if (post.location) { %>
              &nbsp;·&nbsp;<i class="fa-solid fa-location-dot" style="color:#f5533d"></i> <%= post.location %>
            <% } %>
          </div>
        </div>
      </div>

      <div class="fb-post-body"><%= post.message %></div>

      <!-- Images -->
      <% if (post.images && post.images.length > 0) { %>
      <div class="post-img-grid post-img-<%= Math.min(post.images.length, 4) %>">
        <% post.images.slice(0, 4).forEach((img, i) => { %>
        <div class="post-img-item <%= (i === 3 && post.images.length > 4) ? 'has-more' : '' %>"
             onclick="viewImage('/uploads/<%= img %>')">
          <img src="/uploads/<%= img %>" alt="รูปภาพ">
          <% if (i === 3 && post.images.length > 4) { %>
          <div class="img-more-overlay">+<%= post.images.length - 4 %></div>
          <% } %>
        </div>
        <% }); %>
      </div>
      <% } %>

      <div class="fb-post-footer">
        <span><i class="fa-solid fa-layer-group" style="color:#1877f2"></i> <%= total %> เพจได้รับโพสต์</span>
        <span class="pill pill-<%= allOk ? 'success' : 'fail' %>" style="font-size:.8rem">
          <%= allOk ? 'สำเร็จทั้งหมด' : `สำเร็จ ${sc}/${total}` %>
        </span>
      </div>
    </div>

    <%
      const pageResults  = post.results.filter(r => r.type !== 'group');
      const groupResults = post.results.filter(r => r.type === 'group');
      const successPagePosts = pageResults.filter(r => r.status === 'success');
      const failedGroups     = groupResults.filter(r => r.status === 'failed');
    %>

    <!-- Per-page results -->
    <div class="card">
      <div class="card-title" style="margin-bottom:1rem">
        <i class="fa-solid fa-layer-group"></i> ผลลัพธ์แต่ละเพจ
        <span style="margin-left:auto;font-size:.8rem;font-weight:400;color:#65676b"><%= pageResults.length %> เพจ</span>
      </div>
      <% const colors = ['purple','green','orange','blue','red']; %>
      <% const SHOW = 5; %>
      <% pageResults.forEach((r, i) => { %>
      <div class="result-row<%= i >= SHOW ? ' result-row-hidden' : '' %>" style="<%= i >= SHOW ? 'display:none' : '' %>">
        <div class="avatar avatar-<%= colors[i % colors.length] %> avatar-sm"><%= r.pageName.slice(-1) %></div>
        <div class="result-info">
          <div class="result-page-name"><%= r.pageName %></div>
          <div class="result-time">
            <i class="fa-regular fa-clock"></i> <%= new Date(r.timestamp).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
            <% if (r.error) { %>
              &nbsp;·&nbsp;<span style="color:#c62828;font-size:.78rem"><%= r.error %></span>
            <% } %>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:.5rem">
          <% if (r.status === 'success' && r.postUrl) { %>
          <a href="<%= r.postUrl %>" target="_blank" rel="noopener"
             style="font-size:.8rem;color:#1877f2;text-decoration:none;display:flex;align-items:center;gap:.25rem">
            <i class="fa-brands fa-facebook"></i> ดูโพสต์
          </a>
          <% } %>
          <span class="status-badge <%= r.status %>">
            <% if (r.status === 'success') { %>
              <i class="fa-solid fa-circle-check"></i> สำเร็จ
            <% } else { %>
              <i class="fa-solid fa-circle-xmark"></i> ล้มเหลว
            <% } %>
          </span>
        </div>
      </div>
      <% }); %>

      <% if (pageResults.length > SHOW) { %>
      <button id="showMoreResults" class="show-more-btn" onclick="toggleResultRows(this)">
        <i class="fa-solid fa-chevron-down"></i>
        ดูเพิ่มเติม <%= pageResults.length - SHOW %> เพจ
      </button>
      <% } %>
    </div>

    <!-- Group results (success) -->
    <% if (groupResults.filter(r => r.status==='success').length > 0) { %>
    <div class="card">
      <div class="card-title" style="margin-bottom:.8rem">
        <i class="fa-solid fa-people-group" style="color:#42b72a"></i> ผลกลุ่มที่โพสต์สำเร็จ
      </div>
      <% groupResults.filter(r => r.status==='success').forEach((r, i) => { %>
      <div class="result-row">
        <div class="avatar avatar-green avatar-sm"><i class="fa-solid fa-people-group" style="font-size:.65rem"></i></div>
        <div class="result-info">
          <div class="result-page-name"><%= r.pageName %></div>
          <div class="result-time">
            <i class="fa-regular fa-clock"></i> <%= new Date(r.timestamp).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) %>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:.5rem">
          <a href="<%= r.postUrl %>" target="_blank" rel="noopener"
             style="font-size:.8rem;color:#1877f2;text-decoration:none;display:flex;align-items:center;gap:.25rem">
            <i class="fa-solid fa-people-group"></i> ดูกลุ่ม
          </a>
          <span class="status-badge success"><i class="fa-solid fa-circle-check"></i> สำเร็จ</span>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>

    <!-- ── Share to Groups helper (YADEEP-style) ── -->
    <% if (failedGroups.length > 0) { %>
    <div class="card" style="border-top:3px solid #42b72a">
      <div class="card-title" style="margin-bottom:.75rem">
        <i class="fa-solid fa-share-nodes" style="color:#42b72a"></i> แชร์ไปยังกลุ่ม
        <span style="font-size:.76rem;color:#8a8d91;font-weight:400;margin-left:.4rem">คัดลอกลิ้งค์ → เปิดกลุ่ม → วาง</span>
      </div>

      <% if (successPagePosts.length > 0) { %>
      <!-- Copy link bar -->
      <div id="copyBar" style="background:#f0f7ff;border:1.5px solid #cfe2ff;border-radius:9px;padding:.6rem .85rem;margin-bottom:.8rem;display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
        <i class="fa-brands fa-facebook" style="color:#1877f2;flex-shrink:0;font-size:1.1rem"></i>
        <span id="copyUrl" style="font-size:.79rem;color:#1c1e21;flex:1;word-break:break-all;min-width:0"><%= successPagePosts[0].postUrl %></span>
        <button onclick="copyLink('<%= successPagePosts[0].postUrl %>')"
          id="copyBtn"
          style="background:#1877f2;color:#fff;border:none;border-radius:7px;padding:.38rem .85rem;font-size:.8rem;cursor:pointer;font-family:inherit;flex-shrink:0;font-weight:700;display:flex;align-items:center;gap:.35rem">
          <i class="fa-solid fa-copy"></i> คัดลอกลิ้งค์โพสต์
        </button>
      </div>
      <% if (successPagePosts.length > 1) { %>
      <div style="display:flex;gap:.35rem;flex-wrap:wrap;margin-bottom:.75rem">
        <span style="font-size:.75rem;color:#65676b;align-self:center">เลือกเพจ:</span>
        <% successPagePosts.forEach((r, i) => { %>
        <button onclick="switchCopyUrl('<%= r.postUrl %>','<%= r.pageName %>',this)"
          class="copy-page-pill<%= i===0 ? ' active' : '' %>"
          style="border:1.5px solid <%= i===0 ? '#1877f2' : '#e4e6eb' %>;background:<%= i===0 ? '#e7f3ff' : '#fff' %>;color:<%= i===0 ? '#1877f2' : '#65676b' %>;border-radius:999px;padding:.2rem .65rem;font-size:.76rem;cursor:pointer;font-family:inherit">
          <%= r.pageName %>
        </button>
        <% }); %>
      </div>
      <% } %>
      <% } else { %>
      <div style="background:#fff3e0;border-radius:8px;padding:.6rem .85rem;margin-bottom:.75rem;font-size:.82rem;color:#e65100">
        <i class="fa-solid fa-triangle-exclamation"></i>
        ไม่มีเพจที่โพสต์สำเร็จ ไม่สามารถแชร์ลิ้งค์ได้
      </div>
      <% } %>

      <!-- Group list -->
      <% failedGroups.forEach((g, i) => { %>
      <div style="display:flex;align-items:center;gap:.65rem;padding:.55rem 0;<%= i < failedGroups.length-1 ? 'border-bottom:1px solid #f0f2f5' : '' %>">
        <div style="width:34px;height:34px;background:#e8f5e9;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <i class="fa-solid fa-people-group" style="color:#2e7d32;font-size:.8rem"></i>
        </div>
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;font-size:.88rem;color:#1c1e21"><%= g.pageName %></div>
          <div style="font-size:.72rem;color:#8a8d91">ID: <%= g.groupId %></div>
        </div>
        <% if (successPagePosts.length > 0) { %>
        <button onclick="openGroupWithCopy('https://www.facebook.com/groups/<%= g.groupId %>')"
          style="background:#42b72a;color:#fff;border:none;border-radius:8px;padding:.42rem .9rem;font-size:.8rem;cursor:pointer;font-family:inherit;font-weight:700;display:flex;align-items:center;gap:.35rem;flex-shrink:0">
          <i class="fa-solid fa-arrow-up-right-from-square"></i> เปิดกลุ่ม
        </button>
        <% } else { %>
        <a href="https://www.facebook.com/groups/<%= g.groupId %>" target="_blank" rel="noopener"
          style="background:#65676b;color:#fff;border:none;border-radius:8px;padding:.42rem .9rem;font-size:.8rem;text-decoration:none;display:flex;align-items:center;gap:.35rem;font-weight:700;flex-shrink:0">
          <i class="fa-solid fa-arrow-up-right-from-square"></i> เปิดกลุ่ม
        </a>
        <% } %>
      </div>
      <% }); %>

      <div style="margin-top:.75rem;padding:.6rem .85rem;background:#f8f9fa;border-radius:8px;font-size:.78rem;color:#65676b;line-height:1.7">
        <strong style="color:#1c1e21"><i class="fa-solid fa-circle-info" style="color:#1877f2"></i> วิธีใช้:</strong><br>
        1. กด <strong>"คัดลอกลิ้งค์โพสต์"</strong> เพื่อคัดลอก URL โพสต์ที่สำเร็จ<br>
        2. กด <strong>"เปิดกลุ่ม"</strong> → กลุ่ม Facebook เปิดในแท็บใหม่พร้อม URL ในคลิปบอร์ด<br>
        3. วางลิ้งค์ในช่องโพสต์ของกลุ่ม → กด Share
      </div>
    </div>
    <% } %>

    <div style="text-align:center;margin-top:1rem;display:flex;gap:.75rem;justify-content:center">
      <a href="/" class="btn-post" style="text-decoration:none">
        <i class="fa-solid fa-paper-plane"></i> โพสต์อีกครั้ง
      </a>
      <a href="/history" class="btn-post" style="text-decoration:none;background:#65676b">
        <i class="fa-solid fa-clock-rotate-left"></i> ดูประวัติ
      </a>
    </div>

  </main>

  <aside class="right-panel">
    <div class="card stats-card">
      <div class="stats-title"><i class="fa-solid fa-chart-simple"></i> สรุปผล</div>
      <div class="stats-row"><span>สำเร็จ</span><span class="stats-val green"><%= sc %></span></div>
      <div class="stats-row"><span>ล้มเหลว</span><span class="stats-val red"><%= fc %></span></div>
      <div class="stats-row"><span>ทั้งหมด</span><span class="stats-val blue"><%= total %></span></div>
    </div>
  </aside>

</div>

<script>
  const successCount = <%- sc %>;
  const failCount    = <%- fc %>;
  const total        = <%- total %>;

  let _currentCopyUrl = '<%- successPagePosts[0]?.postUrl || "" %>';

  function viewImage(src) {
    Swal.fire({ imageUrl: src, imageAlt: 'รูปภาพ', showConfirmButton: false, showCloseButton: true, width: 'auto' });
  }

  function copyLink(url) {
    const u = url || _currentCopyUrl;
    if (!u) return;
    navigator.clipboard.writeText(u).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = u; document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta);
    });
    const btn = document.getElementById('copyBtn');
    if (btn) {
      const orig = btn.innerHTML;
      btn.innerHTML = '<i class="fa-solid fa-check"></i> คัดลอกแล้ว!';
      btn.style.background = '#2e7d32';
      setTimeout(() => { btn.innerHTML = orig; btn.style.background = '#1877f2'; }, 2000);
    }
  }

  function switchCopyUrl(url, name, btn) {
    _currentCopyUrl = url;
    const el = document.getElementById('copyUrl');
    if (el) el.textContent = url;
    const bar = document.getElementById('copyBar');
    document.querySelectorAll('.copy-page-pill').forEach(p => {
      const active = p === btn;
      p.style.borderColor = active ? '#1877f2' : '#e4e6eb';
      p.style.background  = active ? '#e7f3ff' : '#fff';
      p.style.color       = active ? '#1877f2' : '#65676b';
    });
    // Update copyBtn onclick
    const copyBtn = document.getElementById('copyBtn');
    if (copyBtn) copyBtn.onclick = () => copyLink(url);
  }

  function openGroupWithCopy(groupUrl) {
    copyLink(_currentCopyUrl);
    window.open(groupUrl, '_blank', 'noopener');
    Swal.fire({
      icon: 'info',
      title: 'คัดลอกแล้ว!',
      html: 'ลิ้งค์โพสต์อยู่ในคลิปบอร์ดแล้ว<br>วางในช่องโพสต์ของกลุ่มได้เลย',
      timer: 2500,
      showConfirmButton: false,
    });
  }
</script>
<script src="/js/app.js"></script>
</body>
</html>
