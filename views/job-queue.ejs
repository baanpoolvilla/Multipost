<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Job Queue - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/auth-guard.js"></script>
  <script src="/js/navbar-user.js"></script>
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <% if (locals.currentStaff) { %>
      <div class="navbar-user">
        <div class="avatar avatar-blue avatar-xs"><%= currentStaff.name.charAt(0).toUpperCase() %></div>
        <span class="navbar-user-name"><%= currentStaff.name %></span>
        <i class="fa-solid fa-chevron-down navbar-user-caret"></i>
        <div class="navbar-user-menu">
          <form method="POST" action="/logout">
            <button type="submit" class="navbar-user-menu-item"><i class="fa-solid fa-right-from-bracket"></i> ออกจากระบบ</button>
          </form>
        </div>
      </div>
      <% } %>
    </div>

  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item active"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">ระบบ</div>
    <a href="/user-activity" class="sidebar-item"><i class="fa-solid fa-user-clock"></i><span>กิจกรรมพนักงาน</span></a>
    <% if (locals.currentStaff && currentStaff.canManageStaff) { %>
    <a href="/manage-staff" class="sidebar-item"><i class="fa-solid fa-users-gear"></i><span>จัดการบัญชีผู้ใช้งาน</span></a>
    <a href="/audit-log" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติการเปลี่ยนแปลง</span></a>
    <% } %>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <!-- Agent status banner (top) -->
    <div id="agentBanner" style="display:none"></div>

    <!-- Header -->
    <div class="card" style="padding:.85rem 1.25rem">
      <div class="card-title" style="font-size:1.05rem">
        <i class="fa-solid fa-list-check"></i> คิวโพสลงกลุ่ม
        <span style="background:#e4e6ea;padding:.15rem .55rem;border-radius:999px;font-size:.8rem;margin-left:.4rem" id="jobCount"><%= jobs.length %></span>
        <% if (groups.length) { %>
        <button class="btn-post" style="margin-left:auto;font-size:.85rem;padding:.4rem .9rem" onclick="toggleForm()">
          <i class="fa-solid fa-plus"></i> สร้างงานโพส
        </button>
        <% } %>
      </div>
    </div>

    <%
    // Each group appears under its primary (first non-ทั่วไป) category, or ทั่วไป
    const jqCatMap = {};
    groups.forEach((g, i) => {
      const gcats = (g.categories && g.categories.length) ? g.categories : [g.category || 'ทั่วไป'];
      const primaryCat = gcats.find(c => c !== 'ทั่วไป') || 'ทั่วไป';
      if (!jqCatMap[primaryCat]) jqCatMap[primaryCat] = [];
      jqCatMap[primaryCat].push({ groupId: g.groupId, groupName: g.groupName, _id: String(g._id || ''), _idx: i });
    });
    const allJqSet = new Set(Object.keys(jqCatMap));
    const jqCats = [
      ...(allJqSet.has('ทั่วไป') ? ['ทั่วไป'] : []),
      ...[...allJqSet].filter(c => c !== 'ทั่วไป').sort()
    ];
    %>

    <% if (groups.length === 0) { %>
    <div class="card" style="background:linear-gradient(135deg,#e8f4ff 0%,#f0f7ff 100%);border-color:#b3d4f9;padding:1.25rem 1.5rem;text-align:center">
      <i class="fa-solid fa-robot" style="font-size:2.5rem;color:#1877f2;margin-bottom:.65rem;display:block"></i>
      <div style="font-weight:700;font-size:1rem;color:var(--text-primary);margin-bottom:.4rem">ยังไม่มีกลุ่ม Facebook</div>
      <div style="font-size:.87rem;color:var(--text-secondary);line-height:1.75;margin-bottom:1rem">
        หากต้องการโพสหรือแชร์ลงกลุ่ม Facebook<br>
        ต้องทำตามขั้นตอนนี้ก่อน:
      </div>
      <div style="display:inline-flex;flex-direction:column;gap:.5rem;text-align:left;font-size:.85rem;color:var(--text-secondary);margin-bottom:1.25rem;line-height:1.7">
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;margin-right:.4rem">1</span>ไปที่ <a href="/groups" style="color:#1877f2;font-weight:600">จัดการกลุ่ม</a> → กด "+ เพิ่มกลุ่ม" เพื่อเพิ่มกลุ่มที่ต้องการ</div>
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;margin-right:.4rem">2</span>ติดตั้ง Desktop Agent บนเครื่อง Windows — ดูวิธีที่ <a href="/agent" style="color:#1877f2;font-weight:600">หน้าติดตั้ง Agent</a></div>
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;margin-right:.4rem">3</span>เปิด Agent → Login Facebook → กลับมาสั่งโพสที่หน้านี้</div>
      </div>
      <a href="/groups" style="display:inline-flex;align-items:center;gap:.45rem;background:#1877f2;color:#fff;padding:.5rem 1.25rem;border-radius:8px;font-weight:700;font-size:.85rem;text-decoration:none">
        <i class="fa-solid fa-users-rectangle"></i> ไปเพิ่มกลุ่ม
      </a>
    </div>
    <% } else { %>

    <!-- Create Job Form -->
    <div class="card" id="createForm">
      <div class="card-title"><i class="fa-solid fa-plus"></i> สร้างงานโพสลงกลุ่ม
        <button type="button" class="btn-link-sm" style="margin-left:auto" onclick="openTemplatePicker()"><i class="fa-solid fa-file-lines"></i> ใช้เทมเพลต</button>
      </div>

      <div class="jq-form-grid">
        <!-- Left: message + media + page -->
        <div>
          <label class="form-label" for="fMsg">ข้อความ <span style="color:#fa5252">*</span></label>
          <textarea id="fMsg" rows="6" placeholder="พิมพ์ข้อความที่ต้องการโพสต์..." style="width:100%"></textarea>

          <label class="form-label" style="margin-top:.6rem">รูปภาพ / วิดีโอ (ไม่บังคับ)</label>
          <div id="fMediaRow" class="jq-media-row">
            <label class="jq-media-add" title="เพิ่มรูปหรือวิดีโอ">
              <i class="fa-solid fa-photo-film"></i><span>เพิ่มไฟล์</span>
              <input type="file" id="fFiles" accept="image/*,video/mp4,video/quicktime,video/webm" multiple style="display:none" onchange="onPickFiles(this.files); this.value=''">
            </label>
          </div>

          <label class="form-label" style="margin-top:.6rem" for="fPage">โพสในนาม <span style="color:#fa5252">*</span></label>
          <div style="display:flex;gap:.4rem;align-items:center">
            <select id="fPage" style="flex:1;min-width:0">
              <option value="">— เลือกว่าจะโพสในนามใคร —</option>
            </select>
            <button type="button" id="btnRefreshPages" class="btn-link-sm" style="white-space:nowrap" onclick="refreshPages()" title="ให้เครื่องโพสหลักดึงรายชื่อเพจใหม่จาก Facebook">
              <i class="fa-solid fa-rotate"></i> อัปเดตรายชื่อ
            </button>
          </div>
          <div id="fPageHint" style="font-size:.75rem;color:var(--text-secondary);margin-top:.25rem"></div>
        </div>
        <!-- Right: groups by category with master checkbox -->
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.3rem">
            <label class="form-label" style="margin-bottom:0">กลุ่ม <span style="color:#fa5252">*</span>
              <span id="selCount" style="font-size:.75rem;color:#1877f2;font-weight:700;margin-left:.4rem;text-transform:none;letter-spacing:0"></span>
            </label>
            <span>
              <button class="btn-link-sm" onclick="selAll()">ทั้งหมด</button>
              <button class="btn-link-sm" onclick="selNone()">ยกเลิก</button>
            </span>
          </div>
          <div style="border:1.5px solid var(--border-color);border-radius:10px;max-height:260px;overflow-y:auto">
            <% jqCats.forEach((cat, ci) => { %>

            <!-- ── Category row (master checkbox + collapse) ── -->
            <div class="jq-cat-hd" id="jqCatHd_<%= ci %>">
              <label style="display:flex;align-items:center;gap:.5rem;flex:1;cursor:pointer;min-width:0" onclick="event.stopPropagation()">
                <input type="checkbox" id="catcb_<%= ci %>"
                       style="accent-color:#1877f2;width:15px;height:15px;cursor:pointer;flex-shrink:0"
                       onchange="toggleCatAll(<%= ci %>, this.checked)" checked>
                <i class="fa-solid fa-location-dot" style="color:<%- (catColorMap && catColorMap[cat]) || '#1877f2' %>;font-size:.78rem;flex-shrink:0"></i>
                <span style="font-weight:700;font-size:.85rem;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= cat %></span>
                <span style="font-size:.74rem;color:var(--text-secondary);white-space:nowrap;margin-right:.2rem"><%= jqCatMap[cat].length %> กลุ่ม</span>
              </label>
              <button style="background:none;border:none;cursor:pointer;color:#aaa;padding:.15rem .3rem;flex-shrink:0"
                      onclick="toggleJqCat(<%= ci %>)" title="ยุบ/ขยาย">
                <i class="fa-solid fa-chevron-down" id="jqChev_<%= ci %>" style="font-size:.74rem;transition:transform .2s"></i>
              </button>
            </div>

            <!-- ── Group checkboxes in this category ── -->
            <div id="jqCatBody_<%= ci %>">
              <% jqCatMap[cat].forEach(g => { %>
              <label class="jq-group-row" id="glabel_<%= g._idx %>">
                <span class="jq-indent"></span>
                <input type="checkbox" id="gc_<%= g._idx %>" value="<%= g._idx %>" data-cat="<%= ci %>"
                       style="accent-color:#1877f2;flex-shrink:0" checked
                       onchange="onGroupCbChange(<%= ci %>)">
                <span style="flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:.87rem"><%= g.groupName %></span>
              </label>
              <% }); %>
            </div>

            <% }); %>
          </div>
        </div>
      </div>

      <div style="display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap;margin-bottom:.75rem">
        <div>
          <label class="form-label" for="fDelay">เว้นระหว่างกลุ่ม (วินาที)</label>
          <input type="number" id="fDelay" value="30" min="10" max="120" style="width:90px">
        </div>
        <div>
          <label class="form-label">ตั้งเวลาโพส (ไม่บังคับ)</label>
          <div class="dt24-wrap">
            <input type="date" lang="en-GB" id="fScheduledAt_d">
            <input type="number" id="fScheduledAt_h" min="0" max="23" placeholder="ชม.">
            <span>:</span>
            <input type="number" id="fScheduledAt_m" min="0" max="59" placeholder="นาที">
            <button type="button" onclick="dt24Set('fScheduledAt','')"
              style="background:#f0f2f5;border:none;border-radius:7px;padding:.4rem .6rem;font-size:.78rem;cursor:pointer;color:#65676b" title="ล้าง">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        </div>
      </div>

      <div style="display:flex;gap:.5rem">
        <button id="btnSubmitJob" class="btn-post" style="font-size:.85rem;padding:.45rem 1rem" onclick="submitJob()">
          <i class="fa-solid fa-paper-plane"></i> เพิ่มลงคิว
        </button>
        <button class="btn-back" onclick="toggleForm()">ยกเลิก</button>
      </div>
    </div>

    <!-- Jobs list -->
    <div class="card">
      <div class="card-title">
        <i class="fa-solid fa-clock-rotate-left"></i> รายการ Jobs
        <% const schedCount = jobs.filter(j => j.status==='pending' && j.scheduledAt).length; %>
        <button id="btnSchedFilter" onclick="toggleSchedFilter()"
          style="margin-left:.6rem;background:#fff3cd;border:1px solid #ffe08a;border-radius:7px;padding:.18rem .55rem;font-size:.78rem;font-weight:600;color:#856404;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-clock"></i> ตั้งเวลาไว้ (<%= schedCount %>)
        </button>
        <button id="btnJqTimelineView" onclick="toggleJqTimelineView()"
          style="margin-left:.4rem;background:#fff3cd;border:1px solid #ffe08a;border-radius:7px;padding:.18rem .55rem;font-size:.78rem;font-weight:600;color:#856404;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-calendar-days"></i> ปฏิทิน
        </button>
        <button class="btn-link-sm" style="margin-left:auto" onclick="location.reload()"><i class="fa-solid fa-rotate-right"></i> รีเฟรช</button>
      </div>

      <!-- Bulk reschedule bar — shown only while "ตั้งเวลาไว้" filter is active and rows selected -->
      <div id="jqBulkBar" style="display:none;align-items:center;gap:.5rem;flex-wrap:wrap;padding:.5rem .65rem;border-bottom:1px solid var(--border-color)">
        <span style="font-size:.8rem;color:#856404;font-weight:600">
          <i class="fa-solid fa-clock"></i> เลือกแล้ว <strong id="jqSelCount">0</strong> รายการ
        </span>
        <button onclick="bulkRescheduleJobs()"
          style="background:#856404;color:#fff;border:none;border-radius:7px;padding:.32rem .7rem;font-size:.79rem;font-weight:600;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-clock-rotate-left"></i> เลื่อนเวลาทั้งหมด
        </button>
        <button onclick="clearJqSelection()"
          style="background:#f0f2f5;border:none;border-radius:7px;padding:.32rem .7rem;font-size:.79rem;cursor:pointer;color:#65676b;font-family:inherit">
          ล้างที่เลือก
        </button>
      </div>

      <div id="jqTimelineView" style="display:none;padding:1rem .85rem;overflow-x:auto"></div>

      <% if (jobs.length === 0) { %>
      <div style="color:var(--text-secondary);text-align:center;padding:1.5rem;font-size:.9rem">ยังไม่มี Job</div>
      <% } else { %>
      <% const icons = { pending:'⏳', running:'🔄', success:'✅', failed:'❌', expired:'⏰', cancelled:'🚫' }; %>
      <% const statusTH = { pending:'รอ', running:'กำลังทำ', success:'เสร็จ', failed:'ล้มเหลว', expired:'หมดเวลา', cancelled:'ยกเลิก' }; %>
      <% const statusCls = { pending:'badge-yellow', running:'badge-blue', success:'badge-green', failed:'badge-red', expired:'badge-red', cancelled:'badge-red' }; %>
      <% jobs.forEach((j, idx) => {
           // parse display text — strip |||URL
           let dispMsg = j.message||'';
           let modeTag = '';
           if (dispMsg.includes('|||')) {
             const sep = dispMsg.indexOf('|||');
             const txt = dispMsg.slice(0,sep).trim();
             const url = dispMsg.slice(sep+3).trim();
             if (txt) { dispMsg = txt; modeTag = '🔗 ลิงก์'; }
             else { dispMsg = url.length>55?url.slice(0,55)+'…':url; modeTag = '↗ แชร์'; }
           }
           if (dispMsg.length>70) dispMsg = dispMsg.slice(0,70)+'…';
      %>
      <div style="display:flex;align-items:flex-start;gap:.7rem;padding:.65rem .5rem;border-bottom:1px solid var(--border-color)"
           id="job_<%= j._id %>" class="job-row" data-idx="<%= idx %>" data-scheduled="<%= (j.status==='pending' && j.scheduledAt) ? '1' : '0' %>" data-status="<%= j.status %>">
        <span style="font-size:1.2rem;flex-shrink:0;margin-top:.1rem"><%= icons[j.status]||'❓' %></span>
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
            <% if(modeTag){ %><span style="font-size:.7rem;font-weight:700;background:#e7f3ff;color:#1877f2;border-radius:4px;padding:.05rem .4rem;margin-right:.3rem"><%= modeTag %></span><% } %><%= dispMsg %>
          </div>
          <div style="font-size:.78rem;color:var(--text-secondary);margin-top:.2rem">
            <i class="fa-solid fa-user" style="font-size:.68rem"></i> <strong><%= (j.staffId && staffNameMap[String(j.staffId)]) || 'ไม่ระบุผู้สั่ง' %></strong> ·
            <% if (j.postAsPage) { %><i class="fa-solid fa-flag" style="font-size:.68rem"></i> <%= j.postAsPage %> · <% } %>
            <% if ((j.images||[]).length) { %><i class="fa-solid fa-image" style="font-size:.68rem"></i> <%= j.images.length %> · <% } %>
            <%= (j.groups||[]).length %> กลุ่ม · เว้น <%= j.delaySeconds %>s ·
            <%= new Date(j.createdAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',hour12:false,dateStyle:'short',timeStyle:'short'}) %>
            <% if (j.scheduledAt) { %>
            · <span style="color:#856404;font-weight:600"><i class="fa-solid fa-clock" style="font-size:.7rem"></i> โพส <%= new Date(j.scheduledAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',hour12:false,dateStyle:'short',timeStyle:'short'}) %></span>
            <% } %>
            <% if (j.status==='success'||j.status==='failed') { %>
            · <strong><%= (j.results||[]).filter(r=>r.status==='success').length %>/<%= (j.groups||[]).length %></strong> สำเร็จ
            <% } %>
          </div>
        </div>
        <span class="badge <%= statusCls[j.status]||'' %>" style="flex-shrink:0"><%= statusTH[j.status]||j.status %></span>
        <% if (j.status === 'pending' || j.status === 'expired') { %>
        <% if (j.scheduledAt) { %>
        <input type="checkbox" class="jqSelCb" data-id="<%= j._id %>" onchange="updateJqSelection()"
          style="accent-color:#856404;cursor:pointer;width:16px;height:16px" title="เลือกเพื่อเลื่อนเวลาทั้งหมด">
        <% } %>
        <button onclick="rescheduleJob('<%= j._id %>', '<%= j.scheduledAt || '' %>')"
          style="background:none;border:none;cursor:pointer;color:#856404;font-size:.85rem;padding:.1rem .3rem;border-radius:4px" title="แก้ไขเวลาโพส">
          <i class="fa-solid fa-clock"></i>
        </button>
        <% } %>
        <button onclick="deleteJob('<%= j._id %>')" style="background:none;border:none;cursor:pointer;color:#c5c8d0;font-size:1rem;padding:.1rem .3rem;border-radius:4px" title="ลบ">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
      <% }); %>
      <% if (jobs.length > 20) { %>
      <div id="showMoreRow" style="padding:.65rem;text-align:center">
        <button onclick="showMoreJobs()" style="background:#f0f2f5;border:none;border-radius:8px;padding:.45rem 1.1rem;font-size:.85rem;cursor:pointer;font-family:inherit;color:#1877f2;font-weight:600">
          เพิ่มเติม (<%= jobs.length-20 %> รายการ)
        </button>
      </div>
      <% } %>
      <% } %>
    </div>

    <% } %>

  </main>
</div>

<style>
.form-label { display:block; font-size:.8rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:.04em; margin-bottom:.3rem }
.btn-link-sm { background:none; border:none; color:#1877f2; font-size:.8rem; cursor:pointer; font-family:inherit; padding:0 .3rem }
.btn-link-sm:hover { text-decoration:underline }
.badge-yellow { background:#fff3cd; color:#856404 }
.badge-blue   { background:#cfe2ff; color:#084298 }
.badge-green  { background:#d1e7dd; color:#0a3622 }
