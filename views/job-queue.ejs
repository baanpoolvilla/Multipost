}

/* ── Media: uploaded straight to storage from the browser ──
   Each item: { id, kind:'image'|'video', preview, url|null, state:'uploading'|'ok'|'err' } */
let _media = [];
let _mediaSeq = 0;
const MAX_IMAGE_MB = 25, MAX_VIDEO_MB = 1024;

async function _uploadToStorage(file) {
  try {
    const ext = (file.name.match(/\.[^.]+$/) || [''])[0].toLowerCase();
    const signRes = await fetch(`/api/sign-upload?ext=${encodeURIComponent(ext)}`);
    if (!signRes.ok) throw new Error('sign');
    const { signedUrl, publicUrl } = await signRes.json();
    const up = await fetch(signedUrl, { method:'PUT', headers:{ 'Content-Type': file.type || 'application/octet-stream' }, body:file });
    if (!up.ok) throw new Error(`put ${up.status}`);
    return publicUrl;
  } catch (e) {
    // Cloud storage unavailable: photos can still go through our own server
    // (kept in the database, the same fallback the Desktop Agent uses — the
    // posting machine downloads them from there). Shrunk first, because the
    // server takes at most ~4MB per request and database space is limited.
    // Videos are too big for that, so they need the cloud storage.
    if (!file.type.startsWith('image/')) throw new Error('video-needs-storage');
    return _uploadViaServer(await _shrinkImage(file));
  }
}

function _shrinkImage(file, maxSide = 2048, quality = 0.85) {
  return new Promise((resolve) => {
    if (file.type === 'image/gif') return resolve(file); // keep animation
    const img = new Image();
    const url = URL.createObjectURL(file);
    img.onload = () => {
      const scale = Math.min(1, maxSide / Math.max(img.naturalWidth, img.naturalHeight));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(img.naturalWidth * scale);
      canvas.height = Math.round(img.naturalHeight * scale);
      canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
      URL.revokeObjectURL(url);
      canvas.toBlob(b => resolve(b && b.size < file.size ? new File([b], file.name.replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg' }) : file), 'image/jpeg', quality);
    };
    img.onerror = () => { URL.revokeObjectURL(url); resolve(file); };
    img.src = url;
  });
}

async function _uploadViaServer(file) {
  if (file.size > 4 * 1024 * 1024) throw new Error('too-big');
  const fd = new FormData();
  fd.append('images', file);
  const r = await fetch('/api/upload-images', { method: 'POST', body: fd });
  const d = await r.json().catch(() => null);
  if (!r.ok || !d || !d.ok || !d.filenames || !d.filenames[0]) throw new Error((d && d.error) || `upload ${r.status}`);
  return d.filenames[0];
}

function onPickFiles(files) {
  for (const file of files) {
    const isVideo = file.type.startsWith('video/');
    const limit = isVideo ? MAX_VIDEO_MB : MAX_IMAGE_MB;
    if (file.size > limit * 1024 * 1024) {
      Swal.fire({ icon:'warning', title:'ไฟล์ใหญ่เกินไป', text:`${file.name} — ${isVideo ? 'วิดีโอ' : 'รูปภาพ'}รับได้สูงสุด ${limit} MB`, confirmButtonColor:'#1877f2' });
      continue;
    }
    const item = { id: ++_mediaSeq, kind: isVideo ? 'video' : 'image', preview: URL.createObjectURL(file), url: null, state: 'uploading' };
    _media.push(item);
    _uploadToStorage(file)
      .then(url => { item.url = url; item.state = 'ok'; })
      .catch((e) => {
        item.state = 'err';
        if (e && e.message === 'video-needs-storage') {
          Swal.fire({ icon:'warning', title:'อัปโหลดวิดีโอไม่ได้ตอนนี้', text:'ที่เก็บไฟล์ออนไลน์ (Supabase) ใช้งานไม่ได้ วิดีโอใหญ่เกินกว่าจะส่งผ่านทางสำรอง — แจ้งผู้ดูแลระบบ ระหว่างนี้โพสด้วยรูปภาพได้', confirmButtonColor:'#1877f2' });
        }
      })
      .finally(renderMedia);
  }
  renderMedia();
}

// Template images are stored names/URLs, not local files — add them as already uploaded.
function addExistingMedia(urlOrName) {
  const src = urlOrName.startsWith('http') ? urlOrName : `/uploads/${encodeURIComponent(urlOrName)}`;
  const isVideo = /\.(mp4|mov|webm|avi)(\?|$)/i.test(urlOrName);
  _media.push({ id: ++_mediaSeq, kind: isVideo ? 'video' : 'image', preview: src, url: urlOrName, state: 'ok' });
}

function removeMedia(id) {
  _media = _media.filter(m => m.id !== id);
  renderMedia();
}

function renderMedia() {
  const row = document.getElementById('fMediaRow');
  if (!row) return;
  row.querySelectorAll('.jq-thumb').forEach(el => el.remove());
  const add = row.querySelector('.jq-media-add');
  _media.forEach(m => {
    const box = document.createElement('div');
    box.className = 'jq-thumb' + (m.state === 'err' ? ' err' : '');
    const el = document.createElement(m.kind === 'video' ? 'video' : 'img');
    el.src = m.preview;
    if (m.kind === 'video') el.muted = true;
    box.appendChild(el);
    if (m.state !== 'ok') {
      const s = document.createElement('div');
      s.className = 'jq-thumb-state';
      s.textContent = m.state === 'uploading' ? 'กำลังอัปโหลด…' : 'อัปโหลดไม่สำเร็จ';
      box.appendChild(s);
    }
    const x = document.createElement('button');
    x.type = 'button'; x.className = 'jq-thumb-x'; x.textContent = '✕'; x.title = 'เอาออก';
    x.addEventListener('click', () => removeMedia(m.id));
    box.appendChild(x);
    row.insertBefore(box, add);
  });
  updateSummary();
}

/* ── Templates — the same set the Desktop Agent uses (message, files,
   groups, "post as", spacing, folder) ── */
const _escT = s => String(s || '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));

// Cloud URLs and stored image names work anywhere; "localpath::" files exist
// only on the Agent machine that saved them.
const _usableMedia = u => typeof u === 'string' && !!u && !u.includes('::');

async function _fetchTemplates() {
  try {
    const d = await (await fetch('/api/agent/group-templates')).json();
    return d.ok ? d.templates : [];
  } catch { return []; }
}

async function openTemplatePicker() {
  let list = await _fetchTemplates();
  if (!list.length) {
    Swal.fire({ icon:'info', title:'ยังไม่มีเทมเพลต', text:'ใส่ข้อความ เลือกกลุ่ม แล้วกด "บันทึกเป็นเทมเพลต" เพื่อสร้างอันแรก', confirmButtonColor:'#1877f2' });
    return;
  }
  let folder = '';
  let picked = null;
  const render = (popup) => {
    const folders = [...new Set(list.map(t => t.folder).filter(Boolean))].sort();
    const shown = folder ? list.filter(t => t.folder === folder) : list;
    const tabs = folders.length ? `<div style="display:flex;gap:.3rem;flex-wrap:wrap;margin-bottom:.6rem">
      <button type="button" class="jq-tpl-tab${folder === '' ? ' on' : ''}" data-f="">ทั้งหมด (${list.length})</button>
      ${folders.map(f => `<button type="button" class="jq-tpl-tab${folder === f ? ' on' : ''}" data-f="${_escT(f)}"><i class="fa-solid fa-folder"></i> ${_escT(f)}</button>`).join('')}
    </div>` : '';
    const rows = shown.map(t => {
      const m = t.message || '';
      const i = m.indexOf('|||');
      const text = i === -1 ? m : (m.slice(0, i).trim() || m.slice(i + 3).trim());
      const files = (t.images || []).filter(_usableMedia).length;
      const localOnly = (t.images || []).length - files;
      const meta = [
        t.postAsPage ? `<i class="fa-solid fa-flag"></i> ${_escT(t.postAsPage)}` : '',
        `${(t.groups || []).length} กลุ่ม`,
        files ? `${files} ไฟล์` : '',
        localOnly ? `<span style="color:#b26a00">${localOnly} ไฟล์อยู่ในเครื่อง Agent ใช้บนเว็บไม่ได้</span>` : '',
        `เว้น ${t.delaySeconds || 30}s`,
      ].filter(Boolean).join(' · ');
      return `<div class="jq-tpl-row">
        <button type="button" class="jq-tpl-item" data-id="${_escT(t.id)}">
          <div style="font-weight:700;font-size:.86rem">${_escT(t.name || 'ไม่มีชื่อ')}</div>
          <div style="font-size:.74rem;color:#65676b">${meta}</div>
          <div style="font-size:.8rem;color:#333;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${_escT((text || '').slice(0, 100))}</div>
        </button>
        <button type="button" class="jq-tpl-del" data-id="${_escT(t.id)}" title="ลบเทมเพลต" aria-label="ลบเทมเพลต ${_escT(t.name)}"><i class="fa-solid fa-trash"></i></button>
      </div>`;
    }).join('') || '<div style="color:#65676b;padding:1rem;text-align:center">ไม่มีเทมเพลตในโฟลเดอร์นี้</div>';
    popup.querySelector('#jqTplBody').innerHTML = tabs + rows;
    popup.querySelectorAll('.jq-tpl-tab').forEach(b => b.addEventListener('click', () => { folder = b.dataset.f; render(popup); }));
    popup.querySelectorAll('.jq-tpl-item').forEach(b => b.addEventListener('click', () => { picked = list.find(t => t.id === b.dataset.id); Swal.close(); }));
    popup.querySelectorAll('.jq-tpl-del').forEach(b => b.addEventListener('click', async () => {
      const t = list.find(x => x.id === b.dataset.id);
      if (!t || !confirm(`ลบเทมเพลต "${t.name}" ?\n(จะหายจาก Agent ด้วย เพราะใช้ชุดเดียวกัน)`)) return;
      await fetch(`/api/agent/group-templates/${encodeURIComponent(t.id)}`, { method:'DELETE' }).catch(() => {});
      list = list.filter(x => x.id !== t.id);
      if (!list.length) { Swal.close(); return; }
      render(popup);
    }));
  };
  await Swal.fire({
    title:'เลือกเทมเพลต',
    html:'<div id="jqTplBody" style="max-height:60vh;overflow-y:auto;text-align:left"></div>',
    showConfirmButton:false, showCloseButton:true, width:640, didOpen: render,
  });
  if (!picked) return;
  if (!(await _confirmReplace(picked.message || ''))) return;
  applyTemplate(picked);
}

function applyTemplate(t) {
  _media = [];
  (t.images || []).filter(_usableMedia).forEach(addExistingMedia);
  _loadMessage(t.message || '');
  renderMedia();
  const delay = document.getElementById('fDelay');
  if (delay) delay.value = Math.min(120, Math.max(10, t.delaySeconds || 30));

  // Groups: tick the template's groups that still exist here.
  const want = new Set((t.groups || []).map(g => String(g.groupId)));
  let hit = 0;
  _groups.forEach((g, i) => {
    const cb = document.getElementById(`gc_${i}`);
    if (!cb) return;
    cb.checked = want.has(String(g.groupId));
    if (cb.checked) hit++;
  });
  Object.keys(_catIdxMap).forEach(ci => syncCatCb(parseInt(ci)));

  // "Post as": only if that Page is still in the posting machine's list.
  const input = document.getElementById('fPage');
  const names = [...new Set([_poster && _poster.identity, ...((_poster && _poster.pages) || [])].filter(Boolean))];
  let pageNote = '';
  if (t.postAsPage && names.includes(t.postAsPage)) input.value = t.postAsPage;
  else { input.value = ''; pageNote = t.postAsPage ? ` · ไม่พบเพจ "${t.postAsPage}" กรุณาเลือกเพจเอง` : ' · กรุณาเลือกเพจ'; }
  _pageNamesKey = '';
  fillPageOptions();
  updateSelCount();

  const missing = want.size - hit;
  Swal.fire({ toast:true, position:'top-end', icon: (missing || pageNote) ? 'warning' : 'success', showConfirmButton:false, timer:4000,
    title:`ใช้เทมเพลต "${t.name}" แล้ว — ${hit} กลุ่ม${missing ? ` (ไม่พบ ${missing} กลุ่ม)` : ''}${pageNote}` });
}

async function saveAsTemplate() {
  const message = _composedMessage() || document.getElementById('fMsg').value.trim();
  const groups = _groups.filter((_, i) => document.getElementById(`gc_${i}`)?.checked).map(g => ({ groupId: g.groupId, groupName: g.groupName }));
  if (!message && !groups.length) {
    Swal.fire({ icon:'warning', title:'ยังไม่มีอะไรให้บันทึก', text:'ใส่ข้อความ หรือเลือกกลุ่มก่อน', confirmButtonColor:'#1877f2' });
    return;
  }
  if (_media.some(m => m.state !== 'ok')) {
    Swal.fire({ icon:'info', title:'รอให้อัปโหลดไฟล์เสร็จก่อน', confirmButtonColor:'#1877f2' });
    return;
  }
  const folders = [...new Set((await _fetchTemplates()).map(t => t.folder).filter(Boolean))].sort();
  const page = document.getElementById('fPage').value;
  const { value, isConfirmed } = await Swal.fire({
    title:'บันทึกเป็นเทมเพลต',
    html:`<div style="text-align:left;font-size:.86rem">
      <label for="swTplName" style="font-weight:600;display:block;margin-bottom:.25rem">ชื่อเทมเพลต</label>
      <input id="swTplName" class="swal2-input" style="margin:0 0 .7rem;width:100%;box-sizing:border-box" placeholder="เช่น โปรวันธรรมดา Madaguscar">
      <label for="swTplFolder" style="font-weight:600;display:block;margin-bottom:.25rem">โฟลเดอร์ (ไม่บังคับ)</label>
      <input id="swTplFolder" class="swal2-input" style="margin:0 0 .7rem;width:100%;box-sizing:border-box" list="swTplFolders" placeholder="พิมพ์ชื่อใหม่ หรือเลือกที่มีอยู่">
      <datalist id="swTplFolders">${folders.map(f => `<option value="${_escT(f)}"></option>`).join('')}</datalist>
      <div style="color:#65676b;font-size:.8rem;line-height:1.6">จะบันทึก: ${message ? 'ข้อความ' : 'ไม่มีข้อความ'}${(_postMode === 'text' && _media.length) ? ` · ${_media.length} ไฟล์` : ''} · ${groups.length} กลุ่ม · ${page ? 'ในนาม ' + _escT(page) : 'ไม่ระบุเพจ'} · เว้น ${parseInt(document.getElementById('fDelay').value) || 30}s<br>ใช้ได้ทั้งบนเว็บและใน Agent</div>
    </div>`,
    showCancelButton:true, confirmButtonText:'บันทึก', cancelButtonText:'ยกเลิก', confirmButtonColor:'#1877f2', focusConfirm:false,
    didOpen: () => document.getElementById('swTplName').focus(),
    preConfirm: () => {
      const name = document.getElementById('swTplName').value.trim();
      if (!name) { Swal.showValidationMessage('กรุณาตั้งชื่อเทมเพลต'); return false; }
      return { name, folder: document.getElementById('swTplFolder').value.trim() };
    },
  });
  if (!isConfirmed) return;
  try {
    const r = await fetch('/api/agent/group-templates', {
      method:'POST', headers:{ 'Content-Type':'application/json' },
      body: JSON.stringify({
        name: value.name, folder: value.folder || null, message, groups,
        delaySeconds: parseInt(document.getElementById('fDelay').value) || 30,
        postAsPage: page || null,
        images: _postMode === 'text' ? _media.map(m => m.url).filter(_usableMedia) : [],
      }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'บันทึกไม่สำเร็จ');
    Swal.fire({ toast:true, position:'top-end', icon:'success', title:`บันทึกเทมเพลต "${value.name}" แล้ว`, showConfirmButton:false, timer:2500 });
  } catch (e) {
    Swal.fire({ icon:'error', title:'บันทึกเทมเพลตไม่สำเร็จ', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Live status: posting machine health, what is posting now, who is next ── */
let _poster = null;
let _lastStatusAt = 0;
const _escB = s => String(s || '').replace(/[&<>"]/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c]));

// The status comes from the shared feed in /js/group-notify.js (one poll for
// this banner and for the notifications on every page).
let _statusFails = 0;
function refreshPosterStatus() { return window.PosterFeed ? window.PosterFeed.refresh() : Promise.resolve(null); }
function renderPosterStatus(d) {
  const banner = document.getElementById('agentBanner');
  // A missed update (network blip, slow response) must not wipe what is on
  // screen — above all the chosen Page. Keep the last good state and let the
  // "อัปเดต N วินาทีที่แล้ว" stamp show that it is getting stale.
  if (!d || !d.ok) {
    _statusFails++;
    if (_lastStatusAt && _statusFails < 6) return;
  } else {
    _statusFails = 0;
    _poster = d.poster;
    fillPageOptions();
  }
  if (d && d.ok) { _lastStatusAt = Date.now(); applyJobStatuses(d.jobs || []); }
  if (!banner) return;
  banner.style.display = 'block';

  const q = d && d.queue ? d.queue : { waiting: 0, running: 0, scheduled: 0 };
  const current = (d && d.current) || [];
  const next = (d && d.next) || [];
  let tone, icon, title, body;
  if (!d || !d.ok) {
    tone = ['#fff8e1', '#f0c36d', '#856404']; icon = 'fa-circle-question'; title = 'ตรวจสอบสถานะเครื่องโพสไม่ได้'; body = 'กำลังลองใหม่อัตโนมัติ…';
  } else if (!_poster) {
    tone = ['#fff8e1', '#f0c36d', '#856404']; icon = 'fa-triangle-exclamation'; title = 'ยังไม่ได้ตั้งเครื่องโพสหลัก'; body = 'งานจะรอจนกว่าจะมี Agent เครื่องใดเครื่องหนึ่งเปิดอยู่';
  } else if (!_poster.online) {
    tone = ['#fde8e8', '#f5b5b5', '#842029']; icon = 'fa-power-off'; title = 'เครื่องโพสหลักออฟไลน์';
    body = `ติดต่อล่าสุด ${new Date(_poster.lastSeenAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',dateStyle:'short',timeStyle:'short'})} — สั่งงานได้ งานจะรอในคิว กรุณาแจ้งผู้ดูแลระบบ`;
  } else if (_poster.authWaiting) {
    tone = ['#fde8e8', '#f5b5b5', '#842029']; icon = 'fa-mobile-screen'; title = 'Facebook ขอยืนยันตัวตน — การโพสหยุดรออยู่';
    body = 'กรุณาแจ้งผู้ดูแลให้กดอนุมัติการเข้าสู่ระบบบนมือถือ';
  } else if (!_poster.fbReady) {
    tone = ['#fde8e8', '#f5b5b5', '#842029']; icon = 'fa-user-lock'; title = 'เครื่องโพสหลักยังไม่ได้เข้าสู่ระบบ Facebook';
    body = 'สั่งงานได้ งานจะรอในคิว กรุณาแจ้งผู้ดูแลระบบ';
  } else if (!_poster.running) {
    tone = ['#fff8e1', '#f0c36d', '#856404']; icon = 'fa-pause'; title = 'เครื่องโพสหลักหยุดโพสอัตโนมัติอยู่';
    body = 'งานจะรอในคิวจนกว่าจะเปิดโพสอัตโนมัติ กรุณาแจ้งผู้ดูแลระบบ';
  } else if (current.length) {
    tone = ['#e7f0fd', '#b3d4f9', '#0b3d91']; icon = 'fa-spinner fa-spin'; title = 'กำลังโพสอยู่';
    body = 'งานใหม่ที่สั่งจะต่อคิวและโพสให้อัตโนมัติ';
  } else {
    tone = ['#d1e7dd', '#a3cfbb', '#0a3622']; icon = 'fa-circle-check'; title = 'เครื่องโพสหลักว่าง พร้อมโพส';
    body = q.waiting ? 'กำลังจะเริ่มงานถัดไปในคิว…' : 'สั่งงานแล้วจะเริ่มโพสทันที ไม่ต้องเปิด Agent';
  }

  const curHtml = current.map(c => {
    const pct = c.total ? Math.round(c.done / c.total * 100) : 0;
    return `<div class="jq-live-job">
      <div class="jq-live-line">
        <span><i class="fa-solid fa-user"></i> <b>${_escB(c.owner)}</b>${c.postAsPage ? ` · <i class="fa-solid fa-flag"></i> ${_escB(c.postAsPage)}` : ''}</span>
        <span class="jq-live-num">${c.done}/${c.total} กลุ่ม${c.failed ? ` · <span style="color:#c62828">ไม่สำเร็จ ${c.failed}</span>` : ''}</span>
      </div>
      <div class="jq-live-bar" role="progressbar" aria-valuemin="0" aria-valuemax="${c.total}" aria-valuenow="${c.done}"><div style="width:${pct}%"></div></div>
      <div class="jq-live-sub">${_escB(c.label)}${c.lastGroup ? ` — ล่าสุด: ${_escB(c.lastGroup)}` : ' — กำลังเริ่ม…'}</div>
    </div>`;
  }).join('');
  const nextHtml = next.length ? `<div class="jq-live-next"><b>คิวถัดไป:</b> ${next.map((n, i) => `<span class="jq-live-chip">${i + 1}. ${_escB(n.owner)} · ${n.total} กลุ่ม</span>`).join('')}${q.waiting > next.length ? ` <span class="jq-live-more">+${q.waiting - next.length} งาน</span>` : ''}</div>` : '';
  const counts = [`กำลังโพส ${q.running}`, `รอคิว ${q.waiting}`, q.scheduled ? `ตั้งเวลาไว้ ${q.scheduled}` : ''].filter(Boolean).join(' · ');
  // Which code the posting machine runs — to check it was updated after a change.
  const verHtml = _poster && _poster.online ? `<span class="jq-live-stamp" title="เวอร์ชันโค้ดของเครื่องโพสหลัก"> · เครื่องโพส ${_escB(_poster.version || 'เวอร์ชันเก่า')}</span>` : '';

  const f = d && d.failures;
  const wrongPageHtml = f && f.wrongPage ? `<div class="card" style="background:#fde8e8;border-color:#f5b5b5;color:#842029;padding:.6rem 1.1rem;font-size:.82rem;margin-top:.5rem">
      <i class="fa-solid fa-flag"></i> <b>ไม่ได้โพส ${f.wrongPage} กลุ่ม เพราะเลือกเพจไม่ได้ / ผู้โพสไม่ตรงกับเพจที่เลือก</b>
      — ระบบยกเลิกเพื่อกันโพสผิดเพจ กรุณาตรวจใน <a href="/group-history" style="color:#842029;font-weight:600">ประวัติโพสกลุ่ม</a> แล้วสั่งใหม่ หรือแจ้งผู้ดูแล
    </div>` : '';
  const failHtml = f && f.count ? `<div class="card" style="background:#fff4e5;border-color:#ffd8a8;color:#7a3e00;padding:.6rem 1.1rem;font-size:.82rem;margin-top:.5rem">
      <i class="fa-solid fa-circle-exclamation"></i> <b>มี ${f.count} งานที่โพสไม่สำเร็จบางกลุ่มหรือทั้งหมด (${f.groups} กลุ่ม) ใน 24 ชม.</b>${f.lastError ? ` — สาเหตุล่าสุด: ${_escB(f.lastError).slice(0, 140)}` : ''}
      · ดูรายละเอียดที่ <a href="/group-history" style="color:#7a3e00;font-weight:600">ประวัติโพสกลุ่ม</a>
    </div>${wrongPageHtml}` : '';

  banner.innerHTML = `<div class="card jq-live" style="background:${tone[0]};border-color:${tone[1]};color:${tone[2]}">
    <div class="jq-live-top">
      <i class="fa-solid ${icon}" style="font-size:1.05rem"></i>
      <div style="flex:1;min-width:180px"><div style="font-weight:700;font-size:.9rem">${title}</div><div style="font-size:.78rem;opacity:.9">${body}</div></div>
      <div class="jq-live-counts">${counts}<span class="jq-live-stamp" id="jqLiveStamp"></span>${verHtml}</div>
    </div>
    ${curHtml}${nextHtml}
  </div>${failHtml}`;
  tickLiveStamp();
}

// "อัปเดตเมื่อ N วินาทีที่แล้ว" — makes it obvious the banner is live, and
// turns into a warning if updates stop arriving.
function tickLiveStamp() {
  const el = document.getElementById('jqLiveStamp');
  if (!el) return;
  if (!_lastStatusAt) { el.textContent = ''; return; }
  const s = Math.round((Date.now() - _lastStatusAt) / 1000);
  el.textContent = s <= 1 ? ' · อัปเดตเมื่อสักครู่' : ` · อัปเดต ${s} วินาทีที่แล้ว`;
  el.style.color = s > 30 ? '#c62828' : '';
}

// Every identity is an explicit choice (sent as postAsPage): the account's
// "current" identity changes after posting as another Page, so "post as it
// is" would land on whichever Page it happened to be left on.
let _pageNamesKey = '';
function fillPageOptions() {
  const input = document.getElementById('fPage');
  const box = document.getElementById('fPageChips');
  const hint = document.getElementById('fPageHint');
  if (!input || !box) return;
  const identity = _poster && _poster.identity;
  const names = [...new Set([identity, ...((_poster && _poster.pages) || [])].filter(Boolean))];
  if (input.value && !names.includes(input.value)) input.value = '';
  // Rebuild only when the list changed, so a 20s status refresh never
  // re-renders the chips under the user's cursor.
  const key = names.join('\n') + '|' + input.value;
  if (key !== _pageNamesKey) {
    _pageNamesKey = key;
    box.textContent = '';
    if (!names.length) {
      const e = document.createElement('div');
      e.className = 'jq-chip-empty';
      e.textContent = 'ยังไม่มีรายชื่อเพจ';
      box.appendChild(e);
    }
    names.forEach(name => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'jq-chip' + (input.value === name ? ' active' : '');
      b.setAttribute('role', 'radio');
      b.setAttribute('aria-checked', input.value === name ? 'true' : 'false');
      const av = document.createElement('span');
      av.className = 'jq-chip-av';
      av.textContent = (name.match(/[A-Za-zก-๙0-9]/) || ['?'])[0].toUpperCase();
      const label = document.createElement('span');
      label.textContent = name;
      b.append(av, label);
      b.addEventListener('click', () => {
        input.value = name;
        _pageNamesKey = '';
        fillPageOptions();
        updateSummary();
      });
      box.appendChild(b);
    });
  }
  if (!hint) return;
  if (_poster && _poster.pagesRefreshPending) hint.textContent = '⏳ กำลังรอเครื่องโพสหลักอัปเดตรายชื่อ (จะทำเมื่อว่างจากการโพส)…';
  else if (!names.length) hint.textContent = 'ยังไม่มีรายชื่อ — กด "อัปเดตรายชื่อ"';
  else if (_poster && _poster.pagesUpdatedAt) hint.textContent = `รายชื่อจาก Facebook ล่าสุด ${new Date(_poster.pagesUpdatedAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',dateStyle:'short',timeStyle:'short'})}`;
  else hint.textContent = '';
}

// Ask the posting machine for a fresh Page list, then watch for it to land
// (every 3s) so the user sees the result right away instead of a stale
// "waiting" note until the next 20s status refresh.
async function refreshPages() {
  const btn = document.getElementById('btnRefreshPages');
  const hint = document.getElementById('fPageHint');
  const before = _poster && _poster.pagesUpdatedAt;
  const setBtn = (busy) => {
    if (!btn) return;
    btn.disabled = busy;
    btn.innerHTML = busy ? '<i class="fa-solid fa-spinner fa-spin"></i> กำลังดึงรายชื่อ…' : '<i class="fa-solid fa-rotate"></i> อัปเดตรายชื่อ';
  };
  setBtn(true);
  try {
    const r = await fetch('/api/agent/poster/refresh-pages', { method:'POST' });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'ส่งคำขอไม่สำเร็จ');
    if (_poster && !_poster.online) throw new Error('เครื่องโพสหลักออฟไลน์ — จะอัปเดตให้เมื่อกลับมาออนไลน์');
    const deadline = Date.now() + 120000;
    while (Date.now() < deadline) {
      await new Promise(res => setTimeout(res, 3000));
      await refreshPosterStatus();
      if (_poster && _poster.pagesUpdatedAt && _poster.pagesUpdatedAt !== before && !_poster.pagesRefreshPending) {
        const n = new Set([_poster.identity, ...(_poster.pages || [])].filter(Boolean)).size;
        Swal.fire({ toast:true, position:'top-end', icon:'success', title:`อัปเดตรายชื่อแล้ว (${n} รายการ)`, showConfirmButton:false, timer:2500 });
        return;
      }
      if (hint) hint.textContent = (_poster && _poster.running && !_poster.pagesRefreshPending)
        ? '⏳ กำลังดึงรายชื่อจาก Facebook…'
        : '⏳ เครื่องโพสหลักกำลังโพสอยู่ — จะดึงรายชื่อให้ทันทีที่โพสงานนี้เสร็จ';
    }
    if (hint) hint.textContent = '⏳ เครื่องโพสหลักยังไม่ว่าง (กำลังโพสงานอยู่) — รายชื่อจะอัปเดตเองเมื่อโพสเสร็จ';
  } catch (e) {
    Swal.fire({ icon:'error', title:'อัปเดตรายชื่อไม่สำเร็จ', text:e.message, confirmButtonColor:'#1877f2' });
  } finally {
    setBtn(false);
  }
}

async function submitJob() {
  const msg     = _composedMessage();
  const delay   = parseInt(document.getElementById('fDelay').value) || 30;
  const sel     = _groups.filter((_,i)=>document.getElementById(`gc_${i}`)?.checked);
  const postAsPage = document.getElementById('fPage')?.value || '';

  if (!postAsPage){ Swal.fire({ icon:'warning', title:'กรุณาเลือกว่าจะโพสในนามใคร', confirmButtonColor:'#1877f2' }); return; }
  if (!msg) {
    const need = _postMode === 'text' ? 'กรุณากรอกข้อความ'
      : !_validLink(document.getElementById('fLink').value) ? 'กรุณาใส่ลิงก์ให้ถูกต้อง (ขึ้นต้นด้วย http:// หรือ https://)'
      : 'กรุณากรอกข้อความที่จะแสดงเหนือการ์ดลิงก์';
    Swal.fire({ icon:'warning', title: need, confirmButtonColor:'#1877f2' });
    return;
  }
  if (!sel.length){ Swal.fire({ icon:'warning', title:'กรุณาเลือกกลุ่ม', confirmButtonColor:'#1877f2' }); return; }
  if (_whenMode === 'later' && !dt24Get('fScheduledAt')) { Swal.fire({ icon:'warning', title:'กรุณาเลือกวันและเวลาที่จะโพส', confirmButtonColor:'#1877f2' }); return; }
  const schedIso = _scheduledIso();
  if (_media.some(m => m.state === 'uploading')) { Swal.fire({ icon:'info', title:'รอให้อัปโหลดไฟล์เสร็จก่อน', confirmButtonColor:'#1877f2' }); return; }
  if (_media.some(m => m.state === 'err')) { Swal.fire({ icon:'warning', title:'มีไฟล์ที่อัปโหลดไม่สำเร็จ', text:'กด ✕ เอาไฟล์นั้นออก แล้วเพิ่มใหม่', confirmButtonColor:'#1877f2' }); return; }
  if (delay < 10 || delay > 120) { Swal.fire({ icon:'warning', title:'เว้นระหว่างกลุ่มต้องอยู่ระหว่าง 10–120 วินาที', confirmButtonColor:'#1877f2' }); return; }

  if (schedIso && new Date(schedIso) <= new Date()) {
    Swal.fire({ icon:'warning', title:'กรุณาเลือกเวลาในอนาคต', confirmButtonColor:'#1877f2' });
    return;
  }

  const whenText = schedIso
    ? `โพสเวลา ${new Date(schedIso).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',dateStyle:'medium',timeStyle:'short'})}`
    : 'โพสทันทีตามลำดับคิว';
  const escHtml = s => String(s).replace(/[&<>"]/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c]));
  const ok = await Swal.fire({
    icon:'question', title:'ยืนยันสร้างงานโพส?',
    html:`ในนาม <b>${escHtml(postAsPage)}</b><br>แบบ <b>${{ text:'ข้อความ', link:'ข้อความ + ลิงก์', share:'แชร์ลิงก์' }[_postMode]}</b> · ${sel.length} กลุ่ม${(_postMode === 'text' && _media.length) ? ' · ' + _media.length + ' ไฟล์' : ''} · เว้น ${delay} วินาที<br>${whenText}`,
    showCancelButton:true, confirmButtonText:'สร้างงาน', cancelButtonText:'ยกเลิก', confirmButtonColor:'#1877f2',
  });
  if (!ok.isConfirmed) return;

  const btn = document.getElementById('btnSubmitJob');
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังเพิ่ม...'; }

  try {
    const r = await fetch('/api/agent/jobs', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        message:msg, groups:sel, delaySeconds:delay, postAsPage: postAsPage || null,
        images: _postMode === 'text' ? _media.map(m => m.url) : [],
        scheduledAt: schedIso,
      }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error||'เกิดข้อผิดพลาด');
    await Swal.fire({ icon:'success', title:'สร้างงานแล้ว', text: schedIso ? whenText : 'งานเข้าคิวแล้ว เครื่องโพสหลักจะโพสให้ตามลำดับ', timer:2200, showConfirmButton:false });
    location.reload();
  } catch(e) {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> เพิ่มลงคิว'; }
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

async function rescheduleJob(id, currentScheduledAt) {
  const current = currentScheduledAt
    ? new Date(currentScheduledAt).toLocaleString('sv-SE', { timeZone: 'Asia/Bangkok' }).slice(0, 16)
    : '';
  const { value, isConfirmed } = await Swal.fire({
    title: '<i class="fa-solid fa-clock" style="color:#856404"></i> แก้ไขเวลาโพส',
    html: `<div style="text-align:left">
      <label style="font-size:.82rem;font-weight:600;color:#555;display:block;margin-bottom:.3rem">เวลาที่ต้องการโพส</label>
      <div class="dt24-wrap" style="margin-bottom:.4rem">
        <input type="date" lang="en-GB" id="swal-schedAt_d" style="cursor:pointer;min-width:110px">
        <input type="number" id="swal-schedAt_h" min="0" max="23" placeholder="ชม." style="width:50px;text-align:center">
        <span>:</span>
        <input type="number" id="swal-schedAt_m" min="0" max="59" placeholder="น." style="width:50px;text-align:center">
      </div>
      <div style="display:flex;gap:.3rem;flex-wrap:wrap;margin-bottom:.4rem">
        <button type="button" onclick="dtToday('swal-schedAt')" style="background:#e7f0fd;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#1877f2;font-family:inherit;font-weight:600">วันนี้</button>
        <button type="button" onclick="dtQuick('swal-schedAt',60)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+1ชม.</button>
        <button type="button" onclick="dtQuick('swal-schedAt',180)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+3ชม.</button>
        <button type="button" onclick="dtQuick('swal-schedAt',1440)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+1วัน</button>
      </div>
      <div style="font-size:.75rem;color:#8a8d91">เว้นว่างไว้เพื่อล้างเวลาที่ตั้งไว้ (จะโพสทันที)</div>
    </div>`,
    confirmButtonText: 'บันทึก',
    confirmButtonColor: '#1877f2',
    showCancelButton: true,
    cancelButtonText: 'ยกเลิก',
    focusConfirm: false,
    didOpen: () => dt24Set('swal-schedAt', current),
    preConfirm: () => dt24Get('swal-schedAt'),
  });
  if (!isConfirmed) return;
  try {
    const scheduledAt = value ? new Date(value + ':00+07:00').toISOString() : null;
    const r = await fetch(`/api/agent/jobs/${id}/schedule`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ scheduledAt }),
    });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'แก้ไขไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
  }
}

async function deleteJob(id) {
  const res = await Swal.fire({ title:'ลบ Job?', icon:'warning', showCancelButton:true, confirmButtonColor:'#fa5252', confirmButtonText:'ลบ', cancelButtonText:'ยกเลิก' });
  if (!res.isConfirmed) return;
  try {
    const r = await fetch(`/api/agent/jobs/${id}`, { method:'DELETE' });
    if (!r.ok) {
      const body = await r.json().catch(() => null);
      throw new Error(body?.error || `HTTP ${r.status}`);
    }
    document.getElementById(`job_${id}`)?.remove();
    const cnt = document.querySelectorAll('[id^="job_"]').length;
    document.getElementById('jobCount').textContent = cnt;
  } catch (e) {
    Swal.fire({ icon:'error', title:'ลบไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
  }
}

/* ── Keep each job row's status current without a page reload ── */
const _JOB_ICON = { pending:'⏳', running:'🔄', success:'✅', failed:'❌', expired:'⏰', cancelled:'🚫' };
const _JOB_TH   = { pending:'รอ', running:'กำลังโพส', success:'เสร็จ', failed:'ล้มเหลว', expired:'หมดเวลา', cancelled:'ยกเลิก' };
const _JOB_CLS  = { pending:'badge-yellow', running:'badge-blue', success:'badge-green', failed:'badge-red', expired:'badge-red', cancelled:'badge-red' };
// Rows are updated from the same status call as the banner (no extra request).
// A row that is new since the page loaded can't be patched in — offer a reload.
function applyJobStatuses(jobs) {
  let unseen = 0;
  jobs.forEach(j => {
    const row = document.getElementById(`job_${j.id}`);
    if (!row) { if (j.status === 'pending' || j.status === 'running') unseen++; return; }
    const prog = row.querySelector('.jq-row-prog');
    if (prog) prog.textContent = j.status === 'running' ? ` · กำลังโพส ${j.done}/${j.total} กลุ่ม` : '';
    if (row.dataset.status === j.status) return;
    row.dataset.status = j.status;
    const icon = row.querySelector('span');
    if (icon) icon.textContent = _JOB_ICON[j.status] || '❓';
    const badge = row.querySelector('.badge');
    if (badge) { badge.className = 'badge ' + (_JOB_CLS[j.status] || ''); badge.textContent = _JOB_TH[j.status] || j.status; badge.style.flexShrink = '0'; }
    if (j.status === 'success' || j.status === 'failed') {
      const p2 = row.querySelector('.jq-row-prog');
      if (p2) p2.textContent = ` · ${j.ok}/${j.total} สำเร็จ`;
    }
  });
  const note = document.getElementById('jqNewJobs');
  if (note) note.style.display = unseen ? '' : 'none';
}

if (typeof initComposer === 'function' && document.getElementById('createForm')) initComposer();
if (window.PosterFeed) window.PosterFeed.subscribe(renderPosterStatus);
setInterval(tickLiveStamp, 1000);
</script>

