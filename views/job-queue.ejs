<script>
function dt24Get(prefix) {
  const d = document.getElementById(prefix+'_d')?.value;
  if (!d) return '';
  const h = String(document.getElementById(prefix+'_h').value||0).padStart(2,'0');
  const m = String(document.getElementById(prefix+'_m').value||0).padStart(2,'0');
  return `${d}T${h}:${m}`;
}
function _fpSetDate(el, dateStr) {
  if (!el) return;
  if (el._flatpickr) el._flatpickr.setDate(dateStr || null, false);
  else el.value = dateStr || '';
}
function dt24Set(prefix, localStr) {
  const [d,t] = (localStr||'').split('T');
  _fpSetDate(document.getElementById(prefix+'_d'), d);
  const [h,m] = (t||'').split(':');
  document.getElementById(prefix+'_h').value = h||'';
  document.getElementById(prefix+'_m').value = m||'';
}
function dtQuick(prefix, minutes) {
  const dEl = document.getElementById(prefix+'_d');
  const hEl = document.getElementById(prefix+'_h');
  const mEl = document.getElementById(prefix+'_m');
  if (!dEl) return;
  let base;
  if (dEl.value) {
    const h = parseInt(hEl.value)||0, m = parseInt(mEl.value)||0;
    base = new Date(`${dEl.value}T${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:00+07:00`);
  } else {
    base = new Date(); base.setSeconds(0,0);
  }
  base.setMinutes(base.getMinutes() + minutes);
  const bkk = new Date(base.toLocaleString('en-US', { timeZone:'Asia/Bangkok' }));
  const pad  = n => String(n).padStart(2,'0');
  _fpSetDate(dEl, `${bkk.getFullYear()}-${pad(bkk.getMonth()+1)}-${pad(bkk.getDate())}`);
  hEl.value = bkk.getHours();
  mEl.value = bkk.getMinutes();
}
function dtToday(prefix) {
  const bkk = new Date(new Date().toLocaleString('en-US', { timeZone:'Asia/Bangkok' }));
  const pad  = n => String(n).padStart(2,'0');
  _fpSetDate(document.getElementById(prefix+'_d'), `${bkk.getFullYear()}-${pad(bkk.getMonth()+1)}-${pad(bkk.getDate())}`);
  document.getElementById(prefix+'_h').value = bkk.getHours();
  document.getElementById(prefix+'_m').value = bkk.getMinutes();
}

const _groups = <%- JSON.stringify(groups) %>;
// Map: category index -> array of group indices in _groups
const _catIdxMap = <%- JSON.stringify(Object.fromEntries(jqCats.map((cat, ci) => [ci, jqCatMap[cat].map(g => g._idx)]))) %>;
const _jqScheduled = <%- JSON.stringify(jobs.filter(j => j.status==='pending' && j.scheduledAt).map(j => ({ id: j._id, msg: j.message, at: j.scheduledAt }))) %>;
let _visibleJobs = 20;

// Hide jobs beyond 20 on load
document.querySelectorAll('.job-row').forEach(r => {
  if (parseInt(r.dataset.idx) >= _visibleJobs) r.style.display = 'none';
});

// Deep-link support, e.g. /job-queue?status=expired from the "หมดเวลา"
// reminder modal on the compose page — shows only the items that need
// attention instead of the full unfiltered queue.
if (new URLSearchParams(location.search).get('status') === 'expired') {
  document.querySelectorAll('.job-row').forEach(r => {
    r.style.display = r.dataset.status === 'expired' ? 'flex' : 'none';
  });
  const moreRow = document.getElementById('showMoreRow');
  if (moreRow) moreRow.style.display = 'none';
}

function showMoreJobs() {
  _visibleJobs += 20;
  document.querySelectorAll('.job-row').forEach(r => {
    if (parseInt(r.dataset.idx) < _visibleJobs) r.style.display = 'flex';
  });
  const btn = document.getElementById('showMoreRow');
  const remaining = document.querySelectorAll('.job-row[style*="display: none"], .job-row[style*="display:none"]').length;
  if (remaining === 0 && btn) btn.style.display = 'none';
}

/* ── "ตั้งเวลาไว้" filter ── */
let _schedFilterActive = false;

function toggleSchedFilter() {
  _schedFilterActive = !_schedFilterActive;
  const btn = document.getElementById('btnSchedFilter');
  const moreRow = document.getElementById('showMoreRow');
  if (_schedFilterActive) {
    if (btn) { btn.style.background = '#856404'; btn.style.color = '#fff'; }
    if (moreRow) moreRow.style.display = 'none';
    document.querySelectorAll('.job-row').forEach(r => {
      r.style.display = r.dataset.scheduled === '1' ? 'flex' : 'none';
    });
  } else {
    if (btn) { btn.style.background = '#fff3cd'; btn.style.color = '#856404'; }
    document.querySelectorAll('.job-row').forEach(r => {
      r.style.display = parseInt(r.dataset.idx) < _visibleJobs ? 'flex' : 'none';
    });
    if (moreRow) moreRow.style.display = '';
  }
  updateJqSelection();
}

let _jqTimelineOn = false;
function toggleJqTimelineView() {
  _jqTimelineOn = !_jqTimelineOn;
  const view = document.getElementById('jqTimelineView');
  const btn  = document.getElementById('btnJqTimelineView');
  document.querySelectorAll('.job-row').forEach(r => { if (_jqTimelineOn) r.style.display = 'none'; });
  const moreRow = document.getElementById('showMoreRow');
  if (_jqTimelineOn) {
    renderJobQueueTimeline();
    view.style.display = '';
    btn.style.background = '#856404'; btn.style.color = '#fff';
    if (moreRow) moreRow.style.display = 'none';
  } else {
    view.style.display = 'none';
    btn.style.background = '#fff3cd'; btn.style.color = '#856404';
    if (_schedFilterActive) {
      document.querySelectorAll('.job-row').forEach(r => {
        r.style.display = r.dataset.scheduled === '1' ? 'flex' : 'none';
      });
    } else {
      document.querySelectorAll('.job-row').forEach(r => {
        r.style.display = parseInt(r.dataset.idx) < _visibleJobs ? 'flex' : 'none';
      });
      if (moreRow) moreRow.style.display = '';
    }
  }
  updateJqSelection();
}

function renderJobQueueTimeline() {
  const view = document.getElementById('jqTimelineView');
  const items = _jqScheduled;
  if (!items.length) {
    view.innerHTML = '<div style="text-align:center;padding:2rem;color:#8a8d91">ไม่มีงานที่ตั้งเวลาไว้</div>';
    return;
  }
  const byDate = {};
  items.forEach(j => {
    const d = new Date(j.at);
    const key = d.toLocaleDateString('en-CA');
    (byDate[key] = byDate[key] || []).push(j);
  });
  const now = new Date();
  const hourLines = [0, 4, 8, 12, 16, 20];
  const cols = Object.keys(byDate).sort().map(key => {
    const d = new Date(key + 'T00:00:00');
    const label = d.toLocaleDateString('th-TH', { weekday: 'short', day: 'numeric', month: 'short' });
    const chips = byDate[key].map(j => {
      const t = new Date(j.at);
      const top = ((t.getHours() + t.getMinutes() / 60) / 24 * 100).toFixed(2);
      const overdue = t < now;
      const time = t.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', hour12: false });
      const msg = (j.msg || '').slice(0, 30).replace(/'/g, '&#39;');
      return `<div onclick="rescheduleJob('${j.id}','${j.at}')" title="${time} — ${msg}"
        style="position:absolute;left:4px;right:4px;top:${top}%;background:${overdue ? '#fde8e8' : '#fff3cd'};color:${overdue ? '#c62828' : '#856404'};border:1px solid ${overdue ? '#f5b5b5' : '#ffe08a'};border-radius:5px;padding:.15rem .35rem;font-size:.68rem;font-weight:600;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:140px;z-index:1">
        ${overdue ? '⚠️' : '⏰'} ${time} ${msg}</div>`;
    }).join('');
    const lines = hourLines.map(h => `<div style="position:absolute;left:0;right:0;top:${(h/24*100).toFixed(2)}%;border-top:1px dashed #eee;font-size:.62rem;color:#bbb;padding-left:2px">${String(h).padStart(2,'0')}:00</div>`).join('');
    return `<div style="flex:0 0 150px;min-width:150px">
      <div style="font-size:.78rem;font-weight:700;color:#444;text-align:center;margin-bottom:.4rem">${label}</div>
      <div style="position:relative;height:360px;background:#fafbfc;border:1px solid #eee;border-radius:8px">${lines}${chips}</div>
    </div>`;
  }).join('');
  view.innerHTML = `<div style="display:flex;gap:.6rem">${cols}</div>`;
}

function updateJqSelection() {
  const checked = [...document.querySelectorAll('.jqSelCb')].filter(cb => cb.checked && cb.closest('.job-row').style.display !== 'none');
  const bar = document.getElementById('jqBulkBar');
  if (bar) bar.style.display = checked.length ? 'flex' : 'none';
  const cnt = document.getElementById('jqSelCount');
  if (cnt) cnt.textContent = checked.length;
}

function clearJqSelection() {
  document.querySelectorAll('.jqSelCb').forEach(cb => cb.checked = false);
  updateJqSelection();
}

async function bulkRescheduleJobs() {
  const ids = [...document.querySelectorAll('.jqSelCb')].filter(cb => cb.checked).map(cb => cb.dataset.id);
  if (!ids.length) return;
  const { value, isConfirmed } = await Swal.fire({
    title: `<i class="fa-solid fa-clock" style="color:#856404"></i> เลื่อนเวลาโพส ${ids.length} รายการ`,
    html: `<div style="text-align:left">
      <label style="font-size:.82rem;font-weight:600;color:#555;display:block;margin-bottom:.3rem">เวลาที่ต้องการโพส (ใช้กับทุกรายการที่เลือก)</label>
      <div class="dt24-wrap" style="margin-bottom:.4rem">
        <input type="date" lang="en-GB" id="swal-jqBulkAt_d" style="cursor:pointer;min-width:110px">
        <input type="number" id="swal-jqBulkAt_h" min="0" max="23" placeholder="ชม." style="width:50px;text-align:center">
        <span>:</span>
        <input type="number" id="swal-jqBulkAt_m" min="0" max="59" placeholder="น." style="width:50px;text-align:center">
      </div>
      <div style="display:flex;gap:.3rem;flex-wrap:wrap">
        <button type="button" onclick="dtToday('swal-jqBulkAt')" style="background:#e7f0fd;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#1877f2;font-family:inherit;font-weight:600">วันนี้</button>
        <button type="button" onclick="dtQuick('swal-jqBulkAt',60)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+1ชม.</button>
        <button type="button" onclick="dtQuick('swal-jqBulkAt',180)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+3ชม.</button>
        <button type="button" onclick="dtQuick('swal-jqBulkAt',1440)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+1วัน</button>
      </div>
    </div>`,
    confirmButtonText: 'บันทึกทั้งหมด', confirmButtonColor: '#856404',
    showCancelButton: true, cancelButtonText: 'ยกเลิก', focusConfirm: false,
    preConfirm: () => {
      const v = dt24Get('swal-jqBulkAt');
      if (!v) { Swal.showValidationMessage('กรุณาเลือกวันที่และเวลา'); return false; }
      return v;
    },
  });
  if (!isConfirmed) return;
  const scheduledAt = new Date(value + ':00+07:00').toISOString();
  try {
    await Promise.all(ids.map(id => fetch(`/api/agent/jobs/${id}/schedule`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ scheduledAt }),
    })));
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เลื่อนเวลาไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
  }
}

function toggleForm() {
  const f = document.getElementById('createForm');
  f.style.display = f.style.display === '' ? 'none' : '';
}

/* ── Selection counter ── */
function updateSelCount() {
  const total = document.querySelectorAll('[id^="gc_"]').length;
  const checked = document.querySelectorAll('[id^="gc_"]:checked').length;
  const el = document.getElementById('selCount');
  if (el) el.textContent = checked > 0 ? `(เลือก ${checked}/${total})` : '';
}

/* ── Global select/deselect ── */
function selAll() {
  document.querySelectorAll('[id^="gc_"]').forEach(c => c.checked = true);
  Object.keys(_catIdxMap).forEach(ci => syncCatCb(parseInt(ci)));
  updateSelCount();
}
function selNone() {
  document.querySelectorAll('[id^="gc_"]').forEach(c => c.checked = false);
  Object.keys(_catIdxMap).forEach(ci => syncCatCb(parseInt(ci)));
  updateSelCount();
}

/* ── Master category checkbox ── */
function toggleCatAll(ci, checked) {
  (_catIdxMap[ci]||[]).forEach(i => {
    const el = document.getElementById(`gc_${i}`);
    if (el) el.checked = checked;
  });
  updateSelCount();
}

/* Called when individual group checkbox changes */
function onGroupCbChange(ci) {
  syncCatCb(ci);
  updateSelCount();
}

/* Sync category master checkbox state (checked / indeterminate / unchecked) */
function syncCatCb(ci) {
  const indices = _catIdxMap[ci] || [];
  const cbs = indices.map(i => document.getElementById(`gc_${i}`)).filter(Boolean);
  const checkedN = cbs.filter(c => c.checked).length;
  const catCb = document.getElementById(`catcb_${ci}`);
  if (!catCb) return;
  if (checkedN === 0) {
    catCb.checked = false; catCb.indeterminate = false;
  } else if (checkedN === cbs.length) {
    catCb.checked = true;  catCb.indeterminate = false;
  } else {
    catCb.checked = false; catCb.indeterminate = true;
  }
}

/* ── Collapse/expand category ── */
function toggleJqCat(ci) {
  const body = document.getElementById(`jqCatBody_${ci}`);
  const chev = document.getElementById(`jqChev_${ci}`);
  if (!body) return;
  const hidden = body.style.display === 'none';
  body.style.display = hidden ? '' : 'none';
  if (chev) chev.style.transform = hidden ? '' : 'rotate(-90deg)';
}

/* ── Init on page load ── */
(function init() {
  Object.keys(_catIdxMap).forEach(ci => syncCatCb(parseInt(ci)));
  updateSelCount();
})();

/* ── Media: uploaded straight to storage from the browser ──
   Each item: { id, kind:'image'|'video', preview, url|null, state:'uploading'|'ok'|'err' } */
let _media = [];
let _mediaSeq = 0;
const MAX_IMAGE_MB = 4, MAX_VIDEO_MB = 1024;

async function _uploadToStorage(file) {
  const ext = (file.name.match(/\.[^.]+$/) || [''])[0].toLowerCase();
  const signRes = await fetch(`/api/sign-upload?ext=${encodeURIComponent(ext)}`);
  if (!signRes.ok) throw new Error('สร้างลิงก์อัปโหลดไม่ได้');
  const { signedUrl, publicUrl } = await signRes.json();
  const up = await fetch(signedUrl, { method:'PUT', headers:{ 'Content-Type': file.type || 'application/octet-stream' }, body:file });
  if (!up.ok) throw new Error(`อัปโหลดไม่สำเร็จ (${up.status})`);
  return publicUrl;
}

function onPickFiles(files) {
  for (const file of files) {
    const isVideo = file.type.startsWith('video/');
    const limit = isVideo ? MAX_VIDEO_MB : MAX_IMAGE_MB;
    if (file.size > limit * 1024 * 1024) {
      Swal.fire({ icon:'warning', title:'ไฟล์ใหญ่เกินไป', text:`${file.name} — ${isVideo ? 'วิดีโอ' : 'รูปภาพ'}รับได้สูงสุด ${limit} MB`, confirmButtonColor:'#1877f2' });
      continue;
    }
    const item = { id: ++_mediaSeq, kind: isVideo ? 'video' : 'image', preview: URL.createObjectURL(file), url: null, state: 'uploading' };
    _media.push(item);
    _uploadToStorage(file)
      .then(url => { item.url = url; item.state = 'ok'; })
      .catch(() => { item.state = 'err'; })
      .finally(renderMedia);
  }
  renderMedia();
}

// Template images are stored names/URLs, not local files — add them as already uploaded.
function addExistingMedia(urlOrName) {
  const src = urlOrName.startsWith('http') ? urlOrName : `/uploads/${encodeURIComponent(urlOrName)}`;
  const isVideo = /\.(mp4|mov|webm|avi)(\?|$)/i.test(urlOrName);
  _media.push({ id: ++_mediaSeq, kind: isVideo ? 'video' : 'image', preview: src, url: urlOrName, state: 'ok' });
}

function removeMedia(id) {
  _media = _media.filter(m => m.id !== id);
  renderMedia();
}

function renderMedia() {
  const row = document.getElementById('fMediaRow');
  if (!row) return;
  row.querySelectorAll('.jq-thumb').forEach(el => el.remove());
  const add = row.querySelector('.jq-media-add');
  _media.forEach(m => {
    const box = document.createElement('div');
    box.className = 'jq-thumb' + (m.state === 'err' ? ' err' : '');
    const el = document.createElement(m.kind === 'video' ? 'video' : 'img');
    el.src = m.preview;
    if (m.kind === 'video') el.muted = true;
    box.appendChild(el);
    if (m.state !== 'ok') {
      const s = document.createElement('div');
      s.className = 'jq-thumb-state';
      s.textContent = m.state === 'uploading' ? 'กำลังอัปโหลด…' : 'อัปโหลดไม่สำเร็จ';
      box.appendChild(s);
    }
    const x = document.createElement('button');
    x.type = 'button'; x.className = 'jq-thumb-x'; x.textContent = '✕'; x.title = 'เอาออก';
    x.addEventListener('click', () => removeMedia(m.id));
    box.appendChild(x);
    row.insertBefore(box, add);
  });
}

/* ── Templates ── */
async function openTemplatePicker() {
  let list = [];
  try { list = await (await fetch('/api/templates')).json(); } catch {}
  if (!Array.isArray(list) || !list.length) {
    Swal.fire({ icon:'info', title:'ยังไม่มีเทมเพลต', confirmButtonColor:'#1877f2' });
    return;
  }
  const esc = s => String(s || '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  const html = `<div style="max-height:55vh;overflow-y:auto;text-align:left">${list.map((t, i) => `
    <button type="button" class="jq-tpl-item" data-i="${i}">
      <div style="font-weight:700;font-size:.86rem">${esc(t.name || 'ไม่มีชื่อ')}${(t.images||[]).length ? ` <span style="color:#1877f2;font-size:.75rem">· ${t.images.length} ไฟล์</span>` : ''}</div>
      <div style="font-size:.78rem;color:#65676b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc((t.message || '').slice(0, 90))}</div>
    </button>`).join('')}</div>`;
  let picked = null;
  await Swal.fire({
    title:'เลือกเทมเพลต', html, showConfirmButton:false, showCloseButton:true, width:560,
    didOpen: (popup) => popup.querySelectorAll('.jq-tpl-item').forEach(b => b.addEventListener('click', () => { picked = list[+b.dataset.i]; Swal.close(); })),
  });
  if (!picked) return;
  document.getElementById('fMsg').value = picked.message || '';
  _media = [];
  (picked.images || []).forEach(addExistingMedia);
  renderMedia();
}

/* ── Main posting machine status + its Pages ── */
let _poster = null;
async function refreshPosterStatus() {
  const banner = document.getElementById('agentBanner');
  let d = null;
  try { d = await (await fetch('/api/agent/poster-status')).json(); } catch {}
  _poster = d && d.poster;
  fillPageOptions();
  if (!banner) return;
  banner.style.display = 'block';
  const q = d && d.queue ? d.queue : { waiting: 0, running: 0 };
  const queueText = `กำลังโพส ${q.running} งาน · รอคิว ${q.waiting} งาน`;
  let tone, icon, title, body;
  if (!d || !d.ok) {
    tone = ['#fff8e1', '#f0c36d', '#856404']; icon = 'fa-circle-question'; title = 'ตรวจสอบสถานะเครื่องโพสไม่ได้'; body = 'ลองรีเฟรชหน้าอีกครั้ง';
  } else if (!_poster) {
    tone = ['#fff8e1', '#f0c36d', '#856404']; icon = 'fa-triangle-exclamation'; title = 'ยังไม่ได้ตั้งเครื่องโพสหลัก'; body = 'งานจะรอจนกว่าจะมี Agent เครื่องใดเครื่องหนึ่งเปิดอยู่';
  } else if (!_poster.online) {
    tone = ['#fde8e8', '#f5b5b5', '#842029']; icon = 'fa-power-off'; title = 'เครื่องโพสหลักออฟไลน์';
    body = `ติดต่อล่าสุด ${new Date(_poster.lastSeenAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',dateStyle:'short',timeStyle:'short'})} — สั่งงานได้ งานจะรอในคิว กรุณาแจ้งผู้ดูแลระบบ`;
  } else if (_poster.authWaiting) {
    tone = ['#fde8e8', '#f5b5b5', '#842029']; icon = 'fa-mobile-screen'; title = 'Facebook ขอยืนยันตัวตน — การโพสหยุดรออยู่';
    body = 'กรุณาแจ้งผู้ดูแลให้กดอนุมัติการเข้าสู่ระบบบนมือถือ';
  } else if (!_poster.fbReady) {
    tone = ['#fde8e8', '#f5b5b5', '#842029']; icon = 'fa-user-lock'; title = 'เครื่องโพสหลักยังไม่ได้เข้าสู่ระบบ Facebook';
    body = 'สั่งงานได้ งานจะรอในคิว กรุณาแจ้งผู้ดูแลระบบ';
  } else if (!_poster.running) {
    tone = ['#fff8e1', '#f0c36d', '#856404']; icon = 'fa-pause'; title = 'เครื่องโพสหลักหยุดโพสอัตโนมัติอยู่';
    body = 'งานจะรอในคิวจนกว่าจะเปิดโพสอัตโนมัติ กรุณาแจ้งผู้ดูแลระบบ';
  } else {
    tone = ['#d1e7dd', '#a3cfbb', '#0a3622']; icon = 'fa-circle-check'; title = 'เครื่องโพสหลักพร้อมทำงาน';
    body = 'สั่งงานแล้วระบบจะโพสตามลำดับคิวให้อัตโนมัติ ไม่ต้องเปิด Agent';
  }
  const f = d && d.failures;
  const esc = s => String(s || '').replace(/[&<>"]/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c]));
  const failHtml = f && f.count ? `<div class="card" style="background:#fff4e5;border-color:#ffd8a8;color:#7a3e00;padding:.6rem 1.1rem;font-size:.82rem;margin-top:.5rem">
      <i class="fa-solid fa-circle-exclamation"></i> <b>มีงานล้มเหลว ${f.count} งานใน 24 ชม.</b>${f.lastError ? ` — สาเหตุล่าสุด: ${esc(f.lastError).slice(0, 140)}` : ''}
      · ดูรายละเอียดที่ <a href="/group-history" style="color:#7a3e00;font-weight:600">ประวัติโพสกลุ่ม</a>
    </div>` : '';
  banner.innerHTML = `<div class="card" style="background:${tone[0]};border-color:${tone[1]};color:${tone[2]};padding:.75rem 1.1rem;display:flex;align-items:center;gap:.75rem;flex-wrap:wrap">
    <i class="fa-solid ${icon}" style="font-size:1.1rem"></i>
    <div style="flex:1;min-width:200px"><div style="font-weight:700;font-size:.9rem">${title}</div><div style="font-size:.8rem;opacity:.9">${body}</div></div>
    <div style="font-size:.8rem;font-weight:600;white-space:nowrap">${queueText}</div>
  </div>${failHtml}`;
}

// Every identity is an explicit choice (sent as postAsPage): the account's
// "current" identity changes after posting as another Page, so "post as it
// is" would land on whichever Page it happened to be left on.
function fillPageOptions() {
  const sel = document.getElementById('fPage');
  const hint = document.getElementById('fPageHint');
  if (!sel) return;
  const current = sel.value;
  const identity = _poster && _poster.identity;
  const names = [...new Set([identity, ...((_poster && _poster.pages) || [])].filter(Boolean))];
  sel.querySelectorAll('option[data-page]').forEach(o => o.remove());
  names.forEach(name => {
    const o = document.createElement('option');
    o.value = name; o.dataset.page = '1';
    o.textContent = name === identity ? `${name} (ตัวตนปัจจุบันของบัญชี)` : name;
    sel.appendChild(o);
  });
  if (current && names.includes(current)) sel.value = current;
  if (!hint) return;
  if (_poster && _poster.pagesRefreshPending) hint.textContent = '⏳ กำลังรอเครื่องโพสหลักอัปเดตรายชื่อ (จะทำเมื่อว่างจากการโพส)…';
  else if (!names.length) hint.textContent = 'ยังไม่มีรายชื่อ — กด "อัปเดตรายชื่อ"';
  else if (_poster && _poster.pagesUpdatedAt) hint.textContent = `รายชื่อจาก Facebook ล่าสุด ${new Date(_poster.pagesUpdatedAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',dateStyle:'short',timeStyle:'short'})}`;
  else hint.textContent = '';
}

async function refreshPages() {
  const btn = document.getElementById('btnRefreshPages');
  if (btn) btn.disabled = true;
  try {
    const r = await fetch('/api/agent/poster/refresh-pages', { method:'POST' });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'ส่งคำขอไม่สำเร็จ');
    await refreshPosterStatus();
  } catch (e) {
    Swal.fire({ icon:'error', title:'อัปเดตรายชื่อไม่สำเร็จ', text:e.message, confirmButtonColor:'#1877f2' });
  } finally {
    if (btn) btn.disabled = false;
  }
}

async function submitJob() {
  const msg     = document.getElementById('fMsg').value.trim();
  const delay   = parseInt(document.getElementById('fDelay').value) || 30;
  const schedAt = dt24Get('fScheduledAt');
  const sel     = _groups.filter((_,i)=>document.getElementById(`gc_${i}`)?.checked);
  const postAsPage = document.getElementById('fPage')?.value || '';

  if (!msg)       { Swal.fire({ icon:'warning', title:'กรุณากรอกข้อความ', confirmButtonColor:'#1877f2' }); return; }
  if (!sel.length){ Swal.fire({ icon:'warning', title:'กรุณาเลือกกลุ่ม', confirmButtonColor:'#1877f2' }); return; }
  if (!postAsPage){ Swal.fire({ icon:'warning', title:'กรุณาเลือกว่าจะโพสในนามใคร', confirmButtonColor:'#1877f2' }); return; }
  if (_media.some(m => m.state === 'uploading')) { Swal.fire({ icon:'info', title:'รอให้อัปโหลดไฟล์เสร็จก่อน', confirmButtonColor:'#1877f2' }); return; }
  if (_media.some(m => m.state === 'err')) { Swal.fire({ icon:'warning', title:'มีไฟล์ที่อัปโหลดไม่สำเร็จ', text:'กด ✕ เอาไฟล์นั้นออก แล้วเพิ่มใหม่', confirmButtonColor:'#1877f2' }); return; }
  if (delay < 10 || delay > 120) { Swal.fire({ icon:'warning', title:'เว้นระหว่างกลุ่มต้องอยู่ระหว่าง 10–120 วินาที', confirmButtonColor:'#1877f2' }); return; }

  if (schedAt && new Date(schedAt.slice(0,16) + ':00+07:00') <= new Date()) {
    Swal.fire({ icon:'warning', title:'กรุณาเลือกเวลาในอนาคต', confirmButtonColor:'#1877f2' });
    return;
  }

  const whenText = schedAt
    ? `โพสเวลา ${new Date(schedAt.slice(0,16) + ':00+07:00').toLocaleString('th-TH',{timeZone:'Asia/Bangkok',dateStyle:'short',timeStyle:'short'})}`
    : 'โพสทันทีตามลำดับคิว';
  const ok = await Swal.fire({
    icon:'question', title:'ยืนยันสร้างงานโพส?',
    html:`${sel.length} กลุ่ม · ในนาม <b>${postAsPage.replace(/[<>&]/g,'')}</b>${_media.length ? ' · ' + _media.length + ' ไฟล์' : ''}<br>${whenText}`,
    showCancelButton:true, confirmButtonText:'สร้างงาน', cancelButtonText:'ยกเลิก', confirmButtonColor:'#1877f2',
  });
  if (!ok.isConfirmed) return;

  const btn = document.getElementById('btnSubmitJob');
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังเพิ่ม...'; }

  try {
    const r = await fetch('/api/agent/jobs', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        message:msg, groups:sel, delaySeconds:delay, postAsPage: postAsPage || null,
        images: _media.map(m => m.url),
        scheduledAt: schedAt ? new Date(schedAt.slice(0,16) + ':00+07:00').toISOString() : null,
      }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error||'เกิดข้อผิดพลาด');
    await Swal.fire({ icon:'success', title:'สร้างงานแล้ว', text: schedAt ? whenText : 'งานเข้าคิวแล้ว เครื่องโพสหลักจะโพสให้ตามลำดับ', timer:2200, showConfirmButton:false });
    location.reload();
  } catch(e) {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> เพิ่มลงคิว'; }
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

async function rescheduleJob(id, currentScheduledAt) {
  const current = currentScheduledAt
    ? new Date(currentScheduledAt).toLocaleString('sv-SE', { timeZone: 'Asia/Bangkok' }).slice(0, 16)
    : '';
  const { value, isConfirmed } = await Swal.fire({
    title: '<i class="fa-solid fa-clock" style="color:#856404"></i> แก้ไขเวลาโพส',
    html: `<div style="text-align:left">
      <label style="font-size:.82rem;font-weight:600;color:#555;display:block;margin-bottom:.3rem">เวลาที่ต้องการโพส</label>
      <div class="dt24-wrap" style="margin-bottom:.4rem">
        <input type="date" lang="en-GB" id="swal-schedAt_d" style="cursor:pointer;min-width:110px">
        <input type="number" id="swal-schedAt_h" min="0" max="23" placeholder="ชม." style="width:50px;text-align:center">
        <span>:</span>
        <input type="number" id="swal-schedAt_m" min="0" max="59" placeholder="น." style="width:50px;text-align:center">
      </div>
      <div style="display:flex;gap:.3rem;flex-wrap:wrap;margin-bottom:.4rem">
        <button type="button" onclick="dtToday('swal-schedAt')" style="background:#e7f0fd;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#1877f2;font-family:inherit;font-weight:600">วันนี้</button>
        <button type="button" onclick="dtQuick('swal-schedAt',60)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+1ชม.</button>
        <button type="button" onclick="dtQuick('swal-schedAt',180)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+3ชม.</button>
        <button type="button" onclick="dtQuick('swal-schedAt',1440)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+1วัน</button>
      </div>
      <div style="font-size:.75rem;color:#8a8d91">เว้นว่างไว้เพื่อล้างเวลาที่ตั้งไว้ (จะโพสทันที)</div>
    </div>`,
    confirmButtonText: 'บันทึก',
    confirmButtonColor: '#1877f2',
    showCancelButton: true,
    cancelButtonText: 'ยกเลิก',
    focusConfirm: false,
    didOpen: () => dt24Set('swal-schedAt', current),
    preConfirm: () => dt24Get('swal-schedAt'),
  });
  if (!isConfirmed) return;
  try {
    const scheduledAt = value ? new Date(value + ':00+07:00').toISOString() : null;
    const r = await fetch(`/api/agent/jobs/${id}/schedule`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ scheduledAt }),
    });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'แก้ไขไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
  }
}

async function deleteJob(id) {
  const res = await Swal.fire({ title:'ลบ Job?', icon:'warning', showCancelButton:true, confirmButtonColor:'#fa5252', confirmButtonText:'ลบ', cancelButtonText:'ยกเลิก' });
  if (!res.isConfirmed) return;
  try {
    const r = await fetch(`/api/agent/jobs/${id}`, { method:'DELETE' });
    if (!r.ok) {
      const body = await r.json().catch(() => null);
      throw new Error(body?.error || `HTTP ${r.status}`);
    }
    document.getElementById(`job_${id}`)?.remove();
    const cnt = document.querySelectorAll('[id^="job_"]').length;
    document.getElementById('jobCount').textContent = cnt;
  } catch (e) {
    Swal.fire({ icon:'error', title:'ลบไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
  }
}

refreshPosterStatus();
setInterval(refreshPosterStatus, 20000);
</script>

