<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Job Queue - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/auth-guard.js"></script>
  <script src="/js/group-notify.js"></script>
  <script src="/js/navbar-user.js"></script>
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>
    <div class="navbar-right">
      <% if (locals.currentStaff) { %>
      <div class="navbar-user">
        <div class="avatar avatar-blue avatar-xs"><%= currentStaff.name.charAt(0).toUpperCase() %></div>
        <span class="navbar-user-name"><%= currentStaff.name %></span>
        <i class="fa-solid fa-chevron-down navbar-user-caret"></i>
        <div class="navbar-user-menu">
          <form method="POST" action="/logout">
            <button type="submit" class="navbar-user-menu-item"><i class="fa-solid fa-right-from-bracket"></i> ออกจากระบบ</button>
          </form>
        </div>
      </div>
      <% } %>
    </div>

  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
    <a href="/schedule-center" class="sidebar-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <div class="sidebar-divider"></div>
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>
    <a href="/post-queue" class="sidebar-item"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/job-queue" class="sidebar-item active"><i class="fa-solid fa-list-check"></i><span>คิวโพสกลุ่ม</span></a>
    <a href="/group-overview" class="sidebar-item"><i class="fa-solid fa-chart-line" style="color:#2e7d32"></i><span>ภาพรวม</span></a>
    <a href="/group-history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพสกลุ่ม</span></a>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <div class="sidebar-divider"></div>
    <div class="sidebar-label">ระบบ</div>
    <a href="/user-activity" class="sidebar-item"><i class="fa-solid fa-user-clock"></i><span>กิจกรรมพนักงาน</span></a>
    <% if (locals.currentStaff && currentStaff.canManageStaff) { %>
    <a href="/manage-staff" class="sidebar-item"><i class="fa-solid fa-users-gear"></i><span>จัดการบัญชีผู้ใช้งาน</span></a>
    <a href="/audit-log" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติการเปลี่ยนแปลง</span></a>
    <% } %>
    <%- include('partials/sidebar-pages') %>
  </aside>

  <main class="feed">

    <!-- Agent status banner (top) -->
    <div id="agentBanner" style="display:none"></div>

    <%
    // Each group appears under its primary (first non-ทั่วไป) category, or ทั่วไป
    const jqCatMap = {};
    groups.forEach((g, i) => {
      const gcats = (g.categories && g.categories.length) ? g.categories : [g.category || 'ทั่วไป'];
      const primaryCat = gcats.find(c => c !== 'ทั่วไป') || 'ทั่วไป';
      if (!jqCatMap[primaryCat]) jqCatMap[primaryCat] = [];
      jqCatMap[primaryCat].push({ groupId: g.groupId, groupName: g.groupName, _id: String(g._id || ''), _idx: i });
    });
    const allJqSet = new Set(Object.keys(jqCatMap));
    const jqCats = [
      ...(allJqSet.has('ทั่วไป') ? ['ทั่วไป'] : []),
      ...[...allJqSet].filter(c => c !== 'ทั่วไป').sort()
    ];
    %>

    <% if (groups.length === 0) { %>
    <div class="card" style="background:linear-gradient(135deg,#e8f4ff 0%,#f0f7ff 100%);border-color:#b3d4f9;padding:1.25rem 1.5rem;text-align:center">
      <i class="fa-solid fa-robot" style="font-size:2.5rem;color:#1877f2;margin-bottom:.65rem;display:block"></i>
      <div style="font-weight:700;font-size:1rem;color:var(--text-primary);margin-bottom:.4rem">ยังไม่มีกลุ่ม Facebook</div>
      <div style="font-size:.87rem;color:var(--text-secondary);line-height:1.75;margin-bottom:1rem">
        หากต้องการโพสหรือแชร์ลงกลุ่ม Facebook<br>
        ต้องทำตามขั้นตอนนี้ก่อน:
      </div>
      <div style="display:inline-flex;flex-direction:column;gap:.5rem;text-align:left;font-size:.85rem;color:var(--text-secondary);margin-bottom:1.25rem;line-height:1.7">
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;margin-right:.4rem">1</span>ไปที่ <a href="/groups" style="color:#1877f2;font-weight:600">จัดการกลุ่ม</a> → กด "+ เพิ่มกลุ่ม" เพื่อเพิ่มกลุ่มที่ต้องการ</div>
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;margin-right:.4rem">2</span>ติดตั้ง Desktop Agent บนเครื่อง Windows — ดูวิธีที่ <a href="/agent" style="color:#1877f2;font-weight:600">หน้าติดตั้ง Agent</a></div>
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;margin-right:.4rem">3</span>เปิด Agent → Login Facebook → กลับมาสั่งโพสที่หน้านี้</div>
      </div>
      <a href="/groups" style="display:inline-flex;align-items:center;gap:.45rem;background:#1877f2;color:#fff;padding:.5rem 1.25rem;border-radius:8px;font-weight:700;font-size:.85rem;text-decoration:none">
        <i class="fa-solid fa-users-rectangle"></i> ไปเพิ่มกลุ่ม
      </a>
    </div>
    <% } else { %>

    <!-- Create Job Form -->
    <div class="card jq-compose" id="createForm">
      <div class="jq-compose-head">
        <div class="jq-compose-title"><i class="fa-solid fa-pen-to-square"></i> สร้างโพสลงกลุ่ม
          <span class="jq-compose-sub">สั่งที่นี่ เครื่องโพสหลักจะโพสให้ตามลำดับคิว</span>
        </div>
      </div>

      <div class="jq-cols">
      <div class="jq-col">

      <!-- 1. Post as -->
      <section class="jq-sec">
        <div class="jq-sec-hd">
          <span class="jq-step">1</span> โพสในนาม <span class="jq-req">*</span>
          <button type="button" id="btnRefreshPages" class="jq-link" onclick="refreshPages()" title="ให้เครื่องโพสหลักดึงรายชื่อเพจใหม่จาก Facebook"><i class="fa-solid fa-rotate"></i> อัปเดตรายชื่อ</button>
        </div>
        <input type="hidden" id="fPage" value="">
        <div id="fPageChips" class="jq-chips" role="radiogroup" aria-label="โพสในนาม"></div>
        <div id="fPageHint" class="jq-hint"></div>
      </section>

      <!-- 2. What to post -->
      <section class="jq-sec">
        <div class="jq-sec-hd">
          <span class="jq-step">2</span> โพสอะไร <span class="jq-req">*</span>
        </div>

        <div class="jq-modes" role="radiogroup" aria-label="รูปแบบโพส">
          <button type="button" class="jq-mode active" data-mode="text" onclick="setPostMode('text')">
            <i class="fa-solid fa-align-left"></i>
            <span><b>ข้อความ</b><small>ข้อความอย่างเดียว แนบรูป/วิดีโอได้</small></span>
          </button>
          <button type="button" class="jq-mode" data-mode="link" onclick="setPostMode('link')">
            <i class="fa-solid fa-link"></i>
            <span><b>ข้อความ + ลิงก์</b><small>ข้อความ พร้อมการ์ดลิงก์ด้านล่าง</small></span>
          </button>
          <button type="button" class="jq-mode" data-mode="share" onclick="setPostMode('share')">
            <i class="fa-solid fa-share"></i>
            <span><b>แชร์ลิงก์</b><small>แชร์โพส/ลิงก์ ไม่มีข้อความ</small></span>
          </button>
        </div>

        <div class="jq-toolbar">
          <button type="button" onclick="openTemplatePicker()"><i class="fa-solid fa-folder-open"></i> ใช้เทมเพลต</button>
          <button type="button" onclick="saveAsTemplate()"><i class="fa-solid fa-floppy-disk"></i> บันทึกเป็นเทมเพลต</button>
          <button type="button" onclick="openRecentPosts()"><i class="fa-solid fa-clock-rotate-left"></i> โพสก่อนหน้า</button>
          <button type="button" id="btnHowTo" onclick="togglePanel('howToPanel', this)"><i class="fa-regular fa-circle-question"></i> วิธีใช้งาน</button>
          <button type="button" id="btnTips" onclick="togglePanel('tipsPanel', this)"><i class="fa-regular fa-lightbulb"></i> เคล็ดลับ</button>
        </div>

        <div id="howToPanel" class="jq-panel" style="display:none">
          <div class="jq-panel-title">วิธีใช้งาน — เลือกรูปแบบให้ตรงกับที่อยากให้ขึ้นบน Facebook</div>
          <div class="jq-howto">
            <div><b><i class="fa-solid fa-align-left"></i> ข้อความ</b><span>พิมพ์ข้อความ แนบรูปหรือวิดีโอได้ (ไม่บังคับ) ถ้าในข้อความมีลิงก์ จะเป็นแค่ตัวอักษรลิงก์ ไม่มีการ์ดตัวอย่าง</span></div>
            <div><b><i class="fa-solid fa-link"></i> ข้อความ + ลิงก์</b><span>พิมพ์ข้อความ แล้ววางลิงก์ในช่องลิงก์ โพสจะแสดงข้อความ และการ์ดตัวอย่างลิงก์ (รูป+หัวข้อ) ด้านล่าง ตัวลิงก์ไม่ขึ้นในข้อความ · แนบรูปไม่ได้ เพราะ Facebook จะไม่แสดงการ์ดลิงก์</span></div>
            <div><b><i class="fa-solid fa-share"></i> แชร์ลิงก์</b><span>วางลิงก์โพส Facebook (เช่นโพสของเพจ) หรือเว็บไซต์ จะขึ้นเป็นการ์ดลิงก์อย่างเดียว ไม่มีข้อความ</span></div>
            <div><b><i class="fa-solid fa-flag"></i> โพสในนาม</b><span>เลือกเพจทุกครั้ง ถ้าระบบเลือกเพจนั้นไม่ได้ หรือชื่อผู้โพสไม่ตรง จะไม่โพส และแจ้งเตือนด้านบน</span></div>
            <div><b><i class="fa-solid fa-list-ol"></i> หลังกดเพิ่มลงคิว</b><span>งานเข้าคิว เครื่องโพสหลักโพสให้ทีละงาน ดูผลที่ "รายการ Jobs" ด้านล่าง หรือหน้า ประวัติโพสกลุ่ม</span></div>
          </div>
        </div>

        <div id="tipsPanel" class="jq-panel" style="display:none">
          <div class="jq-panel-title">เคล็ดลับโพสให้ปลอดภัย ไม่โดน Facebook จำกัด</div>
          <div class="jq-tips">
            <div><span class="jq-tag ok">เว้นระหว่างกลุ่ม</span>30–60 วินาที · บัญชีใหม่ 60–90 วินาที</div>
            <div><span class="jq-tag info">ต่อรอบ</span>ไม่เกิน 30–50 กลุ่ม</div>
            <div><span class="jq-tag info">ต่อวัน</span>ไม่เกิน 60 กลุ่ม แบ่งรอบ เช้า · บ่าย · เย็น</div>
            <div><span class="jq-tag warn">กลุ่มเดิม</span>เว้น 1–2 วันก่อนโพสซ้ำ</div>
            <div><span class="jq-tag warn">เนื้อหา</span>สลับรูป / คลิป / ข้อความ ไม่โพสข้อความเดิมซ้ำทุกกลุ่มทุกวัน</div>
            <div><span class="jq-tag bad">ห้าม</span>โพสทุกกลุ่มในครั้งเดียว · เว้นต่ำกว่า 15 วินาที</div>
          </div>
          <div class="jq-hint">ทุกคนโพสผ่านบัญชี Facebook เดียวกัน ยอดรวมทั้งทีมนับรวมกัน</div>
        </div>

        <div class="jq-editor" id="fTextBox">
          <textarea id="fMsg" rows="6" placeholder="พิมพ์ข้อความที่ต้องการโพส..." oninput="updateSummary()"></textarea>
          <div id="fMediaRow" class="jq-media-row">
            <label class="jq-media-add" title="เพิ่มรูปหรือวิดีโอ">
              <i class="fa-solid fa-photo-film"></i><span>รูป / วิดีโอ</span>
              <input type="file" id="fFiles" accept="image/*,video/mp4,video/quicktime,video/webm" multiple style="display:none" onchange="onPickFiles(this.files); this.value=''">
            </label>
          </div>
          <div class="jq-editor-foot"><span id="fMsgCount">0</span> ตัวอักษร</div>
        </div>

        <div id="fLinkBox" class="jq-linkbox" style="display:none">
          <label for="fLink"><i class="fa-solid fa-link"></i> ลิงก์ <span class="jq-req">*</span></label>
          <input type="url" id="fLink" placeholder="https://www.facebook.com/... หรือลิงก์เว็บไซต์" oninput="updateSummary()" autocomplete="off">
          <div class="jq-hint" id="fLinkHint"></div>
        </div>
      </section>

      </div>
      <div class="jq-col jq-col-right">
      <!-- 3. Groups -->
      <section class="jq-sec jq-sec-groups">
        <div class="jq-sec-hd">
          <span class="jq-step">3</span> เลือกกลุ่ม <span class="jq-req">*</span>
          <span id="selCount" class="jq-count-pill">ยังไม่ได้เลือก</span>
          <span style="margin-left:auto;display:flex;gap:.6rem">
            <button type="button" class="jq-link" onclick="selAll()">เลือกทั้งหมด</button>
            <button type="button" class="jq-link" onclick="selNone()">ล้าง</button>
          </span>
        </div>
        <div class="jq-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" id="fGroupSearch" placeholder="ค้นหากลุ่ม..." oninput="filterGroups(this.value)" autocomplete="off">
        </div>
        <div class="jq-group-box" id="fGroupBox">
          <% jqCats.forEach((cat, ci) => { %>
          <div class="jq-cat-hd" id="jqCatHd_<%= ci %>">
            <label class="jq-cat-label" onclick="event.stopPropagation()">
              <input type="checkbox" id="catcb_<%= ci %>" onchange="toggleCatAll(<%= ci %>, this.checked)">
              <i class="fa-solid fa-location-dot" style="color:<%- (catColorMap && catColorMap[cat]) || '#1877f2' %>"></i>
              <span class="jq-cat-name"><%= cat %></span>
              <span class="jq-cat-count" id="catcount_<%= ci %>">0/<%= jqCatMap[cat].length %></span>
            </label>
            <button type="button" class="jq-cat-toggle" onclick="toggleJqCat(<%= ci %>)" title="ยุบ/ขยาย" aria-label="ยุบ/ขยาย <%= cat %>">
              <i class="fa-solid fa-chevron-down" id="jqChev_<%= ci %>" style="transform:rotate(-90deg)"></i>
            </button>
          </div>
          <div id="jqCatBody_<%= ci %>" style="display:none">
            <% jqCatMap[cat].forEach(g => { %>
            <label class="jq-group-row" id="glabel_<%= g._idx %>" data-name="<%= (g.groupName || '').toLowerCase() %>">
              <input type="checkbox" id="gc_<%= g._idx %>" value="<%= g._idx %>" data-cat="<%= ci %>" onchange="onGroupCbChange(<%= ci %>)">
              <span class="jq-group-name"><%= g.groupName %></span>
            </label>
            <% }); %>
          </div>
          <% }); %>
          <div id="fGroupEmpty" class="jq-hint" style="display:none;padding:.8rem;text-align:center">ไม่พบกลุ่มที่ค้นหา</div>
        </div>
      </section>

      <!-- 4. When + spacing -->
      <section class="jq-sec jq-sec-last">
        <div class="jq-sec-hd"><span class="jq-step">4</span> เวลาโพส</div>
        <div class="jq-when">
          <div class="jq-seg" role="radiogroup" aria-label="เวลาโพส">
            <button type="button" id="whenNow" class="active" onclick="setWhen('now')"><i class="fa-solid fa-bolt"></i> โพสทันที</button>
            <button type="button" id="whenLater" onclick="setWhen('later')"><i class="fa-regular fa-clock"></i> ตั้งเวลา</button>
          </div>
          <div id="whenPicker" class="jq-when-picker" style="display:none">
            <div class="dt24-wrap">
              <input type="date" lang="en-GB" id="fScheduledAt_d" onchange="updateSummary()">
              <input type="number" id="fScheduledAt_h" min="0" max="23" placeholder="ชม." oninput="updateSummary()">
              <span>:</span>
              <input type="number" id="fScheduledAt_m" min="0" max="59" placeholder="นาที" oninput="updateSummary()">
            </div>
            <div class="jq-quick">
              <button type="button" onclick="dtQuick('fScheduledAt',60); updateSummary()">+1 ชม.</button>
              <button type="button" onclick="dtQuick('fScheduledAt',180); updateSummary()">+3 ชม.</button>
              <button type="button" onclick="setTomorrow(9); updateSummary()">พรุ่งนี้ 09:00</button>
              <button type="button" onclick="setTomorrow(18); updateSummary()">พรุ่งนี้ 18:00</button>
            </div>
          </div>
          <div class="jq-delay">
            <label for="fDelay">เว้นระหว่างกลุ่ม</label>
            <input type="number" id="fDelay" value="30" min="10" max="120" oninput="updateSummary()"> วินาที
            <span class="jq-hint" style="margin:0">(แนะนำ 30–60)</span>
          </div>
        </div>
      </section>

      <!-- Summary + submit -->
      <div class="jq-submit-bar">
        <div id="fSummary" class="jq-summary">เลือกเพจ ใส่ข้อความ และเลือกกลุ่ม</div>
        <button id="btnSubmitJob" class="btn-post jq-submit" onclick="submitJob()">
          <i class="fa-solid fa-paper-plane"></i> เพิ่มลงคิว
        </button>
      </div>
      </div>
      </div>
    </div>

    <!-- Jobs list -->
    <div class="card">
      <div class="card-title">
        <i class="fa-solid fa-clock-rotate-left"></i> รายการ Jobs <span class="jq-jobcount" id="jobCount"><%= jobTotal %></span>
        <% const schedCount = jobs.filter(j => j.status==='pending' && j.scheduledAt).length; %>
        <button id="btnSchedFilter" onclick="toggleSchedFilter()"
          style="margin-left:.6rem;background:#fff3cd;border:1px solid #ffe08a;border-radius:7px;padding:.18rem .55rem;font-size:.78rem;font-weight:600;color:#856404;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-clock"></i> ตั้งเวลาไว้ (<%= schedCount %>)
        </button>
        <button id="btnJqTimelineView" onclick="toggleJqTimelineView()"
          style="margin-left:.4rem;background:#fff3cd;border:1px solid #ffe08a;border-radius:7px;padding:.18rem .55rem;font-size:.78rem;font-weight:600;color:#856404;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-calendar-days"></i> ปฏิทิน
        </button>
        <button id="jqNewJobs" class="btn-link-sm" style="display:none;margin-left:auto;font-weight:700" onclick="location.reload()"><i class="fa-solid fa-circle-plus"></i> มีงานใหม่ในคิว กดเพื่อแสดง</button>
        <button class="btn-link-sm" style="margin-left:.5rem" onclick="location.reload()"><i class="fa-solid fa-rotate-right"></i> รีเฟรช</button>
      </div>

      <!-- Bulk reschedule bar — shown only while "ตั้งเวลาไว้" filter is active and rows selected -->
      <div id="jqBulkBar" style="display:none;align-items:center;gap:.5rem;flex-wrap:wrap;padding:.5rem .65rem;border-bottom:1px solid var(--border-color)">
        <span style="font-size:.8rem;color:#856404;font-weight:600">
          <i class="fa-solid fa-clock"></i> เลือกแล้ว <strong id="jqSelCount">0</strong> รายการ
        </span>
        <button onclick="bulkRescheduleJobs()"
          style="background:#856404;color:#fff;border:none;border-radius:7px;padding:.32rem .7rem;font-size:.79rem;font-weight:600;cursor:pointer;font-family:inherit">
          <i class="fa-solid fa-clock-rotate-left"></i> เลื่อนเวลาทั้งหมด
        </button>
        <button onclick="clearJqSelection()"
          style="background:#f0f2f5;border:none;border-radius:7px;padding:.32rem .7rem;font-size:.79rem;cursor:pointer;color:#65676b;font-family:inherit">
          ล้างที่เลือก
        </button>
      </div>

      <div id="jqTimelineView" style="display:none;padding:1rem .85rem;overflow-x:auto"></div>

      <% if (jobs.length === 0) { %>
      <div style="color:var(--text-secondary);text-align:center;padding:1.5rem;font-size:.9rem">ยังไม่มี Job</div>
      <% } else { %>
      <% const icons = { pending:'⏳', running:'🔄', success:'✅', failed:'❌', expired:'⏰', cancelled:'🚫' }; %>
      <% const statusTH = { pending:'รอ', running:'กำลังทำ', success:'เสร็จ', failed:'ล้มเหลว', expired:'หมดเวลา', cancelled:'ยกเลิก' }; %>
      <% const statusCls = { pending:'badge-yellow', running:'badge-blue', success:'badge-green', failed:'badge-red', expired:'badge-red', cancelled:'badge-red' }; %>
      <% jobs.forEach((j, idx) => {
           // parse display text — strip |||URL
           let dispMsg = j.message||'';
           let modeTag = '';
           if (dispMsg.includes('|||')) {
             const sep = dispMsg.indexOf('|||');
             const txt = dispMsg.slice(0,sep).trim();
             const url = dispMsg.slice(sep+3).trim();
             if (txt) { dispMsg = txt; modeTag = '🔗 ลิงก์'; }
             else { dispMsg = url.length>55?url.slice(0,55)+'…':url; modeTag = '↗ แชร์'; }
           }
           if (dispMsg.length>70) dispMsg = dispMsg.slice(0,70)+'…';
      %>
      <div style="display:flex;align-items:flex-start;gap:.7rem;padding:.65rem .5rem;border-bottom:1px solid var(--border-color)"
           id="job_<%= j._id %>" class="job-row" data-idx="<%= idx %>" data-scheduled="<%= (j.status==='pending' && j.scheduledAt) ? '1' : '0' %>" data-status="<%= j.status %>">
        <span style="font-size:1.2rem;flex-shrink:0;margin-top:.1rem"><%= icons[j.status]||'❓' %></span>
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
            <% if(modeTag){ %><span style="font-size:.7rem;font-weight:700;background:#e7f3ff;color:#1877f2;border-radius:4px;padding:.05rem .4rem;margin-right:.3rem"><%= modeTag %></span><% } %><%= dispMsg %>
          </div>
          <div style="font-size:.78rem;color:var(--text-secondary);margin-top:.2rem">
            <i class="fa-solid fa-user" style="font-size:.68rem"></i> <strong><%= (j.staffId && staffNameMap[String(j.staffId)]) || 'ไม่ระบุผู้สั่ง' %></strong> ·
            <% if (j.postAsPage) { %><i class="fa-solid fa-flag" style="font-size:.68rem"></i> <%= j.postAsPage %> · <% } %>
            <% if ((j.images||[]).length) { %><i class="fa-solid fa-image" style="font-size:.68rem"></i> <%= j.images.length %> · <% } %>
            <%= j.groupCount %> กลุ่ม · เว้น <%= j.delaySeconds %>s ·
            <%= new Date(j.createdAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',hour12:false,dateStyle:'short',timeStyle:'short'}) %>
            <% if (j.scheduledAt) { %>
            · <span style="color:#856404;font-weight:600"><i class="fa-solid fa-clock" style="font-size:.7rem"></i> โพส <%= new Date(j.scheduledAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',hour12:false,dateStyle:'short',timeStyle:'short'}) %></span>
            <% } %>
            <% if (j.status==='success'||j.status==='failed') { %>
            · <strong><%= j.okCount %>/<%= j.groupCount %></strong> สำเร็จ
            <% } %>
            <span class="jq-row-prog"></span>
          </div>
        </div>
        <span class="badge <%= statusCls[j.status]||'' %>" style="flex-shrink:0"><%= statusTH[j.status]||j.status %></span>
        <% if (j.status === 'pending' || j.status === 'expired') { %>
        <% if (j.scheduledAt) { %>
        <input type="checkbox" class="jqSelCb" data-id="<%= j._id %>" onchange="updateJqSelection()"
          style="accent-color:#856404;cursor:pointer;width:16px;height:16px" title="เลือกเพื่อเลื่อนเวลาทั้งหมด">
        <% } %>
        <button onclick="rescheduleJob('<%= j._id %>', '<%= j.scheduledAt || '' %>')"
          style="background:none;border:none;cursor:pointer;color:#856404;font-size:.85rem;padding:.1rem .3rem;border-radius:4px" title="แก้ไขเวลาโพส">
          <i class="fa-solid fa-clock"></i>
        </button>
        <% } %>
        <button onclick="deleteJob('<%= j._id %>')" style="background:none;border:none;cursor:pointer;color:#c5c8d0;font-size:1rem;padding:.1rem .3rem;border-radius:4px" title="ลบ">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
      <% }); %>
      <% if (jobs.length > 20) { %>
      <div id="showMoreRow" style="padding:.65rem;text-align:center">
        <button onclick="showMoreJobs()" style="background:#f0f2f5;border:none;border-radius:8px;padding:.45rem 1.1rem;font-size:.85rem;cursor:pointer;font-family:inherit;color:#1877f2;font-weight:600">
          เพิ่มเติม (<%= jobs.length-20 %> รายการ)
        </button>
      </div>
      <% } %>
      <% if (!showingAll && jobTotal > jobs.length) { %>
      <div style="padding:.65rem;text-align:center">
        <a href="/job-queue?all=1" style="display:inline-block;background:#f0f2f5;border-radius:8px;padding:.45rem 1.1rem;font-size:.85rem;font-family:inherit;color:#1877f2;font-weight:600;text-decoration:none">
          ดูทั้งหมด (<%= jobTotal %> รายการ)
        </a>
      </div>
      <% } %>
      <% } %>
    </div>

    <% } %>

  </main>
</div>

<style>
.form-label { display:block; font-size:.8rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:.04em; margin-bottom:.3rem }
.btn-link-sm { background:none; border:none; color:#1877f2; font-size:.8rem; cursor:pointer; font-family:inherit; padding:0 .3rem }
.btn-link-sm:hover { text-decoration:underline }
.badge-yellow { background:#fff3cd; color:#856404 }
.badge-blue   { background:#cfe2ff; color:#084298 }
.badge-green  { background:#d1e7dd; color:#0a3622 }
.badge-red    { background:#f8d7da; color:#842029 }

/* The site stylesheet never defines these, so every var() below (and the
   older rules on this page) resolved to nothing — no borders, default text. */
:root { --border-color:#dddfe2; --text-primary:#1c1e21; --text-secondary:#65676b }

/* Live status banner */
.jq-live { padding:.7rem 1.1rem; display:flex; flex-direction:column; gap:.5rem }
.jq-live-top { display:flex; align-items:center; gap:.75rem; flex-wrap:wrap }
.jq-live-counts { font-size:.8rem; font-weight:600; white-space:nowrap; font-variant-numeric:tabular-nums }
.jq-live-stamp { font-weight:400; opacity:.8 }
.jq-live-job { background:rgba(255,255,255,.65); border-radius:10px; padding:.5rem .7rem }
.jq-live-line { display:flex; justify-content:space-between; gap:.6rem; flex-wrap:wrap; font-size:.84rem }
.jq-live-num { font-weight:700; font-variant-numeric:tabular-nums; white-space:nowrap }
.jq-live-bar { height:8px; background:rgba(11,61,145,.15); border-radius:999px; overflow:hidden; margin:.35rem 0 }
.jq-live-bar > div { height:100%; background:#1877f2; border-radius:999px; transition:width .6s ease }
.jq-live-sub { font-size:.76rem; opacity:.85; white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
.jq-live-next { font-size:.8rem; display:flex; align-items:center; gap:.35rem; flex-wrap:wrap }
.jq-live-chip { background:rgba(255,255,255,.7); border-radius:999px; padding:.1rem .6rem; font-size:.76rem }
.jq-live-more { font-size:.76rem; opacity:.8 }
@media (prefers-reduced-motion: reduce) { .jq-live-bar > div { transition:none } .fa-spin { animation:none } }

/* Create-job composer */
.jq-compose { padding:0; overflow:hidden }
.jq-compose-head { padding:1rem 1.25rem .85rem; border-bottom:1px solid var(--border-color); background:linear-gradient(180deg,#f7faff,#fff) }
.jq-compose-title { font-weight:700; font-size:1.05rem; color:var(--text-primary); display:flex; align-items:center; gap:.5rem }
.jq-compose-title i { color:#1877f2 }
.jq-compose-sub { font-size:.8rem; color:var(--text-secondary); margin-top:.15rem }
.jq-sec { padding:.95rem 1.25rem; border-bottom:1px solid var(--border-color) }
.jq-sec-last { border-bottom:none }
.jq-sec-hd { display:flex; align-items:center; gap:.45rem; font-weight:700; font-size:.9rem; color:var(--text-primary); margin-bottom:.6rem; flex-wrap:wrap }
.jq-step { width:22px; height:22px; border-radius:50%; background:#e7f0fd; color:#1877f2; font-size:.75rem; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0 }
.jq-req { color:#fa5252 }
.jq-link { margin-left:auto; background:none; border:none; color:#1877f2; font-size:.8rem; font-weight:600; cursor:pointer; font-family:inherit; padding:.15rem .3rem; border-radius:6px }
.jq-sec-hd span .jq-link { margin-left:0 }
.jq-link:hover { background:#f0f6ff }
.jq-link:disabled { opacity:.5; cursor:default }
.jq-link:focus-visible, .jq-chip:focus-visible, .jq-seg button:focus-visible, .jq-quick button:focus-visible { outline:2px solid #1877f2; outline-offset:2px }
.jq-hint { font-size:.76rem; color:var(--text-secondary); margin-top:.4rem }
.jq-chips { display:flex; flex-wrap:wrap; gap:.45rem }
.jq-chip { border:1.5px solid var(--border-color); background:#fff; color:var(--text-primary); border-radius:999px; padding:.36rem .85rem .36rem .4rem; font-size:.82rem; font-family:inherit; cursor:pointer; display:inline-flex; align-items:center; gap:.4rem; max-width:100%; text-align:left; transition:background .12s,border-color .12s }
.jq-chip:hover { border-color:#9ec5fb; background:#f5f9ff }
.jq-chip-av { width:22px; height:22px; border-radius:50%; background:#e4e6ea; color:#444; font-size:.7rem; font-weight:700; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0 }
.jq-chip.active { background:#1877f2; border-color:#1877f2; color:#fff; font-weight:600 }
.jq-chip.active .jq-chip-av { background:rgba(255,255,255,.25); color:#fff }
.jq-chip-empty { font-size:.82rem; color:var(--text-secondary); padding:.3rem 0 }
.jq-modes { display:grid; grid-template-columns:repeat(3,1fr); gap:.5rem; margin-bottom:.6rem }
.jq-mode { display:flex; align-items:flex-start; gap:.55rem; text-align:left; border:1.5px solid var(--border-color); background:#fff; border-radius:12px; padding:.6rem .7rem; cursor:pointer; font-family:inherit; color:var(--text-primary); transition:border-color .12s,background .12s }
.jq-mode:hover { border-color:#9ec5fb; background:#f5f9ff }
.jq-mode i { color:#8a8d91; font-size:.95rem; margin-top:.15rem; width:1.1rem; text-align:center; flex-shrink:0 }
.jq-mode b { display:block; font-size:.86rem }
.jq-mode small { display:block; font-size:.72rem; color:var(--text-secondary); line-height:1.35; margin-top:.1rem }
.jq-mode.active { border-color:#1877f2; background:#eef5ff }
.jq-mode.active i { color:#1877f2 }
.jq-mode:focus-visible, .jq-toolbar button:focus-visible { outline:2px solid #1877f2; outline-offset:2px }
.jq-toolbar { display:flex; flex-wrap:wrap; gap:.4rem; margin-bottom:.6rem }
.jq-toolbar button { border:1px solid var(--border-color); background:#fff; border-radius:999px; padding:.3rem .8rem; font-size:.78rem; font-family:inherit; cursor:pointer; color:#333; display:inline-flex; align-items:center; gap:.35rem }
.jq-toolbar button:hover { background:#f0f2f5 }
.jq-toolbar button.active { background:#e7f0fd; border-color:#9ec5fb; color:#1877f2; font-weight:600 }
.jq-panel { border:1px solid var(--border-color); background:#fafbfc; border-radius:12px; padding:.75rem .9rem; margin-bottom:.6rem; font-size:.82rem; line-height:1.6 }
.jq-panel-title { font-weight:700; margin-bottom:.45rem; color:var(--text-primary) }
.jq-howto > div { display:grid; grid-template-columns:150px 1fr; gap:.6rem; padding:.3rem 0; border-top:1px solid #eceef1 }
.jq-howto > div:first-child { border-top:none }
.jq-howto b { font-size:.8rem; color:var(--text-primary) }
.jq-howto b i { color:#1877f2; width:1.1rem }
.jq-howto span { color:var(--text-secondary) }
.jq-tips { display:grid; grid-template-columns:1fr 1fr; gap:.3rem .9rem; color:var(--text-secondary) }
.jq-tag { display:inline-block; font-size:.7rem; font-weight:700; border-radius:5px; padding:0 .4rem; margin-right:.35rem }
.jq-tag.ok { background:#d1e7dd; color:#0a3622 } .jq-tag.info { background:#e7f0fd; color:#084298 }
.jq-tag.warn { background:#fff3cd; color:#856404 } .jq-tag.bad { background:#f8d7da; color:#842029 }
.jq-linkbox { margin-top:.6rem }
.jq-linkbox label { display:block; font-size:.82rem; font-weight:700; margin-bottom:.3rem; color:var(--text-primary) }
.jq-linkbox label i { color:#1877f2 }
.jq-linkbox input { width:100%; box-sizing:border-box; padding:.55rem .8rem; border:1.5px solid var(--border-color); border-radius:10px; font-family:inherit; font-size:.9rem; outline:none }
.jq-linkbox input:focus { border-color:#1877f2 }
.jq-linkbox input.bad { border-color:#fa5252 }
.jq-recent-item { display:block; width:100%; text-align:left; background:#fff; border:1px solid var(--border-color); border-radius:8px; padding:.5rem .65rem; margin-bottom:.4rem; cursor:pointer; font-family:inherit }
.jq-recent-item:hover { background:#f0f6ff; border-color:#b3d4f9 }
@media (max-width: 640px) {
  .jq-modes { grid-template-columns:1fr }
  .jq-howto > div { grid-template-columns:1fr; gap:.1rem }
  .jq-tips { grid-template-columns:1fr }
}
.jq-editor { border:1.5px solid var(--border-color); border-radius:12px; overflow:hidden; transition:border-color .12s }
.jq-editor:focus-within { border-color:#1877f2 }
.jq-editor textarea { width:100%; border:none; outline:none; resize:vertical; min-height:130px; padding:.8rem .9rem; font-size:.95rem; line-height:1.6; font-family:inherit; display:block; box-sizing:border-box }
.jq-editor .jq-media-row { padding:.2rem .9rem .75rem }
.jq-editor-foot { font-size:.72rem; color:var(--text-secondary); text-align:right; padding:.35rem .9rem; border-top:1px solid var(--border-color); background:#fafbfc; font-variant-numeric:tabular-nums }
.jq-media-row { display:flex; flex-wrap:wrap; gap:.5rem }
.jq-media-add { width:88px; height:88px; border:1.5px dashed #b3d4f9; border-radius:10px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.3rem; cursor:pointer; color:#1877f2; font-size:.74rem; font-weight:600; background:#f7faff }
.jq-media-add:hover { background:#eaf3ff }
.jq-media-add i { font-size:1.25rem }
.jq-thumb { position:relative; width:88px; height:88px; border-radius:10px; overflow:hidden; background:#f0f2f5; border:1px solid var(--border-color) }
.jq-thumb img, .jq-thumb video { width:100%; height:100%; object-fit:cover; display:block }
.jq-thumb .jq-thumb-x { position:absolute; top:4px; right:4px; width:22px; height:22px; border:none; border-radius:50%; background:rgba(0,0,0,.6); color:#fff; cursor:pointer; font-size:.72rem; line-height:22px; padding:0 }
.jq-thumb .jq-thumb-state { position:absolute; inset:auto 0 0 0; background:rgba(0,0,0,.6); color:#fff; font-size:.66rem; text-align:center; padding:.12rem 0 }
.jq-thumb.err { border:2px solid #fa5252 }
.jq-count-pill { font-size:.74rem; font-weight:700; background:#f0f2f5; color:var(--text-secondary); border-radius:999px; padding:.12rem .55rem }
.jq-count-pill.on { background:#e7f0fd; color:#1877f2 }
.jq-search { position:relative; margin-bottom:.5rem }
.jq-search i { position:absolute; left:.75rem; top:50%; transform:translateY(-50%); color:#8a8d91; font-size:.8rem }
.jq-search input { width:100%; box-sizing:border-box; padding:.5rem .75rem .5rem 2.1rem; border:1.5px solid var(--border-color); border-radius:10px; font-family:inherit; font-size:.86rem; outline:none }
.jq-search input:focus { border-color:#1877f2 }
.jq-group-box { border:1.5px solid var(--border-color); border-radius:12px; max-height:340px; overflow-y:auto }
.jq-cat-label { display:flex; align-items:center; gap:.5rem; flex:1; cursor:pointer; min-width:0 }
.jq-cat-label input, .jq-group-row input { accent-color:#1877f2; width:16px; height:16px; cursor:pointer; flex-shrink:0 }
.jq-cat-label i { font-size:.78rem; flex-shrink:0 }
.jq-cat-name { font-weight:700; font-size:.86rem; flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
.jq-cat-count { font-size:.74rem; color:var(--text-secondary); white-space:nowrap; font-variant-numeric:tabular-nums }
.jq-cat-toggle { background:none; border:none; cursor:pointer; color:#8a8d91; padding:.25rem .45rem; flex-shrink:0; border-radius:6px }
.jq-cat-toggle:hover { background:#e4e6ea }
.jq-cat-toggle i { font-size:.75rem; transition:transform .2s }
.jq-group-name { flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:.86rem }
.jq-when { display:flex; flex-direction:column; gap:.7rem }
.jq-seg { display:inline-flex; background:#f0f2f5; border-radius:10px; padding:3px; align-self:flex-start }
.jq-seg button { border:none; background:none; padding:.42rem .95rem; border-radius:8px; font-family:inherit; font-size:.84rem; font-weight:600; color:var(--text-secondary); cursor:pointer; display:inline-flex; align-items:center; gap:.4rem }
.jq-seg button.active { background:#fff; color:#1877f2; box-shadow:0 1px 3px rgba(0,0,0,.12) }
.jq-when-picker { display:flex; flex-direction:column; gap:.5rem }
.jq-quick { display:flex; flex-wrap:wrap; gap:.35rem }
.jq-quick button { background:#f0f2f5; border:none; border-radius:999px; padding:.3rem .75rem; font-size:.78rem; font-family:inherit; cursor:pointer; color:#333 }
.jq-quick button:hover { background:#e4e6ea }
.jq-delay { display:flex; align-items:center; gap:.45rem; font-size:.84rem; color:var(--text-primary); flex-wrap:wrap }
.jq-delay label { font-weight:600 }
.jq-delay input { width:72px; padding:.35rem .5rem; border:1.5px solid var(--border-color); border-radius:8px; font-family:inherit; text-align:center }
.jq-submit-bar { position:sticky; bottom:0; display:flex; align-items:center; gap:.9rem; padding:.85rem 1.25rem; background:#fff; border-top:1px solid var(--border-color); box-shadow:0 -4px 12px rgba(0,0,0,.04); flex-wrap:wrap; z-index:2 }
.jq-summary { flex:1; min-width:200px; font-size:.84rem; color:var(--text-secondary); line-height:1.5 }
.jq-summary b { color:var(--text-primary) }
.jq-summary .warn { color:#c62828 }
.jq-submit { font-size:.92rem !important; padding:.6rem 1.4rem !important; border-radius:10px !important }
.jq-submit:disabled { opacity:.6; cursor:default }
.jq-tpl-item { display:block; width:100%; text-align:left; background:#fff; border:1px solid var(--border-color); border-radius:8px; padding:.5rem .65rem; margin-bottom:.4rem; cursor:pointer; font-family:inherit }
.jq-tpl-item:hover { background:#f0f6ff; border-color:#b3d4f9 }
.jq-tpl-row { display:flex; gap:.4rem; align-items:stretch; margin-bottom:.4rem }
.jq-tpl-row .jq-tpl-item { margin-bottom:0; flex:1; min-width:0 }
.jq-tpl-del { border:1px solid var(--border-color); background:#fff; border-radius:8px; color:#c5c8d0; cursor:pointer; padding:0 .7rem; flex-shrink:0 }
.jq-tpl-del:hover { color:#c62828; border-color:#f5b5b5; background:#fff5f5 }
.jq-tpl-tab { border:1px solid var(--border-color); background:#fff; border-radius:999px; padding:.2rem .65rem; font-size:.76rem; font-family:inherit; cursor:pointer; color:#444 }
.jq-tpl-tab.on { background:#1877f2; border-color:#1877f2; color:#fff; font-weight:600 }
@media (max-width: 640px) {
  .jq-sec, .jq-compose-head, .jq-submit-bar { padding-left:.85rem; padding-right:.85rem }
  .jq-submit { width:100% }
}

/* One-screen layout: wide page, composer in two columns (what to post |
   where and when), so posting needs no scrolling on a desktop screen. */
.jq-jobcount { background:#e4e6ea; padding:.1rem .5rem; border-radius:999px; font-size:.76rem; margin-left:.3rem }
.jq-compose-head { padding:.6rem 1.1rem }
.jq-compose-title { flex-wrap:wrap }
.jq-compose-sub { font-weight:400; margin:0 0 0 .35rem }
.jq-sec { padding:.7rem 1.1rem }
.jq-sec-hd { margin-bottom:.45rem }
.jq-chips { gap:.35rem }
.jq-chip { padding:.24rem .7rem .24rem .3rem; font-size:.78rem }
.jq-chip-av { width:20px; height:20px; font-size:.66rem }
.jq-hint { margin-top:.3rem }
.jq-modes { margin-bottom:.45rem; gap:.4rem }
.jq-mode { padding:.45rem .6rem; border-radius:10px }
.jq-mode small { font-size:.7rem }
.jq-toolbar { margin-bottom:.45rem; gap:.3rem }
