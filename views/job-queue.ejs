  width:1.6rem;flex-shrink:0;
  border-left:2px solid #dde1e7;
  height:1.6rem;margin-left:.9rem
}
</style>

<script>
function dt24Get(prefix) {
  const d = document.getElementById(prefix+'_d')?.value;
  if (!d) return '';
  const h = String(document.getElementById(prefix+'_h').value||0).padStart(2,'0');
  const m = String(document.getElementById(prefix+'_m').value||0).padStart(2,'0');
  return `${d}T${h}:${m}`;
}
function _fpSetDate(el, dateStr) {
  if (!el) return;
  if (el._flatpickr) el._flatpickr.setDate(dateStr || null, false);
  else el.value = dateStr || '';
}
function dt24Set(prefix, localStr) {
  const [d,t] = (localStr||'').split('T');
  _fpSetDate(document.getElementById(prefix+'_d'), d);
  const [h,m] = (t||'').split(':');
  document.getElementById(prefix+'_h').value = h||'';
  document.getElementById(prefix+'_m').value = m||'';
}
function dtQuick(prefix, minutes) {
  const dEl = document.getElementById(prefix+'_d');
  const hEl = document.getElementById(prefix+'_h');
  const mEl = document.getElementById(prefix+'_m');
  if (!dEl) return;
  let base;
  if (dEl.value) {
    const h = parseInt(hEl.value)||0, m = parseInt(mEl.value)||0;
    base = new Date(`${dEl.value}T${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:00+07:00`);
  } else {
    base = new Date(); base.setSeconds(0,0);
  }
  base.setMinutes(base.getMinutes() + minutes);
  const bkk = new Date(base.toLocaleString('en-US', { timeZone:'Asia/Bangkok' }));
  const pad  = n => String(n).padStart(2,'0');
  _fpSetDate(dEl, `${bkk.getFullYear()}-${pad(bkk.getMonth()+1)}-${pad(bkk.getDate())}`);
  hEl.value = bkk.getHours();
  mEl.value = bkk.getMinutes();
}
function dtToday(prefix) {
  const bkk = new Date(new Date().toLocaleString('en-US', { timeZone:'Asia/Bangkok' }));
  const pad  = n => String(n).padStart(2,'0');
  _fpSetDate(document.getElementById(prefix+'_d'), `${bkk.getFullYear()}-${pad(bkk.getMonth()+1)}-${pad(bkk.getDate())}`);
  document.getElementById(prefix+'_h').value = bkk.getHours();
  document.getElementById(prefix+'_m').value = bkk.getMinutes();
}

const _groups = <%- JSON.stringify(groups) %>;
// Map: category index -> array of group indices in _groups
const _catIdxMap = <%- JSON.stringify(Object.fromEntries(jqCats.map((cat, ci) => [ci, jqCatMap[cat].map(g => g._idx)]))) %>;
const _jqScheduled = <%- JSON.stringify(jobs.filter(j => j.status==='pending' && j.scheduledAt).map(j => ({ id: j._id, msg: j.message, at: j.scheduledAt }))) %>;
let _visibleJobs = 20;

// Hide jobs beyond 20 on load
document.querySelectorAll('.job-row').forEach(r => {
  if (parseInt(r.dataset.idx) >= _visibleJobs) r.style.display = 'none';
});

// Deep-link support, e.g. /job-queue?status=expired from the "หมดเวลา"
// reminder modal on the compose page — shows only the items that need
// attention instead of the full unfiltered queue.
if (new URLSearchParams(location.search).get('status') === 'expired') {
  document.querySelectorAll('.job-row').forEach(r => {
    r.style.display = r.dataset.status === 'expired' ? 'flex' : 'none';
  });
  const moreRow = document.getElementById('showMoreRow');
  if (moreRow) moreRow.style.display = 'none';
}

function showMoreJobs() {
  _visibleJobs += 20;
  document.querySelectorAll('.job-row').forEach(r => {
    if (parseInt(r.dataset.idx) < _visibleJobs) r.style.display = 'flex';
  });
  const btn = document.getElementById('showMoreRow');
  const remaining = document.querySelectorAll('.job-row[style*="display: none"], .job-row[style*="display:none"]').length;
  if (remaining === 0 && btn) btn.style.display = 'none';
}

/* ── "ตั้งเวลาไว้" filter ── */
let _schedFilterActive = false;

function toggleSchedFilter() {
  _schedFilterActive = !_schedFilterActive;
  const btn = document.getElementById('btnSchedFilter');
  const moreRow = document.getElementById('showMoreRow');
  if (_schedFilterActive) {
    if (btn) { btn.style.background = '#856404'; btn.style.color = '#fff'; }
    if (moreRow) moreRow.style.display = 'none';
    document.querySelectorAll('.job-row').forEach(r => {
      r.style.display = r.dataset.scheduled === '1' ? 'flex' : 'none';
    });
  } else {
    if (btn) { btn.style.background = '#fff3cd'; btn.style.color = '#856404'; }
    document.querySelectorAll('.job-row').forEach(r => {
      r.style.display = parseInt(r.dataset.idx) < _visibleJobs ? 'flex' : 'none';
    });
    if (moreRow) moreRow.style.display = '';
  }
  updateJqSelection();
}

let _jqTimelineOn = false;
function toggleJqTimelineView() {
  _jqTimelineOn = !_jqTimelineOn;
  const view = document.getElementById('jqTimelineView');
  const btn  = document.getElementById('btnJqTimelineView');
  document.querySelectorAll('.job-row').forEach(r => { if (_jqTimelineOn) r.style.display = 'none'; });
  const moreRow = document.getElementById('showMoreRow');
  if (_jqTimelineOn) {
    renderJobQueueTimeline();
    view.style.display = '';
    btn.style.background = '#856404'; btn.style.color = '#fff';
    if (moreRow) moreRow.style.display = 'none';
  } else {
    view.style.display = 'none';
    btn.style.background = '#fff3cd'; btn.style.color = '#856404';
    if (_schedFilterActive) {
      document.querySelectorAll('.job-row').forEach(r => {
        r.style.display = r.dataset.scheduled === '1' ? 'flex' : 'none';
      });
    } else {
      document.querySelectorAll('.job-row').forEach(r => {
        r.style.display = parseInt(r.dataset.idx) < _visibleJobs ? 'flex' : 'none';
      });
      if (moreRow) moreRow.style.display = '';
    }
  }
  updateJqSelection();
}

function renderJobQueueTimeline() {
  const view = document.getElementById('jqTimelineView');
  const items = _jqScheduled;
  if (!items.length) {
    view.innerHTML = '<div style="text-align:center;padding:2rem;color:#8a8d91">ไม่มีงานที่ตั้งเวลาไว้</div>';
    return;
  }
  const byDate = {};
  items.forEach(j => {
    const d = new Date(j.at);
    const key = d.toLocaleDateString('en-CA');
    (byDate[key] = byDate[key] || []).push(j);
  });
  const now = new Date();
  const hourLines = [0, 4, 8, 12, 16, 20];
  const cols = Object.keys(byDate).sort().map(key => {
    const d = new Date(key + 'T00:00:00');
    const label = d.toLocaleDateString('th-TH', { weekday: 'short', day: 'numeric', month: 'short' });
    const chips = byDate[key].map(j => {
      const t = new Date(j.at);
      const top = ((t.getHours() + t.getMinutes() / 60) / 24 * 100).toFixed(2);
      const overdue = t < now;
      const time = t.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', hour12: false });
      const msg = (j.msg || '').slice(0, 30).replace(/'/g, '&#39;');
      return `<div onclick="rescheduleJob('${j.id}','${j.at}')" title="${time} — ${msg}"
        style="position:absolute;left:4px;right:4px;top:${top}%;background:${overdue ? '#fde8e8' : '#fff3cd'};color:${overdue ? '#c62828' : '#856404'};border:1px solid ${overdue ? '#f5b5b5' : '#ffe08a'};border-radius:5px;padding:.15rem .35rem;font-size:.68rem;font-weight:600;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:140px;z-index:1">
        ${overdue ? '⚠️' : '⏰'} ${time} ${msg}</div>`;
    }).join('');
    const lines = hourLines.map(h => `<div style="position:absolute;left:0;right:0;top:${(h/24*100).toFixed(2)}%;border-top:1px dashed #eee;font-size:.62rem;color:#bbb;padding-left:2px">${String(h).padStart(2,'0')}:00</div>`).join('');
    return `<div style="flex:0 0 150px;min-width:150px">
      <div style="font-size:.78rem;font-weight:700;color:#444;text-align:center;margin-bottom:.4rem">${label}</div>
      <div style="position:relative;height:360px;background:#fafbfc;border:1px solid #eee;border-radius:8px">${lines}${chips}</div>
    </div>`;
  }).join('');
  view.innerHTML = `<div style="display:flex;gap:.6rem">${cols}</div>`;
}

function updateJqSelection() {
  const checked = [...document.querySelectorAll('.jqSelCb')].filter(cb => cb.checked && cb.closest('.job-row').style.display !== 'none');
  const bar = document.getElementById('jqBulkBar');
  if (bar) bar.style.display = checked.length ? 'flex' : 'none';
  const cnt = document.getElementById('jqSelCount');
  if (cnt) cnt.textContent = checked.length;
}

function clearJqSelection() {
  document.querySelectorAll('.jqSelCb').forEach(cb => cb.checked = false);
  updateJqSelection();
}

async function bulkRescheduleJobs() {
  const ids = [...document.querySelectorAll('.jqSelCb')].filter(cb => cb.checked).map(cb => cb.dataset.id);
  if (!ids.length) return;
  const { value, isConfirmed } = await Swal.fire({
    title: `<i class="fa-solid fa-clock" style="color:#856404"></i> เลื่อนเวลาโพส ${ids.length} รายการ`,
    html: `<div style="text-align:left">
      <label style="font-size:.82rem;font-weight:600;color:#555;display:block;margin-bottom:.3rem">เวลาที่ต้องการโพส (ใช้กับทุกรายการที่เลือก)</label>
      <div class="dt24-wrap" style="margin-bottom:.4rem">
        <input type="date" lang="en-GB" id="swal-jqBulkAt_d" style="cursor:pointer;min-width:110px">
        <input type="number" id="swal-jqBulkAt_h" min="0" max="23" placeholder="ชม." style="width:50px;text-align:center">
        <span>:</span>
        <input type="number" id="swal-jqBulkAt_m" min="0" max="59" placeholder="น." style="width:50px;text-align:center">
      </div>
      <div style="display:flex;gap:.3rem;flex-wrap:wrap">
        <button type="button" onclick="dtToday('swal-jqBulkAt')" style="background:#e7f0fd;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#1877f2;font-family:inherit;font-weight:600">วันนี้</button>
        <button type="button" onclick="dtQuick('swal-jqBulkAt',60)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+1ชม.</button>
        <button type="button" onclick="dtQuick('swal-jqBulkAt',180)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+3ชม.</button>
        <button type="button" onclick="dtQuick('swal-jqBulkAt',1440)" style="background:#f0f2f5;border:none;border-radius:6px;padding:.25rem .5rem;font-size:.72rem;cursor:pointer;color:#444;font-family:inherit">+1วัน</button>
      </div>
    </div>`,
    confirmButtonText: 'บันทึกทั้งหมด', confirmButtonColor: '#856404',
    showCancelButton: true, cancelButtonText: 'ยกเลิก', focusConfirm: false,
    preConfirm: () => {
      const v = dt24Get('swal-jqBulkAt');
      if (!v) { Swal.showValidationMessage('กรุณาเลือกวันที่และเวลา'); return false; }
      return v;
    },
  });
  if (!isConfirmed) return;
  const scheduledAt = new Date(value + ':00+07:00').toISOString();
  try {
    await Promise.all(ids.map(id => fetch(`/api/agent/jobs/${id}/schedule`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ scheduledAt }),
    })));
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เลื่อนเวลาไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
  }
}

function toggleForm() {
  const f = document.getElementById('createForm');
  if (!f) return;
  f.scrollIntoView({ behavior: 'smooth', block: 'start' });
  setTimeout(() => document.getElementById('fMsg')?.focus({ preventScroll: true }), 400);
}

/* ── Selection counter (also per category) ── */
function updateSelCount() {
  const total = document.querySelectorAll('[id^="gc_"]').length;
  const checked = document.querySelectorAll('[id^="gc_"]:checked').length;
  const el = document.getElementById('selCount');
  if (el) {
    el.textContent = checked > 0 ? `เลือก ${checked}/${total} กลุ่ม` : 'ยังไม่ได้เลือก';
    el.classList.toggle('on', checked > 0);
  }
  Object.keys(_catIdxMap).forEach(ci => {
    const idx = _catIdxMap[ci] || [];
    const n = idx.filter(i => document.getElementById(`gc_${i}`)?.checked).length;
    const c = document.getElementById(`catcount_${ci}`);
    if (c) c.textContent = `${n}/${idx.length}`;
  });
  updateSummary();
}

/* ── Group search: show matching groups, open their categories ── */
function filterGroups(q) {
  const term = (q || '').trim().toLowerCase();
  let anyShown = false;
  Object.keys(_catIdxMap).forEach(ci => {
    let shown = 0;
    (_catIdxMap[ci] || []).forEach(i => {
      const row = document.getElementById(`glabel_${i}`);
      if (!row) return;
      const hit = !term || (row.dataset.name || '').includes(term);
      row.style.display = hit ? '' : 'none';
      if (hit) shown++;
    });
    const hd = document.getElementById(`jqCatHd_${ci}`);
    const body = document.getElementById(`jqCatBody_${ci}`);
    const chev = document.getElementById(`jqChev_${ci}`);
    if (hd) hd.style.display = shown ? '' : 'none';
    // Searching opens every category with a hit; clearing folds them all back.
    if (body) body.style.display = term && shown ? '' : 'none';
    if (chev) chev.style.transform = term && shown ? '' : 'rotate(-90deg)';
    if (shown) anyShown = true;
  });
  const empty = document.getElementById('fGroupEmpty');
  if (empty) empty.style.display = anyShown ? 'none' : '';
}

/* ── What to post: text / text + link card / share a link ──
   The posting machine reads "text|||url" (text with a link card) and
   "|||url" (link card only); the form builds that so nobody types it. */
let _postMode = 'text';
function setPostMode(mode, silent) {
  if (mode !== 'text' && _media.length && !silent) {
    Swal.fire({ icon:'info', title:'โพสแบบลิงก์แนบรูปไม่ได้', text:'Facebook จะไม่แสดงการ์ดลิงก์ถ้ามีรูป กรุณาเอารูป/วิดีโอออกก่อน หรือใช้รูปแบบ "ข้อความ"', confirmButtonColor:'#1877f2' });
    return;
  }
  _postMode = mode;
  document.querySelectorAll('.jq-mode').forEach(b => {
    const on = b.dataset.mode === mode;
    b.classList.toggle('active', on);
    b.setAttribute('aria-checked', on ? 'true' : 'false');
  });
  document.getElementById('fTextBox').style.display = mode === 'share' ? 'none' : '';
  document.getElementById('fMediaRow').style.display = mode === 'text' ? '' : 'none';
  document.getElementById('fLinkBox').style.display = mode === 'text' ? 'none' : '';
  document.getElementById('fMsg').placeholder = mode === 'link' ? 'พิมพ์ข้อความที่จะแสดงเหนือการ์ดลิงก์...' : 'พิมพ์ข้อความที่ต้องการโพส...';
  updateSummary();
}
function _validLink(v) { return /^https?:\/\/[^\s]+\.[^\s]+$/i.test((v || '').trim()); }
// The message exactly as the posting machine expects it, or null if incomplete.
function _composedMessage() {
  const text = document.getElementById('fMsg').value.trim();
  const link = document.getElementById('fLink').value.trim();
  if (_postMode === 'text')  return text || null;
  if (!_validLink(link)) return null;
  if (_postMode === 'share') return '|||' + link;
  return text ? `${text}|||${link}` : null;
}
// Fills the form from a stored message (template / previous post).
function _loadMessage(stored) {
  const s = String(stored || '');
  const i = s.indexOf('|||');
  if (i === -1) { document.getElementById('fMsg').value = s; document.getElementById('fLink').value = ''; setPostMode('text', true); return; }
  const text = s.slice(0, i).trim(), url = s.slice(i + 3).trim();
  document.getElementById('fMsg').value = text;
  document.getElementById('fLink').value = url;
  setPostMode(text ? 'link' : 'share', true);
}

function togglePanel(id, btn) {
  const el = document.getElementById(id);
  if (!el) return;
  const open = el.style.display === 'none';
  ['howToPanel', 'tipsPanel'].forEach(p => { const x = document.getElementById(p); if (x) x.style.display = 'none'; });
  ['btnHowTo', 'btnTips'].forEach(b => document.getElementById(b)?.classList.remove('active'));
  if (open) { el.style.display = ''; btn?.classList.add('active'); }
}

/* ── Previous posts: reuse a message that was posted before ── */
async function openRecentPosts() {
  let jobs = [];
  try { jobs = await (await fetch('/api/agent/jobs')).json(); } catch {}
  const seen = new Set();
  const list = (Array.isArray(jobs) ? jobs : []).filter(j => {
    if (!j.message || seen.has(j.message)) return false;
    seen.add(j.message); return true;
  }).slice(0, 30);
  if (!list.length) { Swal.fire({ icon:'info', title:'ยังไม่มีโพสก่อนหน้า', confirmButtonColor:'#1877f2' }); return; }
  const esc = s => String(s || '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  const label = m => { const i = m.indexOf('|||'); return i === -1 ? ['ข้อความ', m] : (m.slice(0, i).trim() ? ['ข้อความ + ลิงก์', m.slice(0, i).trim()] : ['แชร์ลิงก์', m.slice(i + 3).trim()]); };
  const html = `<div style="max-height:55vh;overflow-y:auto;text-align:left">${list.map((j, i) => {
    const [kind, text] = label(j.message);
    const when = new Date(j.lastAttemptAt || j.createdAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',dateStyle:'short',timeStyle:'short'});
    return `<button type="button" class="jq-recent-item" data-i="${i}">
      <div style="font-size:.72rem;color:#1877f2;font-weight:700">${kind}${(j.images||[]).length ? ' · ' + j.images.length + ' ไฟล์' : ''}${j.postAsPage ? ' · ' + esc(j.postAsPage) : ''} <span style="color:#8a8d91;font-weight:400">· ${when}</span></div>
      <div style="font-size:.84rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(text.slice(0, 110))}</div>
    </button>`; }).join('')}</div>`;
  let picked = null;
  await Swal.fire({
    title:'โพสก่อนหน้า', html, showConfirmButton:false, showCloseButton:true, width:600,
    didOpen: (popup) => popup.querySelectorAll('.jq-recent-item').forEach(b => b.addEventListener('click', () => { picked = list[+b.dataset.i]; Swal.close(); })),
  });
  if (!picked) return;
  if (!(await _confirmReplace(picked.message))) return;
  _media = [];
  // Files older than 30 days are deleted by the daily cleanup — don't reuse them.
  const files = (picked.images || []).filter(Boolean);
  const fresh = files.filter(f => !_mediaExpired(f));
  fresh.forEach(addExistingMedia);
  _loadMessage(picked.message);
  renderMedia();
  if (fresh.length < files.length) {
    Swal.fire({ icon:'info', title:`รูป/วิดีโอ ${files.length - fresh.length} ไฟล์ของโพสนี้ถูกลบแล้ว`, text:'ไฟล์ที่เกิน 30 วันจะถูกลบอัตโนมัติ กรุณาแนบใหม่ถ้าต้องการ', confirmButtonColor:'#1877f2' });
  }
}
function _mediaExpired(ref) {
  const m = String(ref || '').split('?')[0].split('/').pop().match(/^(\d{13})-/);
  return !!m && Date.now() - Number(m[1]) > 30 * 24 * 60 * 60 * 1000;
}
async function _confirmReplace(newMessage) {
  const current = _composedMessage() || document.getElementById('fMsg').value.trim();
  if (!current || current === newMessage) return true;
  const r = await Swal.fire({ icon:'question', title:'แทนที่ข้อความเดิม?', text:'ข้อความ ลิงก์ และไฟล์ที่ใส่ไว้จะถูกแทนที่', showCancelButton:true, confirmButtonText:'แทนที่', cancelButtonText:'ยกเลิก', confirmButtonColor:'#1877f2' });
  return r.isConfirmed;
}

/* ── When to post ── */
let _whenMode = 'now';
function setWhen(mode) {
  _whenMode = mode;
  document.getElementById('whenNow')?.classList.toggle('active', mode === 'now');
  document.getElementById('whenLater')?.classList.toggle('active', mode === 'later');
  const picker = document.getElementById('whenPicker');
  if (picker) picker.style.display = mode === 'later' ? '' : 'none';
  if (mode === 'later' && !document.getElementById('fScheduledAt_d')?.value) dtQuick('fScheduledAt', 60);
  updateSummary();
}
function setTomorrow(hour) {
  const bkk = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Bangkok' }));
  bkk.setDate(bkk.getDate() + 1);
  const pad = n => String(n).padStart(2, '0');
  dt24Set('fScheduledAt', `${bkk.getFullYear()}-${pad(bkk.getMonth() + 1)}-${pad(bkk.getDate())}T${pad(hour)}:00`);
}
function _scheduledIso() {
  if (_whenMode !== 'later') return null;
  const v = dt24Get('fScheduledAt');
  return v ? new Date(v.slice(0, 16) + ':00+07:00').toISOString() : null;
}

/* ── Live summary above the submit button ── */
function updateSummary() {
  const el = document.getElementById('fSummary');
  if (!el) return;
  const msgEl = document.getElementById('fMsg');
  const cnt = document.getElementById('fMsgCount');
  if (cnt && msgEl) cnt.textContent = msgEl.value.length;
  const page = document.getElementById('fPage')?.value || '';
  const groups = document.querySelectorAll('[id^="gc_"]:checked').length;
  const hasMsg = !!(msgEl && msgEl.value.trim());
  const linkEl = document.getElementById('fLink');
  const linkVal = linkEl ? linkEl.value.trim() : '';
  const linkOk = _validLink(linkVal);
  if (linkEl) linkEl.classList.toggle('bad', _postMode !== 'text' && !!linkVal && !linkOk);
  const linkHint = document.getElementById('fLinkHint');
  if (linkHint) linkHint.textContent = (_postMode !== 'text' && linkVal && !linkOk) ? 'ลิงก์ต้องขึ้นต้นด้วย http:// หรือ https://' : (_postMode === 'share' ? 'โพสจะขึ้นเป็นการ์ดลิงก์อย่างเดียว ไม่มีข้อความ' : 'ลิงก์จะไม่ขึ้นในข้อความ แต่ขึ้นเป็นการ์ดตัวอย่างใต้ข้อความ');
  const sched = _scheduledIso();
  const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c]));
  const modeName = { text:'ข้อความ', link:'ข้อความ + ลิงก์', share:'แชร์ลิงก์' }[_postMode];
  const parts = [
    page ? `ในนาม <b>${esc(page)}</b>` : '<span class="warn">ยังไม่ได้เลือกเพจ</span>',
    `แบบ <b>${modeName}</b>`,
    (_postMode !== 'share' && !hasMsg) ? '<span class="warn">ยังไม่มีข้อความ</span>' : '',
    (_postMode !== 'text' && !linkOk) ? '<span class="warn">ยังไม่มีลิงก์</span>' : '',
    groups ? `<b>${groups}</b> กลุ่ม` : '<span class="warn">ยังไม่ได้เลือกกลุ่ม</span>',
    (_postMode === 'text' && _media.length) ? `${_media.length} ไฟล์` : '',
    _whenMode === 'later'
      ? (sched ? `โพส <b>${new Date(sched).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',dateStyle:'medium',timeStyle:'short'})}</b>` : '<span class="warn">ยังไม่ได้ตั้งเวลา</span>')
      : 'โพสทันทีตามลำดับคิว',
  ].filter(Boolean);
  el.innerHTML = parts.join(' · ');
}

