<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Job Queue - Multi Post System</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <div class="fb-logo"><i class="fa-brands fa-facebook"></i></div>
      <span>Multi Post System</span>
    </div>

  </div>
</nav>

<div class="page-wrap">

  <aside class="sidebar">
        <div class="sidebar-label">โพสลงเพจ</div>
    <a href="/" class="sidebar-item"><i class="fa-solid fa-pen-to-square"></i><span>โพสใหม่</span></a>
    <a href="/overview" class="sidebar-item"><i class="fa-solid fa-chart-line"></i><span>ภาพรวม</span></a>
    <a href="/history" class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติโพส</span></a>
    <a href="/pages" class="sidebar-item"><i class="fa-brands fa-facebook"></i><span>จัดการเพจ</span></a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-label">โพส&amp;แชร์ ลงกลุ่ม</div>
    <a href="/guide" class="sidebar-item"><i class="fa-solid fa-book-open"></i><span>คู่มือการใช้งาน</span></a>
    <a href="/groups" class="sidebar-item"><i class="fa-solid fa-users-rectangle"></i><span>จัดการกลุ่ม</span></a>
    <a href="/agent" class="sidebar-item"><i class="fa-solid fa-robot"></i><span>ติดตั้ง Desktop Agent</span></a>
    <a href="/job-queue" class="sidebar-item active"><i class="fa-solid fa-list-check"></i><span>คิวโพส</span></a>
  </aside>

  <main class="feed">

    <!-- Agent status banner (top) -->
    <div id="agentBanner" style="display:none"></div>

    <!-- Header -->
    <div class="card" style="padding:.85rem 1.25rem;display:flex;align-items:center;justify-content:space-between">
      <div class="card-title" style="font-size:1.05rem">
        <i class="fa-solid fa-list-check"></i> คิวโพสลงกลุ่ม
        <span style="background:#e4e6ea;padding:.15rem .55rem;border-radius:999px;font-size:.8rem;margin-left:.4rem" id="jobCount"><%= jobs.length %></span>
      </div>
    </div>

    <% if (groups.length === 0) { %>
    <div class="card" style="background:linear-gradient(135deg,#e8f4ff 0%,#f0f7ff 100%);border-color:#b3d4f9;padding:1.25rem 1.5rem;text-align:center">
      <i class="fa-solid fa-robot" style="font-size:2.5rem;color:#1877f2;margin-bottom:.65rem;display:block"></i>
      <div style="font-weight:700;font-size:1rem;color:var(--text-primary);margin-bottom:.4rem">ยังไม่มีกลุ่ม Facebook</div>
      <div style="font-size:.87rem;color:var(--text-secondary);line-height:1.75;margin-bottom:1rem">
        หากต้องการโพสหรือแชร์ลงกลุ่ม Facebook<br>
        ต้องทำตามขั้นตอนนี้ก่อน:
      </div>
      <div style="display:inline-flex;flex-direction:column;gap:.5rem;text-align:left;font-size:.85rem;color:var(--text-secondary);margin-bottom:1.25rem;line-height:1.7">
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;margin-right:.4rem">1</span>ไปที่ <a href="/groups" style="color:#1877f2;font-weight:600">จัดการกลุ่ม</a> แล้วเพิ่มกลุ่มที่ต้องการ</div>
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;margin-right:.4rem">2</span>ดาวน์โหลด Desktop Agent ติดตั้งบนเครื่อง Windows</div>
        <div><span style="background:#1877f2;color:#fff;border-radius:50%;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;margin-right:.4rem">3</span>เปิด Agent → Login Facebook → กลับมาสั่งโพสที่หน้านี้</div>
      </div>
      <div style="display:flex;gap:.6rem;justify-content:center;flex-wrap:wrap">
        <a href="/groups" style="display:inline-flex;align-items:center;gap:.45rem;background:#f0f2f5;color:#1c1e21;padding:.5rem 1.1rem;border-radius:8px;font-weight:700;font-size:.85rem;text-decoration:none">
          <i class="fa-solid fa-users-rectangle"></i> เพิ่มกลุ่ม
        </a>
        <a href="/agent" style="display:inline-flex;align-items:center;gap:.45rem;background:#1877f2;color:#fff;padding:.5rem 1.1rem;border-radius:8px;font-weight:700;font-size:.85rem;text-decoration:none">
          <i class="fa-solid fa-download"></i> ดาวน์โหลด Agent
        </a>
      </div>
    </div>
    <% } else { %>

    <!-- Create Job Form -->
    <div class="card" id="createForm" style="display:none">
      <div class="card-title"><i class="fa-solid fa-plus"></i> สร้าง Job โพสต์กลุ่ม</div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:.75rem">
        <!-- Left: message -->
        <div>
          <label class="form-label">ข้อความ <span style="color:#fa5252">*</span></label>
          <textarea id="fMsg" rows="6" placeholder="พิมพ์ข้อความที่ต้องการโพสต์..." style="width:100%"></textarea>
        </div>
        <!-- Right: groups -->
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.3rem">
            <label class="form-label" style="margin-bottom:0">กลุ่ม <span style="color:#fa5252">*</span></label>
            <span>
              <button class="btn-link-sm" onclick="selAll()">ทั้งหมด</button>
              <button class="btn-link-sm" onclick="selNone()">ยกเลิก</button>
            </span>
          </div>
          <div style="border:1px solid var(--border-color);border-radius:8px;max-height:160px;overflow-y:auto">
            <% groups.forEach((g, i) => { %>
            <label style="display:flex;align-items:center;gap:.5rem;padding:.4rem .65rem;cursor:pointer;border-bottom:1px solid var(--border-color);font-size:.88rem"
                   id="glabel_<%= i %>">
              <input type="checkbox" id="gc_<%= i %>" value="<%= i %>" style="accent-color:#1877f2" checked>
              <span style="flex:1"><%= g.groupName %></span>
              <span style="font-size:.73rem;color:var(--text-secondary)"><%= g.pageName %></span>
            </label>
            <% }); %>
          </div>
        </div>
      </div>

      <div style="display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap;margin-bottom:.75rem">
        <div>
          <label class="form-label">Delay ระหว่างกลุ่ม (วินาที)</label>
          <input type="number" id="fDelay" value="5" min="1" max="120" style="width:90px">
        </div>
        <div>
          <label class="form-label">ตั้งเวลาโพส (ไม่บังคับ)</label>
          <div style="display:flex;align-items:center;gap:.4rem">
            <input type="datetime-local" id="fScheduledAt"
              style="padding:.4rem .6rem;border:1.5px solid #e4e6eb;border-radius:8px;font-size:.83rem;font-family:inherit;color:#444;outline:none">
            <button type="button" onclick="document.getElementById('fScheduledAt').value=''"
              style="background:#f0f2f5;border:none;border-radius:7px;padding:.4rem .6rem;font-size:.78rem;cursor:pointer;color:#65676b" title="ล้าง">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        </div>
      </div>

      <div style="display:flex;gap:.5rem">
        <button class="btn-post" style="font-size:.85rem;padding:.45rem 1rem" onclick="submitJob()">
          <i class="fa-solid fa-paper-plane"></i> เพิ่มลงคิว
        </button>
        <button class="btn-back" onclick="toggleForm()">ยกเลิก</button>
      </div>
    </div>

    <!-- Jobs list -->
    <div class="card">
      <div class="card-title">
        <i class="fa-solid fa-clock-rotate-left"></i> รายการ Jobs
        <button class="btn-link-sm" style="margin-left:auto" onclick="location.reload()"><i class="fa-solid fa-rotate-right"></i> รีเฟรช</button>
      </div>

      <% if (jobs.length === 0) { %>
      <div style="color:var(--text-secondary);text-align:center;padding:1.5rem;font-size:.9rem">ยังไม่มี Job</div>
      <% } else { %>
      <% const icons = { pending:'⏳', running:'🔄', done:'✅', failed:'❌' }; %>
      <% const statusTH = { pending:'รอ', running:'กำลังทำ', done:'เสร็จ', failed:'ล้มเหลว' }; %>
      <% const statusCls = { pending:'badge-yellow', running:'badge-blue', done:'badge-green', failed:'badge-red' }; %>
      <% jobs.forEach((j, idx) => {
           // parse display text — strip |||URL
           let dispMsg = j.message||'';
           let modeTag = '';
           if (dispMsg.includes('|||')) {
             const sep = dispMsg.indexOf('|||');
             const txt = dispMsg.slice(0,sep).trim();
             const url = dispMsg.slice(sep+3).trim();
             if (txt) { dispMsg = txt; modeTag = '🔗 ลิงก์'; }
             else { dispMsg = url.length>55?url.slice(0,55)+'…':url; modeTag = '↗ แชร์'; }
           }
           if (dispMsg.length>70) dispMsg = dispMsg.slice(0,70)+'…';
      %>
      <div style="display:flex;align-items:flex-start;gap:.7rem;padding:.65rem .5rem;border-bottom:1px solid var(--border-color)"
           id="job_<%= j._id %>" class="job-row" data-idx="<%= idx %>">
        <span style="font-size:1.2rem;flex-shrink:0;margin-top:.1rem"><%= icons[j.status]||'❓' %></span>
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
            <% if(modeTag){ %><span style="font-size:.7rem;font-weight:700;background:#e7f3ff;color:#1877f2;border-radius:4px;padding:.05rem .4rem;margin-right:.3rem"><%= modeTag %></span><% } %><%= dispMsg %>
          </div>
          <div style="font-size:.78rem;color:var(--text-secondary);margin-top:.2rem">
            <%= (j.groups||[]).length %> กลุ่ม · delay <%= j.delaySeconds %>s ·
            <%= new Date(j.createdAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',hour12:false,dateStyle:'short',timeStyle:'short'}) %>
            <% if (j.scheduledAt) { %>
            · <span style="color:#856404;font-weight:600"><i class="fa-solid fa-clock" style="font-size:.7rem"></i> โพส <%= new Date(j.scheduledAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',hour12:false,dateStyle:'short',timeStyle:'short'}) %></span>
            <% } %>
            <% if (j.status==='done'||j.status==='failed') { %>
            · <strong><%= (j.results||[]).filter(r=>r.status==='success').length %>/<%= (j.groups||[]).length %></strong> สำเร็จ
            <% } %>
          </div>
        </div>
        <span class="badge <%= statusCls[j.status]||'' %>" style="flex-shrink:0"><%= statusTH[j.status]||j.status %></span>
        <button onclick="deleteJob('<%= j._id %>')" style="background:none;border:none;cursor:pointer;color:#c5c8d0;font-size:1rem;padding:.1rem .3rem;border-radius:4px" title="ลบ">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
      <% }); %>
      <% if (jobs.length > 20) { %>
      <div id="showMoreRow" style="padding:.65rem;text-align:center">
        <button onclick="showMoreJobs()" style="background:#f0f2f5;border:none;border-radius:8px;padding:.45rem 1.1rem;font-size:.85rem;cursor:pointer;font-family:inherit;color:#1877f2;font-weight:600">
          เพิ่มเติม (<%= jobs.length-20 %> รายการ)
        </button>
      </div>
      <% } %>
      <% } %>
    </div>

    <% } %>

  </main>
</div>

<style>
.form-label { display:block; font-size:.8rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:.04em; margin-bottom:.3rem }
.btn-link-sm { background:none; border:none; color:#1877f2; font-size:.8rem; cursor:pointer; font-family:inherit; padding:0 .3rem }
.btn-link-sm:hover { text-decoration:underline }
.badge-yellow { background:#fff3cd; color:#856404 }
.badge-blue   { background:#cfe2ff; color:#084298 }
.badge-green  { background:#d1e7dd; color:#0a3622 }
.badge-red    { background:#f8d7da; color:#842029 }
</style>

<script>
const _groups = <%- JSON.stringify(groups) %>;
let _visibleJobs = 20;

// Hide jobs beyond 20 on load
document.querySelectorAll('.job-row').forEach(r => {
  if (parseInt(r.dataset.idx) >= _visibleJobs) r.style.display = 'none';
});

function showMoreJobs() {
  _visibleJobs += 20;
  document.querySelectorAll('.job-row').forEach(r => {
    if (parseInt(r.dataset.idx) < _visibleJobs) r.style.display = 'flex';
  });
  const btn = document.getElementById('showMoreRow');
  const remaining = document.querySelectorAll('.job-row[style*="display: none"], .job-row[style*="display:none"]').length;
  if (remaining === 0 && btn) btn.style.display = 'none';
}

function toggleForm() {
  const f = document.getElementById('createForm');
  f.style.display = f.style.display === '' ? 'none' : '';
}

function selAll()  { document.querySelectorAll('[id^="gc_"]').forEach(c=>c.checked=true); }
function selNone() { document.querySelectorAll('[id^="gc_"]').forEach(c=>c.checked=false); }

async function submitJob() {
  const msg     = document.getElementById('fMsg').value.trim();
  const delay   = parseInt(document.getElementById('fDelay').value) || 5;
  const schedAt = document.getElementById('fScheduledAt')?.value || '';
  const sel     = _groups.filter((_,i)=>document.getElementById(`gc_${i}`)?.checked);

  if (!msg)       { Swal.fire({ icon:'warning', title:'กรุณากรอกข้อความ', confirmButtonColor:'#1877f2' }); return; }
  if (!sel.length){ Swal.fire({ icon:'warning', title:'กรุณาเลือกกลุ่ม', confirmButtonColor:'#1877f2' }); return; }

  if (schedAt && new Date(schedAt) <= new Date()) {
    Swal.fire({ icon:'warning', title:'กรุณาเลือกเวลาในอนาคต', confirmButtonColor:'#1877f2' });
    return;
  }

  try {
    const r = await fetch('/api/agent/jobs', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ message:msg, groups:sel, delaySeconds:delay, scheduledAt: schedAt ? new Date(schedAt.slice(0,16) + ':00+07:00').toISOString() : null }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error||'เกิดข้อผิดพลาด');
    const schedMsg = schedAt
      ? `ตั้งเวลาไว้ที่ ${new Date(schedAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok',dateStyle:'short',timeStyle:'short'})}`
      : 'Job จะเริ่มทันทีที่ Agent ออนไลน์';
    await Swal.fire({ icon:'success', title:'เพิ่ม Job สำเร็จ', text: schedMsg, timer:2000, showConfirmButton:false });
    location.reload();
  } catch(e) {
    Swal.fire({ icon:'error', title:'เกิดข้อผิดพลาด', text:e.message, confirmButtonColor:'#1877f2' });
  }
}

async function deleteJob(id) {
  const res = await Swal.fire({ title:'ลบ Job?', icon:'warning', showCancelButton:true, confirmButtonColor:'#fa5252', confirmButtonText:'ลบ', cancelButtonText:'ยกเลิก' });
  if (!res.isConfirmed) return;
  try {
    const r = await fetch(`/api/agent/jobs/${id}`, { method:'DELETE' });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    document.getElementById(`job_${id}`)?.remove();
    const cnt = document.querySelectorAll('[id^="job_"]').length;
    document.getElementById('jobCount').textContent = cnt;
  } catch (e) {
    Swal.fire({ icon:'error', title:'ลบไม่สำเร็จ', text: e.message, confirmButtonColor:'#1877f2' });
  }
}

async function checkAgent() {
  const banner = document.getElementById('agentBanner');
  if (!banner) return;
  try {
    const r = await fetch('http://localhost:3001/api/status', { signal: AbortSignal.timeout(3000) });
    const d = await r.json();
    banner.style.display = 'block';
    banner.innerHTML = `<div class="card" style="background:#d1e7dd;border-color:#a3cfbb;font-size:.85rem;color:#0a3622;padding:.7rem 1.1rem;display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
      <i class="fa-solid fa-robot"></i>
      <strong>Desktop Agent ออนไลน์</strong>
      <span style="opacity:.7">·</span>
      <span>Runner: ${d.running ? '<strong>กำลังโพส ▶</strong>' : 'หยุด ⏹'}</span>
      <a href="/agent" style="color:#0a3622;margin-left:auto;font-size:.8rem">ดูรายละเอียด →</a>
    </div>`;
  } catch {
    banner.style.display = 'block';
    banner.innerHTML = `<div class="card" style="background:#fff8e1;border-color:#f0c36d;padding:.85rem 1.25rem">
      <div style="display:flex;align-items:center;gap:.9rem;flex-wrap:wrap">
        <div style="flex:1;min-width:180px">
          <div style="font-weight:700;color:#856404;margin-bottom:.3rem;font-size:.9rem">
            <i class="fa-solid fa-triangle-exclamation"></i> Desktop Agent ยังไม่ได้เปิด
          </div>
          <div style="font-size:.82rem;color:#6b5005;line-height:1.7">
            Job ที่สร้างไว้จะรอจนกว่า Agent จะออนไลน์<br>
            ดาวน์โหลดและติดตั้ง Agent แล้วเปิดไว้เพื่อให้ระบบทำงานได้
          </div>
        </div>
        <a href="/agent" style="display:inline-flex;align-items:center;gap:.45rem;background:#f7b928;color:#1c1e21;padding:.48rem 1rem;border-radius:8px;font-weight:700;font-size:.83rem;text-decoration:none;flex-shrink:0;white-space:nowrap">
          <i class="fa-solid fa-download"></i> ดาวน์โหลด / เปิด Agent
        </a>
      </div>
    </div>`;
  }
}
checkAgent();
</script>

</body>
</html>
